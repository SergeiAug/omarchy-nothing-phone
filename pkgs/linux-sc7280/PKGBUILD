_kmake() {
  local args=(ARCH=arm64)
  if [[ $CARCH != aarch64 || -n ${CROSS_COMPILE:-} ]]; then
    args+=(CROSS_COMPILE="${CROSS_COMPILE:-aarch64-linux-gnu-}")
  fi
  make "${args[@]}" "$@"
}

prepare() {
  cd "$_tree"
  local kernel_patch
  for kernel_patch in "${_patches[@]}"; do
    patch -Np1 -i "$srcdir/$kernel_patch"
  done
  cp "$srcdir/config-postmarketos-qcom-sc7280.aarch64" .config
  # An archive has no SCM version; keep modules and initramfs tied to this package release.
  scripts/config --disable LOCALVERSION_AUTO --set-str LOCALVERSION "-${pkgrel}-sc7280"
  _kmake olddefconfig
}

build() {
  cd "$_tree"
  unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
  _kmake Image Image.gz vmlinuz.efi modules dtbs
  _kmake -s kernelrelease > version
}

package_linux-sc7280() {
  depends=('coreutils' 'kmod' 'mkinitcpio')
  optdepends=('firmware-nothing-spacewar: device firmware' 'linux-firmware-qcom: Adreno firmware')
  conflicts=('linux-aarch64')
  cd "$_tree"
  local kernver=$(<version)
  local modulesdir="$pkgdir/usr/lib/modules/$kernver"
  _kmake INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 DEPMOD=/usr/bin/true modules_install
  rm -f "$modulesdir/build" "$modulesdir/source"
  install -Dm644 arch/arm64/boot/Image "$modulesdir/vmlinuz"
  printf '%s\n' "$pkgbase" > "$modulesdir/pkgbase"
  install -Dm644 arch/arm64/boot/Image "$pkgdir/boot/Image"
  install -Dm644 arch/arm64/boot/Image.gz "$pkgdir/boot/Image.gz"
  install -Dm644 arch/arm64/boot/vmlinuz "$pkgdir/boot/vmlinuz"
  _kmake INSTALL_DTBS_PATH="$pkgdir/boot/dtbs" dtbs_install
  install -Dm644 version "$pkgdir/usr/share/kernel/$pkgbase/kernel.release"
  install -Dm644 "$srcdir/linux-sc7280.preset" "$pkgdir/etc/mkinitcpio.d/linux-sc7280.preset"
}

package_linux-sc7280-headers() {
  pkgdesc='Headers and build scripts for linux-sc7280'
  depends=('pahole')
  cd "$_tree"
  local builddir="$pkgdir/usr/lib/modules/$(<version)/build"
  install -Dt "$builddir" -m644 .config Makefile Module.symvers System.map version vmlinux
  install -Dt "$builddir/kernel" -m644 kernel/Makefile
  install -Dt "$builddir/arch/arm64" -m644 arch/arm64/Makefile
  cp -a --no-preserve=ownership scripts include "$builddir/"
  cp -a --no-preserve=ownership arch/arm64/include "$builddir/arch/arm64/"
  install -Dm644 arch/arm64/kernel/asm-offsets.s "$builddir/arch/arm64/kernel/asm-offsets.s"
  # External modules sometimes include private in-tree headers as well as include/.
  find . -type f \( -name 'Kconfig*' -o -name '*.h' \) \
    -exec install -Dm644 '{}' "$builddir/{}" \;
  find "$builddir" -type f -name '*.o' -delete
  install -d "$pkgdir/usr/src"
  ln -s "../lib/modules/$(<version)/build" "$pkgdir/usr/src/$pkgbase"
}
