package() {
  install -Dm644 "$srcdir/81-libssc-nothing-spacewar.rules" "$pkgdir/usr/lib/udev/rules.d/81-libssc-nothing-spacewar.rules"
  install -Dm644 "$srcdir/deviceinfo" "$pkgdir/usr/share/nothing-spacewar/deviceinfo"
  install -Dm644 "$srcdir/spacewar.conf" "$pkgdir/etc/mkinitcpio.conf.d/spacewar.conf"
  install -Dm755 "$srcdir/spacewar-mkbootimg" "$pkgdir/usr/bin/spacewar-mkbootimg"
  install -Dm644 "$srcdir/99-spacewar-boot.hook" "$pkgdir/usr/share/libalpm/hooks/99-spacewar-boot.hook"
  install -Dm755 "$srcdir/spacewar-usb-reprobe" "$pkgdir/usr/bin/spacewar-usb-reprobe"
  install -Dm644 "$srcdir/spacewar-usb-reprobe.service" "$pkgdir/usr/lib/systemd/system/spacewar-usb-reprobe.service"
