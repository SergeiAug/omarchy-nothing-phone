widget "reminders" {
  page: 1
  order: 4
  size: 3x5
  minSize: 3x3

  meta { owl: 5; description: "Reminders with quick or custom date/time, editing and Android notifications when due."; version: "2.2"; license: "MIT"; category: "productivity" }

  source now = clock every 30s
  state items = [] persist
  state nextId = 1 persist
  state delay = 1800 persist
  state editId = 0
  state draft = ""
  state when = 0

  let pending = items.filter(r => !r.fired).sortBy(r => r.at)
  let nextAt = first(pending).at
  let done = items.filter(r => r.fired)

  at nextAt {
    notify("reminder", join(pending.filter(r => r.at <= nextAt).map(r => r.t), ", "))
    items = items.map(r => r.at <= nextAt && !r.fired ? {id: r.id ?? r.at, t: r.t, at: r.at, fired: true} : r)
  }

  component Chip(label, secs) {
    Text {
      text: label; style: small; align: center; weight: 1
      padding: [0, 4]; border: 1; borderColor: delay == secs ? accent : border
      color: delay == secs ? accent : muted
      onTap: delay = secs
    }
  }

  component Adj(label, secs) {
    Button { text: label; weight: 1; onTap: when = when + secs }
  }

  Column {
    gap: 6
    fill: true
    Text { text: "reminders"; style: muted }
    Input {
      placeholder: "remind me to…"; clear: true
      onSubmit: { items = value == "" ? items : [{id: nextId, t: value, at: now + delay, fired: false}] + pending + done.take(20); nextId = value == "" ? nextId : nextId + 1 }
    }
    Row {
      gap: 4
      Chip { label: "5m"; secs: 300 }
      Chip { label: "30m"; secs: 1800 }
      Chip { label: "1h"; secs: 3600 }
      Chip { label: "1d"; secs: 86400 }
      Text {
        text: "set"; style: small; align: center; weight: 1
        padding: [0, 4]; border: 1; borderColor: border; color: muted
        onTap: { editId = 0; draft = ""; when = now + delay; screen() }
      }
    }
    Column {
      gap: 4
      weight: 1
      scroll: true
      if len(items) == 0 {
        Text { text: "nothing scheduled"; style: small; color: muted }
      }
      for r in pending key r.id ?? r.at {
        Row {
          gap: 6
          onTap: { editId = r.id ?? r.at; draft = r.t; when = r.at; screen() }
          Text { text: r.t; style: small; weight: 1; maxLines: 2 }
          Text { text: fmtDuration(max(r.at - now, 0)); style: small; color: accent; width: 56; align: end }
        }
      }
      for r in done.take(5) key r.id ?? r.at {
        Text {
          text: "✓ ${r.t}"; style: small; color: muted; maxLines: 1
          onTap: { editId = r.id ?? r.at; draft = r.t; when = now + delay; screen() }
        }
      }
    }
  }

  screen {
    title: editId == 0 ? "new reminder" : "edit reminder"
    Column {
      gap: 10
      padding: 12
      scroll: true
      Input { text: draft; placeholder: "remind me to…"; onChange: draft = value }
      Text { text: fmtTime(when ?? now, "EEE dd/MM/yyyy"); style: title }
      Text { text: fmtTime(when, "HH:mm"); style: huge; color: accent }
      Text { text: when > now ? "in ${fmtDuration(when - now)}" : "now"; style: muted }
      Row { gap: 6; Adj { label: "-1d"; secs: -86400 }  Adj { label: "+1d"; secs: 86400 } }
      Row { gap: 6; Adj { label: "-1h"; secs: -3600 }  Adj { label: "+1h"; secs: 3600 } }
      Row { gap: 6; Adj { label: "-5m"; secs: -300 }  Adj { label: "+5m"; secs: 300 } }
      Row {
        gap: 6
        Button {
          text: "save"; weight: 1; color: accent
          onTap: {
            items = draft == "" ? items : editId == 0 ? [{id: nextId, t: draft, at: when, fired: false}] + pending + done.take(20) : items.map(r => (r.id ?? r.at) == editId ? {id: editId, t: draft, at: when, fired: false} : r)
            nextId = draft == "" || editId != 0 ? nextId : nextId + 1
            close()
          }
        }
        if editId != 0 {
          Button {
            text: "delete"; weight: 1; color: red
            onTap: { items = items.filter(r => (r.id ?? r.at) != editId); close() }
          }
        }
        Button { text: "cancel"; weight: 1; onTap: close() }
      }
    }
  }
}
