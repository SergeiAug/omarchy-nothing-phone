widget "bookmarks" {
  page: 1
  order: 6
  size: 3x4
  minSize: 2x3

  requires { pacman: ["curl", "jq", "grep", "sed", "coreutils"] }
  meta { owl: 6; description: "Favorite links with auto-fetched title, summary and thumbnail; search by title, link or tag; open in the browser."; version: "1.1"; license: "MIT"; category: "productivity" }

  state links = [] persist
  state nextId = 0 persist
  state pending = ""
  state fetchN = 0
  state sel = ""
  state editId = ""
  state q = ""
  state nTitle = ""
  state nUrl = ""
  state dupOk = ""
  state go = false
  state nTag = ""

  let needle = lower(trim(q ?? ""))
  let shown = needle == "" ? links : links.filter(b => contains(lower(b.title), needle) || contains(lower(b.url), needle) || contains(lower(b.tag), needle))
  let fullUrl = startsWith(trim(nUrl), "http") ? trim(nUrl) : "https://${trim(nUrl)}"
  let hasUrl = trim(nUrl) != ""
  let isDup = hasUrl && links.find(b => b.url == fullUrl) != null
  let canAdd = hasUrl && (!isDup || dupOk == fullUrl)
  let cur = links.find(b => b.id == sel)

  // Fetches title, description and og:image of a newly added link; {} when idle.
  source meta_ = cmd(pending == "" ? "echo '{}'" : "U=${sh(pending)}; H=$(curl -sL -m 8 -A 'Mozilla/5.0' \"$U\" | tr '\n\r' '  ' | head -c 300000); t=$(echo \"$H\" | grep -oiP '(?<=<title>)[^<]*' | head -1 | sed 's/^ *//;s/ *$//'); d=$(echo \"$H\" | grep -oiP '<meta[^>]+(property|name)=.(og:)?description.[^>]*>' | head -1 | grep -oiP '(?<=content=.)[^\"]*' | head -1); i=$(echo \"$H\" | grep -oiP '<meta[^>]+og:image.[^>]*>' | head -1 | grep -oiP '(?<=content=.)[^\"]*' | head -1); mkdir -p ~/.cache/owl-bookmarks; f=~/.cache/owl-bookmarks/$(echo \"$U\" | md5sum | cut -c1-12); g=''; case \"$i\" in http*) curl -sL -m 8 -o \"$f\" \"$i\" && g=\"$f\";; esac; jq -nc --argjson n ${int(fetchN)} --arg r \"$(date +%s%N)\" --arg u \"$U\" --arg t \"$t\" --arg d \"$d\" --arg g \"$g\" '{n:$n,r:$r,u:$u,title:$t,desc:$d,img:$g}'") every 24h json timeout 30s
  on meta_ {
    links = pending == "" || value.u != pending ? links : links.map(b => b.url == pending ? {id: b.id, title: b.auto && value.title != "" ? value.title : b.title, url: b.url, tag: b.tag, auto: b.auto, desc: value.desc == "" ? b.desc : value.desc, img: value.img == "" ? b.img : value.img} : b)
    pending = pending != "" && value.u == pending ? "" : pending
  }

  component Item(b, removable = false) {
    Row {
      gap: 6
      align: center
      if removable {
        Column {
          gap: 0
          weight: 1
          onTap: sel = b.id
          Text { text: b.title; style: body; maxLines: 1 }
          Text { text: b.tag == "" ? b.url : "#${b.tag}  ${b.url}"; style: muted; fontSize: 11; maxLines: 1 }
        }
        Button { text: "👁"; onTap: sel = b.id }
        Button { text: "✕"; color: red; onTap: links = links.filter(x => x.id != b.id) }
      } else {
        Column {
          gap: 0
          weight: 1
          onTap: url(b.url)
          Text { text: b.title; style: body; maxLines: 1 }
          Text { text: b.tag == "" ? b.url : "#${b.tag}  ${b.url}"; style: muted; fontSize: 11; maxLines: 1 }
        }
        Button { text: "👁"; onTap: { sel = b.id; screen() } }
      }
    }
  }

  Column {
    gap: 6
    fill: true
    Row {
      align: center
      Text { text: "bookmarks (${len(links)})"; style: muted; weight: 1 }
      Button { text: "+"; onTap: { sel = ""; screen() } }
    }
    Input { placeholder: "search"; text: q; onChange: q = value }
    Column {
      gap: 6
      weight: 1
      scroll: true
      if len(shown) == 0 {
        Text { text: len(links) == 0 ? "tap + to add a link" : "no matches"; style: muted }
      }
      for b in shown key b.id {
        Item { b: b }
      }
    }
  }

  screen {
    title: cur == null ? "bookmarks" : "bookmark"
    if cur != null {
      Column {
        gap: 10
        fill: true
        padding: 8
        scroll: true
        if cur.img != null && cur.img != "" {
          Image { src: cur.img; fit: cover; clip: true; fill: width; height: 180; radius: 8 * corners }
        }
        if editId == cur.id {
          Row {
            gap: 6
            align: center
            Input { placeholder: "title"; text: cur.title; weight: 1; onChange: links = links.map(b => b.id == cur.id ? {id: b.id, title: value, url: b.url, tag: b.tag, auto: false, desc: b.desc, img: b.img} : b) }
            Button { text: "✓"; color: accent; onTap: editId = "" }
          }
          Text { text: cur.title; style: muted; maxLines: 6 }
        } else {
          Text { text: cur.title; style: title; maxLines: 3; onTap: editId = cur.id }
        }
        Input { placeholder: "tag"; text: cur.tag; onChange: links = links.map(b => b.id == cur.id ? {id: b.id, title: b.title, url: b.url, tag: lower(trim(value)), auto: b.auto, desc: b.desc, img: b.img} : b) }
        Text { text: cur.url; style: muted; fontSize: 12; maxLines: 5 }
        Text { text: cur.desc == null || cur.desc == "" ? (pending == cur.url ? "fetching summary…" : "no summary available") : cur.desc; style: body }
        Row {
          gap: 8
          Button { text: "open"; color: accent; onTap: url(cur.url) }
          Button { text: pending == cur.url ? "fetching…" : "refetch"; onTap: { pending = cur.url; fetchN = fetchN + 1; refresh() } }
          Button { text: "back"; onTap: { sel = ""; editId = "" } }
          Button { text: "remove"; color: red; onTap: { links = links.filter(x => x.id != cur.id); sel = "" } }
        }
      }
    } else {
      Column {
        gap: 8
        fill: true
        padding: 8
        Input { placeholder: "https://link"; text: nUrl; onChange: nUrl = value }
        Input { placeholder: "title (optional, fetched from the page)"; text: nTitle; onChange: nTitle = value }
        Input { placeholder: "tag (optional)"; text: nTag; onChange: nTag = value }
        Button {
          text: isDup && !canAdd ? "link already saved, tap to add anyway" : "add bookmark"
          color: isDup && !canAdd ? orange : (hasUrl ? accent : muted)
          onTap: {
            go = canAdd
            pending = go ? fullUrl : pending
            links = go ? [{id: "b${nextId}", title: trim(nTitle) == "" ? fullUrl : trim(nTitle), url: fullUrl, tag: lower(trim(nTag)), auto: trim(nTitle) == "", desc: "", img: ""}] + links : links
            nextId = go ? nextId + 1 : nextId
            nTitle = go ? "" : nTitle
            nUrl = go ? "" : nUrl
            nTag = go ? "" : nTag
            fetchN = go ? fetchN + 1 : fetchN
            dupOk = go ? "" : (isDup ? fullUrl : dupOk)
            go = false
            refresh()
          }
        }
        Input { placeholder: "search title, link or tag"; text: q; onChange: q = value }
        Column {
          gap: 8
          weight: 1
          scroll: true
          for b in shown key b.id {
            Item { b: b; removable: true }
          }
        }
      }
    }
  }
}
