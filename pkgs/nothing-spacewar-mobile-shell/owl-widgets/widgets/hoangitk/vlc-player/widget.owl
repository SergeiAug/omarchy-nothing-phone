widget "vlc" {
  page: 1
  order: 55
  size: 6x2
  minSize: 3x2
  meta { description: "VLC for Android player: album art, progress, controls and volume. Tap for a full-screen view with 11 animated backdrops, auto-changing per song"; version: "2.1"; license: "MIT"; category: "fun"; owl: 7 }

  // Needs notification access; shows only VLC's session.
  source vol = android.volume
  state fx = 0 persist
  let fxNames = ["auto", "waves", "bars", "rings", "aurora", "stars", "rain", "pulse", "grid", "rays", "fireflies", "spectrum", "off"]
  let fxList = ["waves", "bars", "rings", "aurora", "stars", "rain", "pulse", "grid", "rays", "fireflies", "spectrum"]
  state autoIdx = 0 persist
  let fxSel = fxNames[fx] ?? "auto"
  let fxName = fxSel == "auto" ? fxList[autoIdx % len(fxList)] : fxSel
  source m = android.media
  let allowed = m == null || m.available != false
  let isVlc = contains(lower("${m.package} ${m.app}"), "vlc")
  let has = m != null && isVlc && m.title != null
  let title = has ? m.title : null
  on title { autoIdx = (autoIdx + 1) % len(fxList) }
  let artist = has ? (m.artist ?? "") : ""
  let album = has ? (m.album ?? "") : ""
  let dur = has ? num(m.duration, 0) : 0
  let pos = dur > 0 ? clamp(num(m.position, 0), 0, dur) : 0
  source now = clock every 1s
  state tapAt = 0
  state tapPlay = false
  let playingRaw = has && m.playing == true
  // A tap on play/pause shows its result at once; Android reports the change a few seconds later.
  let playing = has && (now - tapAt < 5 ? tapPlay : playingRaw)
  let narrow = cols != null && cols < 5
  let art = clamp((tileHeight ?? 130) - 26, 64, 132)
  let bigArt = clamp((screenWidth ?? 360) - 72, 160, 340)

  onTap: screen()

  component ControlIcon(kind) {
      Canvas {
        let cx = width / 2
        let cy = height / 2
        let d = min(width, height)
        if kind == "toggle" {
          circle(cx, cy, d / 2, fill: foreground)
          if playing {
            rect(cx - d * 0.15, cy - d * 0.18, d * 0.11, d * 0.36, radius: d * 0.03, fill: background)
            rect(cx + d * 0.04, cy - d * 0.18, d * 0.11, d * 0.36, radius: d * 0.03, fill: background)
          } else {
            path([[cx - d * 0.12, cy - d * 0.2], [cx + d * 0.21, cy], [cx - d * 0.12, cy + d * 0.2]], closed: true, fill: background)
          }
        } else {
          let dir = kind == "next" ? 1 : -1
          path([[cx - d * 0.19 * dir, cy - d * 0.2], [cx + d * 0.1 * dir, cy], [cx - d * 0.19 * dir, cy + d * 0.2]], closed: true, fill: foreground)
          rect(dir > 0 ? cx + d * 0.1 : cx - d * 0.18, cy - d * 0.2, d * 0.08, d * 0.4, radius: d * 0.03, fill: foreground)
        }
      }
  }

  // media() controls whichever app is active, so without a VLC session the buttons open VLC instead.
  component Control(kind, big = false, s = 0) {
    if has {
      Box {
        size: s > 0 ? s : (big ? 38 : 32)
        onTap: { haptic(); media(kind); tapPlay = kind == "toggle" ? !playing : playing; tapAt = kind == "toggle" ? now : tapAt }
        ControlIcon { kind: kind }
      }
    } else {
      Box {
        size: s > 0 ? s : (big ? 38 : 32)
        onTap: { haptic(); androidApp("org.videolan.vlc") }
        ControlIcon { kind: kind }
      }
    }
  }


  component Bars() {
    Canvas {
      width: 22
      height: 14
      for i in range(5) {
        let h = 3 + (sin(time * (4 + i * 1.9) + i * 2.3) * 0.5 + 0.5) * (height - 3)
        rect(i * 4.5, height - h, 3, h, radius: 1, color: orange)
      }
    }
  }

  component Clock(s) {
    Text { text: "${floor(s / 60)}:${pad(floor(s % 60), 2, "0")}"; style: label; color: muted; font: mono; maxLines: 1; width: 44 }
  }

  component Fx(cxd = null, cyd = null, ar = 200) {
    Canvas {
      let cx = cxd ?? width / 2
      let cy = cyd ?? height / 2
      let big = max(width, height)
      if playing {
        if fxName == "waves" {
          for k in range(4) {
            let amp = min(18, height * 0.12)
            let pts = range(0, 61).map(i => [i * width / 60, height * (0.78 + k * 0.05) + sin(time * (1.0 + k * 0.6) + i * (0.25 + k * 0.1) + k * 2) * amp * (0.6 + 0.4 * sin(time * 0.7 + i * 0.12 + k))])
            path(pts, stroke: alpha(k % 2 == 0 ? orange : accent, 0.35 - k * 0.05), width: 2)
          }
        }
        if fxName == "bars" {
          let bw = width / 32
          for i in range(32) {
            let h = (sin(time * (2 + (i % 5) * 0.7) + i * 0.9) * 0.5 + 0.5) * (0.55 + 0.45 * sin(time * 0.6 + i * 0.2)) * height * 0.18 + 4
            rect(i * bw + 2, height - h - 6, bw - 4, h, radius: 2, fill: alpha(i % 2 == 0 ? orange : accent, 0.35))
          }
        }
        if fxName == "rings" {
          for k in range(4) {
            let t = (time * 0.22 + k / 4) % 1
            circle(cx, cy, ar * 0.3 + t * big * 0.6, stroke: alpha(orange, 0.4 * (1 - t)), width: 2)
          }
        }
        if fxName == "aurora" {
          for k in range(3) {
            let ax = width * (0.5 + 0.4 * sin(time * 0.9 + k * 2.1))
            let ay = height * (0.55 + 0.25 * cos(time * 0.75 + k * 1.7))
            let r = big * (0.55 + 0.15 * sin(time * 1.3 + k))
            let c = k == 0 ? orange : k == 1 ? accent : magenta
            circle(ax, ay, r, fill: radial(ax, ay, r, [alpha(c, 0.38), alpha(c, 0)]))
          }
        }
        if fxName == "stars" {
          for i in range(45) {
            let x = ((i * 0.618034) % 1) * width + sin(time * 0.5 + i) * 6
            let y = height - ((time * (14 + (i % 7) * 7) + i * 53) % height)
            circle(x, y, 1 + i % 3, fill: alpha(i % 4 == 0 ? orange : foreground, 0.2 + 0.1 * (i % 4)))
          }
        }
        if fxName == "rain" {
          for i in range(70) {
            let x = ((i * 0.381966) % 1) * width
            let y = (time * (260 + (i % 5) * 70) + i * 97) % (height + 40) - 20
            line(x, y, x - 3, y + 12 + (i % 3) * 5, stroke: alpha(i % 4 == 0 ? orange : accent, 0.3), width: 1.5)
          }
        }
        if fxName == "pulse" {
          let beat = pow(sin(time * 4.5) * 0.5 + 0.5, 2)
          for k in range(4) {
            circle(cx, cy, ar * 0.58 + k * 14 + beat * 12, stroke: alpha(k % 2 == 0 ? orange : accent, 0.38 - k * 0.07 + beat * 0.12), width: 2)
          }
        }
        if fxName == "grid" {
          let hz = height * 0.82
          clip(0, 0, width, hz) {
            circle(width / 2, hz, width * 0.2, fill: linear(0, hz - width * 0.2, 0, hz, [alpha(orange, 0.5), alpha(magenta, 0.15)]))
          }
          for k in range(9) {
            let t = ((k + time * 0.6) % 9) / 9
            line(0, hz + t * t * (height - hz), width, hz + t * t * (height - hz), stroke: alpha(magenta, 0.08 + 0.3 * t), width: 1.5)
          }
          for i in range(-8, 9) {
            line(width / 2 + i * width * 0.03, hz, width / 2 + i * width * 0.2, height, stroke: alpha(accent, 0.25), width: 1.5)
          }
        }
        if fxName == "rays" {
          for i in range(18) {
            rotate(i * 20 + time * 8, cx, cy) {
              line(cx, cy - ar * 0.74, cx, cy - big * 1.4, stroke: alpha(i % 2 == 0 ? orange : accent, 0.12), width: 7)
            }
          }
        }
        if fxName == "fireflies" {
          for i in range(24) {
            let fx2 = width * (0.5 + 0.45 * sin(time * (0.2 + (i % 5) * 0.07) + i * 1.9))
            let fy2 = height * (0.5 + 0.42 * cos(time * (0.17 + (i % 4) * 0.06) + i * 2.7))
            let glow = 0.5 + 0.5 * sin(time * 1.6 + i)
            circle(fx2, fy2, 10, fill: radial(fx2, fy2, 10, [alpha(orange, 0.5 * glow), alpha(orange, 0)]))
            circle(fx2, fy2, 2, fill: alpha(foreground, 0.4 + 0.4 * glow))
          }
        }
        if fxName == "spectrum" {
          for i in range(48) {
            let h = (sin(time * (2 + (i % 6) * 0.6) + i * 0.8) * 0.5 + 0.5) * (ar * 0.1 + 4) + 4
            rotate(i * 7.5, cx, cy) {
              line(cx, cy - ar * 0.62, cx, cy - ar * 0.62 - h, stroke: alpha(i % 2 == 0 ? orange : accent, 0.55), width: 3, cap: round)
            }
          }
        }
      }
    }
  }

  Box {
    fill: true
    Fx { cxd: narrow ? null : 13 + art / 2; ar: art }
  Row {
    fill: true
    align: center
    gap: 12
    if !narrow {
      Box {
        size: art
        radius: 8 * corners
        clip: true
        if has && m.art != null {
          Image { src: m.art; fit: cover; fill: true }
        } else {
          Canvas {
            rect(0, 0, width, height, fill: linear(0, 0, width, height, [alpha(orange, 0.7), alpha(accent, 0.35)]))
            text("♪", width / 2, height / 2, size: art * 0.45, align: center, color: alpha(foreground, 0.9))
          }
        }
      }
    }
    Column {
      weight: 1
      gap: 2
      Row {
        align: center
        gap: 6
        padding: [0, 6]
        onTap: { haptic(); androidApp("org.videolan.vlc") }
        if playing {
          Bars { }
        }
        Text { text: "vlc ↗"; style: label; color: playing ? orange : muted }
      }
      if has {
        Text { text: title; style: body; bold: true; maxLines: narrow ? 2 : 1 }
        Text { text: [artist, narrow ? "" : album].filter(x => x != "").join(" · "); style: small; color: muted; maxLines: 1 }
      } else {
        Text { text: allowed ? "nothing playing in VLC" : "allow notification access"; style: body; color: muted; maxLines: 2 }
        Text { text: "tap to open VLC"; style: small; color: muted; maxLines: 1 }
      }
      Spacer { weight: 1 }
      if dur > 0 {
        Progress { value: pos; max: dur; color: orange; track: alpha(muted, 0.2); animate value: tween(900ms, "linear") }
      }
      Row {
        align: center
        gap: 4
        if dur > 0 {
          Clock { s: pos }
          Text { text: "/"; style: label; color: alpha(muted, 0.5); width: 8 }
          Clock { s: dur }
        }
        Spacer { weight: 1 }
        Control { kind: "previous" }
        Control { kind: "toggle"; big: true }
        Control { kind: "next" }
      }
    }
  }
  }

  screen {
    title: "vlc"
    Box {
      fill: true
      Canvas {
        rect(0, 0, width, height, fill: linear(0, 0, 0, height, [alpha(orange, 0.28), alpha(accent, 0.1), background]))
      }
      Fx { cyd: 12 + bigArt / 2; ar: bigArt }
      Column {
        scroll: true
        padding: [24, 12, 24, 24]
        gap: 14
        align: center
        Box {
          size: bigArt
          radius: 16 * corners
          clip: true
          if has && m.art != null {
            Image { src: m.art; fit: cover; fill: true }
          } else {
            Canvas {
              rect(0, 0, width, height, fill: linear(0, 0, width, height, [alpha(orange, 0.7), alpha(accent, 0.35)]))
              text("♪", width / 2, height / 2, size: bigArt * 0.4, align: center, color: alpha(foreground, 0.9))
            }
          }
        }
        Column {
          gap: 4
          align: center
          fill: width
          Text { text: has ? title : (allowed ? "nothing playing in VLC" : "allow notification access"); style: title; bold: true; align: center; maxLines: 2 }
          if has {
            Text { text: artist; style: body; color: orange; align: center; maxLines: 1 }
            if album != "" {
              Text { text: album; style: small; color: muted; align: center; maxLines: 1 }
            }
          }
        }
        if dur > 0 {
          Column {
            gap: 4
            fill: width
            Progress { value: pos; max: dur; color: orange; track: alpha(muted, 0.25); animate value: tween(900ms, "linear") }
            Row {
              Clock { s: pos }
              Spacer { weight: 1 }
              Clock { s: dur }
            }
          }
        }
        Row {
          align: center
          gap: 22
          justify: center
          fill: width
          Control { kind: "previous"; s: 52 }
          Control { kind: "toggle"; s: 72 }
          Control { kind: "next"; s: 52 }
        }
        Row {
          align: center
          gap: 12
          fill: width
          Text { text: vol.muted == true ? "mute" : "vol"; style: label; color: muted; width: 30 }
          Slider { value: vol.level ?? 0; min: 0; max: 100; color: orange; track: alpha(muted, 0.25); live: true; weight: 1; onChange: volume(value) }
          Text { text: "${round(vol.level ?? 0)}%"; style: label; color: muted; font: mono; width: 40; align: end }
        }
        Row {
          gap: 8
          justify: center
          fill: width
          Button { text: "‹"; onTap: { haptic(); fx = (fx + len(fxNames) - 1) % len(fxNames) } }
          Button { text: fxSel == "auto" ? "auto · ${fxName}" : "effect: ${fxName}"; color: orange; onTap: { haptic(); fx = (fx + 1) % len(fxNames) } }
          Button { text: "›"; onTap: { haptic(); fx = (fx + 1) % len(fxNames) } }
        }
        Row {
          gap: 8
          justify: center
          fill: width
          Button { text: "vlc"; color: orange; onTap: androidApp("org.videolan.vlc") }
          if has {
            Button { text: "share"; onTap: share("${title} - ${artist}") }
            Button { text: "copy"; onTap: copy("${title} - ${artist}") }
            Button { text: "lyrics"; onTap: url("https://www.google.com/search?q=${replace("${title} ${artist} lyrics", " ", "+")}") }
          }
        }
      }
    }
  }
}
