widget "nfl" {
  meta {
    owl: 5
    description: "NFL scores and standings from ESPN with team logos: live games first, then finals and this week's upcoming games. Tap for every game and both conferences"
    version: "1.0"
    license: "MIT"
    category: "world"
  }
  requires { pacman: ["curl"] }
  page: 1
  order: 45
  size: 6x4
  minSize: 3x3

  source scores = http("https://site.api.espn.com/apis/site/v2/sports/football/nfl/scoreboard") every 5m json timeout 20s
  source table = http("https://site.api.espn.com/apis/v2/sports/football/nfl/standings") every 30m json timeout 20s
  source now = clock every 1m

  // Team logos, fetched once into ~/.cache/nfl-logos and left there, so the widget
  // stays one small file with no paths to local images. The team list is fixed, so
  // nothing the API sends can reach the shell. ESPN serves the Titans under ten.
  source logos = cmd("""
    d=~/.cache/nfl-logos
    mkdir -p "$d"
    for a in ari atl bal buf car chi cin cle dal den det gb hou ind jax kc lac lar lv mia min ne no nyg nyj phi pit sea sf tb ten wsh; do
      [ -s "$d/$a.png" ] || curl -fsm 15 -o "$d/$a.png" "https://a.espncdn.com/i/teamlogos/nfl/500/$a.png" || rm -f "$d/$a.png"
    done
    echo '{"ready": true}'
  """) every 1h json timeout 120s

  state view = "scores"

  let games = scores.events ?? []
  let live = games.filter(g => g.competitions[0].status.type.state == 'in')
  let done = games.filter(g => g.competitions[0].status.type.state == 'post').reverse()
  let next = games.filter(g => g.competitions[0].status.type.state == 'pre')
  let cap = clamp((rows ?? 4) * 3 - 2, 5, 14)
  let picked = flatten([live.take(3), done.take(3), next.take(cap)]).take(cap)

  let confs = table.children ?? []
  let flat = (table.standings.entries ?? []).sortBy(e => (e.stats.find(s => s.name == 'playoffSeed') ?? {}).value ?? 999)
  let confs2 = count(confs) ? confs : [ { name: "NFL", standings: { entries: flat } } ]

  component Badge(t, px = 18) {
    let a = lower(t.team.abbreviation ?? '')
    if t.team.abbreviation {
      Image { src: "~/.cache/nfl-logos/${a == 't' ? 'ten' : a}.png"; size: px; fit: contain }
    }
  }

  component GameRow(g) {
    let c = g.competitions[0]
    let away = c.competitors.filter(t => t.homeAway == 'away')[0] ?? c.competitors[1]
    let home = c.competitors.filter(t => t.homeAway == 'home')[0] ?? c.competitors[0]
    let live = c.status.type.state == 'in'
    let final = c.status.type.state == 'post'
    let pre = c.status.type.state == 'pre'
    let detail = c.status.type.shortDetail

    // Every row has the same shape - badge, team, centre, team, badge - and the
    // centre keeps one width whether or not there are scores in it, so the
    // badges and abbreviations line up down the whole list.
    let vw = max(max(screenWidth ?? 0, tileWidth ?? 0), 240)
    let wide = vw >= 280
    let px = wide ? 18 : 14
    let scW = wide ? 24 : 18
    let dotW = wide ? 8 : 6
    let stW = wide ? 128 : 34
    let gap = wide ? 8 : 4
    let ctrW = 2 * scW + 2 * dotW + stW

    // A full "10/11 - 1:00 PM EDT" won't fit across a narrow tile's middle.
    let parts = words(detail)
    let kick = wide ? detail : get(parts, 0, '') + " " + get(parts, 2, '') + get(parts, 3, '')

    Row {
      gap: gap
      Badge { t: away; px: px }
      Text { text: away.team.abbreviation; style: small; weight: 1; color: final && !away.winner ? muted : foreground }
      if pre {
        Text { text: kick; style: small; width: ctrW; align: center; color: muted; maxLines: 1 }
      } else {
        Row {
          width: ctrW; gap: 0; align: center
          Text { text: away.score ?? '–'; style: small; width: scW; padding: [0, 0, 5, 0]; align: end; bold: final && away.winner; color: live ? accent : final && !away.winner ? muted : foreground }
          Box { width: dotW; height: 5; radius: 2.5; background: live ? accent : rgb(0, 0, 0, 0) }
          Text { text: detail; style: small; width: stW; align: center; color: live ? accent : muted; maxLines: 1 }
          Box { width: dotW }
          Text { text: home.score ?? '–'; style: small; width: scW; padding: [5, 0, 0, 0]; align: start; bold: final && home.winner; color: live ? accent : final && !home.winner ? muted : foreground }
        }
      }
      Text { text: home.team.abbreviation; style: small; weight: 1; align: end; color: final && !home.winner ? muted : foreground }
      Badge { t: home; px: px }
    }
  }

  component TeamRow(t) {
    let diff = (t.stats.find(s => s.name == 'pointDifferential') ?? {}).value ?? 0
    Row {
      Text { text: (t.stats.find(s => s.name == 'playoffSeed') ?? {}).displayValue ?? '–'; width: 24; style: small; color: muted }
      Text { text: t.team.abbreviation; weight: 1; style: small }
      Text { text: (t.stats.find(s => s.name == 'overall') ?? {}).displayValue ?? '–'; width: 46; style: small; bold: true; align: end }
      Text { text: (t.stats.find(s => s.name == 'pointDifferential') ?? {}).displayValue ?? '–'; width: 42; style: small; align: end; color: diff > 0 ? green : diff < 0 ? red : muted }
    }
  }

  onTap: screen()

  Column {
    Row {
      Text { text: "NFL"; style: title; weight: 1 }
      if count(live) > 0 {
        Text { text: "${count(live)} live"; style: small; color: accent; width: 60; align: end; bold: true }
      } else {
        Text { text: fmtTime(now, "EEE d"); style: small; color: muted; width: 60; align: end }
      }
    }
    Row {
      Button { text: "scores"; weight: 1; color: view == "scores" ? accent : muted; onTap: view = "scores" }
      Button { text: "standings"; weight: 1; color: view == "standings" ? accent : muted; onTap: view = "standings" }
    }
    Column {
      weight: 1
      scroll: true
      if view == "scores" {
        if count(picked) == 0 {
          Text { text: "no games this week"; style: small; color: muted }
        } else {
          for g in picked key g.id { GameRow { g: g } }
        }
      } else {
        for c in confs2 {
          Text { text: c.abbreviation ?? c.name; style: label; color: muted }
          for t, i in (c.standings.entries ?? []).sortBy(e => (e.stats.find(s => s.name == 'playoffSeed') ?? {}).value ?? 999) key t.team.id {
            let seed = (t.stats.find(s => s.name == 'playoffSeed') ?? {}).value
            if i > 0 && seed == 8 { Box { height: 7; fill: width  Row { width: 32; height: 1; background: border } } }
            TeamRow { t: t }
          }
        }
      }
    }
  }

  screen {
    title: "NFL"
    Column {
      scroll: true
      Text { text: "scores"; style: title }
      for g in games key g.id { GameRow { g: g } }
      Text { text: "standings"; style: title }
      for c in confs2 {
        Text { text: c.abbreviation ?? c.name; style: label; color: muted }
        for t, i in (c.standings.entries ?? []).sortBy(e => (e.stats.find(s => s.name == 'playoffSeed') ?? {}).value ?? 999) key t.team.id {
          let seed = (t.stats.find(s => s.name == 'playoffSeed') ?? {}).value
          if i > 0 && seed == 8 { Box { height: 7; fill: width  Row { width: 32; height: 1; background: border } } }
          TeamRow { t: t }
        }
      }
      Button { text: "close"; onTap: close() }
    }
  }
}
