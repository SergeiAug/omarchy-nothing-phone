widget "eredivisie" {
  meta {
    owl: 5
    description: "Eredivisie matches by matchday and the table from ESPN, with club logos: live scores, every matchday of the season and the table as it stood after each"
    version: "1.2"
    license: "MIT"
    category: "world"
  }
  requires { pacman: ["curl", "jq", "coreutils", "findutils"] }
  page: 1
  order: 46
  size: 6x4
  minSize: 3x3

  // Built on travonted's nfl widget (MIT) from the widget store: its tabs, game
  // rows and logo cache.
  source today = http("https://site.api.espn.com/apis/site/v2/sports/soccer/ned.1/scoreboard") every 2m json timeout 20s
  source table = http("https://site.api.espn.com/apis/v2/sports/soccer/ned.1/standings") every 10m json timeout 20s
  source now = clock every 1m

  // Every match of the season (ESPN sends 4 MB; trimmed to what the rows read)
  // in its matchday, plus the table after each matchday, worked out from the
  // results (ESPN only serves today's). Ties go by points, goal difference,
  // goals scored. ESPN's `dates` is a calendar year, so this season is the
  // matches of this year and next tagged with its year; a season starts in
  // August.
  // ESPN has no matchday numbers, so they come from TheSportsDB (its free
  // public key), one request per round, kept for a day in ~/.cache. Each home-
  // away pairing is played once a season, so a pairing finds its round; clubs
  // are matched on a shared word of their names ("Fortuna" / "Fortuna
  // Sittard"). Without it, rounds are calendar weeks.
  // Club logos are fetched once into ~/.cache/eredivisie-logos by ESPN team id
  // (a download is renamed into place only when complete); ids that aren't
  // plain numbers are skipped, so nothing else from the APIs reaches a
  // command line.
  source season = cmd("""
    y=$(date +%Y); [ "$(date +%-m)" -lt 7 ] && y=$((y - 1))
    d=~/.cache/eredivisie-logos; mkdir -p "$d"
    c=~/.cache/eredivisie-rounds-$y.json
    t=~/.cache/eredivisie-season.json
    for x in $y $((y + 1)); do
      curl -fsm 40 --compressed "https://site.api.espn.com/apis/site/v2/sports/soccer/ned.1/scoreboard?dates=$x&limit=1000"
    done > "$t"
    jq -r '.events[]?.competitions[0].competitors[].team.id' "$t" | sort -u | while read -r id; do
      case "$id" in ''|*[!0-9]*) continue ;; esac
      [ -s "$d/$id.png" ] || { curl -fsm 15 -o "$d/$id.png.part" "https://a.espncdn.com/i/teamlogos/soccer/500/$id.png" && mv "$d/$id.png.part" "$d/$id.png"; }
    done
    if [ ! -s "$c" ] || [ -n "$(find "$c" -mmin +1440)" ]; then
      for r in $(seq 1 40); do
        o=$(curl -fsm 15 --compressed "https://www.thesportsdb.com/api/v1/json/123/eventsround.php?id=4337&r=$r&s=$y-$((y + 1))") || break
        [ "$(printf %s "$o" | jq '.events | length')" -gt 0 ] || break
        printf '%s\n' "$o"
        sleep 2.1
      done | jq -c -s '[.[].events[] | {r: (.intRound | tonumber), h: .strHomeTeam, a: .strAwayTeam}]' > "$c.part" &&
        [ "$(jq length "$c.part")" -gt 0 ] && mv "$c.part" "$c"
    fi
    jq -c -s --argjson y "$y" --argjson tr "$(cat "$c" 2>/dev/null || echo '[]')" '
      def toks: ascii_downcase | split(" ") | map(select(. != "fc" and . != "sc" and . != ""));
      def wkOf: (. / 86400 | floor) + 3 | . / 7 | floor;
      [.[] | (.events // [])[] | select(.season.year == $y)]
      | map(. + {ts: (.date | strptime("%Y-%m-%dT%H:%MZ") | mktime)}) | sort_by(.ts) as $ev
      | ($tr | map(.h, .a) | unique) as $tnames
      | ([$ev[].competitions[0].competitors[].team] | unique_by(.id)
         | map(. as $t | ($t.shortDisplayName | toks) as $k
           | {key: $t.id, value: ([$tnames[] | . as $n | {n: $n, s: ([$k[] | select(. as $w | $n | toks | index($w))] | length)}]
               | max_by(.s) // {s: 0} | if .s > 0 then .n else null end)})
         | from_entries) as $nameOf
      | ($tr | map({key: (.h + "|" + .a), value: .r}) | from_entries) as $roundOf
      | [$ev[] | .competitions[0].competitors as $c
         | ($c[] | select(.homeAway == "home") | .team.id) as $h | ($c[] | select(.homeAway == "away") | .team.id) as $a
         | {id, ts, r: $roundOf[($nameOf[$h] // "?") + "|" + ($nameOf[$a] // "?")],
            competitions: [.competitions[0] | {status: {type: {state: .status.type.state, shortDetail: .status.type.shortDetail}},
              competitors: [.competitors[] | {homeAway, score, winner, team: {id: .team.id, abbreviation: .team.abbreviation, shortDisplayName: .team.shortDisplayName}}]}]}] as $raw
      | ($ev | map(.ts | wkOf) | unique | to_entries | map({key: (.value | tostring), value: (.key + 1)}) | from_entries) as $wkIdx
      | [$raw[] | select(.r != null)] as $known
      | # A match TheSportsDB has no round for joins the round most of its week is in;
        # without TheSportsDB at all, rounds are calendar weeks.
        [$raw[] | if .r != null then . else (.ts | wkOf) as $w
          | . + {r: (if ($known | length) == 0 then $wkIdx[$w | tostring]
                   else [$known[] | select((.ts | wkOf) == $w) | .r] | group_by(.) | max_by(length) // [$wkIdx[$w | tostring]] | first end)} end] as $games
      | ([$games[].r] | max // 0) as $nr
      | [range(1; $nr + 1) as $k | ($games | map(select(.r == $k)) | sort_by(.ts)) as $g
         | ($g[($g | length) / 2 | floor].ts) as $med
         | {r: $k, n: ($g | length), first: ($g | map(.ts) | min), last: ($g | map(.ts) | max), med: $med,
            end: ($g | map(.ts | select(. <= $med + 3 * 86400)) | max)}] as $rounds
      | ([$ev[].competitions[0].competitors[].team | {key: .id, value: {id, abbreviation, displayName, shortDisplayName}}] | from_entries) as $tm
      | [$games[] | select(.competitions[0].status.type.state == "post") | .ts as $ts | .competitions[0].competitors as $c
         | ($c[] | select(.homeAway == "home")) as $h | ($c[] | select(.homeAway == "away")) as $a
         | {ts: $ts, th: $h.team.id, ta: $a.team.id, sh: ($h.score | tonumber), sa: ($a.score | tonumber)}] as $res
      | def table($end): ($res | map(select(.ts <= $end))) as $rr
          | [$tm | keys[] as $t
            | [$rr[] | if .th == $t then {f: .sh, a: .sa} elif .ta == $t then {f: .sa, a: .sh} else empty end] as $g
            | ($g | map(select(.f > .a)) | length) as $w | ($g | map(select(.f == .a)) | length) as $d
            | {id: $t, abbr: $tm[$t].abbreviation, name: $tm[$t].displayName, short: $tm[$t].shortDisplayName, p: ($g | length), w: $w, d: $d, l: (($g | length) - $w - $d),
               gf: ($g | map(.f) | add // 0), ga: ($g | map(.a) | add // 0), pts: (3 * $w + $d)} | .gd = .gf - .ga]
          | sort_by([-.pts, -.gd, -.gf, .name]) | to_entries | map(.value + {rank: (.key + 1)});
      {games: $games, rounds: $rounds, official: (($tr | length) > 0), tables: [$rounds[] | table(.end)]}
    ' "$t"
  """) every 30m json timeout 180s

  state view = "matches"
  state pick = null

  // The matchday shown when nothing is picked: the latest one whose middle
  // match is no more than two days off, so the next one takes over on Thursday.
  let weeks = season.rounds ?? []
  let started = weeks.filter(w => w.med <= now + 2 * 86400)
  let home = max(count(started) - 1, 0)
  let shown = pick ?? home
  let wk = weeks[shown]
  let sameMonth = fmtTime(wk.first, "MMM") == fmtTime(wk.end, "MMM")
  let wkLabel = wk == null ? "…"
    : season.official ? "Matchday ${wk.r}"
    : fmtTime(wk.first, "d MMM") == fmtTime(wk.end, "d MMM") ? fmtTime(wk.first, "EEE d MMM")
    : sameMonth ? fmtTime(wk.first, "d") + "–" + fmtTime(wk.end, "d MMM")
    : fmtTime(wk.first, "d MMM") + " – " + fmtTime(wk.end, "d MMM")

  // Live scores come from today's scoreboard (every 2 minutes) over the
  // season's copy (every 30).
  let todays = today.events ?? []
  let liveNow = todays.filter(g => g.competitions[0].status.type.state == 'in')
  let games = (season.games ?? []).filter(g => g.r == wk.r)
    .map(g => { id: g.id, ts: g.ts, competitions: (todays.find(e => e.id == g.id) ?? g).competitions })
  let live = games.filter(g => g.competitions[0].status.type.state == 'in')
  let done = games.filter(g => g.competitions[0].status.type.state == 'post').sortBy(g => -g.ts)
  let next = games.filter(g => g.competitions[0].status.type.state != 'in' && g.competitions[0].status.type.state != 'post').sortBy(g => g.ts)
  let ordered = flatten([live, done, next])

  // ESPN's table, in the same shape as the worked-out ones, with its zone notes
  // (Champions League, relegation, ...) by position.
  let official = (table.children[0].standings.entries ?? [])
    .map(e => {
      id: e.team.id, abbr: e.team.abbreviation, name: e.team.displayName, short: e.team.shortDisplayName,
      rank: (e.stats.find(s => s.name == 'rank') ?? {}).value,
      p: (e.stats.find(s => s.name == 'gamesPlayed') ?? {}).value,
      w: (e.stats.find(s => s.name == 'wins') ?? {}).value,
      d: (e.stats.find(s => s.name == 'ties') ?? {}).value,
      l: (e.stats.find(s => s.name == 'losses') ?? {}).value,
      gd: (e.stats.find(s => s.name == 'pointDifferential') ?? {}).value,
      pts: (e.stats.find(s => s.name == 'points') ?? {}).value,
      zone: e.note.description, zoneColor: e.note.color
    })
    .sortBy(r => r.rank)
  let zones = official.map(r => r.zone)
  let zoneColors = official.map(r => r.zoneColor)
  let current = count(official) ? official : (season.tables ?? [])[home] ?? []
  // The full screen shows the table after a past matchday picked there.
  let past = shown < home && (season.tables ?? [])[shown] != null
  let shownTable = past ? season.tables[shown] : current

  component Badge(id, px = 18) {
    // The logos are downloaded before `season` loads, so wait for it.
    if id && season != null {
      Image { src: "~/.cache/eredivisie-logos/${id}.png"; size: px; fit: contain }
    }
  }

  // A position's zone in ESPN's own colours (pastel green for the Champions
  // League down to red for relegation), which read the same in every theme.
  component ZoneBar(rank) {
    let c = zoneColors[rank - 1]
    Box { width: 3; height: 16; radius: 1.5; background: c ?? rgb(0, 0, 0, 0) }
  }

  component GameRow(g) {
    let c = g.competitions[0]
    let home = c.competitors.filter(t => t.homeAway == 'home')[0] ?? c.competitors[0]
    let away = c.competitors.filter(t => t.homeAway == 'away')[0] ?? c.competitors[1]
    let live = c.status.type.state == 'in'
    let final = c.status.type.state == 'post'
    let pre = !live && !final
    let detail = c.status.type.shortDetail

    // Home on the left. Same shape on every row - badge, club, centre, club,
    // badge - with a fixed centre, so the columns line up down the list.
    let vw = max(max(screenWidth ?? 0, tileWidth ?? 0), 240)
    let wide = vw >= 280
    let px = wide ? 18 : 14
    let scW = wide ? 22 : 18
    let dotW = wide ? 7 : 5
    let stW = wide ? 34 : 28
    let gap = wide ? 6 : 4
    let ctrW = 2 * scW + 2 * dotW + stW
    // In a draw neither side is greyed out.
    let homeLost = final && away.winner
    let awayLost = final && home.winner

    Row {
      gap: gap
      Badge { id: home.team.id; px: px }
      Text { text: wide ? home.team.shortDisplayName ?? home.team.abbreviation : home.team.abbreviation; style: small; weight: 1; maxLines: 1; color: homeLost ? muted : foreground }
      if pre {
        Text { text: fmtTime(g.ts, abs(g.ts - (wk.med ?? g.ts)) > 4 * 86400 ? "d MMM" : "EEE HH:mm"); style: small; width: ctrW; align: center; color: muted; maxLines: 1 }
      } else {
        Row {
          width: ctrW; gap: 0; align: center
          Text { text: home.score ?? '–'; style: small; width: scW; padding: [0, 0, 5, 0]; align: end; bold: final && home.winner; color: live ? accent : homeLost ? muted : foreground }
          Box { width: dotW; height: 5; radius: 2.5; background: live ? accent : rgb(0, 0, 0, 0) }
          Text { text: detail; style: small; width: stW; align: center; color: live ? accent : muted; maxLines: 1 }
          Box { width: dotW }
          Text { text: away.score ?? '–'; style: small; width: scW; padding: [5, 0, 0, 0]; align: start; bold: final && away.winner; color: live ? accent : awayLost ? muted : foreground }
        }
      }
      Text { text: wide ? away.team.shortDisplayName ?? away.team.abbreviation : away.team.abbreviation; style: small; weight: 1; maxLines: 1; align: end; color: awayLost ? muted : foreground }
      Badge { id: away.team.id; px: px }
    }
  }

  component TableHeader() {
    let vw = max(max(screenWidth ?? 0, tileWidth ?? 0), 240)
    let wide = vw >= 280
    Row {
      gap: 6
      Text { text: "#"; width: 22; style: label; color: muted }
      Spacer { width: 3 }
      Text { text: "club"; weight: 1; style: label; color: muted }
      Text { text: "P"; width: 24; style: label; color: muted; align: end }
      if wide { Text { text: "W-D-L"; width: 64; style: label; color: muted; align: end } }
      Text { text: "GD"; width: 36; style: label; color: muted; align: end }
      Text { text: "Pts"; width: 34; style: label; color: muted; align: end }
    }
  }

  component TableRow(r) {
    // "Feyenoord Rotterdam" on the full screen, "Feyenoord" on a tile, "FEY" on a narrow one.
    let vw = max(max(screenWidth ?? 0, tileWidth ?? 0), 240)
    let wide = vw >= 280
    Row {
      gap: 6
      align: center
      Text { text: r.rank; width: 22; style: small; color: muted }
      ZoneBar { rank: r.rank }
      Badge { id: r.id; px: wide ? 18 : 14 }
      Text { text: vw >= 480 ? r.name : wide ? r.short ?? r.abbr : r.abbr; weight: 1; style: small; maxLines: 1 }
      Text { text: r.p; width: 24; style: small; color: muted; align: end }
      if wide { Text { text: "${r.w}-${r.d}-${r.l}"; width: 64; style: small; color: muted; align: end } }
      Text { text: r.gd > 0 ? "+${r.gd}" : "${r.gd}"; width: 36; style: small; align: end; color: r.gd > 0 ? green : r.gd < 0 ? red : muted }
      Text { text: r.pts; width: 34; style: small; bold: true; align: end }
    }
  }

  component Legend() {
    // One entry per zone, at the first position that has it.
    let firsts = range(count(zones)).filter(i => zones[i] != null && indexOf(zones, zones[i]) == i)
    Grid {
      columns: 2
      gap: 4
      for i in firsts {
        Row { gap: 6; align: center  ZoneBar { rank: i + 1 }  Text { text: zones[i]; style: small; color: muted; weight: 1 } }
      }
    }
  }

  // ‹ Matchday 8 ›: the arrows step through the season; tapping the name goes
  // back to the current matchday.
  component WeekPicker() {
    Row {
      align: center
      Button { text: "‹"; width: 48; color: shown > 0 ? foreground : muted; onTap: pick = max(shown - 1, 0) }
      Text {
        text: shown == home ? "${wkLabel} · now" : wkLabel
        weight: 1; align: center; style: small; bold: true
        color: shown == home ? accent : foreground
        onTap: pick = null
      }
      Button { text: "›"; width: 48; color: shown < count(weeks) - 1 ? foreground : muted; onTap: pick = min(shown + 1, count(weeks) - 1) }
    }
  }

  onTap: screen()

  Column {
    Row {
      Text { text: "Eredivisie"; style: title; weight: 1 }
      if count(liveNow) > 0 {
        Text { text: "${count(liveNow)} live"; style: small; color: accent; width: 60; align: end; bold: true }
      } else {
        Text { text: fmtTime(now, "EEE d"); style: small; color: muted; width: 60; align: end }
      }
    }
    Row {
      Button { text: "matches"; weight: 1; color: view == "matches" ? accent : muted; onTap: view = "matches" }
      Button { text: "table"; weight: 1; color: view == "table" ? accent : muted; onTap: view = "table" }
    }
    if view == "matches" { WeekPicker { } } else { TableHeader { } }
    Column {
      weight: 1
      scroll: true
      if view == "matches" {
        if season == null {
          Text { text: "loading the season…"; style: small; color: muted }
        } else {
          if count(ordered) == 0 {
            Text { text: "no matches"; style: small; color: muted }
          } else {
            for g in ordered key g.id { GameRow { g: g } }
          }
        }
      } else {
        for r in current key r.id { TableRow { r: r } }
      }
    }
  }

  screen {
    title: "Eredivisie"
    Column {
      scroll: true
      Text { text: "matches"; style: title }
      WeekPicker { }
      for g in ordered key g.id { GameRow { g: g } }
      Text { text: past ? "table after ${wkLabel}" : "table"; style: title }
      TableHeader { }
      for r in shownTable key r.id { TableRow { r: r } }
      Legend { }
      Button { text: "close"; onTap: close() }
    }
  }
}
