widget "gestures" {
  size: 6x2
  minSize: 2x2

  meta { owl: 7; description: "A swipe pad: swipe in any of 8 directions to open the app assigned to it."; version: "1.7"; license: "MIT"; category: "productivity" }

  // Directions clockwise from up; apps and labels are lists in this order ("" = unassigned).
  // Also settable from a script:
  //   owl-send 15-gestures.owl set apps '["com.android.chrome","","com.spotify.music","","","","",""]'
  let dirs = ["up", "up-right", "right", "down-right", "down", "down-left", "left", "up-left"]
  let arrows = ["↑", "↗", "→", "↘", "↓", "↙", "←", "↖"]
  state apps = ["", "", "", "", "", "", "", ""] persist
  state labels = ["", "", "", "", "", "", "", ""] persist

  // The 4-direction version kept maps; carry them over once.
  state pkgs = {up: "", down: "", left: "", right: ""} persist
  state names = {up: "", down: "", left: "", right: ""} persist
  state migrated = false persist
  when !migrated {
    apps = [pkgs.up ?? "", "", pkgs.right ?? "", "", pkgs.down ?? "", "", pkgs.left ?? "", ""]
    labels = [names.up ?? "", "", names.right ?? "", "", names.down ?? "", "", names.left ?? "", ""]
    migrated = true
  }

  source now = clock every 1s

  // App picker. Android doesn't tell widgets which apps are installed, so the picker
  // offers apps this phone has shown notifications or media from (remembered as they
  // appear), then a list of popular apps. Entries with m: only show on that maker's phones.
  source dev = android.device
  source notes = android.notifications
  source media = android.media
  state seen = [] persist          // "package|App name", newest first
  state q = ""
  on notes { seen = unique((notes.items ?? []).map(it => "${it.package}|${it.app ?? it.package}") + seen).take(80) }
  on media { seen = media.package ? unique(["${media.package}|${media.app ?? media.package}"] + seen).take(80) : seen }

  let catalog = [
    {n: "Chrome", p: "com.android.chrome"}, {n: "Gmail", p: "com.google.android.gm"},
    {n: "Google Maps", p: "com.google.android.apps.maps"}, {n: "YouTube", p: "com.google.android.youtube"},
    {n: "YouTube Music", p: "com.google.android.apps.youtube.music"}, {n: "Google Photos", p: "com.google.android.apps.photos"},
    {n: "Google Drive", p: "com.google.android.apps.docs"}, {n: "Google Calendar", p: "com.google.android.calendar"},
    {n: "Google Keep", p: "com.google.android.keep"}, {n: "Google (search)", p: "com.google.android.googlequicksearchbox"},
    {n: "Play Store", p: "com.android.vending"}, {n: "Settings", p: "com.android.settings"},
    {n: "Messages (Google)", p: "com.google.android.apps.messaging"}, {n: "Phone (Google)", p: "com.google.android.dialer"},
    {n: "Contacts (Google)", p: "com.google.android.contacts"}, {n: "Clock (Google)", p: "com.google.android.deskclock"},
    {n: "Calculator (Google)", p: "com.google.android.calculator"}, {n: "Camera (Pixel)", p: "com.google.android.GoogleCamera", m: "google"},
    {n: "Files by Google", p: "com.google.android.apps.nbu.files"}, {n: "Google Translate", p: "com.google.android.apps.translate"},
    {n: "Google Wallet", p: "com.google.android.apps.walletnfcrel"}, {n: "Google Home", p: "com.google.android.apps.chromecast.app"},
    {n: "Google Docs", p: "com.google.android.apps.docs.editors.docs"}, {n: "Google Sheets", p: "com.google.android.apps.docs.editors.sheets"},
    {n: "Google Meet", p: "com.google.android.apps.tachyon"}, {n: "Gemini", p: "com.google.android.apps.bard"},
    {n: "Google Fit", p: "com.google.android.apps.fitness"}, {n: "Google Tasks", p: "com.google.android.apps.tasks"},
    {n: "Google Lens", p: "com.google.ar.lens"}, {n: "Google News", p: "com.google.android.apps.magazines"},
    {n: "Google Authenticator", p: "com.google.android.apps.authenticator2"},
    {n: "Camera (Samsung)", p: "com.sec.android.app.camera", m: "samsung"}, {n: "Phone (Samsung)", p: "com.samsung.android.dialer", m: "samsung"},
    {n: "Messages (Samsung)", p: "com.samsung.android.messaging", m: "samsung"}, {n: "Gallery (Samsung)", p: "com.sec.android.gallery3d", m: "samsung"},
    {n: "Clock (Samsung)", p: "com.sec.android.app.clockpackage", m: "samsung"}, {n: "Calculator (Samsung)", p: "com.sec.android.app.popupcalculator", m: "samsung"},
    {n: "Samsung Internet", p: "com.sec.android.app.sbrowser", m: "samsung"}, {n: "My Files (Samsung)", p: "com.sec.android.app.myfiles", m: "samsung"},
    {n: "Samsung Notes", p: "com.samsung.android.app.notes", m: "samsung"}, {n: "Calendar (Samsung)", p: "com.samsung.android.calendar", m: "samsung"},
    {n: "Contacts (Samsung)", p: "com.samsung.android.app.contacts", m: "samsung"},
    {n: "WhatsApp", p: "com.whatsapp"}, {n: "Instagram", p: "com.instagram.android"},
    {n: "Facebook", p: "com.facebook.katana"}, {n: "Messenger", p: "com.facebook.orca"},
    {n: "Telegram", p: "org.telegram.messenger"}, {n: "Signal", p: "org.thoughtcrime.securesms"},
    {n: "Discord", p: "com.discord"}, {n: "Snapchat", p: "com.snapchat.android"},
    {n: "TikTok", p: "com.zhiliaoapp.musically"}, {n: "X (Twitter)", p: "com.twitter.android"},
    {n: "Reddit", p: "com.reddit.frontpage"}, {n: "LinkedIn", p: "com.linkedin.android"},
    {n: "Threads", p: "com.instagram.barcelona"}, {n: "Bluesky", p: "xyz.blueskyweb.app"},
    {n: "Mastodon", p: "org.joinmastodon.android"}, {n: "Pinterest", p: "com.pinterest"},
    {n: "Slack", p: "com.Slack"}, {n: "Microsoft Teams", p: "com.microsoft.teams"},
    {n: "Zoom", p: "us.zoom.videomeetings"}, {n: "Outlook", p: "com.microsoft.office.outlook"},
    {n: "Spotify", p: "com.spotify.music"}, {n: "Netflix", p: "com.netflix.mediaclient"},
    {n: "Prime Video", p: "com.amazon.avod.thirdpartyclient"}, {n: "Disney+", p: "com.disney.disneyplus"},
    {n: "Twitch", p: "tv.twitch.android.app"}, {n: "SoundCloud", p: "com.soundcloud.android"},
    {n: "Pocket Casts", p: "au.com.shiftyjelly.pocketcasts"}, {n: "Audible", p: "com.audible.application"},
    {n: "Kindle", p: "com.amazon.kindle"}, {n: "VLC", p: "org.videolan.vlc"},
    {n: "Apple Music", p: "com.apple.android.music"}, {n: "Shazam", p: "com.shazam.android"},
    {n: "Firefox", p: "org.mozilla.firefox"}, {n: "Brave", p: "com.brave.browser"},
    {n: "DuckDuckGo", p: "com.duckduckgo.mobile.android"}, {n: "Microsoft Edge", p: "com.microsoft.emmx"},
    {n: "Notion", p: "notion.id"}, {n: "Obsidian", p: "md.obsidian"},
    {n: "Todoist", p: "com.todoist"}, {n: "Microsoft To Do", p: "com.microsoft.todos"},
    {n: "Evernote", p: "com.evernote"}, {n: "1Password", p: "com.onepassword.android"},
    {n: "Bitwarden", p: "com.x8bit.bitwarden"}, {n: "Proton Mail", p: "ch.protonmail.android"},
    {n: "Microsoft Authenticator", p: "com.azure.authenticator"}, {n: "Dropbox", p: "com.dropbox.android"},
    {n: "Termux", p: "com.termux"}, {n: "GitHub", p: "com.github.android"},
    {n: "ChatGPT", p: "com.openai.chatgpt"}, {n: "Claude", p: "com.anthropic.claude"},
    {n: "Uber", p: "com.ubercab"}, {n: "Uber Eats", p: "com.ubercab.eats"},
    {n: "Lyft", p: "me.lyft.android"}, {n: "DoorDash", p: "com.dd.doordash"},
    {n: "Airbnb", p: "com.airbnb.android"}, {n: "Amazon Shopping", p: "com.amazon.mShop.android.shopping"},
    {n: "Waze", p: "com.waze"}, {n: "PayPal", p: "com.paypal.android.p2pmobile"},
    {n: "Venmo", p: "com.venmo"}, {n: "Cash App", p: "com.squareup.cash"},
    {n: "Revolut", p: "com.revolut.revolut"}, {n: "Duolingo", p: "com.duolingo"},
    {n: "Strava", p: "com.strava"}, {n: "Pocket", p: "com.ideashower.readitlater.pro"},
    {n: "NewPipe", p: "org.schabi.newpipe"}, {n: "LibreTube", p: "com.github.libretube"},
    {n: "F-Droid", p: "org.fdroid.fdroid"}, {n: "Aurora Store", p: "com.aurora.store"},
    {n: "Obtainium", p: "dev.imranr.obtainium.fdroid"}, {n: "Fennec", p: "org.mozilla.fennec_fdroid"},
    {n: "Thunderbird", p: "net.thunderbird.android"}, {n: "K-9 Mail", p: "com.fsck.k9"},
    {n: "Element", p: "im.vector.app"}, {n: "Tusky", p: "com.keylesspalace.tusky"},
    {n: "AntennaPod", p: "de.danoeh.antennapod"}, {n: "Auxio", p: "org.oxycblt.auxio"},
    {n: "Seal", p: "com.junkfood.seal"}, {n: "Feeder", p: "com.nononsenseapps.feeder"},
    {n: "Organic Maps", p: "app.organicmaps"}, {n: "OsmAnd", p: "net.osmand.plus"},
    {n: "Aegis", p: "com.beemdevelopment.aegis"}, {n: "KeePassDX", p: "com.kunzisoft.keepass.libre"},
    {n: "Markor", p: "net.gsantner.markor"}, {n: "Material Files", p: "me.zhanghai.android.files"},
    {n: "Breezy Weather", p: "org.breezyweather"},
    {n: "Gallery (Fossify)", p: "org.fossify.gallery"}, {n: "File Manager (Fossify)", p: "org.fossify.filemanager"},
    {n: "Calendar (Fossify)", p: "org.fossify.calendar"}, {n: "Notes (Fossify)", p: "org.fossify.notes"},
    {n: "Clock (Fossify)", p: "org.fossify.clock"}, {n: "Messages (Fossify)", p: "org.fossify.messages"},
    {n: "Phone (Fossify)", p: "org.fossify.phone"}, {n: "Contacts (Fossify)", p: "org.fossify.contacts"},
    {n: "Camera (Fossify)", p: "org.fossify.camera"},
  ]
  let maker = lower(dev.maker ?? "")
  let seenApps = seen.map(s => {n: split(s, "|")[1], p: split(s, "|")[0], seen: true})
  let seenPkgs = seenApps.map(a => a.p)
  let pool = seenApps + catalog.filter(a => !contains(seenPkgs, a.p) && (a.m == null || maker == "" || contains(maker, a.m)))
  let ql = lower(trim(q))
  let results = pool.filter(a => ql == "" || contains(lower(a.n), ql) || contains(lower(a.p), ql)).take(40)

  // Swipe tracking. onDrag has no "finger up" event, so a touch is followed by its
  // positions: it starts where it first lands (or jumps to), and once it travels
  // far enough it launches once, then stays spent until a new touch or a second passes.
  state sx = 0
  state sy = 0
  state cx = 0
  state cy = 0
  state fresh = false
  state armed = false
  state spent = false
  state spentUntil = 0
  state idleAt = 0                // a short drag that never launched is dropped after this
  state fired = -1
  state editing = 0

  let ddx = cx - sx
  let ddy = cy - sy
  let dist = sqrt(ddx * ddx + ddy * ddy)
  // Compass angle (0 = up, clockwise), cut into eight 45° slices.
  let dir = (round(deg(atan2(ddx, -ddy)) / 45) + 8) % 8
  let threshold = 48
  let shown = range(8).map(i => (labels[i] ?? "") != "" ? labels[i] : (apps[i] ?? "") != "" ? last(split(apps[i], ".")) : "—")

  state go = false
  at spentUntil { spent = false; fired = -1; spentUntil = 0 }
  at idleAt { armed = false; idleAt = 0 }

  onTap: screen()

  // Small tiles get small icons, so the eight never touch.
  let iconSize = clamp(min(tileWidth ?? 200, tileHeight ?? 200) / (look == "both" ? 6 : 5), 18, 44)
  state look = "icons" persist     // "icons", "both" (icons and titles) or "text"

  component AppIcon(i, s) {
    Box {
      width: s
      height: s
      align: center
      if (apps[i] ?? "") == "" {
        Text { text: arrows[i]; color: alpha(muted, 0.5); align: center }
      } else {
        // The installed app's own icon, as the drawer shows it (icon pack, monochrome).
        Image { src: "app:${apps[i]}"; width: s; height: s }
      }
    }
  }

  component Slot(i, side) {
    Row {
      weight: 1
      justify: side
      align: center
      let hot = fired == i || (armed && dist > threshold / 3 && dir == i)
      if look == "text" {
        Text {
          text: side == "end" ? "${shown[i]} ${arrows[i]}" : "${arrows[i]} ${shown[i]}"
          style: small
          maxLines: 1
          color: hot ? accent : (apps[i] ?? "") != "" ? foreground : muted
          bold: fired == i
          align: side
          animate color: tween(150ms, "out")
        }
      } else {
        Column {
          gap: 2
          align: center
          scale: hot ? 1.25 : 1
          opacity: armed && !hot ? 0.6 : 1
          animate scale: spring()
          animate opacity: tween(150ms, "out")
          AppIcon { i: i; s: iconSize }
          if look == "both" {
            Text { text: (apps[i] ?? "") != "" ? shown[i] : ""; width: 72; style: small; maxLines: 1; align: center; color: hot ? accent : muted }
          }
        }
      }
    }
  }

  Box {
    fill: true
    onDrag: {
      fresh = (!armed && !spent) || abs(x - cx) + abs(y - cy) > 40
      spent = fresh ? false : spent
      sx = fresh ? x : sx
      sy = fresh ? y : sy
      cx = x
      cy = y
      armed = !spent
      idleAt = now + 2
      // Decided right here (not in a trigger), from this event's own position.
      go = armed && sqrt((x - sx) * (x - sx) + (y - sy) * (y - sy)) > threshold
      fired = go ? (round(deg(atan2(x - sx, sy - y)) / 45) + 8) % 8 : fired
      androidApp(go && (apps[fired] ?? "") != "" ? apps[fired] : null)
      armed = go ? false : armed
      spent = go ? true : spent
      spentUntil = go ? now + 1 : spentUntil
    }
    Canvas {
      let r = min(width, height) / 2 - 6
      circle(width / 2, height / 2, 4, color: alpha(muted, 0.6))
      circle(width / 2, height / 2, min(r, 28), stroke: alpha(border, 0.8), width: 1)
      if armed {
        line(width / 2, height / 2, width / 2 + clamp(ddx, -r, r), height / 2 + clamp(ddy, -r, r), stroke: accent, width: 3, cap: round)
      }
    }
    Column {
      fill: true
      gap: 0
      justify: spaceBetween
      Row {
        fill: width
        gap: 4
        Slot { i: 7; side: "start" }
        Slot { i: 0; side: "center" }
        Slot { i: 1; side: "end" }
      }
      Row {
        fill: width
        Slot { i: 6; side: "start" }
        Slot { i: 2; side: "end" }
      }
      Row {
        fill: width
        gap: 4
        Slot { i: 5; side: "start" }
        Slot { i: 4; side: "center" }
        Slot { i: 3; side: "end" }
      }
    }
  }

  component Pick(i) {
    Box {
      fill: width
      height: 56
      align: center
      border: editing == i ? 2 : 1
      borderColor: editing == i ? accent : border
      onTap: editing = i
      AppIcon { i: i; s: 32 }
    }
  }

  screen {
    title: "swipe gestures"
    Column {
      scroll: true
      gap: 12
      Row {
        gap: 6
        align: center
        Text { text: "tile shows"; style: label; width: 88 }
        Button { text: "icons"; color: look == "icons" ? accent : muted; onTap: look = "icons" }
        Button { text: "both"; color: look == "both" ? accent : muted; onTap: look = "both" }
        Button { text: "text"; color: look == "text" ? accent : muted; onTap: look = "text" }
      }
      Text { text: "Pick a direction, then pick its app below."; style: small; color: muted }
      Grid {
        columns: 3
        gap: 6
        width: 240
        Pick { i: 7 }
        Pick { i: 0 }
        Pick { i: 1 }
        Pick { i: 6 }
        Spacer { }
        Pick { i: 2 }
        Pick { i: 5 }
        Pick { i: 4 }
        Pick { i: 3 }
      }
      Row {
        align: center
        Text { text: "${arrows[editing]} ${dirs[editing]}: ${(apps[editing] ?? "") != "" ? (labels[editing] ?? "") != "" ? labels[editing] : apps[editing] : "unassigned"}"; weight: 1; maxLines: 1 }
        Button { text: "test"; onTap: androidApp((apps[editing] ?? "") == "" ? null : (apps[editing] ?? "")) }
        Button { text: "clear"; color: red; onTap: { apps = range(8).map(j => j == editing ? "" : (apps[j] ?? "")); labels = range(8).map(j => j == editing ? "" : (labels[j] ?? "")) } }
      }
      if (apps[editing] ?? "") != "" {
        Row {
          align: center
          Text { text: "title"; style: label; width: 48 }
          // Saved with the keyboard's enter key; empty goes back to the app's own name.
          Input {
            weight: 1
            text: labels[editing] ?? ""
            placeholder: "title on tile (enter to save)"
            onSubmit: labels = range(8).map(j => j == editing ? trim(value) : (labels[j] ?? ""))
          }
        }
      }
      Input {
        text: q
        placeholder: "search apps (or type a package name)"
        onChange: q = value
        onSubmit: { apps = contains(value, ".") && !contains(trim(value), " ") ? range(8).map(j => j == editing ? trim(value) : (apps[j] ?? "")) : apps; q = "" }
      }
      if !(notes.available ?? true) && len(seen) == 0 {
        Button { text: "show apps from my phone"; color: muted; onTap: notification("open", "") }
      }
      Column {
        gap: 0
        for a in results key a.p {
          Row {
            align: center
            padding: [0, 8]
            onTap: { apps = range(8).map(j => j == editing ? a.p : (apps[j] ?? "")); labels = range(8).map(j => j == editing ? trim(split(a.n, " (")[0]) : (labels[j] ?? "")); q = "" }
            Text { text: a.n; weight: 1; maxLines: 1; color: a.p == (apps[editing] ?? "") ? accent : foreground }
            Text { text: a.seen ? "on phone" : ""; width: 72; style: small; color: green; align: end }
          }
        }
        if len(results) == 0 {
          Text { text: "no match; if you know the package name, type it and press enter"; style: small; color: muted }
        }
      }
      Text { text: "current"; style: label }
      for d, i in dirs {
        Row {
          Text { text: "${arrows[i]} ${d}"; width: 120 }
          Text { text: (apps[i] ?? "") != "" ? "${(labels[i] ?? "") != "" ? (labels[i] ?? "") + " · " : ""}${(apps[i] ?? "")}" : "unassigned"; weight: 1; style: small; color: (apps[i] ?? "") != "" ? foreground : muted; maxLines: 1 }
        }
      }
      Button { text: "done"; onTap: close() }
    }
  }
}
