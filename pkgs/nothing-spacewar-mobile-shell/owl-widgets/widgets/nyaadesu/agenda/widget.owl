widget "agenda" {
  meta { owl: 6; description: "Your next two weeks from any number of Google (or other iCal) calendars, color-coded, with a full agenda on tap"; version: "1.0"; license: "MIT"; category: "productivity" }
  size: 3x5
  minSize: 2x3
  requires { pacman: ["python", "python-icalendar", "python-recurring-ical-events", "nano"] }

  // Events from every calendar listed in ~/.config/gcal-agenda/urls: one secret iCal address per
  // line, optionally as "name = address".
  source sys = android.system every 10m
  source now = clock every 1m
  // Fetches each feed (cached 10 minutes, last copy kept for offline), expands recurring events
  // and groups the next 14 days by day, in the phone's timezone.
  source cal = cmd("""
    python3 -c 'import sys, textwrap; exec(textwrap.dedent(sys.argv[1]))' '
      import datetime as dt, hashlib, json, sys, time, urllib.request
      from pathlib import Path
      from zoneinfo import ZoneInfo
      import icalendar, recurring_ical_events

      CONF = Path.home() / ".config/gcal-agenda/urls"
      CACHE = Path.home() / ".cache/gcal-agenda"
      MAX_AGE = 600

      def out(**kw):
          print(json.dumps(kw))
          sys.exit(0)

      def feeds():
          if not CONF.exists():
              return []
          result = []
          for line in CONF.read_text().splitlines():
              line = line.strip()
              if not line or line.startswith("#"):
                  continue
              name, _, url = line.rpartition(" = ")
              result.append((name.strip(), url.strip()))
          return result

      # Returns the feed, why it could not be updated (or None), and whether that was
      # the network rather than the feed itself.
      def fetch(url):
          CACHE.mkdir(parents=True, exist_ok=True)
          path = CACHE / (hashlib.sha1(url.encode()).hexdigest() + ".ics")
          if path.exists() and time.time() - path.stat().st_mtime < MAX_AGE:
              return path.read_bytes(), None, False
          try:
              req = urllib.request.Request(url, headers={"User-Agent": "gcal-agenda"})
              with urllib.request.urlopen(req, timeout=20) as r:
                  data = r.read()
              # A wifi login page or an error page served with a 200 is not a calendar:
              # keep the last good copy instead of caching it.
              if not data.lstrip().startswith(b"BEGIN:VCALENDAR"):
                  raise ValueError("not an iCal feed")
              path.write_bytes(data)
              return data, None, False
          except urllib.error.HTTPError as e:
              err, offline = "HTTP " + str(e.code), False
          except ValueError as e:
              err, offline = str(e), False
          except Exception as e:
              err, offline = "offline (" + e.__class__.__name__ + ")", True
          # Fall back to the last copy, however old.
          return (path.read_bytes() if path.exists() else None), err, offline

      days = int(sys.argv[2])
      try:
          tz = ZoneInfo(sys.argv[3]) if len(sys.argv) > 3 and sys.argv[3] else None
      except Exception:
          tz = None
      tz = tz or dt.datetime.now().astimezone().tzinfo

      urls = feeds()
      if not urls:
          out(ok=False, setup=True, error="no calendar URLs in ~/.config/gcal-agenda/urls", days=[])

      today = dt.datetime.now(tz).date()
      start = dt.datetime.combine(today, dt.time(), tz)
      end = start + dt.timedelta(days=days)

      # problems: one entry per calendar that could not be updated, for the tile to name it.
      events, problems = [], []
      for idx, (name, url) in enumerate(urls):
          data, err, offline = fetch(url)
          label = name or "calendar " + str(idx + 1)
          feed_events = []
          # One broken feed must not take the other calendars down with it.
          try:
              if data is not None:
                  cal = icalendar.Calendar.from_ical(data)
                  cal_name = name or str(cal.get("X-WR-CALNAME", ""))
                  label = cal_name or label
                  for ev in recurring_ical_events.of(cal).between(start, end):
                      if str(ev.get("STATUS", "")).upper() == "CANCELLED":
                          continue
                      s = ev["DTSTART"].dt
                      e = ev["DTEND"].dt if "DTEND" in ev else None
                      all_day = not isinstance(s, dt.datetime)
                      if all_day:
                          e = e or s + dt.timedelta(days=1)
                          s_dt = dt.datetime.combine(s, dt.time(), tz)
                          e_dt = dt.datetime.combine(e, dt.time(), tz)
                      else:
                          s_dt = s.astimezone(tz) if s.tzinfo else s.replace(tzinfo=tz)
                          e_dt = (e.astimezone(tz) if e.tzinfo else e.replace(tzinfo=tz)) if e else s_dt
                      feed_events.append({
                          "title": str(ev.get("SUMMARY", "(no title)")),
                          "location": str(ev.get("LOCATION", "")),
                          "calendar": cal_name,
                          "color": idx,
                          "allDay": all_day,
                          "start": int(s_dt.timestamp()),
                          "end": int(e_dt.timestamp()),
                          "time": "all day" if all_day else s_dt.strftime("%H:%M"),
                          "until": "" if all_day else e_dt.strftime("%H:%M"),
                      })
          except Exception as e:
              # The copy we have is unreadable, whatever happened on the way.
              data, offline, feed_events = None, False, []
              err = "unreadable (" + (str(e)[:60] or e.__class__.__name__) + ")"
          if err:
              problems.append({"name": label, "error": err, "offline": offline, "lastCopy": data is not None})
          events.extend(feed_events)

      seen, unique = set(), []
      for e in events:
          k = (e["title"], e["start"], e["end"])
          if k not in seen:
              seen.add(k)
              unique.append(e)
      events = unique

      # One entry per day; multi-day events appear on each day they cover.
      out_days = []
      for i in range(days):
          d = today + dt.timedelta(days=i)
          d0 = dt.datetime.combine(d, dt.time(), tz)
          d1 = d0 + dt.timedelta(days=1)
          t0, t1 = d0.timestamp(), d1.timestamp()
          items = [e for e in events if e["start"] < t1 and max(e["end"], e["start"] + 1) > t0]
          items.sort(key=lambda e: (not e["allDay"], e["start"], e["title"]))
          label = "Today" if i == 0 else "Tomorrow" if i == 1 else d.strftime("%a %-d %b")
          out_days.append({"date": int(t0), "label": label, "events": items})

      out(ok=not problems or bool(events), problems=problems, days=out_days,
          error="; ".join(p["name"] + ": " + p["error"] + (" (showing the last copy)" if p["lastCopy"] else "") for p in problems),
          total=sum(len(d["events"]) for d in out_days))
    '
  """ + " 14 ${sh(sys.timezone ?? "")}") every 10m json timeout 60s

  let days = cal.days ?? []
  let colors = [accent, green, yellow, magenta, cyan, orange, blue, red]
  // The tile: today always, then only days that have something on, cut to what fits.
  let shown = days.filter(d => d.label == "Today" || len(d.events) > 0).take(4)
  let lines = flatten(flatten(shown.map(d => [[{head: d.label, empty: len(d.events) == 0}], d.events])))
  // Day headings and all-day events take one line, timed events two (start over end).
  let heights = lines.map(l => l.head ? 22 : l.allDay ? 18 : 25)
  // Calendars that didn't update: "offline" when it's only the network, else named on the tile.
  let problems = cal.problems ?? []
  let offline = len(problems) > 0 && all(problems, p => p.offline)
  let failed = offline ? [] : problems.filter(p => !p.offline).map(p => p.name)
  let room = (tileHeight ?? 300) - 72 - (len(failed) > 0 ? 18 : 0)
  let n = max(2, count(range(len(lines)), i => sum(heights.take(i + 1)) <= room))
  // Don't end on a day heading whose events didn't fit.
  let fit = n < len(lines) && lines[n - 1].head ? n - 1 : n

  onTap: screen()

  component Event(e, full = false) {
    Row {
      gap: 6
      align: center
      opacity: e.end <= now ? 0.45 : 1
      Box { width: 3; height: e.allDay ? 12 : full ? 26 : 22; radius: 2 * corners; background: colors[e.color % 8] }
      Column {
        gap: 0
        width: full ? 64 : 46
        Text { text: e.allDay && !full ? "" : e.time; maxLines: 1; style: small; font: mono; color: muted }
        if e.until != "" { Text { text: e.until; maxLines: 1; style: label; fontSize: full ? 8 : 7; font: mono; color: alpha(muted, 0.7) } }
      }
      Column {
        gap: 0
        weight: 1
        Text { text: e.title; style: small; maxLines: full ? 2 : 1 }
        if full && (e.location != "" || e.calendar != "") {
          Text { text: join([e.location, e.calendar].filter(x => x != ""), " · "); style: label; color: muted; maxLines: 1 }
        }
      }
    }
  }

  Column {
    gap: 1
    Row {
      Text { text: "agenda"; style: muted; weight: 1 }
      Text { text: offline ? "offline" : fmtTime(now, "EEE d"); style: small; color: offline ? yellow : accent; width: 64; maxLines: 1; align: end }
    }
    if len(failed) > 0 {
      Text { text: len(failed) == 1 ? "⚠ ${failed[0]} didn't update" : "⚠ ${len(failed)} calendars didn't update"; style: label; color: yellow; maxLines: 1 }
    }
    if cal == null {
      Text { text: "loading…"; style: small; color: muted }
    } else if cal.setup {
      Text { text: "add your calendars' secret iCal addresses to ~/.config/gcal-agenda/urls"; style: small; color: muted }
      Text { text: "tap to set up"; style: small; color: accent }
    } else {
      for l, i in lines.take(fit) {
        if l.head {
          Text { text: l.head; style: label; color: accent; bold: true; padding: [0, i == 0 ? 0 : 3, 0, 0] }
          if l.empty { Text { text: "nothing on"; style: small; color: muted } }
        } else {
          Event { e: l }
        }
      }
      let rest = count(lines.drop(fit), l => !l.head)
      if rest > 0 { Text { text: "+ ${rest} more"; style: label; color: muted } }
    }
  }

  screen {
    title: "agenda"
    Column {
      scroll: true
      gap: 2
      padding: 12
      for p in problems {
        Text { text: "${p.name}: ${p.error}${p.lastCopy ? ", showing the last copy" : ""}"; style: small; color: yellow }
      }
      for d in days key d.date {
        Text { text: d.label; color: accent; bold: true; padding: [0, 6, 0, 0] }
        if len(d.events) == 0 { Text { text: "nothing on"; style: small; color: muted } }
        for e in d.events key "${e.calendar}${e.start}${e.title}" { Event { e: e; full: true } }
      }
      Row {
        padding: [0, 12, 0, 0]
        Button { text: "refresh"; onTap: refresh() }
        Button { text: "edit calendars"; onTap: terminal("mkdir -p ~/.config/gcal-agenda && nano ~/.config/gcal-agenda/urls", "calendars") }
      }
    }
  }
}
