widget "balatro joker" {
  meta { description: "A random Joker from Balatro with its effect, cost and rarity. Tap for another"; version: "1.0"; license: "MIT"; category: "fun" }
  size: 3x3
  minSize: 2x2

  requires { pacman: ["jq", "curl", "perl"] }

  // On first run this caches every joker (name, effect, cost, rarity) and its art from
  // balatrowiki.org into ~/.cache/balatro; after that a pick is just shuf over the cached list.
  source pick = cmd("""
d=~/.cache/balatro
if [ ! -s "$d/jokers.json" ]; then
  mkdir -p "$d/img"
  tmp=$(mktemp)
  curl -sf 'https://balatrowiki.org/api.php?action=parse&page=Jokers&prop=text&format=json' |
    jq -r '.parse.text["*"]' > "$tmp"
  perl -MJSON::PP -e '
    local $/; my $html = <STDIN>; my @out;
    for my $row (split /<tr>/, $html) {
      my @td = $row =~ /<td[^>]*>(.*?)<\/td>/gs;
      next unless @td >= 6 && $td[0] =~ /^\s*(\d+)\s*$/;
      my $nr = $1;
      my ($file) = $td[1] =~ /srcset="\/images\/([^"?]+)/;
      $file =~ s{^thumb/([^/]+)/.*}{$1};
      next unless $file && $file !~ m{/|^\.};
      my ($name) = $td[1] =~ /title="([^"]+)">[^<]+<\/a>\s*$/s;
      ($name) = $td[1] =~ /title="([^"]+)"/ unless $name;
      my $clean = sub {
        my $s = shift; $s =~ s/<style.*?<\/style>//gs; $s =~ s/<br\s*\/?>/ /g; $s =~ s/<[^>]+>//g;
        $s =~ s/&#160;|&nbsp;/ /g; $s =~ s/&#(\d+);/chr($1)/ge; $s =~ s/&amp;/&/g; $s =~ s/&quot;/"/g;
        $s =~ s/&lt;/</g; $s =~ s/&gt;/>/g; $s =~ s/&#39;/\x27/g; $s =~ s/\s+/ /g; $s =~ s/^ | $//g; $s };
      my $cost = $clean->($td[3]); $cost = "-" if $cost eq "N/A";
      push @out, { nr => $nr+0, name => $clean->($name), file => $file, effect => $clean->($td[2]),
                   cost => $cost, rarity => $clean->($td[4]) };
    }
    print JSON::PP->new->utf8(0)->canonical->encode(\@out);
  ' < "$tmp" > "$d/jokers.new.json"
  rm -f "$tmp"
  if [ "$(jq length "$d/jokers.new.json" 2>/dev/null || echo 0)" -gt 100 ]; then
    jq -r '.[].file' "$d/jokers.new.json" | while read -r f; do
      [ -s "$d/img/$f" ] || curl -sf -o "$d/img/$f" "https://balatrowiki.org/images/$f"
    done
    mv "$d/jokers.new.json" "$d/jokers.json"
  fi
fi
jq -c '.[]' "$d/jokers.json" | shuf -n1
""") every 1h json timeout 180s

  let art = "~/.cache/balatro/img/${pick.file}"
  let rarityColor = pick.rarity == "Legendary" ? magenta : pick.rarity == "Rare" ? red : pick.rarity == "Uncommon" ? green : blue

  onTap: refresh()

  component Header() {
    Column {
      gap: 4
      Text { text: pick.name ?? "shuffling…"; style: body; bold: true; maxLines: 2 }
      Text { text: pick.rarity; style: small; bold: true; color: rarityColor }
      if pick.cost != "-" { Text { text: pick.cost; style: small; bold: true; color: yellow } }
    }
  }

  if pick == null {
    Text { text: "shuffling…"; style: muted }
  } else if cols < 3 {
    Image { src: art; fit: contain; fill: true }
  } else if cols < 5 {
    // narrow: art and name side by side, effect underneath
    Column {
      gap: 8
      fill: true
      Row {
        gap: 10
        align: center
        Image { src: art; fit: contain; width: 72; height: 96 }
        Header { weight: 1 }
      }
      Text { text: pick.effect; style: small; weight: 1 }
    }
  } else {
    Row {
      gap: 12
      fill: true
      align: center
      Image { src: art; fit: contain; width: 96; fill: height }
      Column {
        weight: 1
        gap: 6
        Header { }
        Text { text: pick.effect; style: small }
      }
    }
  }
}
