widget "Singapore PSI" {
  page: 1
  order: 61
  size: 3x4
  minSize: 3x4
  padding: 12

  meta {
    description: "Latest NEA 24-hour PSI readings for all five Singapore regions. Tap to open haze.gov.sg."
    version: "1.0"
    license: "MIT"
    category: "world"
  }
  requires { pacman: [] }

  source response = http("https://api-open.data.gov.sg/v2/real-time/api/psi") every 10m json status
  let latest = response.out.data.items[0]
  let readings = latest.readings.psi_twenty_four_hourly
  let regions = ["north", "south", "east", "west", "central"]
  let ready = response.ok && response.out.code == 0 && readings != null
  onTap: url("https://www.haze.gov.sg/")

  Column {
    fill: true
    gap: 3
    Text { text: "SINGAPORE"; fontSize: 11; color: muted }
    Text { text: "24-hour PSI"; fontSize: 18 }
    Text {
      text: ready ? "${sub(latest.timestamp, 11, 16)} SGT · ${sub(latest.timestamp, 0, 10)}" : response == null ? "Loading readings…" : "Readings unavailable"
      style: small
      fontSize: 10
      color: muted
    }
    for region in regions {
      let value = readings[region]
      let tint = value == null ? muted : value <= 50 ? green : value <= 100 ? yellow : value <= 200 ? orange : value <= 300 ? red : magenta
      Row {
        fill: width
        align: center
        padding: [8, 2]
        background: surface
        Column {
          weight: 1
          gap: 0
          Text { text: "${upper(sub(region, 0, 1))}${sub(region, 1)}"; fontSize: 14 }
        }
        Text { text: value; width: 52; align: end; fontSize: 18; color: tint }
      }
    }
    Spacer { weight: 1 }
    Text { text: "NEA · haze.gov.sg ↗"; fontSize: 10; color: muted }
  }
}
