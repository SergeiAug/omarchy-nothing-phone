widget "omarcharium" {
  meta { owl: 5; description: "Omarcharium's terminal reef on your home screen: eight ASCII tropical species, kelp, coral and bubbles. Tap to immerse"; version: "1.0"; license: "MIT"; category: "fun" }
  size: 6x3
  minSize: 2x2
  padding: 0

  // A port of Omarcharium (github.com/DailenG/omarcharium), the Omarchy
  // screensaver plugin. A Canvas keeps nothing between frames, so every fish,
  // bubble and kelp frond is a function of `time`. Canvas text has no
  // monospace font, so each glyph is placed on its own cell of a terminal-like
  // grid instead.
  //
  // If the plugin's config.json is here too, its species counts and palette
  // are used; the screen's palette button overrides the palette.
  source cfg = file("~/.config/omarcharium/config.json") json optional
  state pal = "" persist
  state status = false persist
  state blowAt = -100
  state bx = 0
  state by = 0

  let palettes = ["theme", "lagoon", "midnight", "coral", "phosphor"]
  let palName = pal != "" ? pal : palettes.indexOf(cfg.art.palette ?? "") > 0 ? cfg.art.palette : "theme"

  // Environment colors, as in aquarium.py's PALETTES; "theme" follows Omarchy.
  let envs = {
    theme: {bg: background, water: mix(cyan, background, 0.45), caustic: cyan, sand: mix(yellow, orange, 0.4), rock: mix(muted, background, 0.35), kelp: green, coral: red, dim: mix(muted, background, 0.45), text: foreground},
    lagoon: {bg: #02121c, water: #1d788f, caustic: #5de6e2, sand: #b48d56, rock: #2d524e, kelp: #2aa775, coral: #ff677e, dim: #1f4f5c, text: #a1f1eb},
    midnight: {bg: #010612, water: #18366f, caustic: #5f6de8, sand: #5b5174, rock: #272f52, kelp: #1d7777, coral: #b550cd, dim: #1f335e, text: #93baff},
    coral: {bg: #150814, water: #8a315d, caustic: #ff956f, sand: #dc975c, rock: #5b3144, kelp: #67ab71, coral: #ff525f, dim: #5f2d4c, text: #ffd8af},
    phosphor: {bg: #000b08, water: #146942, caustic: #63ffa9, sand: #51955a, rock: #1e432f, kelp: #31c05b, coral: #99ff7b, dim: #164d30, text: #9bffbd}
  }
  let env = get(envs, palName, envs.theme)

  // Species, in aquarium.py's order: [body, accent, shadow] colors.
  let keys = ["neon_tetra", "clownfish", "angelfish", "discus", "butterflyfish", "royal_tang", "betta", "puffer"]
  let speeds = [8.0, 4.8, 2.4, 2.9, 4.0, 5.6, 2.0, 2.2]
  let defaults = {neon_tetra: 10, clownfish: 4, angelfish: 3, discus: 3, butterflyfish: 2, royal_tang: 3, betta: 1, puffer: 2}
  let fishColors = palName == "theme" ? [
    [cyan, red, bright_cyan],
    [orange, foreground, mix(orange, background, 0.5)],
    [mix(yellow, foreground, 0.6), cyan, mix(yellow, background, 0.5)],
    [magenta, cyan, mix(magenta, background, 0.5)],
    [yellow, foreground, mix(foreground, background, 0.55)],
    [blue, yellow, mix(blue, background, 0.5)],
    [bright_magenta, bright_cyan, mix(magenta, background, 0.4)],
    [green, yellow, mix(green, background, 0.5)]
  ] : [
    [#34dbff, #f54c7e, #9df5ff],
    [#ff8430, #ffefbf, #9c3623],
    [#f2e5af, #61d0dc, #93765e],
    [#ff5cae, #50e0d3, #7e3482],
    [#ffe146, #fffaca, #2c434f],
    [#4189ff, #ffe33e, #14378a],
    [#bb5dff, #40e0ef, #6a2b94],
    [#a4e865, #ffde5a, #3e683f]
  ]

  // Right-facing frames, straight from aquarium.py. Spaces are transparent.
  let raw = [
    [["  __/=>", "<==_o_>"], ["  __/=>", "<~=_o_>"]],
    [["   .---.  ", "<==|o|==)>", "   '---'  "], ["  .----.  ", "<~=|o|==)>", "  '----'  "]],
    [["    /|   ", " __/ |   ", "<== o|)>", "   \\ |   ", "    \\|   "], ["    /|   ", "  _/ |   ", "<~= o|)>", " __\\ |   ", "    \\|   "]],
    [["  .-===-. ", "<=| o  |)>", "  '-===-' "], ["  .-===-. ", "<~| o  |)>", "  '-===-' "]],
    [["    /\\   ", "<==/##\\  ", "  |#o#|)>", "   \\##/  "], ["   _/\\   ", "<~=/##\\  ", "  |#o#|)>", "   \\##/  "]],
    [["   __---. ", "<==  @  )>", "   '--__' "], ["   __---. ", "<~=  @  )>", "   '--__' "]],
    [["     __   ", "<~~~~_o\\)>", "  ~~  /  ", "   ~~/   "], ["    ___   ", "<~~~__o\\)>", "   ~~ /  ", "  ~~ /   "]],
    [["  ^-^-^  ", "<= (o ) >", "  v-v-v  "], ["  ^-^-^  ", "<~ (o ) >", "  v-v-v  "]]
  ]
  let spriteW = raw.map(fr => max(fr[0].map(l => len(l))))
  let spriteH = raw.map(fr => len(fr[0]))
  // Each frame as cells [column, row, glyph, color index]: accent for
  // eyes and bands, shadow for outlines, body for the rest.
  let right = raw.map(fr => fr.map(lines => flatten(lines.map((l, r) => range(len(l)).map(c => [c, r, sub(l, c, c + 1)])))
    .filter(v => v[2] != " ")
    .map(v => [v[0], v[1], v[2], contains("oO@#=|", v[2]) ? 1 : contains("_.'~-", v[2]) ? 2 : 0])))
  // Left-facing: flipped columns, and glyphs swapped for their mirror image.
  let mirror = [["<", ">"], [">", "<"], ["/", "\\"], ["\\", "/"], ["(", ")"], [")", "("], ["{", "}"], ["}", "{"], ["[", "]"], ["]", "["]]
  let left = right.map((fr, s) => fr.map(cs => cs.map(v => [spriteW[s] - 1 - v[0], v[1], (find(mirror, m => m[0] == v[2]) ?? [v[2], v[2]])[1], v[3]])))

  // The population: species taken in turns, so a small tile still gets a mix.
  let counts = cfg.species ?? defaults
  let order = flatten(range(20).map(k => range(8).filter(s => num(get(counts, keys[s], 0), 0) > k)))
  // Per-fish constants from a hash of its index: [species, direction, speed,
  // start, depth seed, bob rate, bob height, bob phase, fin phase]
  let fishes = order.map((s, i) => [i * 12.9898, i * 78.233, i * 37.719, i * 4.581, i * 91.17, i * 23.03].map(k => abs(sin(k + 1.3) * 43758.5453) % 1)
    .map((r, j) => r))
    .map((r, i) => [order[i], r[0] < 0.5 ? -1 : 1, speeds[order[i]] * (0.72 + 0.56 * r[1]), r[2], i * 7.31, 0.45 + 0.7 * r[3], 0.35 + 1.05 * r[4], r[5] * 6.28, r[3] * 6.28])

  component Reef() {
    Canvas {
      // A terminal grid sized to the canvas: about 64 columns on a full-width tile.
      let fs = clamp(width / 38, 8, 11)
      let cw = fs * 0.62
      let ch = fs * 1.22
      let W = floor(width / cw)
      let H = max(floor(height / ch), 8)
      let oy = (height - H * ch) / 2
      let floorY = H - 3
      // The plugin's 28 fish fill a 120x36 terminal; keep that density.
      let nf = clamp(round(len(order) * W * H / 4320), 1, len(order))

      rect(0, 0, width, height, fill: env.bg)
      clip(0, 0, width, height) {
        translate(0, oy) {
          // Surface ripples, drifting motes and shafts of light
          for x in range(0, W, 2) {
            text(floor(x / 2 + time * 7.5) % 3 ? "~" : "_", (x + 0.5) * cw, (1.5 + round(sin(x * 0.13 + time * 0.7))) * ch, size: fs, align: center, color: env.caustic)
          }
          for m in range(max(6, floor(W * H / 200))) {
            let mx = abs(sin(m * 3.7 + 0.4) * 9631.7) % 1 * W
            let my = 3 + abs(sin(m * 5.3 + 1.9) * 4718.3) % 1 * (H - 7)
            let glow = sin(time * 1.6 + m) > 0.44
            text(glow ? "+" : ".", (floor(mx + sin(time * 0.1 + m) * 0.6) + 0.5) * cw, (floor(my) + 0.5) * ch, size: fs, align: center, color: glow ? env.water : env.dim)
          }
          for s in range(3) {
            let sc = (W * (s + 0.7) / 3.5 + time * (s + 1) * 0.35) % W
            for y in range(4, min(H - 5, 15 + s * 3)) {
              if (y + s) % 3 == 0 {
                text(":", (floor(sc + sin(y * 0.22 + time) * 2) + 0.5) * cw, (y + 0.5) * ch, size: fs, align: center, color: env.dim)
              }
            }
          }

          // Sand ridges and rock beneath
          for x in range(W) {
            let rv = 1.4 * sin(x * 0.09) + 0.7 * sin(x * 0.31)
            let y = floorY + floor(sign(rv) * floor(abs(rv)) / 2)
            text(x % 4 ? "_" : ".", (x + 0.5) * cw, (y + 0.5) * ch, size: fs, align: center, color: env.sand)
            text(".", (x + 0.5) * cw, (y + 1.5) * ch, size: fs, align: center, color: env.rock)
          }
          // Kelp, swaying a cell either way
          for k in range(max(1, round(floor(W / 7) * 0.5))) {
            let ax = floor((k * W * 0.6180339887 + 5) % (W - 8)) + 4
            let kh = clamp(round((4 + (k * 7 + (k % 3) * 5) % 8) * 0.875), 2, H - 5)
            for seg in range(kh) {
              let sw = round(sin(time * (0.65 + (k % 5) * 0.08) + seg * 0.48 + k * 1.3))
              text(sw >= 0 ? "}" : "{", (ax + sw + 0.5) * cw, (floorY - seg + 0.5) * ch, size: fs, align: center, color: env.kelp)
            }
            text("Y", (ax + 0.5) * cw, (floorY + 1.5) * ch, size: fs, align: center, color: env.kelp)
          }
          // Branching coral in the middle, a smaller one to the left, rocks
          let reefs = [
            [floor(W / 2 + sin(W) * W * 0.04) - 5, floorY - 2, ["  \\ \\|/ /  ", "---\\ | /---", "    \\|/    ", "     Y     "], env.coral],
            [max(8, floor(W / 4)) - 2, floorY - 1, [" \\|/ ", "  Y  "], env.coral],
            [2, floorY, ["[__]"], env.rock],
            [floor(W / 3), floorY, ["(_/\\_)"], env.rock],
            [W - 9, floorY, ["[___]"], env.rock]
          ]
          for rf in reefs {
            for l, r in rf[2] {
              for c in range(len(l)) {
                if sub(l, c, c + 1) != " " {
                  text(sub(l, c, c + 1), (rf[0] + c + 0.5) * cw, (rf[1] + r + 0.5) * ch, size: fs, align: center, color: rf[3])
                }
              }
            }
          }

          // Bubbles rising from the sand, wobbling as they go
          for b in range(floor(W * H * 55 / 8500) + 4) {
            let bs = abs(sin(b * 7.77 + 0.3) * 2741.1) % 1
            let rise = 1.6 + 3.2 * abs(sin(b * 2.13) * 9127.3) % 1
            let trip = H - 6
            let t = time * rise + bs * trip
            let lap = floor(t / trip)
            let bxc = (abs(sin(b * 4.9 + lap * 1.7) * 6151.9) % 1) * (W - 4) + 2 + sin(time * 1.7 + b) * 0.8
            let size = bs < 0.6 ? 0 : bs < 0.9 ? 1 : 2
            text(size == 0 ? "." : size == 1 ? "o" : "O", (floor(bxc) + 0.5) * cw, (floor(H - 3 - (t - lap * trip)) + 0.5) * ch, size: fs, align: center, color: env.caustic)
          }

          // The fish. Each swims across, then comes back in at a new depth.
          for f in fishes.take(nf) {
            let s = f[0]
            let span = W + 2 * spriteW[s] + 8
            let trav = f[3] * span + f[2] * time
            let lap = floor(trav / span)
            let u = trav - lap * span
            let col = round(f[1] > 0 ? u - spriteW[s] - 4 : W + 4 - u)
            let depth = abs(sin(f[4] + lap * 78.233) * 43758.5453) % 1
            let lo = min(4, H - spriteH[s] - 4)
            let row = round(lo + depth * max(H - spriteH[s] - 5 - lo, 0) + sin(time * f[5] + f[7]) * f[6])
            let fi = floor(time * (2.2 + f[2] * 0.08) + f[8]) % 2
            let colors = fishColors[s]
            for v in f[1] > 0 ? right[s][fi] : left[s][fi] {
              text(v[2], (col + v[0] + 0.5) * cw, (row + v[1] + 0.5) * ch, size: fs, align: center, color: colors[v[3]])
            }
          }
        }
      }
    }
  }

  onTap: screen()

  Reef { fill: true }

  screen {
    title: "omarcharium"
    Column {
      gap: 0
      fill: true
      background: env.bg
      Box {
        weight: 1
        fill: width
        Reef { fill: true }
        // A tap releases a burst of bubbles where it lands. This canvas sits
        // over the reef and draws the burst on its own clock.
        Canvas {
          fill: true
          onTap: { blowAt = time; bx = x; by = y }
          let fs = clamp(width / 38, 8, 11)
          let cw = fs * 0.62
          let ch = fs * 1.22
          let since = time >= blowAt ? time - blowAt : 100
          if since < 4 {
            for q in range(9) {
              let rise = (2 + (q * 5) % 7) * since * ch * 1.2
              let wob = sin(since * 3 + q) * 0.8 + (q - 4) * 0.6 * min(since, 1)
              let gy = by - rise
              if gy > ch * 2 {
                text(q % 3 == 0 ? "O" : q % 3 == 1 ? "o" : ".", (floor(bx / cw + wob) + 0.5) * cw, (floor(gy / ch) + 0.5) * ch, size: fs, align: center, color: alpha(env.caustic, clamp(1.6 - since / 2.5, 0, 1)))
              }
            }
          }
          if status {
            text(" OMARCHARIUM // PELAGIC TERMINAL ENVIRONMENT ", 8, ch * 0.6, size: fs, color: env.text)
          }
        }
      }
      Row {
        padding: [12, 8]
        gap: 8
        Button { text: "palette: ${palName}"; color: env.caustic; weight: 1; onTap: pal = palettes[(palettes.indexOf(palName) + 1) % len(palettes)] }
        Button { text: status ? "status on" : "status off"; color: env.dim; width: 120; onTap: status = !status }
      }
      Text {
        text: "BIOMASS ${pad(len(order), 2, "0")} // ${upper(palName)}  ·  tap the water for bubbles"
        style: small
        color: env.dim
        align: center
        padding: [12, 0, 12, 12]
      }
    }
  }
}
