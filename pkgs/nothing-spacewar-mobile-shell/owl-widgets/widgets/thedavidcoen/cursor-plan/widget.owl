widget "cursor plan" {
  size: 3x3
  minSize: 3x2

  meta {
    description: "Cursor plan name with included and API usage percent from the local Cursor session";
    version: "1.0";
    license: "MIT";
    category: "dev"
  }

  requires { pacman: ["jq", "curl"] }

  // Plan name + included/API % from Cursor's dashboard APIs (local session token).
  source data = cmd("""
    auth=~/.config/cursor/auth.json
    token=$(jq -r '.accessToken // empty' "$auth")
    if [ -z "$token" ]; then
      printf '%s\n' '{"ok":false,"error":"sign in to Cursor"}'
      exit 0
    fi
    usage=$(printf 'Authorization: Bearer %s\n' "$token" | curl -sfS --max-time 15 -X POST \
      'https://api2.cursor.sh/aiserver.v1.DashboardService/GetCurrentPeriodUsage' \
      -H @- -H 'Content-Type: application/json' -H 'Connect-Protocol-Version: 1' -d '{}') || {
      printf '%s\n' '{"ok":false,"error":"usage unavailable"}'
      exit 0
    }
    plan=$(printf 'Authorization: Bearer %s\n' "$token" | curl -sfS --max-time 15 -X POST \
      'https://api2.cursor.sh/aiserver.v1.DashboardService/GetPlanInfo' \
      -H @- -H 'Content-Type: application/json' -H 'Connect-Protocol-Version: 1' -d '{}') || {
      printf '%s\n' '{"ok":false,"error":"plan unavailable"}'
      exit 0
    }
    jq -nc --argjson u "$usage" --argjson p "$plan" '{
      ok: true,
      plan: ($p.planInfo.planName // "Cursor"),
      price: ($p.planInfo.price // ""),
      planPct: ($u.planUsage.totalPercentUsed // 0),
      apiPct: ($u.planUsage.apiPercentUsed // 0),
      included: (($u.planUsage.includedSpend // 0) / 100),
      limit: (($u.planUsage.limit // 0) / 100),
      cycleEnd: ($u.billingCycleEnd // null | if . then tonumber / 1000 else null end),
      message: ($u.displayMessage // "")
    }' || printf '%s\n' '{"ok":false,"error":"usage unavailable"}'
  """) every 5m json timeout 40s

  let planPct = data.ok ? round(data.planPct) : null
  let apiPct = data.ok ? round(data.apiPct) : null
  let planColor = planPct == null ? muted : planPct >= 90 ? red : planPct >= 75 ? yellow : accent
  let apiColor = apiPct == null ? muted : apiPct >= 90 ? red : apiPct >= 75 ? yellow : accent

  onTap: url("https://cursor.com/dashboard/usage")

  Column {
    gap: 6
    Row {
      gap: 6
      align: center
      Text { text: "cursor"; style: muted; weight: 1 }
      if data.price != null && data.price != "" {
        Text { text: data.price; style: small; color: muted; width: 56; align: end }
      }
    }
    Text {
      text: data == null ? "…" : data.ok ? data.plan : (data.error ?? "offline")
      style: title
      color: data.ok ? foreground : muted
    }
    Column {
      gap: 2
      Row {
        align: center
        Text { text: "plan"; style: label; weight: 1 }
        Text {
          text: planPct == null ? "…" : "${planPct}%"
          style: small
          color: planColor
          width: 40
          align: end
        }
      }
      Progress { value: planPct ?? 0; color: planColor; animate value: spring() }
    }
    Column {
      gap: 2
      Row {
        align: center
        Text { text: "API"; style: label; weight: 1 }
        Text {
          text: apiPct == null ? "…" : "${apiPct}%"
          style: small
          color: apiColor
          width: 40
          align: end
        }
      }
      Progress { value: apiPct ?? 0; color: apiColor; animate value: spring() }
    }
    if data.ok && data.cycleEnd != null {
      Text {
        text: data.limit > 0
          ? "\$${fixed(data.included, 0)} / \$${fixed(data.limit, 0)} · resets ${fmtTime(data.cycleEnd, "MMM d")}"
          : "resets ${fmtTime(data.cycleEnd, "MMM d")}"
        style: small
        color: muted
      }
    }
  }
}
