widget "flipper zero" {
  page: 2
  order: 2
  size: 6x3
  minSize: 3x3

  meta { owl: 6; description: "A Flipper Zero's live screen and buttons, through a small bridge on the computer it's plugged into over USB, reached over ssh"; version: "1.0"; license: "MIT"; category: "dev" }
  requires { pacman: ["openssh", "util-linux"] }

  // Android doesn't let Linux on the phone use Bluetooth or USB, and the launcher may
  // not reach the LAN directly, so the Flipper plugs into a computer that runs
  // flipper_bridge.py (see the README) on its 127.0.0.1:8765, and the widget gets
  // there over ssh: `ssh <host>` has to work from here with a key, no password.
  // The ssh host, as in ~/.ssh/config; the screen's connect button writes it.
  source hostFile = file("~/.config/owl-flipper/host")
  let host = trim(hostFile ?? "")
  state draftHost = ""
  state long = false             // the next button is a long press
  state pressed = ""             // the key being sent, "failed", or ""
  state press = {k: "", n: 0}    // set by the pads; the trigger below sends it

  // Frames come from a feeder that streams from the bridge over ssh into a file:
  // {ok, connected, error, name, fw, battery, charging, rows}, rows being 64 strings
  // of 128 '.' or 'x'. Not a stream source, since the launcher drops stream lines
  // over about 8 KB (a frame is just over) and can stop reading a stream without
  // restarting it. This command starts the feeder (the FEED part) as its own
  // process, and restarts it when the host changes; calling it every 5 s keeps it
  // going, and it quits 45 s after the widget goes off screen. Its ssh connection is
  // shared, so a button press is a quick extra channel on it instead of a new login.
  source feeder = cmd("""
d=~/.cache/owl-flipper
mkdir -p "$d" && touch "$d/heartbeat"
h=$(head -1 ~/.config/owl-flipper/host 2>/dev/null)
pid=$(cat "$d/feed.pid" 2>/dev/null)
if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
  [ "$(cat "$d/feed.host" 2>/dev/null)" = "$h" ] && exit 0
  kill -- "-$pid"
  sleep 0.3
fi
if [ -z "$h" ]; then printf '%s\n' '{"ok":false,"error":"not set up"}' > "$d/frame.json"; exit 0; fi
printf '%s\n' "$h" > "$d/feed.host"
feed=$(cat <<'FEED'
d=~/.cache/owl-flipper
h=$1
exec 9> "$d/feed.lock"
flock -n 9 || exit 0
echo $$ > "$d/feed.pid"
write() { t="$d/frame.$BASHPID.tmp"; printf '%s\n' "$1" > "$t" && mv -f "$t" "$d/frame.json"; }
status() { write "$(printf '{"ok":false,"error":"%s"}' "$1")"; }
stale() { [ $(( $(date +%s) - $(stat -c %Y "$d/heartbeat" 2>/dev/null || echo 0) )) -gt 45 ]; }
trap 'status paused; rm -f "$d/feed.pid"' EXIT
r='curl -sN -y 20 -Y 1 "http://127.0.0.1:8765/stream?token=$(cat ~/.config/flipper-bridge/token)"'
c=/tmp/owl-flipper-%C
while ! stale; do
  # A shared connection whose master died leaves a socket nobody answers.
  ssh -o ControlPath=$c -O check -- "$h" 2>/dev/null 9>&- || rm -f /tmp/owl-flipper-[0-9a-f]*
  ssh -n -o BatchMode=yes -o ConnectTimeout=8 -o ServerAliveInterval=10 -o ServerAliveCountMax=2 -o ControlMaster=auto -o ControlPath=$c -o ControlPersist=120 -- "$h" "$r" 2> "$d/ssh.err" 9>&- |
  while IFS= read -r line; do write "$line"; stale && break; done
  rc=$PIPESTATUS
  if [ "$rc" -eq 255 ]; then
    e=$(grep -v muxclient "$d/ssh.err" | tail -1 | tr -cd 'A-Za-z0-9 .:_@/-' | cut -c1-60)
    status "$h: $(echo "$e" | grep . || echo no connection)"
  elif [ "$rc" -ne 0 ] && [ "$rc" -ne 23 ] && [ "$rc" -lt 128 ]; then
    status "bridge not running on $h"
  fi
  sleep 2
done
FEED
)
setsid -f bash -c "$feed" owl-flipper-feed "$h" > /dev/null 2>&1 < /dev/null
""") every 5s
  source f = file("~/.cache/owl-flipper/frame.json") json
  let rows = f.rows

  // Sends a key over the feeder's connection; the token stays on the computer, read
  // there. It prints nothing on success, so the highlight clears when it's done.
  let kind = long ? "long" : "short"
  on press {
    pressed = value.k
    pressed = run("ssh -n -o BatchMode=yes -o ConnectTimeout=8 -o ControlMaster=auto -o ControlPath=/tmp/owl-flipper-%C -o ControlPersist=120 -- ${sh(host)} 'curl -sf -m 3 -o /dev/null \"http://127.0.0.1:8765/input?token=$(cat ~/.config/flipper-bridge/token)&key='${sh(value.k)}'&type='${sh(kind)}'\"' && sleep 0.1 || echo failed")
    long = false
  }

  let live = f.ok == true && f.connected == true && rows != null
  let status = host == "" ? "tap the screen to set up"
    : f == null || f.error == "paused" ? "connecting…"
    : f.ok != true ? (f.error ?? "bridge unreachable")
    : f.connected != true ? (f.error ?? "flipper not connected")
    : pressed == "failed" ? "that button didn't go through"
    : "${f.name ?? "flipper"} · ${f.battery ?? "?"}%"
  let statusColor = !live || pressed == "failed" ? yellow : f.charging ? green : muted
  let lcdNote = host == "" ? "tap to set up" : f.ok != true ? "no bridge" : "no flipper"

  // Flipper's backlit LCD, whatever the theme.
  let lcd = "#fe8a2c"
  let ink = "#000000"

  component Lcd() {
    Canvas {
      let p = min((width - 8) / 128, (height - 8) / 64)
      let ox = (width - 128 * p) / 2
      let oy = (height - 64 * p) / 2
      rect(ox - 4, oy - 4, 128 * p + 8, 64 * p + 8, fill: live ? lcd : mix(lcd, background, 0.6), radius: 6 * corners)
      if live {
        sprite(rows, ox, oy, p, color: ink)
      } else {
        text(lcdNote, width / 2, height / 2, size: 13, align: center, color: ink)
      }
    }
  }

  // A D-pad with OK in the middle and Back below to the right, as on the Flipper.
  // s is the width; the pad is 1.22 s tall. hit takes [x, y, s] and says which key that is.
  let hit = v => pow(v[0] - 0.86 * v[2], 2) + pow(v[1] - 1.07 * v[2], 2) < pow(0.15 * v[2], 2) ? "back"
    : pow(v[0] - 0.5 * v[2], 2) + pow(v[1] - 0.5 * v[2], 2) < pow(0.17 * v[2], 2) ? "ok"
    : pow(v[0] - 0.5 * v[2], 2) + pow(v[1] - 0.5 * v[2], 2) < pow(0.52 * v[2], 2)
      ? (abs(v[0] - 0.5 * v[2]) > abs(v[1] - 0.5 * v[2]) ? (v[0] > 0.5 * v[2] ? "right" : "left") : (v[1] > 0.5 * v[2] ? "down" : "up"))
    : ""
  let wedge = {up: -45, right: 45, down: 135, left: 225}

  component Pad(s) {
    Canvas {
      onTap: press = host == "" || [[x, y, s]].map(hit)[0] == "" ? press : {k: [[x, y, s]].map(hit)[0], n: press.n + 1}

      let c = 0.5 * s
      let r = 0.47 * s
      circle(c, c, r, fill: surface, stroke: long ? yellow : border, width: long ? 2 : 1)
      if get(wedge, pressed) != null {
        arc(c, c, r, get(wedge, pressed), 90, fill: alpha(accent, 0.4))
      }
      let a = 0.07 * s
      path([[c, c - 0.39 * s], [c - a, c - 0.28 * s], [c + a, c - 0.28 * s]], closed: true, fill: foreground)
      path([[c, c + 0.39 * s], [c - a, c + 0.28 * s], [c + a, c + 0.28 * s]], closed: true, fill: foreground)
      path([[c - 0.39 * s, c], [c - 0.28 * s, c - a], [c - 0.28 * s, c + a]], closed: true, fill: foreground)
      path([[c + 0.39 * s, c], [c + 0.28 * s, c - a], [c + 0.28 * s, c + a]], closed: true, fill: foreground)
      circle(c, c, 0.17 * s, fill: pressed == "ok" ? accent : background, stroke: long ? yellow : border, width: long ? 2 : 1)

      let bx = 0.86 * s
      let by = 1.07 * s
      let br = 0.13 * s
      circle(bx, by, br, fill: pressed == "back" ? accent : surface, stroke: border, width: 1)
      // A back arrow: up, across to the left, arrowhead.
      line(bx + 0.4 * br, by + 0.4 * br, bx + 0.4 * br, by - 0.15 * br, stroke: foreground, width: max(1.5, 0.12 * br), cap: round)
      line(bx + 0.4 * br, by - 0.15 * br, bx - 0.25 * br, by - 0.15 * br, stroke: foreground, width: max(1.5, 0.12 * br), cap: round)
      path([[bx - 0.55 * br, by - 0.15 * br], [bx - 0.2 * br, by - 0.42 * br], [bx - 0.2 * br, by + 0.12 * br]], closed: true, fill: foreground)
    }
  }

  // One key of the strip that narrow tiles get instead of the pad.
  component Key(k) {
    Box {
      border: 1
      borderColor: long && k == "ok" ? yellow : border
      background: pressed == k ? alpha(accent, 0.5) : surface
      onTap: press = host == "" ? press : {k: k, n: press.n + 1}
      Canvas {
        let c = width / 2
        let m = height / 2
        let a = min(width, height) * 0.2
        if k == "up" { path([[c, m - a], [c - a, m + a * 0.6], [c + a, m + a * 0.6]], closed: true, fill: foreground) }
        if k == "down" { path([[c, m + a], [c - a, m - a * 0.6], [c + a, m - a * 0.6]], closed: true, fill: foreground) }
        if k == "left" { path([[c - a, m], [c + a * 0.6, m - a], [c + a * 0.6, m + a]], closed: true, fill: foreground) }
        if k == "right" { path([[c + a, m], [c - a * 0.6, m - a], [c - a * 0.6, m + a]], closed: true, fill: foreground) }
        if k == "ok" { circle(c, m, a * 0.8, stroke: long ? yellow : foreground, width: 2) }
        if k == "back" {
          line(c + a * 0.6, m + a * 0.7, c + a * 0.6, m - a * 0.2, stroke: foreground, width: 2, cap: round)
          line(c + a * 0.6, m - a * 0.2, c - a * 0.3, m - a * 0.2, stroke: foreground, width: 2, cap: round)
          path([[c - a * 0.9, m - a * 0.2], [c - a * 0.3, m - a * 0.65], [c - a * 0.3, m + a * 0.25]], closed: true, fill: foreground)
        }
      }
    }
  }

  component LongToggle() {
    Text {
      text: long ? "long ●" : "long"
      style: small; align: center
      color: long ? yellow : muted
      border: 1; borderColor: long ? yellow : border
      padding: [6, 2]
      onTap: long = !long
    }
  }

  let wide = (cols ?? 6) >= 5
  let padS = clamp(((tileHeight ?? 180) - 24) / 1.22, 56, 130)

  if wide {
    // Like the Flipper itself: the screen on the left, the pad on the right.
    Row {
      gap: 10
      fill: true
      align: center
      Column {
        weight: 1
        fill: height
        gap: 6
        justify: center
        Box {
          weight: 1
          fill: width
          onTap: { draftHost = host; screen() }
          Lcd { fill: true }
        }
        Row {
          gap: 6
          align: center
          Text { text: status; style: small; color: statusColor; maxLines: 1; weight: 1 }
          LongToggle { width: 56 }
        }
      }
      Pad { s: padS; width: padS; height: padS * 1.22 }
    }
  } else {
    Column {
      gap: 6
      fill: true
      Box {
        weight: 1
        fill: width
        onTap: { draftHost = host; screen() }
        Lcd { fill: true }
      }
      Row {
        gap: 4
        height: 34
        fill: width
        for k in ["left", "up", "down", "right", "ok", "back"] {
          Key { k: k; weight: 1; fill: height }
        }
      }
      Row {
        gap: 6
        align: center
        Text { text: status; style: small; color: statusColor; maxLines: 1; weight: 1 }
        LongToggle { width: 56 }
      }
    }
  }

  screen {
    title: "flipper zero"
    Column {
      scroll: true
      gap: 14
      padding: 16
      align: center
      Lcd { fill: width; height: ((screenWidth ?? 360) - 32) / 2 + 8 }
      Row {
        gap: 8
        align: center
        fill: width
        Text { text: status; color: statusColor; maxLines: 1; weight: 1 }
        Text { text: live && f.fw != null ? "fw ${f.fw}" : ""; style: small; color: muted; width: 96; align: end; maxLines: 1 }
      }
      Pad { s: min(220, (screenWidth ?? 360) * 0.6); width: min(220, (screenWidth ?? 360) * 0.6); height: min(220, (screenWidth ?? 360) * 0.6) * 1.22 }
      LongToggle { width: 80 }

      Column {
        gap: 8
        fill: width
        Text { text: "computer"; style: label; color: muted }
        Input { text: host; placeholder: "its ssh host, as in ~/.ssh/config"; onChange: draftHost = value }
        Button { text: "connect"; onTap: run("mkdir -p ~/.config/owl-flipper && printf '%s\\n' ${sh(trim(draftHost))} > ~/.config/owl-flipper/host") }
        Text {
          text: "The Flipper plugs into that computer over USB, and flipper_bridge.py runs there; the widget's README has it and a systemd unit. ssh to the computer has to work from this phone's Linux with a key. Close qFlipper there first: only one program can hold the Flipper's port. Long-press belongs to the home screen, so tap long to make the next button a long press."
          style: small
          color: muted
        }
      }
    }
  }
}
