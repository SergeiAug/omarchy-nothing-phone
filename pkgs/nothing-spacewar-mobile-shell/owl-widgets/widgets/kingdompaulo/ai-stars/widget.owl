widget "ai stars" {
  size: 3x5
  minSize: 3x3
  meta { description: "The AI repos gaining GitHub stars fastest: stars per hour or day, % growth and acceleration, with a full ranking, language filter, search, pins and #1 alerts."; version: "3.0"; license: "MIT"; category: "dev"; owl: 5 }

  requires { pacman: ["curl", "jq", "util-linux"] }

  // GitHub keeps no star history, so this samples the most-starred AI repos (search API, no
  // token needed) every few minutes while the page is live, keeps the snapshots in
  // ~/.cache/ai-stars and measures growth between them.
  source data = cmd("""
    set -u
    D="$HOME/.cache/ai-stars"; mkdir -p "$D"
    ST="$D/state.json"; OUT="$D/top.json"
    now=$(date +%s)
    exec 9>"$D/.lock"
    flock -w 50 9 || { cat "$OUT" 2>/dev/null || echo null; exit 0; }
    last=$(jq -r '.updated // 0' "$OUT" 2>/dev/null || echo 0)
    if [ $((now - last)) -lt 200 ]; then cat "$OUT"; exit 0; fi
    A=(-H "Accept: application/vnd.github+json")
    T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
    new=$(date -u -d '45 days ago' +%F)
    # Established projects by topic, plus young ones by keyword, so fresh risers show up early.
    # One request at a time: GitHub turns away bursts of searches.
    i=0
    for q in "topic:llm stars:>500" "topic:ai stars:>500" "topic:ai-agents stars:>300" "topic:generative-ai stars:>500" \
      "topic:machine-learning stars:>1000" "topic:rag stars:>300" \
      "llm in:name,description,topics created:>$new stars:>100" "agent in:name,description,topics created:>$new stars:>100"; do
      i=$((i + 1))
      curl -s --max-time 10 "${A[@]}" --get --data-urlencode "q=$q" -d sort=stars -d order=desc -d per_page=100 \
        -o "$T/$i.json" -w '%{http_code}' https://api.github.com/search/repositories > "$T/$i.code"
    done
    for n in $(seq "$i"); do [ -f "$T/$n.json" ] || echo "{}" > "$T/$n.json"; done
    ok=0; err=""
    for f in "$T"/[0-9]*.json; do
      c=$(cat "${f%.json}.code")
      if [ "$c" = 200 ] && jq -e '.items | type == "array"' "$f" > /dev/null 2>&1; then
        jq '.items' "$f" > "$f.i" && mv "$f.i" "$f"; ok=$((ok + 1))
      else
        case "$c" in 403|429) err="rate limited by GitHub";; 000) err="offline";; *) err="GitHub error $c";; esac
        echo '[]' > "$f"
      fi
    done
    if [ "$ok" = 0 ]; then
      jq -c --arg e "$err" '. + {error: $e}' "$OUT" 2>/dev/null || jq -nc --arg e "$err" '{error: $e, top: []}'
      exit 0
    fi
    [ "$ok" -lt "$i" ] || err=""
    jq -s 'add | unique_by(.full_name) | map({name: .full_name, url: .html_url, desc: ((.description // "") | .[0:120]), lang: (.language // ""), stars: .stargazers_count, created: .created_at})' "$T"/[0-9]*.json > "$T/docs.json"
    [ -f "$ST" ] || echo '{}' > "$ST"
    jq -c -n --argjson now "$now" --arg err "$err" --slurpfile d "$T/docs.json" --slurpfile s "$ST" '
      ($s[0] // {}) as $st | (if ($st.v // 0) >= 3 then $st else {repos: ($st.repos // {}), runs: ($st.runs // 0)} end) as $st |
      ($st.repos // {}) as $old |
      # Stars at time t from a [[t, stars]] history: the last point at or before t.
      def at($h; $t): [$h[] | select(.[0] <= $t)] | last;
      # Growth over the last w seconds, scaled to w when the nearest snapshot is a bit older.
      def grow($h; $s; $w): at($h; $now - $w) as $q |
        if $q == null or ($now - $q[0]) > $w * 1.5 then null else (($s - $q[1]) * $w / ($now - $q[0]) | round) end;
      def pct($g; $s): if $g == null or $s - $g <= 0 then null else $g / ($s - $g) * 100 end;
      ($d[0] | map({(.name): .}) | add) as $cur |
      # The market: stars gained per hour by repos present in both this and the last run.
      ([$cur | to_entries[] | select($old[.key].hist != null) | .value.stars - $old[.key].hist[-1][1]] | add // 0) as $delta |
      (($now - ($st.updated // $now)) / 3600) as $dh |
      (($old + ($cur | with_entries(
        .key as $k | ($old[$k] // {}) as $o | ($o.hist // []) as $h0 |
        .value += {
          hist: ((($h0 | map(select(.[0] > $now - 3 * 86400))) + [[$now, .value.stars]]) | sort_by(.[0]) | .[-300:]),
          seen: $now
        }))) | with_entries(select($now - .value.seen < 3 * 86400))) as $repos |
      ([$repos[] | select($now - .seen < 1800) | .hist as $h | (.stars - $h[0][1]) as $since | ($now - $h[0][0]) as $tf |
        (grow($h; .stars; 3600)) as $g1 | (grow($h; .stars; 21600)) as $g6 | (grow($h; .stars; 86400)) as $g24 |
        ((try (.created | fromdateiso8601) catch null) as $c | if $c then ($now - $c) / 86400 | floor else null end) as $age |
        {name, url, desc, lang, stars, age: $age,
         g1h: $g1, g6h: $g6, g24h: $g24, p1h: pct($g1; .stars), p6h: pct($g6; .stars), p24h: pct($g24; .stars),
         accel: (if $g6 != null and $g24 != null then $g6 / 6 - $g24 / 24 else null end),
         # Best guess at stars per day: the full day, else the last 6 hours, else what we have seen so far.
         rate: ($g24 // (if $g6 != null then $g6 * 4 else null end) // (if $tf >= 1800 then $since * 86400 / $tf else null end)),
         spark: (.hist | map(select(.[0] > $now - 86400)) | map(.[1]) | .[-16:])}]) as $e |
      (($st.agg // []) + (if $dh > 0 and $dh < 3 then [[$now, ($delta / $dh | round)]] else [] end) | .[-96:]) as $agg |
      {
        state: {v: 3, runs: (($st.runs // 0) + 1), updated: $now, agg: $agg,
                repos: $repos},
        out: {updated: $now, runs: (($st.runs // 0) + 1), error: (if $err == "" then null else $err end),
              tracked: ($e | length), warming: ($e | all(.g24h == null)), span: ([$repos[].hist[0][0]] | $now - min),
              full24: ($e | map(select(.g24h != null)) | length), full1: ($e | map(select(.g1h != null)) | length),
              total24h: ($e | map(.rate // 0) | add | round), totalStars: ($e | map(.stars) | add),
              perHour: $agg, top: ($e | sort_by(-(.rate // 0))),
              langs: ($e | map(select(.lang != "")) | group_by(.lang) | map({lang: .[0].lang, count: length, rate: (map(.rate // 0) | add)}) | sort_by(-.rate) | .[0:8])}
      }' > "$T/r.json" || { cat "$OUT"; exit 0; }
    jq -c '.state' "$T/r.json" > "$ST.tmp" && mv "$ST.tmp" "$ST"
    jq -c '.out' "$T/r.json" > "$OUT.tmp" && mv "$OUT.tmp" "$OUT"
    cat "$OUT"
  """) every 5m json timeout 90s

  source now = clock every 1m

  state win = 24 persist
  state metric = "abs" persist
  state lang = "" persist
  state query = ""
  state alerts = false persist
  state bookmarks = [] persist
  // The last #1 seen, so an alert only goes out when it really changes.
  state top1 = "" persist

  let items = data.top ?? []
  let keyWin = win == 1 ? "g1h" : win == 6 ? "g6h" : "g24h"
  let keyPct = win == 1 ? "p1h" : win == 6 ? "p6h" : "p24h"
  let winLabel = win == 1 ? "1h" : win == 6 ? "6h" : "24h"
  // Each repo's number for the chosen ranking. Until a full window has been observed it's
  // projected from its rate (the day so far), marked "~".
  let scored = items.map(r => {
    r: r,
    v: metric == "trend" ? r.accel : metric == "pct" ? (get(r, keyPct) ?? (r.rate != null && r.stars > r.rate * win / 24 ? r.rate * win / 24 / (r.stars - r.rate * win / 24) * 100 : null)) : (get(r, keyWin) ?? (r.rate == null ? null : r.rate * win / 24)),
    est: metric == "trend" ? false : get(r, metric == "pct" ? keyPct : keyWin) == null
  })
  let ranked = scored.filter(s => s.v != null).sortBy(s => -s.v) + scored.filter(s => s.v == null)
  let filtered = ranked.filter(s => (lang == "" || s.r.lang == lang) && (query == "" || contains(lower(s.r.name + " " + s.r.desc), lower(query))))
  let favourites = scored.filter(s => indexOf(bookmarks, s.r.name) >= 0).sortBy(s => indexOf(bookmarks, s.r.name) ?? 0)
  let shown = clamp((rows ?? 5) + 1, 3, 9)
  let leader = (data.warming ?? true) ? null : (first(items) ?? {}).name
  let age = data.updated == null ? 0 : (now ?? data.updated) - data.updated
  let note = data.error != null ? data.error : age > 1800 ? "updated ${fmtDuration(age)} ago" : data.warming ? "warming up · ${fmtDuration(data.span ?? 0)} of history" : null

  onTap: screen()
  // A new repo takes the top spot by stars per day.
  when alerts && leader != null && top1 != "" && leader != top1 { notify("AI stars: new #1", "${leader} now gains the most stars per day") }
  on leader { top1 = value ?? top1 }

  component Num(v, est = false, kind = "abs", size = 14) {
    Text {
      text: v == null ? "…" : (est ? "~" : "") + (kind == "trend" ? (v >= 0 ? "▲" : "▼") + fixed(abs(v), 1) + "/h" : kind == "pct" ? (v >= 0 ? "+" : "") + fixed(v, abs(v) < 10 ? 2 : 1) + "%" : (v >= 0 ? "+" : "-") + (abs(v) >= 10000 ? fixed(abs(v) / 1000, 0) + "k" : abs(v) >= 1000 ? fixed(abs(v) / 1000, 1) + "k" : str(round(abs(v)))))
      fontSize: size
      bold: !est
      color: v == null || est ? muted : kind == "trend" ? (v > 0 ? green : red) : v > 0 ? green : foreground
      align: end
      maxLines: 1
    }
  }


  // One repository in the full-screen lists: tap it to open on GitHub, tap ★ to pin it.
  component Repo(s, rank) {
    let r = s.r
    let marked = indexOf(bookmarks, r.name) >= 0
    let at = indexOf(bookmarks, r.name) ?? 0
    Row {
      gap: 8
      align: center
      padding: [4, 6]
      radius: 6
      background: marked ? alpha(accent, 0.08) : null
      onTap: url(r.url)
      Text { text: rank; style: label; color: rank == "1" || rank == "2" || rank == "3" ? accent : muted; width: 22; align: end; maxLines: 1 }
      Column {
        gap: 1
        weight: 1
        Row {
          gap: 6
          align: center
          Text { text: last(split(r.name, "/")); style: body; bold: true; maxLines: 1; weight: 1 }
          if r.age != null && r.age < 45 { Text { text: "NEW"; fontSize: 9; bold: true; color: background; background: accent; padding: [5, 1]; radius: 4; width: 34; align: center; maxLines: 1 } }
        }
        Text { text: first(split(r.name, "/")) + (r.lang != "" ? " · " + r.lang : "") + (r.age != null && r.age < 45 ? " · ${r.age}d old" : ""); style: label; color: muted; maxLines: 1 }
        if r.desc != "" { Text { text: r.desc; style: small; color: alpha(foreground, 0.75); maxLines: 1 } }
      }
      Sparkline { values: r.spark; color: (last(r.spark) ?? 0) > (first(r.spark) ?? 0) ? green : muted; min: min(r.spark); width: 48; height: 22 }
      Column {
        gap: 1
        width: 62
        Num { v: s.v; est: s.est; kind: metric }
        Text { text: "★" + (r.stars >= 1000 ? fixed(r.stars / 1000, r.stars >= 100000 ? 0 : 1) + "k" : str(r.stars)); style: label; color: muted; align: end; maxLines: 1 }
      }
      Text {
        text: marked ? "★" : "☆"
        fontSize: 20
        color: marked ? accent : alpha(muted, 0.8)
        width: 32
        align: center
        padding: [0, 6]
        onTap: bookmarks = marked ? bookmarks.take(at) + bookmarks.drop(at + 1) : bookmarks + [r.name]
      }
    }
  }

  Column {
    gap: 6
    Row {
      align: center
      gap: 6
      Text { text: "★ AI STARS"; style: label; bold: true; color: accent; weight: 1; maxLines: 1 }
      // Tap to step through the windows without opening the screen.
      Text {
        text: metric == "trend" ? "TREND" : (metric == "pct" ? "%" : "+") + upper(winLabel)
        style: label
        bold: true
        color: accent
        background: alpha(accent, 0.15)
        padding: [8, 3]
        radius: 8
        width: 58
        align: center
        maxLines: 1
        onTap: win = win == 24 ? 1 : win == 1 ? 6 : 24
      }
    }
    if data == null {
      Text { text: "fetching GitHub…"; style: small; color: muted; weight: 1 }
    } else if len(ranked) == 0 {
      Text { text: data.error ?? "no repos yet"; style: small; color: muted; weight: 1 }
    } else {
      Column {
        gap: 4
        weight: 1
        justify: spaceBetween
        for s, i in take(ranked, shown) key s.r.name {
          let marked = indexOf(bookmarks, s.r.name) >= 0
          Row {
            gap: 8
            align: center
            Text { text: "${i + 1}"; style: label; bold: i == 0; color: i == 0 ? accent : muted; width: 12; align: center; maxLines: 1 }
            Column {
              gap: 0
              weight: 1
              Text { text: (marked ? "★ " : "") + last(split(s.r.name, "/")); style: body; color: marked ? accent : foreground; maxLines: 1 }
              Text { text: (s.r.age != null && s.r.age < 45 ? "new · " : "") + "★" + (s.r.stars >= 1000 ? fixed(s.r.stars / 1000, s.r.stars >= 100000 ? 0 : 1) + "k" : str(s.r.stars)) + (s.r.lang != "" ? " · " + s.r.lang : ""); style: label; color: s.r.age != null && s.r.age < 45 ? accent : muted; maxLines: 1 }
            }
            if (cols ?? 3) >= 4 { Sparkline { values: s.r.spark; min: min(s.r.spark); color: (last(s.r.spark) ?? 0) > (first(s.r.spark) ?? 0) ? green : muted; width: 44; height: 18 } }
            Num { v: s.v; est: s.est; kind: metric; size: 12; width: 54 }
          }
        }
      }
      Text {
        text: note ?? "+" + ((data.total24h ?? 0) >= 1000 ? fixed(data.total24h / 1000, 1) + "k" : str(data.total24h)) + " ★/day · ${data.tracked} repos"
        style: label
        color: data.error != null ? red : note != null ? accent : muted
        maxLines: 1
      }
    }
  }

  screen {
    title: "AI STARS"
    Column {
      scroll: true
      gap: 14
      if data == null {
        Text { text: "fetching GitHub…"; style: body; color: muted }
      } else {
        // What to rank by, over which window, and which repos.
        Column {
          gap: 10
          fill: width
          background: alpha(muted, 0.1)
          padding: [12, 12]
          radius: 8
          Row {
            gap: 6
            align: center
            Text { text: "rank"; style: label; color: muted; width: 52; maxLines: 1 }
            Text { text: "stars"; style: small; color: (metric == "abs") ? background : foreground; background: (metric == "abs") ? accent : alpha(muted, 0.15); padding: [10, 5]; radius: 12; weight: 1; align: center; maxLines: 1; onTap: metric = "abs" }
            Text { text: "percent"; style: small; color: (metric == "pct") ? background : foreground; background: (metric == "pct") ? accent : alpha(muted, 0.15); padding: [10, 5]; radius: 12; weight: 1; align: center; maxLines: 1; onTap: metric = "pct" }
            Text { text: "trend"; style: small; color: (metric == "trend") ? background : foreground; background: (metric == "trend") ? accent : alpha(muted, 0.15); padding: [10, 5]; radius: 12; weight: 1; align: center; maxLines: 1; onTap: metric = "trend" }
          }
          if metric != "trend" {
            Row {
              gap: 6
              align: center
              Text { text: "window"; style: label; color: muted; width: 52; maxLines: 1 }
              Text { text: "1 hour"; style: small; color: (win == 1) ? background : foreground; background: (win == 1) ? accent : alpha(muted, 0.15); padding: [10, 5]; radius: 12; weight: 1; align: center; maxLines: 1; onTap: win = 1 }
              Text { text: "6 hours"; style: small; color: (win == 6) ? background : foreground; background: (win == 6) ? accent : alpha(muted, 0.15); padding: [10, 5]; radius: 12; weight: 1; align: center; maxLines: 1; onTap: win = 6 }
              Text { text: "24 hours"; style: small; color: (win == 24) ? background : foreground; background: (win == 24) ? accent : alpha(muted, 0.15); padding: [10, 5]; radius: 12; weight: 1; align: center; maxLines: 1; onTap: win = 24 }
            }
          }
          Flow {
            gap: 6
            Text { text: "all"; style: small; color: (lang == "") ? background : foreground; background: (lang == "") ? accent : alpha(muted, 0.15); padding: [10, 5]; radius: 12; width: 56; align: center; maxLines: 1; onTap: lang = "" }
            for l in data.langs ?? [] key l.lang {
              Text { text: "${l.lang} ${l.count}"; style: small; color: (lang == l.lang) ? background : foreground; background: (lang == l.lang) ? accent : alpha(muted, 0.15); padding: [10, 5]; radius: 12; width: (len(l.lang) + len(str(l.count)) + 1) * 7.4 + 26; maxLines: 1; onTap: lang = lang == l.lang ? "" : l.lang }
            }
          }
          Input { text: query; placeholder: "search name or description"; onChange: query = value; fill: width }
        }

        // The tracked universe at a glance.
        Row {
          gap: 8
          for st in [
            ["repos", "${data.tracked}", "tracked"],
            ["★ / day", ((data.total24h ?? 0) >= 1000 ? fixed(data.total24h / 1000, 1) + "k" : str(data.total24h)), data.warming ? "projected" : "last 24h"],
            ["history", fmtDuration(data.span ?? 0), "snapshots"]
          ] key st[0] {
            Column {
              gap: 2
              weight: 1
              padding: [10, 8]
              radius: 8
              background: alpha(muted, 0.08)
              Text { text: st[0]; style: label; color: muted; maxLines: 1 }
              Text { text: st[1]; style: title; color: st[0] == "★ / day" ? green : foreground; maxLines: 1 }
              Text { text: st[2]; fontSize: 11; color: muted; maxLines: 1 }
            }
          }
        }

        // Stars gained per hour across every tracked repo, one bar per sample.
        if len(data.perHour ?? []) > 1 {
          Column {
            gap: 6
            Row {
              Text { text: "STARS PER HOUR, ALL REPOS"; style: label; color: accent; bold: true; weight: 1; maxLines: 1 }
              Text { text: "now ${last(data.perHour)[1]}"; style: label; color: green; width: 90; align: end; maxLines: 1 }
            }
            Canvas {
              height: 110
              fill: width
              let pts = data.perHour
              let hi = max(max(pts.map(p => p[1])), 1)
              let bw = width / len(pts)
              for p, i in pts {
                rect(i * bw + 1, 96 - max(p[1], 0) / hi * 88, max(bw - 2, 1), max(max(p[1], 0) / hi * 88, 1), fill: i == len(pts) - 1 ? green : alpha(green, 0.45), radius: 1)
              }
              line(0, 96.5, width, 96.5, stroke: alpha(muted, 0.4), width: 1)
              text("${hi}/h", 0, 4, size: 10, color: muted)
              text(fmtTime(first(pts)[0], "HH:mm"), 0, 105, size: 10, color: muted)
              text("now", width, 105, size: 10, align: end, color: muted)
            }
          }
        }

        if len(favourites) > 0 && query == "" && lang == "" {
          Column {
            gap: 2
            Text { text: "★ PINNED"; style: label; color: accent; bold: true }
            for s in take(favourites, 12) key s.r.name {
              Repo { s: s; rank: "★" }
            }
          }
        }

        Column {
          gap: 2
          Row {
            align: end
            Text { text: "RANKING"; style: label; color: accent; bold: true; width: 72; maxLines: 1 }
            Text {
              text: (metric == "trend" ? "speeding up most, stars/hour" : metric == "pct" ? "biggest ${winLabel} gain, % of stars" : "most stars in ${winLabel}") + (lang != "" ? " · " + lang : "")
              style: small
              color: muted
              weight: 1
              align: end
              maxLines: 1
            }
          }
          if len(filtered) == 0 {
            Text { text: "nothing matches"; style: small; color: muted; padding: [0, 8] }
          }
          for s, i in take(filtered, 50) key s.r.name {
            Repo { s: s; rank: "${indexOf(ranked, s) + 1}" }
          }
        }

        // How the numbers are made, and what's going on right now.
        Column {
          gap: 4
          padding: [12, 10]
          radius: 8
          background: alpha(muted, 0.08)
          if note != null { Text { text: note; style: small; color: data.error != null ? red : accent } }
          Text {
            text: "Samples the most-starred AI repos on GitHub every few minutes while this page is open, and measures growth between samples. \"~\" marks a projection until a full window has been seen."            style: small
            color: muted
          }
          Text { text: "updated ${fmtTime(data.updated, "HH:mm")} · ${data.tracked} repos"; style: label; color: muted; maxLines: 1 }
          Row {
            gap: 8
            align: center
            Text { text: alerts ? "🔔 new #1 alerts on" : "🔕 alert on new #1"; style: small; color: (alerts) ? background : foreground; background: (alerts) ? accent : alpha(muted, 0.15); padding: [10, 5]; radius: 12; weight: 1; align: center; maxLines: 1; onTap: alerts = !alerts }
            Text { text: "↻ refresh"; style: small; color: (false) ? background : foreground; background: (false) ? accent : alpha(muted, 0.15); padding: [10, 5]; radius: 12; weight: 1; align: center; maxLines: 1; onTap: refresh() }
          }
        }
      }
    }
  }
}
