widget "spacex" {
  size: 3x4
  minSize: 3x3
  meta {
    description: "Upcoming SpaceX launches, booster landings, dockings and splashdowns, with the webcast when one is on."
    version: "1.0"
    license: "MIT"
    category: "world"
    owl: 5
  }

  // Launch Library 2.3.0. Detailed launches include the webcast links (list mode leaves them out).
  // No shell tools: http only, so the tile also works before Linux is installed.
  source now = clock every 1s
  source launches = http("https://ll.thespacedevs.com/2.3.0/launches/upcoming/?lsp__name=SpaceX&limit=5&mode=detailed&format=json") every 20m json timeout 20s status
  source events = http("https://ll.thespacedevs.com/2.3.0/events/upcoming/?search=SpaceX&limit=8&format=json") every 20m json timeout 20s status

  let months = ["january", "february", "march", "april", "may", "june", "july", "august", "september", "october", "november", "december"]
  let mon = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]

  // ISO-8601 UTC to Unix seconds. The launcher has fmtTime but no parser.
  let unix = iso => iso == null || iso == "" ? null : [match(str(iso), "(\\d+)-(\\d+)-(\\d+)T(\\d+):(\\d+):(\\d+)")].map(g => g == null ? null : {
    y: floor(num(g[0])) - (floor(num(g[1])) <= 2 ? 1 : 0),
    m: floor(num(g[1])),
    d: floor(num(g[2])),
    h: floor(num(g[3])),
    mi: floor(num(g[4])),
    s: floor(num(g[5]))
  }).map(p => p == null ? null : {
    era: floor((p.y >= 0 ? p.y : p.y - 399) / 400),
    y: p.y, m: p.m, d: p.d, h: p.h, mi: p.mi, s: p.s
  }).map(p => p == null ? null : {
    yoe: p.y - p.era * 400,
    doy: floor((153 * (p.m + (p.m > 2 ? -3 : 9)) + 2) / 5) + p.d - 1,
    era: p.era, h: p.h, mi: p.mi, s: p.s
  }).map(p => p == null ? null : {
    days: p.era * 146097 + (p.yoe * 365 + floor(p.yoe / 4) - floor(p.yoe / 100) + p.doy) - 719468,
    h: p.h, mi: p.mi, s: p.s
  }).map(p => p == null ? null : p.days * 86400 + p.h * 3600 + p.mi * 60 + p.s)[0]

  // Timeline offsets look like PT8M23S, PT8M23.5S, PT1H1M57S, -PT35M, P1DT2H or P0D.
  let dur = rel => rel == null || rel == "" ? 0 : [rel].map(rel => {
    sign: startsWith(rel, "-") ? -1 : 1,
    body: startsWith(rel, "-") ? sub(rel, 1, len(rel)) : rel
  }).map(p => {
    sign: p.sign,
    body: startsWith(p.body, "P") ? sub(p.body, 1, len(p.body)) : p.body
  }).map(p => p.sign * (
    (match(p.body, "(\\d+\\.\\d+|\\d+)D") != null ? num(match(p.body, "(\\d+\\.\\d+|\\d+)D")[0]) * 86400 : 0) +
    (match(p.body, "(\\d+\\.\\d+|\\d+)H") != null ? num(match(p.body, "(\\d+\\.\\d+|\\d+)H")[0]) * 3600 : 0) +
    (match(p.body, "(\\d+\\.\\d+|\\d+)M") != null ? num(match(p.body, "(\\d+\\.\\d+|\\d+)M")[0]) * 60 : 0) +
    (match(p.body, "(\\d+\\.\\d+|\\d+)S") != null ? num(match(p.body, "(\\d+\\.\\d+|\\d+)S")[0]) : 0)
  ))[0]

  // Prefer an X webcast. Otherwise the first video link, labeled by its host. No link means no button.
  let xCast = urls => ((urls ?? []).filter(v => contains(v.url ?? "", "x.com/") || contains(v.url ?? "", "twitter.com/")))
    .sortBy(v => v.type.name == "Official Webcast" ? 0 : 1).first()
  let castOf = urls => [urls].map(xCast)[0] ?? (urls ?? []).first()
  let hostOf = url => url == null || url == "" ? "" : contains(url, "x.com/") || contains(url, "twitter.com/") ? "X" : contains(url, "youtube.com") || contains(url, "youtu.be") ? "YouTube" : contains(url, "nasa.gov") ? "NASA" : [match(url, "://([^/]+)")].map(g => g == null ? "web" : replace(g[0], "www.", ""))[0]
  // Hour is a window, not a liftoff time, so it does not get a seconds countdown or a live state.
  let preciseOf = n => n == "Second" || n == "Minute"
  let missionOf = name => split(split(name ?? "", " | ").last() ?? "", " (")[0]
  let kindOf = n => n == "Press Event" ? "briefing" : n == "Static Fire" ? "static fire" : lower(n ?? "event")
  let leadOf = k => k == "docking" || k == "undocking" ? 90 * 60 : k == "splashdown" || k == "reentry" || k == "landing" ? 60 * 60 : k == "return" ? 5 * 60 : k == "briefing" ? 20 * 60 : 30 * 60
  let tailOf = k => k == "launch" ? 20 * 60 : k == "return" ? 8 * 60 : k == "docking" || k == "undocking" ? 40 * 60 : k == "splashdown" || k == "landing" || k == "reentry" ? 30 * 60 : k == "briefing" ? 70 * 60 : 30 * 60
  let tone = s => s == "Go" || s == "Success" ? green : s == "TBD" || s == "TBC" ? yellow : s == "Failure" || s == "Hold" ? red : s == "In Flight" ? orange : muted
  let away = s => s >= 86400 ? "${floor(s / 86400)}d ${floor((s % 86400) / 3600)}h" : s >= 3600 ? "${floor(s / 3600)}h ${pad(floor((s % 3600) / 60), 2, "0")}m" : s >= 600 ? "${floor(s / 60)}m" : s >= 60 ? "${floor(s / 60)}m ${pad(floor(s % 60), 2, "0")}s" : "${max(floor(s), 0)}s"
  let placeOf = s => trim(replace(replace(replace(split(s ?? "", ",")[0] ?? "", " SFB", ""), " SFS", ""), " AFB", ""))
  // Day, month and hour NETs are midnight or the top of the hour in UTC. fmtTime would show the day before, west of UTC.
  let utcWhen = e => [match(str(e.iso ?? ""), "(\\d+)-(\\d+)-(\\d+)T(\\d+)")].map(g => g == null ? null : {
    y: g[0],
    m: months[floor(num(g[1])) - 1] ?? "",
    mo: mon[floor(num(g[1])) - 1] ?? "",
    d: floor(num(g[2])),
    h: g[3]
  }).map(p => p == null ? "tbd" : e.prec == "Month" || e.prec == "Quarter" || e.prec == "Year" ? "${p.m} ${p.y}" : e.prec == "Hour" ? "no earlier than ${p.d} ${p.mo} ${p.y}, ${p.h}:00 utc" : "no earlier than ${p.d} ${p.mo} ${p.y}")[0]

  let ready = launches != null && events != null
  let launchRows = ready && launches.ok ? launches.out.results ?? [] : []
  let eventRows = ready && events.ok ? events.out.results ?? [] : []

  // One launch, plus a booster-return row when a landing is planned (about T+8m).
  let fromLaunch = launch => [launch].map(launch => {
    cast: [launch.vid_urls].map(castOf)[0],
    at: [launch.net].map(unix)[0],
    prec: launch.net_precision.name ?? "",
    land: (launch.timeline ?? []).filter(t => contains(t.type.abbrev ?? "", "Landing") && !contains(t.type.abbrev ?? "", "Burn")).last().relative_time,
    vehicle: launch.rocket.configuration.name ?? "",
    place: [launch.pad.location.name ?? ""].map(placeOf)[0],
    mission: [launch.name].map(missionOf)[0],
    status: launch.status.abbrev ?? "",
    id: launch.id,
    iso: launch.net,
    webcast: launch.webcast_live == true,
    stages: launch.rocket.launcher_stage ?? []
  }).map(f => {
    precise: [f.prec].map(preciseOf)[0],
    off: f.land != null ? [f.land].map(dur)[0] : 510,
    url: f.cast.url,
    start: [f.cast.start_time].map(unix)[0],
    at: f.at, iso: f.iso, prec: f.prec, vehicle: f.vehicle, place: f.place, mission: f.mission,
    status: f.status, id: f.id, webcast: f.webcast, stages: f.stages
  }).map(f => [{
    id: f.id,
    kind: "launch",
    title: f.mission ?? "launch",
    vehicle: f.vehicle,
    place: f.place,
    status: f.status,
    at: f.at,
    iso: f.iso,
    precise: f.precise,
    prec: f.prec,
    lead: ["launch"].map(leadOf)[0],
    tail: ["launch"].map(tailOf)[0],
    url: f.url,
    start: f.start,
    host: [f.url].map(hostOf)[0],
    webcast: f.webcast
  }] + f.stages.filter(s => f.precise && s.landing.attempt == true && f.off > 60 && !contains(lower(s.launcher.serial_number ?? "unknown"), "unknown")).map(s => {
    id: "${f.id}-${s.launcher.serial_number ?? s.id}",
    kind: "return",
    title: s.launcher.serial_number ?? "booster",
    vehicle: s.landing.type.abbrev ?? "booster",
    place: s.landing.location.abbrev ?? s.landing.location.name ?? "landing zone",
    status: f.status,
    at: f.at + f.off,
    iso: f.iso,
    precise: f.precise,
    prec: f.prec,
    lead: ["return"].map(leadOf)[0],
    tail: ["return"].map(tailOf)[0],
    url: f.url,
    start: null,
    host: [f.url].map(hostOf)[0],
    webcast: false
  }))[0]

  let fromEvent = ev => [ev].map(ev => {
    cast: [ev.vid_urls].map(castOf)[0],
    kind: [ev.type.name].map(kindOf)[0],
    at: [ev.date].map(unix)[0],
    precise: [ev.date_precision.name ?? ""].map(preciseOf)[0],
    prec: ev.date_precision.name ?? ""
  }).map(f => {
    id: "event-${ev.id}",
    kind: f.kind,
    title: replace(ev.name ?? "event", "SpaceX ", ""),
    vehicle: "",
    place: [ev.location ?? ""].map(placeOf)[0],
    status: f.precise ? "Set" : "TBD",
    at: f.at,
    iso: ev.date,
    precise: f.precise,
    prec: f.prec,
    lead: [f.kind].map(leadOf)[0],
    tail: [f.kind].map(tailOf)[0],
    url: f.cast.url,
    start: [f.cast.start_time].map(unix)[0],
    host: [f.cast.url].map(hostOf)[0],
    webcast: ev.webcast_live == true
  })[0]

  // lsp__name=SpaceX already limited the launches. search=SpaceX keeps splashdowns and undockings whose names omit those words.
  let raw = flatten((launchRows ?? []).map(fromLaunch)) + (eventRows ?? []).map(fromEvent)

  // Clock-independent fields. The 1s tick only fills in the countdown, the live flag and the hint.
  let scheduled = raw.filter(e => e.at != null).map(e => [e].map(e => {
    announced: e.start != null && e.precise && e.start <= e.at && e.at - e.start < 3 * 3600 ? e.start : null
  }).map(w => {
    open: w.announced != null ? w.announced : e.at - e.lead,
    close: e.at + e.tail,
    id: e.id, kind: e.kind, title: e.title, vehicle: e.vehicle, place: e.place, status: e.status,
    at: e.at, precise: e.precise, prec: e.prec, link: e.url, host: e.host, webcast: e.webcast,
    detail: join([e.vehicle, e.place].filter(s => s != null && s != ""), " · "),
    clock: e.precise ? lower(fmtTime(e.at, "EEE d MMM · HH:mm")) : [e].map(utcWhen)[0],
    feed: e.precise && e.url != null ? lower(fmtTime((w.announced != null ? w.announced : e.at - e.lead), "HH:mm")) : "",
    from: e.url != null ? lower(fmtTime((w.announced != null ? w.announced : e.at - e.lead), "EEE HH:mm")) : ""
  })[0]).sortBy(e => e.at)

  let items = scheduled.map(e => {
    id: e.id, kind: e.kind, title: e.title, vehicle: e.vehicle, place: e.place, status: e.status,
    at: e.at, precise: e.precise, prec: e.prec, open: e.open, close: e.close, link: e.link, host: e.host,
    detail: e.detail, clock: e.clock, feed: e.feed,
    live: e.link != null && e.precise && ((now >= e.open && now <= e.close) || (e.webcast && now >= e.open - 600 && now <= e.close)),
    when: !e.precise ? "tbd" : now >= e.at && now <= e.close ? "live" : [max(e.at - now, 0)].map(away)[0],
    hint: e.link == null ? "" : !e.precise ? "on ${e.host} once a time is set" : now >= e.open && now <= e.close ? "live on ${e.host}" : "on ${e.host} from ${e.from}",
    urgency: !e.precise ? muted : now >= e.at && now <= e.close ? red : e.at - now < 3600 ? orange : e.at - now < 6 * 3600 ? accent : foreground
  }).filter(e => e.precise ? e.close >= now : e.at >= now - 86400)

  let hero = items.first()
  let extraN = rows != null && rows < 4 ? 0 : clamp(rows == null ? 2 : rows - 2, 1, 4)
  let upcoming = items.drop(1).take(extraN)
  let notice = !ready ? "" : launches.ok != true && events.ok != true ? "schedule offline" : launches.ok != true ? "launches offline" : events.ok != true ? "events offline" : ""

  onTap: screen()

  component Rule() {
    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
  }

  component Activity(kind, title, when, detail, clock, live, link, host, tint) {
    Column {
      gap: 1
      padding: [0, 8]
      Row {
        gap: 8
        align: center
        Text { text: kind; style: label; color: accent; width: 78; maxLines: 1 }
        Column {
          gap: 0
          weight: 1
          Text { text: title; maxLines: 2 }
          Text { text: detail; style: small; color: muted; maxLines: 1 }
        }
        Text { text: when; style: small; color: tint; width: 72; align: end; maxLines: 1 }
      }
      Text { text: clock; style: small; color: muted; maxLines: 1 }
      if live {
        Button { text: host == "" ? "watch" : "watch on ${host}"; fill: width; onTap: url(link) }
      }
    }
  }

  Column {
    gap: 2
    if !ready {
      Text { text: "spacex"; style: label; color: accent }
      Spacer { weight: 1 }
      Text { text: "…"; style: title }
      Spacer { weight: 1 }
    } else if hero == null {
      Text { text: "spacex"; style: label; color: accent }
      Spacer { weight: 1 }
      Text { text: notice != "" ? notice : "nothing scheduled"; style: body; color: muted }
      Spacer { weight: 1 }
    } else {
      Row {
        align: center
        Text { text: "spacex"; style: label; color: accent; weight: 1; maxLines: 1 }
        Text { text: lower(hero.status); style: label; color: [hero.status].map(tone)[0]; width: 64; align: end; maxLines: 1 }
      }
      if notice != "" {
        Text { text: notice; style: small; color: yellow; maxLines: 1 }
      }
      Text { text: hero.when; fontSize: 30; color: hero.urgency; maxLines: 1 }
      Text { text: hero.title; style: title; maxLines: 2 }
      Text { text: "${hero.kind}${hero.place != "" ? " · " + hero.place : ""}"; style: small; color: muted; maxLines: 1 }
      Text { text: hero.clock; style: small; color: muted; maxLines: 1 }
      if hero.live {
        Spacer { height: 4 }
        Button { text: hero.host == "" ? "watch" : "watch on ${hero.host}"; fill: width; onTap: url(hero.link) }
      } else if hero.hint != "" {
        Text { text: hero.hint; style: small; color: muted; maxLines: 1 }
      }
      Spacer { weight: 1 }
      if len(upcoming) > 0 {
        Rule { }
        Spacer { height: 6 }
        for e in upcoming key e.id {
          Column {
            gap: 0
            padding: [0, 2]
            Row {
              align: center
              Text { text: e.kind; style: label; color: muted; weight: 1; maxLines: 1 }
              Text { text: e.when; style: small; color: e.urgency; width: 68; align: end; maxLines: 1 }
            }
            Text { text: e.kind == "return" ? "${e.title} · ${e.place}" : e.title; style: small; maxLines: 1 }
          }
        }
      }
    }
  }

  screen {
    title: "spacex"
    Column {
      scroll: true
      gap: 0
      Text { text: "launches, landings and returns"; style: label; color: muted }
      Spacer { height: 8 }
      if !ready {
        Text { text: "…"; style: title }
      } else if hero == null {
        Text { text: notice != "" ? notice : "nothing scheduled"; color: muted }
      } else {
        if notice != "" {
          Text { text: notice; style: small; color: yellow; maxLines: 1 }
          Spacer { height: 8 }
        }
        if items.any(e => e.live) {
          let on = items.find(e => e.live)
          Button { text: on.host == "" ? "watch ${on.kind}" : "watch ${on.kind} on ${on.host}"; fill: width; onTap: url(on.link) }
          Text { text: on.title; style: small; color: muted; maxLines: 1 }
          Spacer { height: 8 }
        }
        for e, i in items.take(12) key e.id {
          if i > 0 { Rule { } }
          Activity {
            kind: e.kind
            title: e.title
            when: e.when
            detail: e.detail
            clock: e.feed != "" ? "${e.clock} · ${e.host} ${e.feed}" : e.clock
            live: e.live
            link: e.link
            host: e.host
            tint: e.urgency
          }
        }
        Spacer { height: 12 }
        Text { text: "precise times are local · dates without a clock are utc · launch library"; style: small; color: muted; maxLines: 2 }
      }
    }
  }
}
