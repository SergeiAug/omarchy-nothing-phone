widget "coin flip" {
  meta {
    description: "A coin to toss: tap it and watch it tumble to heads or tails"
    version: "1.0"; license: "MIT"; category: "fun"
  }
  size: 3x3
  minSize: 2x2

  requires { pacman: ["coreutils"] }

  source now = clock every 1s
  state face = 1 persist        // 1 = heads, 2 = tails
  state flips = 0 persist
  state flipAt = -100           // Canvas time the toss began
  state flipNow = 0             // wall-clock second it began

  let heads = face == 1
  let label = heads ? "heads" : "tails"
  let flipping = flipNow > 0 && now - flipNow < 2

  Column {
    gap: 4
    Row {
      Text { text: "coin flip"; style: muted; weight: 1; maxLines: 1 }
      Text { text: "×${flips}"; style: small; color: muted; width: 48; align: end; maxLines: 1 }
    }

    Canvas {
      weight: 1
      fill: width
      onTap: {
        face = run("shuf -i 1-2 -n1")
        flips = flips + 1
        flipAt = time
        flipNow = now
      }

      // One toss: eases out over ~1.1 s with two full turns, landing on `face`.
      let dur = 1.1
      let since = time >= flipAt && now - flipNow < 10 ? time - flipAt : 1000
      let s = clamp(since / dur, 0, 1)
      let e = 1 - pow(1 - s, 3)
      let theta = e * 4 * pi                    // two turns; even multiple of pi at rest
      let w = abs(cos(theta))                   // squash to an edge when sideways
      let up = (floor(theta / pi + 0.5) % 2 == 0) ? heads : !heads

      let cx = width / 2
      let cy = height / 2
      let r = min(width, height) * 0.30
      let gold = mix(yellow, accent, 0.2)
      let lift = sin(s * pi) * r * 0.5

      // the shadow shrinks as the coin rises
      let sy = min(cy + r + 5, height - 2)
      scale(1, 0.32, cx, sy) {
        circle(cx, sy, r * (0.75 - 0.25 * sin(s * pi)), fill: alpha(#000000, 0.3))
      }

      translate(0, -lift) {
        scale(w, 1, cx, cy) {
          circle(cx, cy, r, fill: radial(cx - r * 0.35, cy - r * 0.35, r * 1.5,
            [mix(gold, foreground, 0.55), gold, mix(gold, background, 0.45)]))
          circle(cx, cy, r, stroke: mix(gold, background, 0.6), width: 2)
          // milled edge
          for i in range(24) {
            rotate(i * 15, cx, cy) {
              rect(cx - 1, cy - r + 1, 2, 3, fill: mix(gold, foreground, 0.35))
            }
          }
          // inner ring and rim light
          circle(cx, cy, r * 0.82, stroke: alpha(mix(gold, background, 0.45), 0.8), width: 1.5)
          arc(cx, cy, r * 0.92, -150, 120, stroke: alpha(foreground, 0.45), width: 1.5, cap: round)
          // embossed face
          text(up ? "H" : "T", cx, cy, size: r * 1.1, bold: true, align: center,
            color: mix(gold, background, 0.72))
        }
      }
    }

    Text {
      text: flipping ? "tossing…" : cols != null && cols < 3 ? label : "${label} · tap to toss"
      style: small
      align: center
      maxLines: 1
      color: flipping ? muted : heads ? yellow : foreground
    }
  }
}
