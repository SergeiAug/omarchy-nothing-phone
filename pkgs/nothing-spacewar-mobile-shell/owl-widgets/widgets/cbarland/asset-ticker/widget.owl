widget "asset ticker" {
  size: 6x3
  minSize: 3x2
  meta { owl: 6; description: "An editable Yahoo Finance watchlist for stocks, ETFs, crypto, forex, indices and futures, with monthly charts."; version: "1.2"; license: "MIT"; category: "world" }
  requires { pacman: ["python"] }
  state watchlist = "AAPL SPY BTC-USD EURUSD=X GC=F" persist
  padding: 8
  state chartRange = "1mo"
  state expanded = false
  state selected = "BTC-USD" persist
  source quotes = cmd("python -c " + sh("import concurrent.futures,json,sys,time,urllib.request,urllib.parse\nsymbols=list(dict.fromkeys(sys.argv[1].upper().replace(\",\",\" \").split()))[:12]\ndef fetch(symbol):\n    try:\n        def chart(span):\n            url=\"https://query1.finance.yahoo.com/v8/finance/chart/\"+urllib.parse.quote(symbol,safe=\"\")+\"?interval=1d&range=\"+span\n            req=urllib.request.Request(url,headers={\"User-Agent\":\"asset-ticker/1.2\"})\n            with urllib.request.urlopen(req,timeout=8) as response:\n                data=json.load(response)\n            return data[\"chart\"][\"result\"][0]\n        data=chart(\"1mo\")\n        meta=data[\"meta\"]\n        price=meta.get(\"regularMarketPrice\")\n        points=[p for p in data[\"indicators\"][\"quote\"][0][\"close\"] if p is not None]\n        previous=points[-2] if len(points) >= 2 else None\n        change=(price-previous)/previous*100 if price is not None and previous else None\n        return dict(symbol=symbol,name=meta.get(\"longName\",meta.get(\"shortName\",symbol)),price=price,currency=meta.get(\"currency\",\"\"),change=change,points=points,stamp=meta.get(\"regularMarketTime\"),kind=meta.get(\"instrumentType\",\"\"),exchange=meta.get(\"fullExchangeName\",meta.get(\"exchangeName\",\"\")),digits=min(max(meta.get(\"priceHint\",2),2),6),ok=price is not None)\n    except Exception:\n        return dict(symbol=symbol,ok=False,error=\"Quote unavailable; check symbol or connection\")\nwith concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:\n    items=list(pool.map(fetch,symbols))\nprint(json.dumps(dict(items=items,fetched=time.time())))\n") + " " + sh(watchlist)) every 5m json timeout 40s
  source now = clock every 1m
  state searchDraft = ""
  state searchQuery = ""
  state selectorTab = "find"
  source lookup = cmd("python -c " + sh("import json,sys,urllib.request,urllib.parse\nquery=sys.argv[1].strip()\ntry:\n    if query:\n        url=\"https://query1.finance.yahoo.com/v1/finance/search?\"+urllib.parse.urlencode(dict(q=query,quotesCount=12,newsCount=0,enableFuzzyQuery=\"false\"))\n        with urllib.request.urlopen(urllib.request.Request(url,headers={\"User-Agent\":\"asset-ticker/1.2\"}),timeout=10) as response:\n            quotes=json.load(response).get(\"quotes\",[])\n        items=[dict(symbol=q[\"symbol\"],name=q.get(\"longname\",q.get(\"shortname\",q[\"symbol\"])),kind=q.get(\"typeDisp\",q.get(\"quoteType\",\"\")),exchange=q.get(\"exchDisp\",q.get(\"exchange\",\"\"))) for q in quotes if q.get(\"isYahooFinance\") and q.get(\"quoteType\") in {\"EQUITY\",\"ETF\",\"CRYPTOCURRENCY\",\"CURRENCY\",\"INDEX\",\"FUTURE\",\"MUTUALFUND\"}]\n    else:\n        items=[dict(symbol=s,name=n,kind=k,exchange=e) for s,n,k,e in [(\"AAPL\",\"Apple Inc.\",\"Equity\",\"NASDAQ\"),(\"SPY\",\"SPDR S&P 500 ETF Trust\",\"ETF\",\"NYSE Arca\"),(\"BTC-USD\",\"Bitcoin USD\",\"Cryptocurrency\",\"USD\"),(\"ETH-USD\",\"Ethereum USD\",\"Cryptocurrency\",\"USD\"),(\"EURUSD=X\",\"EUR / USD\",\"Currency\",\"FX\"),(\"^GSPC\",\"S&P 500\",\"Index\",\"SNP\"),(\"GC=F\",\"Gold futures\",\"Futures\",\"COMEX\"),(\"CL=F\",\"Crude oil futures\",\"Futures\",\"NYMEX\")]]\n    print(json.dumps(dict(query=query,items=items,ok=True)))\nexcept Exception:\n    print(json.dumps(dict(query=query,items=[],ok=False,error=\"Search unavailable. Check your connection and try again.\")))\n") + " " + sh(searchQuery)) every 10m json timeout 15s
  let watched = unique(words(upper(watchlist.replace(",", " ")))).take(12)
  let matches = lookup.query == searchQuery ? lookup.items ?? [] : []
  let assets = quotes.items ?? []
  let active = find(assets, a => a.symbol == selected) ?? first(assets)
  source plot = cmd("python -c " + sh("import json,sys,urllib.request,urllib.parse\nsymbol,span=sys.argv[1:3]\ninterval={\"1d\":\"5m\",\"5d\":\"30m\",\"1mo\":\"1d\",\"1y\":\"1d\",\"5y\":\"1wk\"}[span]\ntry:\n    url=\"https://query1.finance.yahoo.com/v8/finance/chart/\"+urllib.parse.quote(symbol,safe=\"\")+\"?\"+urllib.parse.urlencode(dict(interval=interval,range=span))\n    with urllib.request.urlopen(urllib.request.Request(url,headers={\"User-Agent\":\"asset-ticker/1.2\"}),timeout=10) as response:\n        data=json.load(response)[\"chart\"][\"result\"][0]\n    points=[p for p in data[\"indicators\"][\"quote\"][0][\"close\"] if p is not None]\n    print(json.dumps(dict(symbol=symbol,span=span,points=points,ok=True)))\nexcept Exception:\n    print(json.dumps(dict(symbol=symbol,span=span,points=[],ok=False)))\n") + " " + sh(active.symbol ?? selected) + " " + sh(chartRange)) every 5m json timeout 20s
  let plotPoints = plot.symbol == active.symbol && plot.span == chartRange && plot.ok ? plot.points : []
  let tint = active.change == null ? muted : active.change >= 0 ? green : red
  component QuoteRow(a) {
    Row {
      gap: 5
      align: center
      padding: [4, 1]
      background: alpha(surface, 0.45)
      onTap: { selected = a.symbol; expanded = true; close() }
      Text { text: a.symbol; fontSize: 11; bold: true; weight: 1; maxLines: 1 }
      Column {
        width: 83
        gap: 0
        Text { text: a.ok ? fixed(a.price, a.digits) : "unavailable"; font: mono; fontSize: 11; align: end; maxLines: 1 }
        Text { text: a.change == null ? "—" : (a.change >= 0 ? "+" : "") + fixed(a.change, 2) + "%"; fontSize: 10; align: end; color: a.change == null ? muted : a.change >= 0 ? green : red; maxLines: 1 }
      }
    }
  }

  Column {
    fill: true
    gap: 4
    Row {
      align: center
      Text { text: expanded ? active.symbol : "ASSET TICKER"; style: label; color: accent; weight: 1; maxLines: 1 }
      Button { text: "↻"; onTap: refresh() }
      if expanded {
        Button { text: "view all"; onTap: expanded = false }
      } else {
        Button { text: "assets"; onTap: screen() }
      }
    }
    if expanded {
      Row {
        gap: 3
        for period in [{label: "1D", value: "1d"}, {label: "5D", value: "5d"}, {label: "1M", value: "1mo"}, {label: "1Y", value: "1y"}, {label: "5Y", value: "5y"}] {
          Button { text: period.label; color: chartRange == period.value ? accent : muted; onTap: { chartRange = period.value; refresh() } }
        }
      }
      if active.ok {
        Row {
          align: bottom
          Text { text: fixed(active.price, active.digits); fontSize: cols >= 5 ? 26 : 21; weight: 1; maxLines: 1 }
          Text { text: active.currency; style: label; color: muted; width: 35; align: end; maxLines: 1 }
        }
        Text { text: active.change == null ? "change unavailable" : (active.change >= 0 ? "+" : "") + fixed(active.change, 2) + "% vs previous close"; fontSize: 11; color: tint; maxLines: 1 }
        Sparkline { values: plotPoints; min: min(plotPoints) * 0.999; max: max(plotPoints) * 1.001; weight: 1; fill: width; color: tint; area: true }
        Text { text: chartRange + " · " + fmtTime(active.stamp, "MMM d HH:mm"); fontSize: 10; color: muted; maxLines: 1 }
      } else {
        Text { text: active.error ?? "loading quote…"; style: small; color: muted; weight: 1 }
      }
    } else {
      Column {
        weight: 1
        fill: width
        scroll: true
        gap: 0
        if quotes == null { Text { text: "loading quotes…"; style: small; color: muted } }
        Grid {
          columns: cols >= 5 ? 2 : 1
          gap: 3
          for a in assets key a.symbol { QuoteRow { a: a } }
        }
        if quotes != null && len(assets) == 0 { Text { text: "use edit to add symbols"; style: small; color: muted } }
      }
      Text { text: "Yahoo · " + (quotes.fetched == null ? "updating…" : fmtTime(quotes.fetched, "HH:mm")) + " · tap asset for plot"; fontSize: 10; color: muted; maxLines: 1 }
    }
  }

  screen {
    title: "choose assets"
    Column {
      fill: true
      gap: 10
      Row {
        Button { text: "find assets"; color: selectorTab == "find" ? accent : muted; onTap: selectorTab = "find" }
        Button { text: "watchlist " + len(watched) + "/12"; color: selectorTab == "list" ? accent : muted; onTap: selectorTab = "list" }
      }
      if selectorTab == "find" {
        Input {
          text: searchDraft
          placeholder: "Company, asset name or symbol"
          onChange: searchDraft = value
          onSubmit: { searchDraft = trim(value); searchQuery = trim(value); refresh() }
        }
        Row {
          Button { text: "search"; onTap: { searchQuery = trim(searchDraft); refresh() } }
          Button { text: "popular"; onTap: { searchDraft = ""; searchQuery = ""; refresh() } }
        }
        Text { text: searchQuery == "" ? "POPULAR ASSETS" : "MATCHES FOR “" + searchQuery + "”"; style: label; color: accent; maxLines: 2 }
        Text { text: "Check the name, asset type and exchange before adding. Crypto pairs include their quote currency."; style: small; color: muted }
        if len(watched) >= 12 { Text { text: "Watchlist full. Remove an asset in the watchlist tab to add another."; style: small; color: yellow } }
        Column {
          weight: 1
          scroll: true
          gap: 6
          if lookup == null || lookup.query != searchQuery {
            Text { text: "searching…"; style: body; color: muted }
          } else {
            if !lookup.ok { Text { text: lookup.error; style: body; color: muted } }
            if lookup.ok && len(matches) == 0 { Text { text: "No matching symbols. Try the company name, exact ticker, or another spelling."; style: body; color: muted } }
            for hit in matches key hit.symbol {
              Row {
                align: center
                padding: 10
                background: alpha(surface, 0.45)
                Column {
                  weight: 1
                  gap: 3
                  Text { text: hit.symbol; style: body; bold: true; color: accent; maxLines: 1 }
                  Text { text: hit.name; style: small; maxLines: 2 }
                  Text { text: hit.kind + " · " + hit.exchange; style: label; color: muted; maxLines: 2 }
                }
                if contains(watched, hit.symbol) {
                  Text { text: "added"; style: small; color: green; width: 58; align: end }
                } else {
                  if len(watched) < 12 {
                    Button { text: "+ add"; onTap: { watchlist = join(watched + [hit.symbol], " ") } }
                  } else {
                    Text { text: "full"; style: small; color: muted; width: 58; align: end }
                  }
                }
              }
            }
          }
        }
      } else {
        Text { text: "YOUR WATCHLIST · " + len(watched) + " of 12 assets"; style: label; color: accent }
        Text { text: "Tap an asset to open its plot. Remove frees a slot."; style: small; color: muted }
        Column {
          weight: 1
          scroll: true
          gap: 6
          if len(watched) == 0 { Text { text: "Find assets to build your watchlist."; style: body; color: muted } }
          for symbol in watched key symbol {
            let asset = find(assets, a => a.symbol == symbol)
            Row {
              align: center
              padding: 8
              background: alpha(surface, 0.45)
              Column {
                weight: 1
                onTap: { selected = symbol; expanded = true; close() }
                Text { text: symbol; style: body; bold: true; maxLines: 1 }
                Text { text: asset.name ?? (asset.error ?? "loading quote…"); style: small; color: muted; maxLines: 2 }
              }
              Button { text: "remove"; onTap: { watchlist = join(watched.filter(s => s != symbol), " "); expanded = false } }
            }
          }
        }
      }
      Button { text: "return to ticker"; onTap: { expanded = false; close() } }
      Text { text: "Yahoo Finance · quotes may be delayed"; style: label; color: muted }
    }
  }
}
