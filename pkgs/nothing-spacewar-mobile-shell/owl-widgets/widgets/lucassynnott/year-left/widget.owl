widget "year" {
  size: 3x4
  minSize: 2x2

  meta {
    description: "A grid of every day in the year, one dot each, so you can see how much of it is left at a glance."
    version: "1.0"
    license: "MIT"
    category: "time"
  }

  source now = clock every 1m

  let year = num(fmtTime(now, "yyyy"))
  let leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
  let total = leap ? 366 : 365
  let day = num(fmtTime(now, "D"))
  let left = total - day
  let pctLeft = round(left / total * 100)

  Box {
    Canvas {
      // bottom strip is reserved for the percentage label
      let labelH = 16
      let gw = width
      // leave a little breathing room above the label strip so the last row isn't clipped
      let gh = max(1, height - labelH - 8)

      // pick the column count that makes the dots as large as possible
      let cols = range(1, total + 1).sortBy(c => -min(gw / c, gh / ceil(total / c))).first()
      let nrows = ceil(total / cols)
      let cell = min(gw / cols, gh / nrows)
      let r = max(0.8, cell * 0.36)
      let ox = (gw - cell * cols) / 2
      let oy = (gh - cell * nrows) / 2

      for i in range(total) {
        let cx = ox + (i % cols + 0.5) * cell
        let cy = oy + (floor(i / cols) + 0.5) * cell
        if i < day - 1 {
          rect(cx - r, cy - r, r * 2, r * 2, fill: foreground)
        } else if i == day - 1 {
          let o = min(cell * 0.5, r + 1.5)
          rect(cx - r, cy - r, r * 2, r * 2, fill: foreground)
          rect(cx - o, cy - o, o * 2, o * 2, stroke: foreground, width: 1)
        } else {
          rect(cx - r, cy - r, r * 2, r * 2, fill: alpha(foreground, 0.16))
        }
      }

      text("${pctLeft}% left", 0, height - labelH / 2, size: 11, align: start, color: muted)
    }
  }
}
