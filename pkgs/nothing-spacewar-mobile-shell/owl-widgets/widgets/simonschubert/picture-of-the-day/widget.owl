widget "picture of the day" {
  meta { description: "Wikimedia Commons' picture of the day with its caption; tap to see the full image"; version: "1.1"; license: "MIT"; category: "fun" }
  size: 6x4
  minSize: 3x3
  padding: 0

  requires { pacman: ["curl", "jq"] }

  // Downloads each day's picture once into ~/.cache/potd and removes older ones.
  source pic = cmd("""
    c=~/.cache/potd
    mkdir -p "$c"
    day=$(date -u +%Y-%m-%d)
    info=$(curl -fsm 12 "https://api.wikimedia.org/feed/v1/wikipedia/en/featured/$(date -u +%Y/%m/%d)" | jq -c '.image') || exit
    [ "$info" = null ] && exit
    [ -s "$c/$day.jpg" ] || curl -fsm 30 -o "$c/$day.jpg" "$(jq -r .thumbnail.source <<< "$info")"
    find "$c" -name '*.jpg' ! -name "$day.jpg" -delete
    jq -c --arg path "$c/$day.jpg" '{
      path: $path, url: .file_page,
      caption: ((.description.text // (.title | sub("^File:"; "") | sub("\\.[A-Za-z]+$"; ""))) | gsub("<[^>]*>"; "")),
      artist: ((.artist.text // "") | gsub("<[^>]*>"; ""))
    }' <<< "$info"
  """) every 1h json timeout 60s

  onTap: url(pic.url ?? "https://commons.wikimedia.org/wiki/Commons:Picture_of_the_day")

  Box {
    fill: true
    align: bottom
    if pic.path != null { Image { src: pic.path; fit: cover; fill: true } }
    Column {
      fill: width
      gap: 0
      padding: [10, 6]
      background: alpha(background, 0.75)
      Text { text: pic.caption; fontSize: 12; maxLines: 2 }
      if pic.artist != "" && pic.artist != null { Text { text: pic.artist; fontSize: 10; color: muted; maxLines: 1 } }
    }
  }
}
