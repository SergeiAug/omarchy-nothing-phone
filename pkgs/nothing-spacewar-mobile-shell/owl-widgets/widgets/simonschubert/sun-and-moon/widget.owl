widget "sun and moon" {
  meta { description: "Sunrise, sunset, daylight left and tonight's moon phase, located by IP or a city you type, via wttr.in"; version: "1.2"; license: "MIT"; category: "world"; owl: 5 }
  size: 3x3
  minSize: 3x3

  requires { pacman: ["curl", "jq"] }

  state city = "" persist
  // The city, percent-encoded so it can't break the URL or the shell's single quotes. Empty means located by IP.
  let q = city.replace("%", "%25").replace("+", "%2B").replace("/", "%2F").replace("?", "%3F").replace("#", "%23").replace("&", "%26").replace("'", "%27").replace(" ", "+")
  // wttr.in gives local clock times ("07:14 AM"); date turns them into Unix time for today and tomorrow.
  source sky = cmd("""
    IFS=$'\t' read -r place rise set next phase illum < <(curl -fsm 12 'https://wttr.in/${q}?format=j1' | jq -r '[
      .nearest_area[0].areaName[0].value, (.weather[0].astronomy[0] | .sunrise, .sunset),
      .weather[1].astronomy[0].sunrise, (.weather[0].astronomy[0] | .moon_phase, .moon_illumination)
    ] | @tsv') || exit
    jq -nc --arg place "$place" --arg phase "$phase" \
      --argjson rise "$(date -d "today $rise" +%s)" --argjson set "$(date -d "today $set" +%s)" \
      --argjson next "$(date -d "tomorrow $next" +%s)" --argjson illum "$illum" \
      '{place: $place, rise: $rise, set: $set, next: $next, phase: $phase, illum: $illum}'
  """) every 1h json timeout 20s
  source now = clock every 60s
  let day = now >= sky.rise && now < sky.set
  let p = clamp((now - sky.rise) / (sky.set - sky.rise), 0, 1)
  let waxing = contains(sky.phase, "Waxing") || contains(sky.phase, "First")

  onTap: screen()

  Column {
    gap: 4
    Row {
      Text { text: "sun & moon"; style: muted; weight: 1 }
      Text { text: sky.place; fontSize: 10; color: muted; maxLines: 1; width: 72; align: end }
    }
    // The day as an arc from sunrise (left) to sunset (right).
    Canvas {
      weight: 1
      fill: width
      let cx = width / 2
      let cy = height - 4
      let r = min(width / 2 - 8, height - 12)
      let a = rad(-90 + 180 * p)
      line(4, cy, width - 4, cy, stroke: border, width: 1)
      arc(cx, cy, r, -90, 180, stroke: border, width: 2, cap: round)
      if day { arc(cx, cy, r, -90, 180 * p, stroke: yellow, width: 3, cap: round) }
      circle(cx + r * sin(a), cy - r * cos(a), day ? 7 : 5, fill: day ? yellow : muted)
    }
    Row {
      Text { text: "↑ ${fmtTime(now < sky.set ? sky.rise : sky.next, "HH:mm")}"; fontSize: 12; weight: 1 }
      Text { text: "↓ ${fmtTime(sky.set, "HH:mm")}"; fontSize: 12; width: 56; align: end }
    }
    Text {
      text: now < sky.rise ? "sunrise in ${fmtDuration(sky.rise - now)}" : day ? "${fmtDuration(sky.set - now)} of daylight left" : "sunrise in ${fmtDuration(sky.next - now)}"
      style: small; color: muted; maxLines: 1
    }
    Row {
      align: center
      // Lit part of the moon: the limb on one side, the terminator (an ellipse) on the other.
      Canvas {
        size: 22
        let r = 10
        let c = 11
        let s = waxing ? 1 : -1
        let f = num(sky.illum, 0) / 100
        let ys = range(21).map(i => -r + 2 * r * i / 20)
        circle(c, c, r, fill: surface, stroke: border, width: 1)
        path(ys.map(y => [c + s * sqrt(max(r * r - y * y, 0)), c + y]) + reverse(ys).map(y => [c + s * sqrt(max(r * r - y * y, 0)) * (1 - 2 * f), c + y]), closed: true, fill: foreground)
      }
      Text { text: "${lower(sky.phase)} · ${sky.illum}%"; fontSize: 11; maxLines: 1; weight: 1 }
    }
  }

  screen {
    title: "sun and moon"
    Input {
      text: city
      placeholder: "city · empty = auto"
      onSubmit: { city = trim(value); refresh() }
    }
    Text { text: sky == null ? "…" : lower(sky.place); style: small; color: muted }
  }
}
