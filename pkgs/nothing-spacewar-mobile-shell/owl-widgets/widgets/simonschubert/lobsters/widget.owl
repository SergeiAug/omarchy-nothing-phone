widget "lobsters" {
  meta { description: "The hottest stories on Lobsters with score, comments and tags; tap a story to read it"; version: "1.1"; license: "MIT"; category: "news" }
  size: 6x4
  minSize: 4x3

  requires { pacman: ["curl", "jq"] }

  source hot = cmd("""
    curl -fsm 10 'https://lobste.rs/hottest.json' | jq -c '.[:20] | [.[] | {
      id: .short_id, title, score, comments: .comment_count, tags: (.tags | join(" ")),
      url: (if .url == "" then .comments_url else .url end), discussion: .comments_url
    }]'
  """) every 15m json timeout 15s

  onTap: url("https://lobste.rs")

  Column {
    gap: 4
    Text { text: "lobsters"; style: muted; color: red }
    Column {
      scroll: true
      weight: 1
      gap: 6
      for s in hot key s.id {
        Column {
          gap: 0
          onTap: url(s.url)
          Text { text: s.title; fontSize: 13; maxLines: 2 }
          Row {
            gap: 6
            Text { text: "${s.score} pts"; fontSize: 10; color: muted; width: 48 }
            Text { text: "${s.comments} comments"; fontSize: 10; color: muted; width: 88; onTap: url(s.discussion) }
            Text { text: s.tags; fontSize: 10; color: accent; maxLines: 1; weight: 1; align: end }
          }
        }
      }
    }
  }
}
