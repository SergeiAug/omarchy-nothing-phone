widget "ifsc" {
  meta {
    owl: 5
    description: "IFSC Climbing World Cup: the next event with a countdown, the latest podiums, live results and the cup standings for boulder, lead and speed. Tap for everything"
    version: "1.0"
    license: "MIT"
    category: "world"
  }
  requires { pacman: ["curl", "jq"] }
  size: 6x4
  minSize: 3x3

  // The current season's World Cup calendar from ifsc.results.info (it only wants a
  // Referer), and the results of the latest event that has started: top 8 of each
  // category, with each climber's score from the last round they climbed. Flags are
  // fetched once into ~/.cache/ifsc-flags.
  source info = cmd("""
    g() { curl -fsm 15 --compressed -H 'Referer: https://ifsc.results.info/' "https://ifsc.results.info$1"; }
    lg=$(g /api/v1/ | jq -r '.current.leagues[] | select(.league_id == 1) | .url') || exit 1
    s=$(g "$lg") || exit 1
    ev=$(printf '%s' "$s" | jq -c --argjson now "$(date +%s)" '
      def t: sub(" UTC$"; "Z") | sub(" "; "T") | fromdateiso8601;
      def d: strptime("%Y-%m-%d") | strftime("%-d %b");
      { season, events: [.events[] | (.starts_at | t) as $a | (.ends_at | t) as $b | {
          id: .event_id,
          name: (.event | sub("^(World Climbing Series|IFSC World Cup|IFSC Climbing World Cup|IFSC) "; "") | sub(" [0-9]{4}$"; "")),
          full: .event, start: $a, end: $b,
          dates: (if .local_start_date == .local_end_date then (.local_start_date | d) else "\(.local_start_date | d) – \(.local_end_date | d)" end),
          kinds: ([.d_cats[].name | split(" ")[0] | ascii_downcase | select(. != "speed")] + [.d_cats[].name | select(test("^SPEED (Men|Women)")) | "speed"] | unique),
          cats: [.d_cats[] | select(.name | test("RELAY") | not) | {id, name, status}],
          state: (if $now >= $b or all(.d_cats[]; .status == "finished") then "done" elif $now >= $a then "live" else "next" end)
      }] | sort_by(.start) }') || exit 1
    lat=$(printf '%s' "$ev" | jq -c '[.events[] | select(.state != "next")] | last // empty')
    cats='[]'
    if [ -n "$lat" ]; then
      id=$(printf '%s' "$lat" | jq -r .id)
      cats=$(for c in $(printf '%s' "$lat" | jq -r '.cats[].id'); do g "/api/v1/events/$id/result/$c"; done | jq -sc '[.[] | {
        name: .dcat, short: (.dcat | split(" ") | "\(.[0] | ascii_downcase) \(.[1][0:1])"), kind: (.dcat | split(" ")[0] | ascii_downcase), status,
        round: ([.category_rounds[] | select(.status != null and .status != "pending")] | last | .name),
        top: [.ranking[:8][] | {rank, name: "\(.firstname) \(.lastname)", country,
          score: ([.rounds[] | select(.score != null and .score != "")] | last | .score // "" | tostring | split(" (")[0])}]
      } | select(.top | length > 0)]') || cats='[]'
    fi
    d=~/.cache/ifsc-flags; mkdir -p "$d"
    for f in $(printf '%s' "$cats" | jq -r '.[].top[].country | select(test("^[A-Z]{3}$"))' | sort -u); do
      [ -s "$d/$f.png" ] || curl -fsm 10 -o "$d/$f.png" "https://d1n1qj9geboqnb.cloudfront.net/flags/$f.png" || rm -f "$d/$f.png"
    done
    [ -n "$lat" ] || lat=null
    printf '%s' "$ev" | jq -c --argjson lat "$lat" --argjson cats "$cats" '. + {latest: (if $lat then $lat + {results: $cats} else null end)}'
  """) every 10m json timeout 120s

  // Cup standings, top 10 of each Olympic discipline.
  source cup = cmd("""
    g() { curl -fsm 15 --compressed -H 'Referer: https://ifsc.results.info/' "https://ifsc.results.info$1"; }
    lg=$(g /api/v1/ | jq -r '.current.leagues[] | select(.league_id == 1) | .url') || exit 1
    urls=$(g "$lg" | jq -r '.cups[0].d_cats[] | select(.name | test("^(BOULDER|LEAD|SPEED) (Men|Women)$")) | .ranking_url') || exit 1
    r=$(for u in $urls; do g "$u"; done | jq -sc '[.[] | {name: .dcat_name, short: (.dcat_name | split(" ") | "\(.[0] | ascii_downcase) \(.[1][0:1])"), kind: (.dcat_name | split(" ")[0] | ascii_downcase),
      top: [.ranking[:10][] | {rank, name: "\(.firstname) \(.lastname)", country, score: (.score | (tonumber? // .) | if type == "number" and . == floor then floor else . end | tostring)}]} | select(.top | length > 0)] | sort_by(.kind, (.name | test("Women")))') || exit 1
    d=~/.cache/ifsc-flags; mkdir -p "$d"
    for f in $(printf '%s' "$r" | jq -r '.[].top[].country | select(test("^[A-Z]{3}$"))' | sort -u); do
      [ -s "$d/$f.png" ] || curl -fsm 10 -o "$d/$f.png" "https://d1n1qj9geboqnb.cloudfront.net/flags/$f.png" || rm -f "$d/$f.png"
    done
    printf '%s\n' "$r"
  """) every 1h json timeout 120s

  source now = clock every 1m

  state tab = "results"
  state pick = 0

  let events = info.events ?? []
  let latest = info.latest
  let live = latest.state == "live"
  let upcoming = events.filter(e => e.state == "next")
  let next = first(upcoming)
  let results = latest.results ?? []
  let standings = cup ?? []
  let wide = (tileWidth ?? 0) >= 300
  // Lines below the divider: the latest winners first, then cup leaders if 2+ fit.
  let slots = max(2, (rows ?? 4) * 2 - 1)
  let shown = results.take(slots)
  let spare = slots - count(shown) - 1
  let leaders = spare >= 2 ? standings.take(spare) : []


  component Until(t, tint = foreground, fs = 12) {
    Text {
      text: t - now > 86400 ? "in ${ceil((t - now) / 86400)}d" : t > now ? "in ${fmtDuration(t - now)}" : "now"
      fontSize: fs; width: 64; align: end; color: tint; maxLines: 1
    }
  }

  component Flag(code, px = 14) {
    if code {
      Image { src: "~/.cache/ifsc-flags/${code}.png"; width: px * 1.5; height: px; fit: contain }
    } else {
      Box { width: px * 1.5; height: px }
    }
  }

  component Kinds(list) {
    Row {
      gap: 4
      for k in list ?? [] {
        Text { text: k; style: label; width: len(k) * 7 + 14; align: center; color: (k == "boulder" ? yellow : k == "lead" ? blue : k == "speed" ? red : accent); padding: [5, 1]; border: 1; borderColor: alpha((k == "boulder" ? yellow : k == "lead" ? blue : k == "speed" ? red : accent), 0.5) }
      }
    }
  }

  component Athlete(a, showScore = true) {
    Row {
      gap: 6
      align: center
      Text { text: a.rank; width: 18; style: small; align: end; bold: a.rank <= 3; color: a.rank == 1 ? yellow : a.rank == 2 ? foreground : a.rank == 3 ? orange : muted }
      Flag { code: a.country }
      Text { text: a.name; style: small; weight: 1; maxLines: 1 }
      if showScore {
        Text { text: a.score ?? ""; style: small; width: 64; align: end; color: muted; maxLines: 1 }
      }
    }
  }

  // One category's winner on the tile.
  component Winner(c) {
    let w = c.top[0]
    Row {
      gap: 6
      align: center
      Text { text: c.short; style: small; width: wide ? 72 : 60; color: (c.kind == "boulder" ? yellow : c.kind == "lead" ? blue : c.kind == "speed" ? red : accent); maxLines: 1 }
      Flag { code: w.country }
      Text { text: w.name; style: small; weight: 1; maxLines: 1 }
      if wide {
        Text {
          text: c.status == null ? "${w.score} pts" : c.status == "finished" ? (w.score ?? "") : (c.round ?? "live")
          style: small; width: 72; align: end; color: c.status == null || c.status == "finished" ? muted : accent; maxLines: 1
        }
      }
    }
  }

  component EventRow(e) {
    Row {
      gap: 8
      align: center
      Box { width: 3; height: 30; radius: 1.5; background: e.state == "live" ? accent : e.state == "next" ? alpha(foreground, 0.6) : alpha(muted, 0.4) }
      Column {
        gap: 0
        weight: 1
        Text { text: e.name; style: body; maxLines: 1; color: e.state == "done" ? muted : foreground }
        Text { text: e.dates; style: small; color: muted; maxLines: 1 }
      }
      Kinds { list: e.kinds }
      if e.state == "next" {
        Until { t: e.start }
      } else {
        Text { text: e.state == "live" ? "live" : "✓"; style: small; width: 64; align: end; color: e.state == "live" ? accent : muted }
      }
    }
  }

  onTap: screen()

  Column {
    gap: 6
    Row {
      align: center
      Text { text: "IFSC World Cup"; style: title; weight: 1; maxLines: 1 }
      Text { text: live ? "● live" : info.season ?? ""; style: small; width: 60; align: end; color: live ? accent : muted; bold: live }
    }

    // The next event (or the live one) up top.
    if live {
      Row {
        gap: 8; align: center
        Text { text: latest.name; style: body; weight: 1; maxLines: 1; color: accent }
        Kinds { list: latest.kinds }
      }
    } else if next != null {
      Row {
        gap: 8; align: center
        Column {
          gap: 0; weight: 1
          Text { text: "next · ${next.name}"; style: body; maxLines: 1 }
          Text { text: next.dates; style: small; color: muted; maxLines: 1 }
        }
        if wide { Kinds { list: next.kinds } }
        Until { t: next.start; tint: accent; fs: 15 }
      }
    } else if info != null {
      Text { text: "season over"; style: small; color: muted }
    }

    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }

    if latest != null {
      Text { text: "${live ? "now" : "last"} · ${latest.name}"; style: label; color: muted; maxLines: 1 }
      Column {
        gap: 3
        for c in shown { Winner { c: c } }
      }
      if count(leaders) > 0 {
        Spacer { height: 4 }
        Text { text: "cup leaders"; style: label; color: muted; maxLines: 1 }
        Column {
          gap: 3
          for c in leaders { Winner { c: c } }
        }
      }
    } else {
      Text { text: info == null ? "loading…" : "no results yet"; style: small; color: muted }
    }
  }

  screen {
    title: "IFSC World Cup ${info.season ?? ''}"
    Column {
      gap: 10
      Row {
        gap: 6
        Button { text: live ? "live" : "results"; weight: 1; color: tab == "results" ? accent : muted; onTap: tab = "results" }
        Button { text: "standings"; weight: 1; color: tab == "cup" ? accent : muted; onTap: { tab = "cup"; pick = 0 } }
        Button { text: "calendar"; weight: 1; color: tab == "calendar" ? accent : muted; onTap: tab = "calendar" }
      }

      Column {
        weight: 1
        scroll: true
        gap: 6

        if tab == "results" {
          if latest == null {
            Text { text: "no results yet"; style: small; color: muted }
          } else {
            Text { text: latest.full; style: title; maxLines: 2 }
            Row {
              gap: 8; align: center
              Text { text: latest.dates; style: small; color: muted; weight: 1 }
              if live { Text { text: "● live"; style: small; color: accent; bold: true; width: 60; align: end } }
            }
            for c in results {
              Spacer { height: 6 }
              Row {
                align: center
                Text { text: lower(c.name); style: label; color: (c.kind == "boulder" ? yellow : c.kind == "lead" ? blue : c.kind == "speed" ? red : accent); weight: 1 }
                Text { text: c.status == "finished" ? "final" : (c.round ?? c.status); style: small; color: c.status == "finished" ? muted : accent; width: 110; align: end; maxLines: 1 }
              }
              for a in c.top key a.name { Athlete { a: a } }
            }
            Spacer { height: 6 }
            Button { text: "full results on ifsc.results.info"; onTap: url("https://ifsc.results.info/event/${latest.id}") }
          }
        } else if tab == "cup" {
          Flow {
            gap: 6
            for s, i in standings {
              Button { text: s.short; color: pick == i ? (s.kind == "boulder" ? yellow : s.kind == "lead" ? blue : s.kind == "speed" ? red : accent) : muted; onTap: pick = i }
            }
          }
          let s = standings[pick]
          if s == null {
            Text { text: cup == null ? "loading…" : "no standings yet"; style: small; color: muted }
          } else {
            Text { text: lower(s.name); style: title; color: (s.kind == "boulder" ? yellow : s.kind == "lead" ? blue : s.kind == "speed" ? red : accent) }
            for a in s.top key a.name { Athlete { a: a } }
          }
        } else {
          for e in events key e.id { EventRow { e: e } }
        }
      }

      Button { text: "close"; onTap: close() }
    }
  }
}
