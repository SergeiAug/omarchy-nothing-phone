widget "xkcd" {
  meta { description: "The latest xkcd comic with its title and alt text; tap to open it"; version: "1.1"; license: "MIT"; category: "fun" }
  size: 6x5
  minSize: 3x3

  requires { pacman: ["curl", "jq"] }

  // Downloads the image once per comic into ~/.cache/xkcd and removes older ones.
  source comic = cmd("""
    c=~/.cache/xkcd
    mkdir -p "$c"
    info=$(curl -fsm 10 https://xkcd.com/info.0.json) || exit
    num=$(jq -r .num <<< "$info")
    [ -s "$c/$num.png" ] || curl -fsm 20 -o "$c/$num.png" "$(jq -r .img <<< "$info")"
    find "$c" -name '*.png' ! -name "$num.png" -delete
    jq -c --arg path "$c/$num.png" '{num, title: .safe_title, alt, path: $path}' <<< "$info"
  """) every 1h json timeout 40s

  onTap: url("https://xkcd.com/${comic.num}")

  Column {
    gap: 4
    Row {
      Text { text: comic.title; style: body; bold: true; maxLines: 1; weight: 1 }
      Text { text: "#${comic.num}"; style: muted; width: 56; align: end }
    }
    if comic.path != null { Image { src: comic.path; fit: contain; fill: width; weight: 1 } }
    Text { text: comic.alt; style: small; color: muted; maxLines: 3 }
  }
}
