widget "calendar" {
  meta { description: "This month's calendar with today highlighted"; version: "1.1"; license: "MIT"; category: "productivity" }
  size: 3x3
  source now = clock every 60s
  // Date math with only fmtTime: first weekday of the month, days in the month.
  let day = num(fmtTime(now, "d"))
  let first = now - (day - 1) * 86400
  let offset = num(fmtTime(first, "e")) - 1
  let days = 32 - num(fmtTime(first + 31 * 86400, "d"))
  Column {
    gap: 4
    Text { text: fmtTime(now, "MMMM yyyy"); style: small; color: accent }
    Grid {
      columns: 7
      gap: 2
      for d in ["M", "T", "W", "T", "F", "S", "S"] { Text { text: d; fontSize: 9; color: muted; align: center } }
      for i in range(offset + days) {
        Text {
          text: i < offset ? "" : str(i - offset + 1)
          fontSize: 10; align: center
          color: i - offset + 1 == day ? background : foreground
          background: i - offset + 1 == day ? accent : transparent
        }
      }
    }
  }
}
