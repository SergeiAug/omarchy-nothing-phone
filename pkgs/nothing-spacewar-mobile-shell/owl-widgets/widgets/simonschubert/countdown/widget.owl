widget "countdown" {
  meta { description: "Days until the dates listed in ~/.config/omarchy-proot/countdown, soonest first"; version: "1.1"; license: "MIT"; category: "productivity" }
  size: 3x3
  minSize: 3x2

  // "2026-12-24 christmas" per line; the file starts with the next new year.
  // Prints "epoch label" per line and lets the clock do the counting.
  source dates = cmd("""
    f=~/.config/omarchy-proot/countdown
    mkdir -p "${f%/*}"
    [ -f "$f" ] || echo "$(( $(date +%Y) + 1 ))-01-01 new year" > "$f"
    grep -v '^#' "$f" | while read -r day label; do
      t=$(date -d "$day" +%s 2>/dev/null) && echo "$t ${label:-$day}"
    done
  """) every 1h
  source now = clock every 60s
  let events = lines(dates).filter(l => l != "").map(l => { at: num(words(l)[0]), label: sub(l, len(words(l)[0]) + 1) }).filter(e => e.at > now - 86400).sortBy(e => e.at)

  onTap: terminal('$EDITOR ~/.config/omarchy-proot/countdown', "countdown")

  Column {
    gap: 6
    Text { text: "countdown"; style: muted }
    for e, i in events.take(4) key e.label {
      let days = ceil((e.at - now) / 86400)
      Row {
        align: bottom
        Text { text: days <= 0 ? "today" : "${days}d"; fontSize: i == 0 ? 22 : 14; color: i == 0 ? accent : foreground; width: 64 }
        Text { text: e.label; fontSize: 12; maxLines: 1; weight: 1 }
      }
    }
  }
}
