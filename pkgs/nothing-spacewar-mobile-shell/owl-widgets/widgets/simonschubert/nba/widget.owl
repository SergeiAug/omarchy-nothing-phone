widget "nba" {
  meta {
    owl: 5
    description: "NBA scores from ESPN with team logos: live games first, then last night's finals and today's tip-offs. Tap for every game and both conference standings"
    version: "1.0"
    license: "MIT"
    category: "world"
  }
  requires { pacman: ["curl", "jq"] }
  page: 1
  order: 45
  size: 6x4
  minSize: 3x3

  // ESPN's scoreboard answers one day at a time: yesterday, today and tomorrow,
  // trimmed to what the tile shows. Logos are referred to by file name, kept to
  // [a-z0-9].png.
  source games = cmd("""
    u=https://site.api.espn.com/apis/site/v2/sports/basketball/nba/scoreboard
    for i in -1 0 1; do
      curl -fsm 10 --compressed "$u?dates=$(date -d "$i day" +%Y%m%d)"
    done | jq -sc '[.[].events[] | .competitions[0] as $c | {
      id, at: (.date[0:16] + ":00Z" | fromdateiso8601),
      state: $c.status.type.state, detail: $c.status.type.shortDetail,
      teams: [$c.competitors[] | {
        side: .homeAway, abbr: .team.abbreviation, name: .team.shortDisplayName, score, winner: (.winner // false),
        logo: ((.team.logo // "") | sub(".*/"; "") | if test("^[a-z0-9]+[.]png$") then . else "" end)
      }]
    }] | unique_by(.id) | sort_by(.at)'
  """) every 5m json timeout 60s

  // Standings by conference, in seed order, with each team's logo fetched once
  // into ~/.cache/espn-logos, at 96 px, and left there.
  source table = cmd("""
    d=~/.cache/espn-logos/nba
    mkdir -p "$d"
    t=$(curl -fsm 20 --compressed https://site.api.espn.com/apis/v2/sports/basketball/nba/standings | jq -c '[.children[] | {
      name: .abbreviation, teams: [.standings.entries[] | (reduce .stats[] as $s ({}; .[$s.name] = $s)) as $st | {
        id: .team.id, abbr: .team.abbreviation, name: .team.shortDisplayName,
        logo: ((.team.logos[0].href // "") | sub(".*/"; "") | if test("^[a-z0-9]+[.]png$") then . else "" end),
        seed: ($st.playoffSeed.value // 99 | floor), rec: ($st.overall.displayValue // "" | split(", ")[0]),
        b: $st.gamesBehind.displayValue
      }] | sort_by(.seed)
    }]') || exit 1
    for f in $(printf '%s' "$t" | jq -r '.[].teams[].logo | select(. != "")'); do
      [ -s "$d/$f" ] || curl -fsm 15 -o "$d/$f" "https://a.espncdn.com/combiner/i?img=/i/teamlogos/nba/500/$f&w=96&h=96" || rm -f "$d/$f"
    done
    printf '%s\n' "$t"
  """) every 30m json timeout 120s
  source now = clock every 1m

  state view = "scores"

  let all = games ?? []
  let live = all.filter(g => g.state == 'in')
  let done = all.filter(g => g.state == 'post').reverse()
  let next = all.filter(g => g.state == 'pre')
  let cap = clamp((rows ?? 4) * 3 - 2, 5, 14)
  let picked = flatten([live, done.take(ceil(cap / 2)), next]).take(cap)
  let groups = table ?? []
  let wide = max(max(screenWidth ?? 0, tileWidth ?? 0), 240) >= 280
  // A line under the last playoff seed, and under the play-in.
  let cuts = [6, 10]
  let bLabel = "GB"

  component Badge(logo, px = 18) {
    if logo {
      Image { src: "~/.cache/espn-logos/nba/${logo}"; size: px; fit: contain }
    } else {
      Box { size: px }
    }
  }

  component GameRow(g) {
    let away = g.teams.find(t => t.side == 'away') ?? g.teams[1]
    let home = g.teams.find(t => t.side == 'home') ?? g.teams[0]
    let live = g.state == 'in'
    let final = g.state == 'post'
    let px = wide ? 18 : 14
    let scW = wide ? 30 : 24
    let dotW = wide ? 8 : 6
    let stW = wide ? 104 : 40
    let ctrW = 2 * scW + 2 * dotW + stW

    // Away on the left, at home on the right; the centre keeps one width so the
    // logos and names line up down the list.
    Row {
      gap: wide ? 8 : 4
      Badge { logo: away.logo; px: px }
      Text { text: wide ? away.name : away.abbr; style: small; weight: 1; maxLines: 1; color: final && !away.winner ? muted : foreground }
      if g.state == 'pre' {
        Text { text: fmtTime(g.at, wide ? "EEE HH:mm" : "HH:mm"); style: small; width: ctrW; align: center; color: muted; maxLines: 1 }
      } else {
        Row {
          width: ctrW; gap: 0; align: center
          Text { text: away.score ?? '–'; style: small; width: scW; align: end; bold: final && away.winner; color: live ? accent : final && !away.winner ? muted : foreground }
          Box { width: dotW; height: 5; radius: 2.5; background: live ? accent : rgb(0, 0, 0, 0) }
          Text { text: g.detail; style: small; width: stW; align: center; color: live ? accent : muted; maxLines: 1 }
          Box { width: dotW }
          Text { text: home.score ?? '–'; style: small; width: scW; align: start; bold: final && home.winner; color: live ? accent : final && !home.winner ? muted : foreground }
        }
      }
      Text { text: wide ? home.name : home.abbr; style: small; weight: 1; maxLines: 1; align: end; color: final && !home.winner ? muted : foreground }
      Badge { logo: home.logo; px: px }
    }
  }

  component TeamRow(t) {
    Row {
      gap: 6
      Text { text: t.seed < 99 ? t.seed : '–'; width: 20; style: small; color: muted; align: end }
      Badge { logo: t.logo; px: 16 }
      Text { text: wide ? t.name : t.abbr; weight: 1; style: small; maxLines: 1 }
      Text { text: t.rec; width: 56; style: small; bold: true; align: end }
      Text { text: t.b ?? '–'; width: 36; style: small; color: muted; align: end }
    }
  }

  component Standings() {
    for grp in groups {
      Row {
        Text { text: grp.name; style: label; color: muted; weight: 1 }
        Text { text: bLabel; style: label; color: muted; width: 36; align: end }
      }
      for t, i in grp.teams key t.id {
        if i > 0 && cuts.contains(i) { Box { height: 7; fill: width  Row { width: 32; height: 1; background: border } } }
        TeamRow { t: t }
      }
    }
  }

  onTap: screen()

  Column {
    Row {
      Text { text: "NBA"; style: title; weight: 1; maxLines: 1 }
      if count(live) > 0 {
        Text { text: "${count(live)} live"; style: small; color: accent; width: 60; align: end; bold: true }
      } else {
        Text { text: fmtTime(now, "EEE d"); style: small; color: muted; width: 60; align: end }
      }
    }
    Row {
      Button { text: "scores"; weight: 1; color: view == "scores" ? accent : muted; onTap: view = "scores" }
      Button { text: "standings"; weight: 1; color: view == "standings" ? accent : muted; onTap: view = "standings" }
    }
    Column {
      weight: 1
      scroll: true
      if view == "scores" {
        if count(picked) == 0 {
          Text { text: games == null ? "loading…" : "no games today"; style: small; color: muted }
        } else {
          for g in picked key g.id { GameRow { g: g } }
        }
      } else {
        Standings {}
      }
    }
  }

  screen {
    title: "NBA"
    Column {
      scroll: true
      Text { text: "scores"; style: title }
      if count(all) == 0 { Text { text: "no games today"; style: small; color: muted } }
      for g in all key g.id { GameRow { g: g } }
      Text { text: "standings"; style: title }
      Standings {}
      Button { text: "close"; onTap: close() }
    }
  }
}
