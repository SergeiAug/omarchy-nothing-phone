widget "notifications" {
  size: 3x4
  minSize: 3x3
  requires { pacman: [] }
  meta { description: "Your phone's notifications on the home screen, newest first, with a count per app. Tap one to open it, × to dismiss it; tap the tile for all of them by app"; version: "1.0"; license: "MIT"; category: "productivity"; owl: 5 }

  // {available, count, items: [{key, app, package, title, text, time, clearable}]}, newest first,
  // without ongoing ones (music, downloads) and group headers. Needs notification access.
  source n = android.notifications
  source now = clock every 1m

  let items = n.items ?? []
  let allowed = n == null || n.available != false
  let apps = items.map(i => i.app).unique().map(a => {app: a, count: count(items, i => i.app == a)})
  // A row is ~46dp, the header and app chips ~56dp.
  let visible = items.take(tileHeight == null ? 3 : clamp(floor((tileHeight - 64) / 46), 1, 12))
  let palette = [accent, blue, magenta, cyan, green, orange, yellow, red]

  onTap: screen()

  component Dot(app, d = 22) {
    Box {
      size: d
      radius: d / 2
      background: alpha(palette[len(app) % 8], 0.22)
      align: center
      Text { text: upper(sub(app, 0, 1)); fontSize: d * 0.5; bold: true; color: palette[len(app) % 8]; align: center }
    }
  }

  component Item(i, now, full = false) {
    Row {
      align: top
      gap: 8
      onTap: notification("open", i.key)
      Dot { app: i.app }
      Column {
        weight: 1
        gap: 0
        let age = now - i.time
        Text { text: "${lower(i.app)} · ${age < 60 ? "now" : age < 3600 ? "${floor(age / 60)}m" : age < 86400 ? "${floor(age / 3600)}h" : "${floor(age / 86400)}d"}"; style: label; color: muted; maxLines: 1 }
        if i.title != "" {
          Text { text: i.title; style: small; bold: true; maxLines: 1 }
        }
        if i.text != "" {
          Text { text: i.text; style: small; color: full ? foreground : muted; maxLines: full ? 4 : 1 }
        }
      }
      if i.clearable == true {
        Box {
          size: 24
          align: center
          onTap: notification("dismiss", i.key)
          Text { text: "󰅖"; font: icon; fontSize: 14; color: muted; align: center }
        }
      }
    }
  }

  Column {
    gap: 8
    Row {
      align: center
      Text { text: "notifications"; style: muted; weight: 1 }
      if len(items) > 0 {
        Text { text: "${n.count}"; style: label; bold: true; color: accent; background: alpha(accent, 0.2); padding: [7, 1]; radius: 9; align: center; width: len("${n.count}") * 7 + 16 }
      }
    }
    if !allowed {
      Text { text: "Allow notification access to see them here. Tap to open the setting."; style: small; maxLines: 4; onTap: notification("open", "") }
    } else {
      if n == null {
        Text { text: "loading…"; style: small; color: muted }
      } else {
        if len(items) == 0 {
          Column {
            weight: 1
            align: center
            justify: center
            gap: 4
            Text { text: "󰄬"; font: icon; fontSize: 28; color: green; align: center }
            Text { text: "all caught up"; style: small; color: muted; align: center }
          }
        } else {
          if len(apps) > 1 {
            Flow {
              gap: 4
              for a in apps.take(4) key a.app {
                Text { text: "${lower(a.app)} ${a.count}"; style: label; color: palette[len(a.app) % 8]; background: alpha(palette[len(a.app) % 8], 0.15); padding: [6, 1]; radius: 8; maxLines: 1; align: center; width: min(len("${lower(a.app)} ${a.count}") * 6.7 + 12, 150) }
              }
            }
          }
          Column {
            gap: 10
            for i in visible key i.key {
              Item { i: i; now: now }
            }
          }
          if len(items) > len(visible) {
            Text { text: "+${len(items) - len(visible)} more"; style: label; color: muted }
          }
        }
      }
    }
  }

  screen {
    title: "notifications"
    Column {
      scroll: true
      gap: 12
      if len(items) == 0 {
        Text { text: "all caught up"; style: body; color: muted }
      }
      for a in apps key a.app {
        Column {
          gap: 10
          Row {
            align: center
            gap: 8
            Dot { app: a.app; d: 26 }
            Text { text: a.app; style: body; bold: true; weight: 1; maxLines: 1 }
            Text { text: "${a.count}"; style: label; color: muted; width: 32; align: end }
          }
          for i in items.filter(x => x.app == a.app) key i.key {
            Item { i: i; now: now; full: true }
          }
          Spacer { height: 1; fill: width; background: alpha(muted, 0.2) }
        }
      }
      Spacer { height: 12 }
    }
  }
}
