widget "hacker news" {
  meta { description: "The Hacker News front page with points and comments; tap a story to read it"; version: "1.1"; license: "MIT"; category: "news" }
  size: 6x4
  minSize: 4x3

  requires { pacman: ["curl", "jq"] }

  source hn = cmd("""
    curl -fsm 10 'https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=15' | jq -c '[.hits[] | {
      id: .objectID, title, points, comments: (.num_comments // 0),
      url: (.url // "https://news.ycombinator.com/item?id=\(.objectID)"),
      site: ((.url // "") | sub("^https?://(www\\.)?"; "") | split("/")[0])
    }]'
  """) every 15m json timeout 15s

  onTap: url("https://news.ycombinator.com")

  Column {
    gap: 4
    Text { text: "hacker news"; style: muted; color: orange }
    Column {
      scroll: true
      weight: 1
      gap: 6
      for s in hn key s.id {
        Column {
          gap: 0
          onTap: url(s.url)
          Text { text: s.title; fontSize: 13; maxLines: 2 }
          Row {
            gap: 6
            Text { text: "${s.points} pts"; fontSize: 10; color: muted; width: 56 }
            Text { text: "${s.comments} comments"; fontSize: 10; color: muted; width: 96; onTap: url("https://news.ycombinator.com/item?id=${s.id}") }
            Text { text: s.site; fontSize: 10; color: muted; maxLines: 1; weight: 1; align: end }
          }
        }
      }
    }
  }
}
