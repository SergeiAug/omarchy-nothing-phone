widget "wikipedia" {
  meta { description: "Wikipedia's featured article of the day, what everyone is reading, and on this day in history"; version: "1.1"; license: "MIT"; category: "news" }
  size: 6x4
  minSize: 4x3

  requires { pacman: ["curl", "jq"] }

  // Wikimedia's daily feed for English Wikipedia; only the parts drawn are kept.
  source wp = cmd("""
    curl -fsm 12 "https://api.wikimedia.org/feed/v1/wikipedia/en/featured/$(date -u +%Y/%m/%d)" | jq -c '{
      tfa: (.tfa // null | if . then {title: .titles.normalized, text: .extract, url: .content_urls.mobile.page} else null end),
      read: [(.mostread.articles // [])[] | select(.namespace.id == 0) | {title: .titles.normalized, views, url: .content_urls.mobile.page}][:5],
      onthisday: [(.onthisday // [])[:3][] | {year, text}]
    }'
  """) every 1h json timeout 20s

  onTap: url("https://en.m.wikipedia.org")

  component Heading(text) { Text { text: text; style: label; color: accent } }

  Column {
    gap: 4
    Text { text: "wikipedia"; style: muted }
    Column {
      scroll: true
      weight: 1
      gap: 6
      if wp.tfa != null {
        Column {
          gap: 2
          onTap: url(wp.tfa.url)
          Heading { text: "featured article" }
          Text { text: wp.tfa.title; style: body; bold: true; maxLines: 2 }
          Text { text: wp.tfa.text; fontSize: 12; color: muted; maxLines: 4 }
        }
      }
      if len(wp.read) > 0 {
        Heading { text: "most read" }
        for a in wp.read key a.url {
          Row {
            onTap: url(a.url)
            Text { text: a.title; fontSize: 12; maxLines: 1; weight: 1 }
            Text { text: a.views >= 1000000 ? "${fixed(a.views / 1000000, 1)}M" : "${round(a.views / 1000)}k"; fontSize: 11; color: muted; width: 48; align: end }
          }
        }
      }
      if len(wp.onthisday) > 0 {
        Heading { text: "on this day" }
        for e, i in wp.onthisday key i {
          Row {
            align: top
            Text { text: "${e.year}"; fontSize: 12; color: accent; width: 40 }
            Text { text: e.text; fontSize: 12; maxLines: 3; weight: 1 }
          }
        }
      }
    }
  }
}
