widget "home assistant" {
  meta { description: "Home Assistant entities with their states; tap a light or switch to toggle it. Set up in ~/.config/omarchy-proot/home-assistant"; version: "1.2"; license: "MIT"; owl: 6; category: "home" }
  size: 6x3
  minSize: 3x2

  requires { pacman: ["curl", "jq"] }

  // The config file holds the server URL on line 1, a long-lived access token on line 2
  // (Home Assistant: profile > security) and entity ids on the lines after.
  source ha = cmd("""
    f=~/.config/omarchy-proot/home-assistant
    mkdir -p "${f%/*}"
    [ -f "$f" ] || printf 'http://homeassistant.local:8123\nPASTE-A-LONG-LIVED-TOKEN\nsun.sun\n' > "$f"
    chmod 600 "$f"
    base=$(sed -n 1p "$f"); token=$(sed -n 2p "$f")
    tail -n +3 "$f" | grep . | while read -r id; do
      curl -fsm 8 -H "Authorization: Bearer $token" "$base/api/states/$id" ||
        jq -nc --arg id "$id" '{entity_id: $id, state: "unreachable", attributes: {}}'
      echo
    done | jq -sc '[.[] | {id: .entity_id, name: (.attributes.friendly_name // .entity_id), state, unit: (.attributes.unit_of_measurement // "")}]'
  """) every 1m json timeout 30s
  let unset = ha != null && len(ha) > 0 && ha.all(e => e.state == "unreachable")

  onTap: terminal('$EDITOR ~/.config/omarchy-proot/home-assistant', "home assistant")

  Column {
    gap: 4
    Text { text: "home assistant"; style: muted }
    if unset { Text { text: "can't reach it: tap to set the URL, token and entities"; style: small } }
    Grid {
      columns: 2
      gap: 6
      for e in ha key e.id {
        let domain = split(e.id, ".")[0]
        let toggles = domain == "light" || domain == "switch" || domain == "fan" || domain == "input_boolean"
        Column {
          gap: 0
          padding: 6
          radius: 6
          background: e.state == "on" ? alpha(accent, 0.2) : surface
          onTap: run(!toggles ? "true" : "f=~/.config/omarchy-proot/home-assistant; curl -fsm 8 -X POST -H \"Authorization: Bearer $(sed -n 2p $f)\" -H 'Content-Type: application/json' -d ${sh('{"entity_id": "' + e.id + '"}')} \"$(sed -n 1p $f)/api/services/homeassistant/toggle\"")
          Text { text: e.name; fontSize: 11; color: muted; maxLines: 1 }
          Text { text: "${e.state} ${e.unit}"; fontSize: 14; color: e.state == "on" ? accent : e.state == "unreachable" ? red : foreground; maxLines: 1 }
        }
      }
    }
  }
}
