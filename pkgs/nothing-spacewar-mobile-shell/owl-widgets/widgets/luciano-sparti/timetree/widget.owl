widget "timetree" {
  size: 6x4
  minSize: 6x4

  meta {
    description: "TimeTree shared calendar with monthly view, agenda, quick app launch, and phone notification reminders"
    version: "1.0"
    license: "MIT"
    category: "productivity"
    owl: 5
  }

  requires {
    pacman: ["gawk"]
  }

  // Live time, calendar calculation, and event sources
  source now = clock every 1m
  source cal = cmd("""
    mkdir -p ~/.config/timetree
    f=~/.config/timetree/events.json
    [ -f "$f" ] || echo '[]' > "$f"

    gawk -v events_file="$f" '
    BEGIN {
      while ((getline line < events_file) > 0) {
        if (match(line, /"date"[[:space:]]*:[[:space:]]*"([0-9]{4}-[0-9]{2}-[0-9]{2})"/, m_date)) {
          cur_date = m_date[1]
          date_has_ev[cur_date]++
          if (match(line, /"color"[[:space:]]*:[[:space:]]*"([^"]+)"/, m_col)) {
            if (date_colors[cur_date] == "") {
              date_colors[cur_date] = m_col[1]
            } else if (split(date_colors[cur_date], dummy, ",") < 3) {
              date_colors[cur_date] = date_colors[cur_date] "," m_col[1]
            }
          }
        }
      }
      close(events_file)

      now = systime()
      cur_y = strftime("%Y", now) + 0
      cur_m = strftime("%m", now) + 0
      today = strftime("%Y-%m-%d", now)

      printf "{\"today\":\"%s\",\"months\":[", today

      m_idx = 0
      for (off = -3; off <= 3; off++) {
        y = cur_y
        m = cur_m + off
        while (m < 1) { m += 12; y-- }
        while (m > 12) { m -= 12; y++ }

        t_first = mktime(sprintf("%d %02d 01 12 00 00", y, m))
        label = strftime("%B %Y", t_first)
        short_label = strftime("%b %Y", t_first)
        dow = strftime("%w", t_first) + 0
        t_start = t_first - (dow * 86400)

        next_y = y; next_m = m + 1
        if (next_m > 12) { next_m = 1; next_y++ }
        t_next = mktime(sprintf("%d %02d 01 12 00 00", next_y, next_m))
        t_last = t_next - 86400
        days_in_m = strftime("%d", t_last) + 0

        cells = (dow + days_in_m > 35) ? 42 : 35

        if (m_idx > 0) printf ","
        printf "{\"off\":%d,\"label\":\"%s\",\"short\":\"%s\",\"year\":%d,\"month\":%d,\"weeks\":[", off, label, short_label, y, m

        for (w = 0; w < (cells / 7); w++) {
          if (w > 0) printf ","
          printf "{\"days\":["
          for (d = 0; d < 7; d++) {
            idx = w * 7 + d
            t_day = t_start + (idx * 86400)
            d_str = strftime("%Y-%m-%d", t_day)
            d_num = strftime("%d", t_day) + 0
            d_m = strftime("%m", t_day) + 0
            in_m = (d_m == m) ? "true" : "false"
            is_today = (d_str == today) ? "true" : "false"
            cnt = date_has_ev[d_str] + 0
            cols = date_colors[d_str]
            if (cols == "") cols = "#10b981"
            split(cols, c_arr, ",")
            c_json = "["
            for (ci = 1; ci <= length(c_arr); ci++) {
              if (ci > 1) c_json = c_json ","
              c_json = c_json "\"" c_arr[ci] "\""
            }
            c_json = c_json "]"

            if (d > 0) printf ","
            printf "{\"d\":%d,\"date\":\"%s\",\"cur\":%s,\"today\":%s,\"dow\":%d,\"count\":%d,\"colors\":%s}", d_num, d_str, in_m, is_today, d, cnt, c_json
          }
          printf "]}"
        }
        printf "]}"
        m_idx++
      }
      printf "]}"
    }'
  """) every 10m json

  source events = file("~/.config/timetree/events.json") json
  source notifs = android.notifications

  // State for interactive navigation
  state offset = 0 persist
  state selectedDate = ""

  // Derived calendar values
  let todayDate = cal.today ?? fmtTime(now, "yyyy-MM-dd")
  let activeDate = selectedDate != "" ? selectedDate : todayDate
  let monthsList = cal.months ?? []
  let activeMonth = monthsList.find(m => m.off == offset) ?? monthsList.find(m => m.off == 0)
  let monthLabel = activeMonth.label ?? fmtTime(now, "MMMM yyyy")
  let monthWeeks = activeMonth.weeks ?? []
  let allEvents = events ?? []
  let dayEvents = allEvents.filter(e => e.date == activeDate)
  let ttNotifs = (notifs.items ?? []).filter(n => n.package == "works.jubilee.timetree")
  let ttColor = #10b981

  component TreeLogo(sz = 20) {
    Canvas {
      width: sz
      height: sz
      rect(0, 0, sz, sz, radius: 4, fill: ttColor)
      circle(sz * 0.5, sz * 0.38, sz * 0.22, fill: #ffffff)
      rect(sz * 0.44, sz * 0.46, sz * 0.12, sz * 0.32, radius: 1, fill: #ffffff)
    }
  }

  component DayCell(day) {
    let isSel = day.date == activeDate
    let dayCol = !day.cur ? alpha(foreground, 0.25) : (day.dow == 0 ? red : (day.dow == 6 ? cyan : foreground))
    Column {
      weight: 1
      align: center
      padding: [0, 1]
      onTap: selectedDate = day.date

      Box {
        size: 19
        radius: 9.5
        background: day.today ? ttColor : (isSel ? alpha(ttColor, 0.25) : transparent)
        border: (isSel && !day.today) ? 1.5 : 0
        borderColor: ttColor
        align: center

        Text {
          text: str(day.d)
          fontSize: 10
          bold: day.today || isSel
          color: day.today ? #ffffff : dayCol
          align: center
        }
      }

      Row {
        gap: 2
        height: 3
        align: center
        if day.count > 0 {
          Box { size: 3; radius: 1.5; background: day.colors[0] ?? ttColor }
        }
        if day.count > 1 {
          Box { size: 3; radius: 1.5; background: day.colors[1] ?? #f59e0b }
        }
      }
    }
  }

  component EventItem(ev) {
    Row {
      gap: 5
      align: center
      padding: [4, 3]
      radius: 4
      background: alpha(muted, 0.12)
      onTap: androidApp("works.jubilee.timetree")

      Box {
        width: 3
        height: 20
        radius: 1.5
        background: ev.color ?? ttColor
      }

      Column {
        gap: 0
        weight: 1
        Row {
          gap: 4
          Text { text: ev.time ?? "All day"; fontSize: 9; color: muted; width: 42 }
          if ev.calendar != null {
            Text { text: "· ${ev.calendar}"; fontSize: 9; color: alpha(foreground, 0.45); weight: 1; maxLines: 1 }
          }
        }
        Text { text: ev.title; fontSize: 10; bold: true; maxLines: 1 }
      }
    }
  }

  Column {
    gap: 4

    // Top Header: TimeTree Logo, Title, Month Switcher, App Launcher
    Row {
      gap: 6
      align: center

      Row {
        gap: 4
        align: center
        width: 86
        onTap: androidApp("works.jubilee.timetree")
        TreeLogo { sz: 18 }
        Text { text: "TimeTree"; fontSize: 12; bold: true; color: ttColor; width: 64; maxLines: 1 }
      }

      Row {
        gap: 2
        align: center
        width: 128
        Box {
          size: 18
          radius: 3
          background: alpha(muted, 0.2)
          align: center
          onTap: offset = max(-3, offset - 1)
          Text { text: "‹"; fontSize: 11; bold: true; align: center }
        }
        Text {
          text: monthLabel
          fontSize: 11
          bold: true
          width: 86
          align: center
          maxLines: 1
          onTap: offset = 0
        }
        Box {
          size: 18
          radius: 3
          background: alpha(muted, 0.2)
          align: center
          onTap: offset = min(3, offset + 1)
          Text { text: "›"; fontSize: 11; bold: true; align: center }
        }
      }

      if offset != 0 {
        Box {
          padding: [4, 2]
          radius: 3
          background: alpha(ttColor, 0.2)
          align: center
          onTap: offset = 0
          Text { text: "Today"; fontSize: 9; color: ttColor; bold: true; width: 28; align: center }
        }
      }

      Spacer { weight: 1 }

      Box {
        padding: [6, 3]
        radius: 4
        background: ttColor
        align: center
        onTap: screen()
        Text { text: "Open"; fontSize: 10; bold: true; color: #ffffff; width: 28; align: center }
      }
    }

    // TimeTree notification banner if any active notification exists
    if len(ttNotifs) > 0 {
      Row {
        gap: 4
        align: center
        padding: [4, 2]
        radius: 4
        background: alpha(ttColor, 0.2)
        onTap: notification("open", ttNotifs[0].key)
        Text { text: ttNotifs[0].title; fontSize: 10; bold: true; width: 90; maxLines: 1 }
        Text { text: ttNotifs[0].text; fontSize: 10; color: muted; weight: 1; maxLines: 1 }
      }
    }

    // Main Content: Side-by-side Calendar and Agenda
    Row {
      gap: 8
      weight: 1

      // Left Column: Calendar Grid
      Column {
        width: 195
        gap: 1

        // Weekday headers
        Row {
          for w, i in ["S", "M", "T", "W", "T", "F", "S"] {
            Text {
              text: w
              weight: 1
              fontSize: 9
              bold: true
              align: center
              color: i == 0 ? red : (i == 6 ? cyan : muted)
            }
          }
        }

        Spacer { height: 1 }

        // Weeks
        for week in monthWeeks {
          Row {
            for day in week.days key day.date {
              DayCell { day: day }
            }
          }
        }
      }

      // Divider
      Spacer { width: 1; fill: height; background: alpha(muted, 0.25) }

      // Right Column: Selected Day's Events Agenda
      Column {
        weight: 1
        gap: 3

        Row {
          align: center
          Text {
            text: activeDate == todayDate ? "Today" : sub(activeDate, 5, 10)
            fontSize: 11
            bold: true
            weight: 1
            maxLines: 1
          }
          if activeDate != todayDate {
            Box {
              padding: [3, 1]
              radius: 3
              background: alpha(ttColor, 0.2)
              align: center
              onTap: selectedDate = todayDate
              Text { text: "Today"; fontSize: 8; color: ttColor; bold: true; width: 26; align: center }
            }
          }
          Text {
            text: "${len(dayEvents)} ev"
            fontSize: 9
            color: muted
            width: 26
            align: end
          }
        }

        Column {
          scroll: true
          weight: 1
          gap: 3

          if len(dayEvents) > 0 {
            for ev in dayEvents key ev.id {
              EventItem { ev: ev }
            }
          } else {
            Column {
              align: center
              justify: center
              weight: 1
              gap: 4
              Text { text: "No events"; fontSize: 10; color: muted; align: center }
              Button {
                text: "+ TimeTree"
                color: ttColor
                onTap: androidApp("works.jubilee.timetree")
              }
            }
          }
        }
      }
    }
  }

  // Full-screen Screen View
  screen {
    title: "TimeTree Schedule"

    Column {
      scroll: true
      gap: 12
      padding: 12

      // Screen Header
      Row {
        gap: 8
        align: center
        TreeLogo { sz: 28 }
        Column {
          gap: 0
          weight: 1
          Text { text: "TimeTree"; fontSize: 18; bold: true; color: ttColor }
          Text { text: "Shared Calendar & Schedule"; style: small; color: muted }
        }
        Row {
          gap: 6
          Button {
            text: "Open App"
            color: ttColor
            onTap: androidApp("works.jubilee.timetree")
          }
        }
      }

      Spacer { height: 1; fill: width; background: alpha(muted, 0.3) }

      // Month Selector
      Row {
        gap: 8
        align: center
        Box {
          width: 70
          height: 28
          radius: 4
          background: alpha(muted, 0.2)
          align: center
          onTap: offset = max(-3, offset - 1)
          Text { text: "‹ Prev"; fontSize: 12; bold: true; align: center }
        }
        Text { text: monthLabel; fontSize: 15; bold: true; weight: 1; align: center }
        Box {
          width: 70
          height: 28
          radius: 4
          background: alpha(muted, 0.2)
          align: center
          onTap: offset = min(3, offset + 1)
          Text { text: "Next ›"; fontSize: 12; bold: true; align: center }
        }
        if offset != 0 {
          Box {
            width: 50
            height: 28
            radius: 4
            background: ttColor
            align: center
            onTap: offset = 0
            Text { text: "Today"; fontSize: 11; bold: true; color: #ffffff; align: center }
          }
        }
      }

      // Large Full Calendar
      Column {
        gap: 3
        padding: 8
        border: 1
        borderColor: alpha(muted, 0.3)
        radius: 8

        Row {
          for w in ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"] {
            Text {
              text: w
              weight: 1
              fontSize: 11
              bold: true
              align: center
              color: w == "Sun" ? red : (w == "Sat" ? cyan : muted)
            }
          }
        }

        Spacer { height: 4 }

        for week in monthWeeks {
          Row {
            for day in week.days key day.date {
              let isSel = day.date == activeDate
              let dayCol = !day.cur ? alpha(foreground, 0.3) : (day.dow == 0 ? red : (day.dow == 6 ? cyan : foreground))
              Column {
                weight: 1
                align: center
                padding: [2, 4]
                radius: 6
                background: isSel ? alpha(ttColor, 0.15) : transparent
                onTap: selectedDate = day.date

                Box {
                  size: 26
                  radius: 13
                  background: day.today ? ttColor : transparent
                  align: center
                  Text {
                    text: str(day.d)
                    fontSize: 12
                    bold: day.today || isSel
                    color: day.today ? #ffffff : dayCol
                  }
                }

                Row {
                  gap: 2
                  height: 6
                  align: center
                  if day.count > 0 {
                    Box { size: 4; radius: 2; background: day.colors[0] ?? ttColor }
                  }
                  if day.count > 1 {
                    Box { size: 4; radius: 2; background: day.colors[1] ?? #f59e0b }
                  }
                }
              }
            }
          }
        }
      }

      // Agenda for Selected Day
      Column {
        gap: 8
        padding: 10
        border: 1
        borderColor: alpha(muted, 0.3)
        radius: 8

        Row {
          align: center
          Text { text: "Schedule · ${activeDate}"; fontSize: 14; bold: true; weight: 1; maxLines: 1 }
          Text { text: "${len(dayEvents)} events"; fontSize: 12; color: muted; width: 65; align: end }
        }

        if len(dayEvents) > 0 {
          for ev in dayEvents key ev.id {
            Row {
              gap: 8
              align: center
              padding: [8, 6]
              radius: 6
              background: alpha(muted, 0.15)
              Box { width: 4; height: 28; radius: 2; background: ev.color ?? ttColor }
              Column {
                gap: 1
                weight: 1
                Row {
                  gap: 6
                  Text { text: ev.time ?? "All day"; fontSize: 11; bold: true; color: ttColor; width: 50 }
                  if ev.calendar != null {
                    Text { text: "· ${ev.calendar}"; fontSize: 11; color: muted; weight: 1; maxLines: 1 }
                  }
                }
                Text { text: ev.title; fontSize: 13; bold: true; maxLines: 1 }
              }
              Box {
                width: 48
                height: 26
                radius: 4
                background: alpha(ttColor, 0.2)
                align: center
                onTap: androidApp("works.jubilee.timetree")
                Text { text: "Open"; fontSize: 10; bold: true; color: ttColor; align: center }
              }
            }
          }
        } else {
          Text { text: "No events on this day."; fontSize: 12; color: muted }
        }
      }

      // Quick Add Event Form
      Column {
        gap: 6
        padding: 10
        border: 1
        borderColor: alpha(muted, 0.3)
        radius: 8

        Text { text: "Manage Events for ${activeDate}"; fontSize: 13; bold: true }
        Row {
          gap: 6
          align: center
          Button {
            text: "+ Add Event in TimeTree App"
            color: ttColor
            weight: 1
            onTap: androidApp("works.jubilee.timetree")
          }
        }
      }

      // Bottom Action buttons
      Row {
        gap: 8
        Button {
          text: "Edit Events"
          weight: 1
          onTap: terminal('$EDITOR ~/.config/timetree/events.json', "TimeTree Events")
        }
        Button {
          text: "Close"
          weight: 1
          onTap: close()
        }
      }
    }
  }
}
