widget "retro amp" {
  page: 2
  order: 3
  size: 6x3
  minSize: 4x2
  padding: 0

  meta { owl: 5; description: "A late-90s style music player for whatever is playing on the phone: spectrum, scrolling title, cover and song history, in classic or theme colors."; version: "1.1"; license: "MIT"; category: "fun" }

  // Android's media sessions (YouTube Music, or any other player) and the media volume.
  source m = android.media
  source v = android.volume
  source now = clock every 1m

  // Tap the title bar to switch between the classic skin and the Omarchy theme's colors.
  state skin = "classic" persist
  let classic = skin == "classic"

  let cBody = classic ? #2e2e44 : surface
  let cHi = classic ? #7a7a9c : border
  let cLo = classic ? #0e0e16 : background
  let cTitle = classic ? #d0d0e0 : foreground
  let cStripe = classic ? #d8b24a : accent
  let cLcd = classic ? #000000 : background
  let cLit = classic ? #00e800 : accent
  let cDim = classic ? #0b5c0b : muted
  let cKey = classic ? #b9bdcb : surface
  let cKeyHi = classic ? #f2f4fa : border
  let cKeyLo = classic ? #50546a : background
  let cInk = classic ? #1c1c28 : foreground
  let cVis = classic ? [#00e800, #e8e800, #e83000] : [accent, foreground]

  let has = m.available && m.title != null
  let playing = has && m.playing
  let dur = m.duration ?? 0
  let pos = has ? clamp(m.position ?? 0, 0, dur > 0 ? dur : 359999) : 0
  let clockText = "${pad(floor(pos / 60), 2, "0")}:${pad(floor(pos) % 60, 2, "0")}"
  let durText = "${floor(dur / 60)}:${pad(floor(dur) % 60, 2, "0")}"

  let banner = !m.available ? "*** NEEDS NOTIFICATION ACCESS - TAP THE DISPLAY ***"
    : m.title == null ? "*** NOTHING PLAYING - EJECT OPENS YOUTUBE MUSIC ***"
    : "${m.artist ?? m.app} - ${m.title}${dur > 0 ? " (${durText})" : ""}"

  let compact = (rows ?? 3) < 3 || (cols ?? 6) < 5

  // Songs seen so far, newest first. Only noticed while the tile's page or the screen is showing.
  state hist = [] persist
  let pushed = m.title == null || first(hist).title == m.title ? hist
    : take(flatten([[{title: m.title, artist: m.artist ?? m.app ?? "", at: now ?? 0}], hist]), 50)
  on m.title { hist = pushed }
  let coverSize = min((screenWidth ?? 360) - 24, (screenHeight ?? 700) * 0.45)

  // A raised key with its symbol; `lit` colors the symbol like the display.
  component Key(kind, lit = false) {
    Canvas {
      let cx = width / 2
      let cy = height / 2
      let ink = lit ? (classic ? #0a7a0a : accent) : cInk
      rect(0, 0, width, height, fill: cKeyLo)
      rect(0, 0, width - 1.5, height - 1.5, fill: cKeyHi)
      rect(1.5, 1.5, width - 3, height - 3, fill: cKey)
      if kind == "prev" {
        rect(cx - 6, cy - 5, 2.5, 10, fill: ink)
        path([[cx + 6, cy - 5], [cx - 3, cy], [cx + 6, cy + 5]], closed: true, fill: ink)
      }
      if kind == "play" {
        path([[cx - 4, cy - 6], [cx + 6, cy], [cx - 4, cy + 6]], closed: true, fill: ink)
      }
      if kind == "pause" {
        rect(cx - 5, cy - 5, 3.5, 10, fill: ink)
        rect(cx + 1.5, cy - 5, 3.5, 10, fill: ink)
      }
      if kind == "stop" {
        rect(cx - 4.5, cy - 4.5, 9, 9, fill: ink)
      }
      if kind == "next" {
        path([[cx - 6, cy - 5], [cx + 3, cy], [cx - 6, cy + 5]], closed: true, fill: ink)
        rect(cx + 3.5, cy - 5, 2.5, 10, fill: ink)
      }
      if kind == "eject" {
        path([[cx - 6, cy + 1], [cx, cy - 6], [cx + 6, cy + 1]], closed: true, fill: ink)
        rect(cx - 6, cy + 3, 12, 2.5, fill: ink)
      }
    }
  }

  // Position bar. Android gives no way to seek, so it only shows where the song is.
  component SeekBar() {
    Canvas {
      let x0 = 6
      let room = width - 12
      let knob = 26
      let f = dur > 0 ? clamp(pos / dur, 0, 1) : 0
      rect(x0, 2, room, 8, fill: cHi)
      rect(x0, 2, room - 1, 7, fill: cLo)
      if has {
        let kx = x0 + (room - knob) * f
        rect(kx, 1, knob, 10, fill: cKeyLo)
        rect(kx, 1, knob - 1, 9, fill: cKeyHi)
        rect(kx + 1, 2, knob - 2, 8, fill: cKey)
        line(kx + knob / 2, 3, kx + knob / 2, 9, stroke: cStripe, width: 2)
      }
    }
  }

  component Keys() {
    Row {
      gap: 3
      Box { weight: 1; fill: height; onTap: media("previous"); Key { kind: "prev" } }
      Box { weight: 1; fill: height; onTap: media("play"); Key { kind: "play"; lit: playing } }
      Box { weight: 1; fill: height; onTap: media("pause"); Key { kind: "pause"; lit: has && !playing } }
      // Android has no stop: this pauses too.
      Box { weight: 1; fill: height; onTap: media("pause"); Key { kind: "stop" } }
      Box { weight: 1; fill: height; onTap: media("next"); Key { kind: "next" } }
      Spacer { width: 6 }
      if m.available && m.title == null {
        Box { weight: 1; fill: height; onTap: androidApp("com.google.android.apps.youtube.music"); Key { kind: "eject" } }
      } else {
        Box { weight: 1; fill: height; onTap: media("open"); Key { kind: "eject" } }
      }
    }
  }

  Column {
    gap: 0
    fill: true
    background: cBody

    // Title bar
    Canvas {
      height: 18
      fill: width
      onTap: skin = classic ? "omarchy" : "classic"
      let cy = height / 2
      rect(0, 0, width, height, fill: cLo)
      rect(6, cy - 3, 6, 6, stroke: cStripe, width: 1)
      for dy in [-2.5, 0, 2.5] {
        line(18, cy + dy, width / 2 - 44, cy + dy, stroke: cStripe, width: 1)
        line(width / 2 + 44, cy + dy, width - 58, cy + dy, stroke: cStripe, width: 1)
      }
      text("RETRO AMP", width / 2, cy, size: 11, bold: true, align: center, color: cTitle)
      text(classic ? "CLASSIC" : "OMARCHY", width - 6, cy, size: 8, align: end, color: cStripe)
    }

    Row {
      gap: 6
      weight: 1
      fill: width
      padding: [6, 6, 6, 4]

      // Display: play state, time and a spectrum that only moves while playing. Tap for the big view.
      Canvas {
        width: compact ? 92 : 124
        fill: height
        onTap: screen()
        let t = playing ? time : 0
        rect(0, 0, width, height, fill: cHi)
        rect(0, 0, width - 1, height - 1, fill: cLo)
        rect(1, 1, width - 2, height - 2, fill: cLcd)
        let gy = min(18, height / 2)
        if playing {
          path([[8, gy - 5], [16, gy], [8, gy + 5]], closed: true, fill: cLit)
        } else {
          if has {
            rect(8, gy - 5, 3, 10, fill: cLit)
            rect(13, gy - 5, 3, 10, fill: cLit)
          } else {
            rect(8, gy - 4, 8, 8, fill: cDim)
          }
        }
        text(clockText, width - 8, gy, size: compact ? 20 : 24, bold: true, align: end, color: has ? cLit : cDim)
        if height > 62 {
          let top = 36
          let bottom = height - 6
          let n = 19
          let bw = (width - 14) / n
          for i in range(n) {
            let a = abs(sin(t * (2.3 + (i * 37 % 11) * 0.27) + i * 1.3))
            let b = 0.55 + 0.45 * sin(t * 0.9 + i * 0.5)
            let h = playing ? max(2, (bottom - top) * a * b * (1 - i / n * 0.45)) : 2
            rect(7 + i * bw, bottom - h, bw - 1.5, h, fill: linear(0, bottom, 0, top, cVis))
          }
          for k in range(floor((bottom - top) / 3)) {
            line(6, bottom - k * 3 - 0.5, width - 6, bottom - k * 3 - 0.5, stroke: cLcd, width: 1)
          }
        }
      }

      Column {
        gap: 4
        weight: 1
        fill: height

        // Song title, scrolling when it doesn't fit.
        Canvas {
          height: 22
          fill: width
          let est = len(banner) * 7.4
          let room = width - 12
          let loop = est + 48
          rect(0, 0, width, height, fill: cHi)
          rect(0, 0, width - 1, height - 1, fill: cLo)
          rect(1, 1, width - 2, height - 2, fill: cLcd)
          clip(5, 1, width - 10, height - 2) {
            if est <= room {
              text(banner, 6, height / 2, size: 12, color: cLit)
            } else {
              let x = playing ? 6 - (time * 28) % loop : 6
              text(banner, x, height / 2, size: 12, color: cLit)
              if playing { text(banner, x + loop, height / 2, size: 12, color: cLit) }
            }
          }
        }

        if !compact {
          Row {
            gap: 6
            fill: width
            Text { text: upper(has ? m.app ?? "player" : "no disc"); fontSize: 10; font: mono; color: cTitle; weight: 1; maxLines: 1 }
            Text { text: "STEREO"; fontSize: 10; font: mono; bold: true; color: playing ? cLit : cDim; width: 46; align: end }
          }
          Text { text: has ? m.album ?? "" : ""; fontSize: 10; font: mono; color: cStripe; maxLines: 1 }
          Spacer { weight: 1 }
          Row {
            gap: 6
            fill: width
            align: center
            Text { text: "VOL"; fontSize: 10; font: mono; color: cTitle; width: 24 }
            // One step per volume step of the phone.
            Slider { value: v.muted ? 0 : v.level; step: 100 / (v.steps ?? 15); live: true; weight: 1; height: 22; color: cStripe; track: cLo; onChange: volume(value) }
            Text { text: v.muted ? "--" : "${round(v.level)}"; fontSize: 10; font: mono; color: cTitle; width: 22; align: end }
          }
        }
      }
    }

    SeekBar { height: 12; fill: width }
    Keys { height: 36; fill: width; padding: [6, 4, 6, 6] }
  }

  // Full screen: the cover, the controls and the songs played so far.
  screen {
    title: "retro amp"
    Column {
      scroll: true
      fill: true
      gap: 10
      padding: 12
      background: cBody
      align: center

      Box {
        size: coverSize
        background: cLcd
        border: 2
        borderColor: cHi
        radius: 0
        clip: true
        align: center
        if has && m.art != null {
          Image { src: m.art; fit: cover; fill: true }
        } else {
          Text { text: has ? "NO COVER" : "NO DISC"; font: mono; bold: true; color: cDim; align: center }
        }
      }

      Column {
        gap: 2
        fill: width
        padding: [8, 6]
        background: cLcd
        border: 1
        borderColor: cHi
        radius: 0
        Text { text: has ? m.title : "nothing playing"; bold: true; fontSize: 17; color: cLit; maxLines: 2 }
        Text { text: has ? m.artist ?? m.app ?? "" : "eject opens YouTube Music"; fontSize: 13; color: cLit; maxLines: 1 }
        if has && m.album != null {
          Text { text: m.album; fontSize: 12; color: cStripe; maxLines: 1 }
        }
      }

      Row {
        gap: 8
        fill: width
        align: center
        Text { text: clockText; font: mono; fontSize: 12; color: cTitle; width: 44 }
        SeekBar { height: 12; weight: 1 }
        Text { text: dur > 0 ? durText : "--:--"; font: mono; fontSize: 12; color: cTitle; width: 44; align: end }
      }

      Keys { height: 44; fill: width }

      Row {
        gap: 6
        fill: width
        align: center
        Text { text: "VOL"; fontSize: 11; font: mono; color: cTitle; width: 28 }
        Slider { value: v.muted ? 0 : v.level; step: 100 / (v.steps ?? 15); live: true; weight: 1; height: 26; color: cStripe; track: cLo; onChange: volume(value) }
        Text { text: v.muted ? "--" : "${round(v.level)}"; fontSize: 11; font: mono; color: cTitle; width: 28; align: end }
      }

      Row {
        fill: width
        align: center
        Text { text: "PLAYLIST HISTORY"; font: mono; bold: true; fontSize: 12; color: cStripe; weight: 1 }
        Text { text: "${len(hist)} songs"; font: mono; fontSize: 11; color: cTitle; width: 70; align: end }
        Box { width: 56; height: 24; onTap: hist = []; align: center; background: cKey; border: 1; borderColor: cKeyHi; radius: 0
          Text { text: "CLEAR"; font: mono; bold: true; fontSize: 10; color: cInk; align: center }
        }
      }

      Column {
        gap: 0
        fill: width
        padding: [0, 4]
        background: cLcd
        border: 1
        borderColor: cHi
        radius: 0
        if len(hist) == 0 {
          Text { text: "no songs yet - they are added while this widget is on screen"; fontSize: 12; color: cDim; padding: [8, 8] }
        }
        // Tap a song to look it up in YouTube Music.
        for h, i in hist key "${h.at}-${h.title}" {
          let cur = has && i == 0 && h.title == m.title
          Row {
            gap: 6
            fill: width
            padding: [8, 5]
            background: cur ? alpha(cLit, 0.18) : cLcd
            onTap: url("https://music.youtube.com/search?q=${replace(replace(replace(replace(replace("${h.artist} ${h.title}", "%", "%25"), "&", "%26"), "#", "%23"), "+", "%2B"), " ", "+")}")
            Text { text: "${i + 1}."; font: mono; fontSize: 12; color: cur ? cTitle : cLit; width: 26; align: end }
            Text { text: h.artist == "" ? h.title : "${h.artist} - ${h.title}"; fontSize: 13; color: cur ? cTitle : cLit; weight: 1; maxLines: 1 }
            Text { text: fmtTime(h.at, "HH:mm"); font: mono; fontSize: 11; color: cDim; width: 40; align: end }
          }
        }
      }
    }
  }
}
