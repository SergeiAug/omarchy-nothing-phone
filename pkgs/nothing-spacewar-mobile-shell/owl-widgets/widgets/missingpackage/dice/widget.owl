widget "dice" {
  meta { owl: 6; description: "A set of dice from d2 to d100: pick one and tap it to roll. The d100 rolls a tens die and a units die, and the last rolls stay on the tile"; version: "1.0"; license: "MIT"; category: "fun" }
  size: 3x3
  minSize: 3x3

  source now = clock every 1s

  state sides = 20 persist
  // Park-Miller generator (x * 48271 mod 2^31-1), stirred with the tap's time
  // before every roll. The products stay under 2^53, so they are exact.
  state seed = 20261012 persist
  state a = 0 persist             // the roll; on a d100 the tens digit (0-9)
  state b = 0 persist             // on a d100 the units digit (0-9)
  state total = 0 persist         // 0 = not rolled yet
  state log = [] persist          // earlier rolls of this die, newest first
  state rollAt = -100             // Canvas time of the roll
  state rollNow = 0               // wall-clock second of the roll

  let kinds = [2, 4, 6, 8, 10, 12, 20, 100]
  let pair = sides == 100

  component Chip(n) {
    Text {
      text: "d${n}"
      fontSize: 12
      bold: sides == n
      align: center
      maxLines: 1
      padding: [0, 5]
      radius: 3 * corners
      background: sides == n ? accent : surface
      color: sides == n ? background : foreground
      onTap: { log = sides == n ? log : []; total = sides == n ? total : 0; sides = n }
    }
  }

  Column {
    gap: 6
    Row {
      Text { text: "d${sides}"; style: muted; width: 44; maxLines: 1 }
      Text { text: join(log, " · "); style: small; color: muted; weight: 1; align: end; maxLines: 1 }
    }

    Canvas {
      weight: 1
      fill: width
      onTap: {
        log = total > 0 ? take([total] + log, 6) : log
        seed = ((seed + floor(time * 1000) + now) % 2147483646 + 1) * 48271 % 2147483647
        a = pair ? seed % 10 : seed % sides + 1
        seed = seed * 48271 % 2147483647
        b = seed % 10
        total = !pair ? a : a + b == 0 ? 100 : a * 10 + b
        rollAt = time
        rollNow = now
      }

      // Seconds since the roll. The wall clock has the last word, as `time`
      // restarts with the frame clock and an old roll could look fresh again.
      let dur = 0.55
      let since = now - rollNow < 5 && time >= rollAt ? time - rollAt : 1000
      let rolling = since < dur
      let s = clamp(since / dur, 0, 1)
      let wobble = rolling ? sin(since * 38) * 16 * (1 - s) : 0
      let pop = 1 + (since < dur + 0.25 && !rolling ? 0.12 * sin((since - dur) / 0.25 * pi) : 0)
      let hop = rolling ? sin(s * pi) * 6 : 0

      let n = pair ? 2 : 1
      let r = pair ? min(width / 4 - 5, height / 2 - 4) : min(width, height) / 2 - 4
      let cy = height / 2
      let best = total == sides
      let worst = total == 1 && sides > 2
      let tint = rolling || total == 0 ? accent : best ? green : worst ? red : accent
      let face = mix(tint, background, 0.78)
      let edge = alpha(tint, 0.45)

      for k in range(n) {
        let cx = pair ? width / 2 + (k * 2 - 1) * (r + 5) : width / 2
        // while it tumbles the die shows faces picked by the frame clock
        let flick = floor(abs(sin((floor(time * 18) + k * 7) * 12.9898) * 43758.5453)) % (pair ? 10 : sides)
        let shown = rolling ? (pair ? flick : flick + 1) : k == 0 ? a : b
        let label = total == 0 && !rolling ? (pair ? (k == 0 ? "00" : "0") : "d${sides}")
          : pair && k == 0 ? "${shown}0" : "${shown}"

        translate(0, -hop) {
          rotate(wobble * (k == 0 ? 1 : -1), cx, cy) {
            scale(pop, pop, cx, cy) {
              if sides == 2 {
                circle(cx, cy, r, fill: face)
                circle(cx, cy, r, stroke: tint, width: 2)
                circle(cx, cy, r * 0.8, stroke: edge, width: 1)
              }
              if sides == 4 {
                let p = range(3).map(i => [cx + r * 1.08 * sin(rad(i * 120)), cy + r * 0.2 - r * 1.08 * cos(rad(i * 120))])
                path(p, closed: true, fill: face)
                path(p, closed: true, stroke: tint, width: 2)
              }
              if sides == 6 {
                rect(cx - r * 0.8, cy - r * 0.8, r * 1.6, r * 1.6, radius: r * 0.22, fill: face)
                rect(cx - r * 0.8, cy - r * 0.8, r * 1.6, r * 1.6, radius: r * 0.22, stroke: tint, width: 2)
              }
              if sides == 8 {
                let p = [[cx, cy - r], [cx + r * 0.86, cy], [cx, cy + r], [cx - r * 0.86, cy]]
                path(p, closed: true, fill: face)
                path([[cx - r * 0.86, cy], [cx, cy + r * 0.42], [cx + r * 0.86, cy]], stroke: edge, width: 1)
                path([[cx, cy + r * 0.42], [cx, cy + r]], stroke: edge, width: 1)
                path(p, closed: true, stroke: tint, width: 2)
              }
              if sides == 10 || pair {
                let p = [[cx, cy - r], [cx + r * 0.9, cy - r * 0.12], [cx + r * 0.9, cy + r * 0.22], [cx, cy + r], [cx - r * 0.9, cy + r * 0.22], [cx - r * 0.9, cy - r * 0.12]]
                let f = [[cx, cy - r], [cx + r * 0.58, cy + r * 0.2], [cx, cy + r * 0.52], [cx - r * 0.58, cy + r * 0.2]]
                path(p, closed: true, fill: face)
                path(f, closed: true, stroke: edge, width: 1)
                line(cx + r * 0.58, cy + r * 0.2, cx + r * 0.9, cy + r * 0.22, stroke: edge, width: 1)
                line(cx - r * 0.58, cy + r * 0.2, cx - r * 0.9, cy + r * 0.22, stroke: edge, width: 1)
                line(cx, cy + r * 0.52, cx, cy + r, stroke: edge, width: 1)
                path(p, closed: true, stroke: tint, width: 2)
              }
              if sides == 12 {
                let p = range(10).map(i => [cx + r * sin(rad(i * 36)), cy - r * cos(rad(i * 36))])
                let f = range(5).map(i => [cx + r * 0.62 * sin(rad(i * 72)), cy - r * 0.62 * cos(rad(i * 72))])
                path(p, closed: true, fill: face)
                path(f, closed: true, stroke: edge, width: 1)
                for i in range(5) {
                  line(cx + r * 0.62 * sin(rad(i * 72)), cy - r * 0.62 * cos(rad(i * 72)), cx + r * sin(rad(i * 72)), cy - r * cos(rad(i * 72)), stroke: edge, width: 1)
                }
                path(p, closed: true, stroke: tint, width: 2)
              }
              if sides == 20 {
                let p = range(6).map(i => [cx + r * sin(rad(i * 60)), cy - r * cos(rad(i * 60))])
                let f = range(3).map(i => [cx + r * 0.6 * sin(rad(i * 120)), cy - r * 0.6 * cos(rad(i * 120))])
                path(p, closed: true, fill: face)
                path(f, closed: true, stroke: edge, width: 1)
                for i in range(3) {
                  let fx = cx + r * 0.6 * sin(rad(i * 120))
                  let fy = cy - r * 0.6 * cos(rad(i * 120))
                  line(fx, fy, cx + r * sin(rad(i * 120)), cy - r * cos(rad(i * 120)), stroke: edge, width: 1)
                  line(fx, fy, cx + r * sin(rad(i * 120 + 60)), cy - r * cos(rad(i * 120 + 60)), stroke: edge, width: 1)
                  line(fx, fy, cx + r * sin(rad(i * 120 - 60)), cy - r * cos(rad(i * 120 - 60)), stroke: edge, width: 1)
                }
                path(p, closed: true, stroke: tint, width: 2)
              }
              text(label, cx, cy + (sides == 4 ? r * 0.22 : 0), size: r * (pair ? 0.62 : sides == 4 ? 0.5 : total == 0 && !rolling ? 0.42 : 0.62), bold: true, align: center,
                color: total == 0 && !rolling ? alpha(foreground, 0.5) : rolling ? alpha(foreground, 0.7) : foreground)
            }
          }
        }
      }
      if pair && total > 0 && !rolling {
        text("= ${total}", width / 2, height - 7, size: 13, bold: true, align: center, color: foreground)
      }
    }

    Grid {
      columns: 4
      gap: 4
      for n in kinds key n { Chip { n: n } }
    }
  }
}
