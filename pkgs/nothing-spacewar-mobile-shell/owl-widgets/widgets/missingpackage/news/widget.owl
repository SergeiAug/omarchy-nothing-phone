widget "news" {
  meta { description: "Feeds, Hacker News, Lobsters, Reddit and any other feed in one list, with a tab per source. Tap the square for a full-screen view"; version: "1.1"; license: "MIT"; category: "news"; owl: 5 }
  size: 6x5
  minSize: 4x3

  requires { pacman: ["python"] }

  // The tabs come from ~/.config/omarchy-proot/news, one per line (the full-screen view has a button that opens it).
  // The feed tab reads ~/.config/omarchy-proot/feeds (one URL per line), the same list the feeds widget reads.
  // Everything is fetched in parallel; a tab that is unreachable or too slow shows the posts saved from its last answer.
  // Each feed gives its 4 newest posts.
  source news = cmd("""
    d=~/.config/omarchy-proot
    mkdir -p "$d"
    [ -f "$d/feeds" ] || { echo https://archlinux.org/feeds/news/; echo https://github.com/omacom/omarchy/releases.atom; } > "$d/feeds"
    [ -f "$d/news" ] || {
      echo "# One tab per line, in this order. Every tab also goes into the all tab."
      echo "#   feeds                     the feeds listed in ~/.config/omarchy-proot/feeds"
      echo "#   hn [show|ask|best]        the Hacker News front page, or Show HN, Ask HN, the best of the week"
      echo "#   lobsters [TAG]            the hottest on Lobsters, or the posts with one of its tags"
      echo "#   reddit SUBREDDIT [label]  a subreddit, or several: reddit linux+archlinux (one reddit line only)"
      echo "#   rss URL [label]           any RSS or Atom feed as a tab of its own"
      echo "# A line like this hides the posts with these words in the title, in every tab:"
      echo "#   mute WORDS"
      echo feeds; echo hn; echo lobsters
    } > "$d/news"
    python3 -c '
import sys, os, re, json, time, html, urllib.request, xml.etree.ElementTree as ET
from concurrent.futures import ThreadPoolExecutor, wait
from datetime import datetime
from email.utils import parsedate_to_datetime
from urllib.parse import urlsplit, urljoin

A = "{http://www.w3.org/2005/Atom}"
HN = "https://news.ycombinator.com/item?id="
DIR = os.path.expanduser("~/.config/omarchy-proot/")
# Feeds stop reading here, so a slow one still hands over the posts it got before the deadline below.
STOP = time.monotonic() + 15

def fetch(url):
    req = urllib.request.Request(url, headers={"User-Agent": "omarchy-proot news widget"})
    return urllib.request.urlopen(req, timeout=10)

def get(url):
    with fetch(url) as r:
        return r.read()

def web(u, base=""):
    # Only http(s) links reach the launcher: a feed can carry javascript: or any other scheme.
    u = (u or "").strip()
    try:
        u = urljoin(base, u) if u else ""
    except Exception:
        return ""
    return u if u.lower().startswith(("http://", "https://")) else ""

def when(s):
    try:
        return int(parsedate_to_datetime(s).timestamp())
    except Exception:
        try:
            return int(datetime.fromisoformat(s.strip().replace("Z", "+00:00")).timestamp())
        except Exception:
            return 0

def text(e, *tags):
    for t in tags:
        x = e.find(t)
        if x is not None and x.text:
            return " ".join(x.text.split())
    return ""

def post(tab, title, url, at, label, disc="", pts=None, com=None):
    return {"id": tab["id"] + ":" + (disc or url), "c": tab["c"], "src": tab["src"], "title": title, "url": url,
            "at": at, "label": label, "disc": disc, "pts": pts, "com": com}

def feed(tab, url, n, named=True):
    # Reads only as much of a feed as its newest posts need: some feeds are several megabytes.
    out, name, stack, got = [], "", [], 0
    parser = ET.XMLPullParser(["start", "end"])

    def add(title, link, at, label=""):
        # Posts without a link that can be opened are left out.
        link = web(link, url)
        if link:
            out.append(post(tab, html.unescape(title) or link, link, at, label))

    try:
        with fetch(url) as r:
            while len(out) < n and got < 400000 and time.monotonic() < STOP:
                chunk = r.read1(16384)
                if not chunk:
                    break
                got += len(chunk)
                parser.feed(chunk)
                for ev, e in parser.read_events():
                    if ev == "start":
                        stack.append(e.tag)
                        continue
                    stack.pop()
                    up = stack[-1] if stack else ""
                    if e.tag in ("title", A + "title") and up in ("channel", A + "feed") and e.text:
                        name = html.unescape(" ".join(e.text.split()))
                    elif e.tag == "item":
                        add(text(e, "title"), text(e, "link"), when(text(e, "pubDate")))
                    elif e.tag == A + "entry":
                        link = e.find(A + "link[@rel=\"alternate\"]")
                        if link is None:
                            link = e.find(A + "link")
                        href = link.get("href") if link is not None else ""
                        cat = e.find(A + "category")
                        add(text(e, A + "title"), href, when(text(e, A + "published", A + "updated")),
                            cat.get("label") or "" if cat is not None else "")
    except Exception:
        pass
    name = name or urlsplit(url).netloc
    return [dict(p, label=name) if named else p for p in out[:n]]

def hn(tab, how):
    out = []
    try:
        since = "&numericFilters=created_at_i%3E" + str(int(time.time()) - (7 if how == "best" else 2) * 86400)
        q = {"": "front_page", "show": "show_hn" + since, "ask": "ask_hn" + since, "best": "story" + since}[how]
        hits = json.loads(get("https://hn.algolia.com/api/v1/search?hitsPerPage=20&tags=" + q))["hits"]
        for h in hits:
            disc = HN + str(h["objectID"])
            link = web(h.get("url")) or disc
            site = urlsplit(link).netloc.removeprefix("www.") if link != disc else ""
            out.append(post(tab, h.get("title") or "", link, h.get("created_at_i") or 0,
                            site, disc, h.get("points") or 0, h.get("num_comments") or 0))
    except Exception:
        pass
    return out

def lobsters(tab, tag):
    out = []
    try:
        for s in json.loads(get("https://lobste.rs/" + ("t/" + tag if tag else "hottest") + ".json"))[:20]:
            disc = web(s["comments_url"])
            link = web(s.get("url")) or disc
            if link:
                out.append(post(tab, s["title"], link, when(s["created_at"]), " ".join(s.get("tags") or []),
                                disc or link, s.get("score") or 0, s.get("comment_count") or 0))
    except Exception:
        pass
    return out

def lines(name, default):
    try:
        with open(DIR + name) as f:
            got = [l.strip() for l in f if l.strip() and not l.strip().startswith("#")]
    except Exception:
        got = []
    return got or default

def words(s):
    # Lowercase words with single spaces around them, so that "ai" is not found in "rain".
    return " " + " ".join("".join(ch if ch.isalnum() else " " for ch in s.lower()).split()) + " "

# The last posts of every tab: {tab id: {key, at, posts}}.
CACHE = os.path.expanduser("~/.cache/omarchy-proot-news.json")
try:
    with open(CACHE) as f:
        old = json.load(f)
except Exception:
    old = {}
now = time.time()

def saved(t):
    # What the tab showed last time, if it still asks for the same thing and is not older than 3 days.
    try:
        o = old[t["id"]]
        if o["key"] == t["key"] and 0 <= now - o["at"] < 3 * 86400:
            return dict(o, posts=[dict(p, c=t["c"], src=t["src"]) for p in o["posts"]])
    except Exception:
        pass
    return None

pool = ThreadPoolExecutor(24)
tabs, jobs, mutes = [], {}, []

def tab(id, label, src, short=None, c=None, key=""):
    # feed, hn and lobsters keep their colors; the other tabs take turns on the rest of the palette.
    t = {"id": id, "label": label, "short": short or label, "src": src, "key": key,
         "c": 3 + len(tabs) % 5 if c is None else c}
    # How much of the tab row each label needs: capitals and m, w are wider.
    for k in ("label", "short"):
        t[k + "W"] = (1 if k == "short" else 2) + sum(1.5 if ch.isupper() or ch in "mw" else 1 for ch in t[k])
    if id in jobs or len(tabs) == 8:
        return None
    tabs.append(t)
    jobs[id] = []
    return t

HOW = {"": ("hacker news", "hn"), "show": ("show hn", "show"), "ask": ("ask hn", "ask"), "best": ("hn best", "best")}

for line in lines("news", ["feeds", "hn", "lobsters"]):
    w = line.split()
    kind, arg, label = w[0].lower(), w[1] if len(w) > 1 else "", " ".join(w[2:])
    if kind == "mute":
        mutes.append(words(" ".join(w[1:])))
    elif kind in ("feeds", "feed"):
        t = tab("feed", "feed", "", c=0)
        if t:
            # Queued after the single sources, so a long feed list cannot keep them waiting.
            t["urls"] = lines("feeds", [])
    elif kind == "hn" and arg.lower() in HOW:
        how = arg.lower()
        t = tab("hn:" + how if how else "hn", HOW[how][0], HOW[how][0] if how else "hn", HOW[how][1], 1)
        if t:
            jobs[t["id"]].append(pool.submit(hn, t, how))
    elif kind == "lobsters" and re.fullmatch("[a-z0-9_,-]*", arg.lower()):
        tag = arg.lower()
        t = tab("lobsters:" + tag if tag else "lobsters", label or tag or "lobsters", "lobsters", (label or tag)[:6].strip(), 2)
        if t:
            jobs[t["id"]].append(pool.submit(lobsters, t, tag))
    elif kind == "reddit":
        subs = re.sub("^/?r/", "", arg)
        if re.fullmatch("[A-Za-z0-9_+]+", subs):
            t = tab("reddit", label or ("reddit" if "+" in subs else "r/" + subs), "reddit", label[:6].strip() or "reddit", key=subs)
            # Reddit only answers its feeds without an account (so no points), and one request a minute:
            # for 10 minutes after an answer it is not asked again.
            if t and (saved(t) is None or now - saved(t)["at"] > 600):
                jobs["reddit"].append(pool.submit(feed, t, "https://www.reddit.com/r/" + subs + "/hot.rss?limit=20", 20, False))
            elif t:
                t["held"] = True
    elif kind == "rss" and web(arg):
        name = label or urlsplit(arg).netloc.removeprefix("www.")
        t = tab("rss:" + arg, name, name, name[:6].strip())
        if t:
            jobs[t["id"]].append(pool.submit(feed, t, web(arg), 20, False))

for t in tabs:
    for u in t.pop("urls", []):
        jobs["feed"].append(pool.submit(feed, t, u, 4))

# One deadline for everything: what has not answered by then is left out, and the rest is still shown.
done = wait([f for fs in jobs.values() for f in fs], timeout=25).done

posts, keep, shown = {}, {}, set()
for t in tabs:
    got = [p for f in jobs[t["id"]] if f in done and not f.exception() for p in f.result()]
    if t["id"] == "feed":
        got.sort(key=lambda p: -p["at"])
    seen = set()
    got = [p for p in got if not (p["id"] in seen or seen.add(p["id"]))][:40]
    held, o = t.pop("held", False), saved(t)
    t["saved"] = False
    if got:
        keep[t["id"]] = {"key": t["key"], "at": now, "posts": got}
    elif o and (held or jobs[t["id"]]):
        # Nothing came back (or Reddit was not asked): the posts of last time, marked as saved unless they are just held.
        got, keep[t["id"]], t["saved"] = o["posts"], o, not held
    del t["key"]
    posts[t["id"]] = [p for p in got if not any(m in words(p["title"]) for m in mutes)]
    # A post that an earlier tab already has stays in its own tab, but is left out of the all tab.
    for p in posts[t["id"]]:
        p["dup"] = p["url"] in shown
        shown.add(p["url"])
try:
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    with open(CACHE + ".tmp", "w") as f:
        json.dump(keep, f)
    os.replace(CACHE + ".tmp", CACHE)
except Exception:
    pass
print(json.dumps({"tabs": tabs, "posts": posts}))
sys.stdout.flush()
# Does not wait for the fetches still running.
os._exit(0)
'
  """) every 15m json timeout 40s
  source now = clock every 60s

  state tab = "all" persist
  // The links of the posts that were opened, newest first: their titles are dimmed.
  state seen = [] persist

  let tabs = news.tabs ?? []
  let cur = tabs.any(t => t.id == tab) ? tab : "all"
  let all = flatten(tabs.map(t => get(news.posts, t.id, []))).filter(p => !p.dup).sortBy(p => -p.at).take(60)
  let items = cur == "all" ? all : (get(news.posts, cur, []) ?? [])
  // True when what is shown is what was saved from an earlier answer, because nothing came back this time.
  let saved = cur == "all" ? len(tabs) > 0 && tabs.all(t => t.saved) : tabs.any(t => t.id == cur && t.saved)
  let tints = [accent, orange, red, blue, green, magenta, cyan, yellow]
  let slim = (cols ?? 6) < 5

  component Tab(id, label, tint, big = false) {
    Text {
      text: label; fontSize: big ? 15 : slim && len(tabs) > 5 ? 10.5 : 12; align: center; bold: cur == id; maxLines: 1
      color: cur == id ? tint : muted
      onTap: tab = id
    }
  }

  component Tabs(short = false, big = false) {
    Row {
      gap: 0
      Tab { id: "all"; label: "all"; tint: foreground; big: big; weight: short ? 3.5 : 4.5 }
      for t in tabs key t.id {
        Tab { id: t.id; label: short ? t.short : t.label; tint: tints[t.c]; big: big; weight: short ? t.shortW : t.labelW }
      }
    }
  }

  component Posts(big = false) {
    Column {
      scroll: true
      gap: big ? 12 : 6
      if news == null {
        Text { text: "loading…"; style: small }
      } else {
        if len(items) == 0 {
          if cur == "feed" {
            Text { text: "nothing loaded: tap to check the feed list"; style: small; onTap: terminal('$EDITOR ~/.config/omarchy-proot/feeds', "feeds") }
          } else {
            Text { text: "nothing to show: tap to retry"; style: small; onTap: refresh() }
          }
        } else {
          if saved {
            Text { text: "no answer: these are saved posts, tap to retry"; style: small; onTap: refresh() }
          }
        }
      }
      for p in items key p.id {
        let age = now - p.at
        let read = indexOf(seen, p.url) >= 0
        Column {
          gap: 0
          onTap: { seen = read ? seen : take(flatten([[p.url], seen]), 150); url(p.url) }
          Text { text: p.title; fontSize: big ? 16 : 13; maxLines: big ? 3 : 2; color: read ? muted : foreground }
          Row {
            gap: 6
            Text {
              text: cur != "all" || p.src == "" ? p.label : p.label == "" ? p.src : "${p.src} · ${p.label}"
              fontSize: big ? 12 : 10; color: tints[p.c]; maxLines: 1; weight: 1
            }
            if p.pts != null {
              Text {
                text: slim && !big ? "${p.pts}p · ${p.com}c" : "${p.pts} pts · ${p.com} com"
                fontSize: big ? 12 : 10; color: muted; width: big ? 150 : slim ? 80 : 124; align: end; maxLines: 1
                onTap: { seen = read ? seen : take(flatten([[p.url], seen]), 150); url(p.disc) }
              }
            }
            Text {
              text: p.at == 0 ? "" : age < 3600 ? "${max(floor(age / 60), 1)}m" : age < 86400 ? "${floor(age / 3600)}h" : "${floor(age / 86400)}d"
              fontSize: big ? 12 : 10; color: muted; width: big ? 34 : 28; align: end
            }
          }
        }
      }
    }
  }

  Column {
    gap: 4
    Row {
      gap: 0
      align: center
      Tabs { short: slim || len(tabs) > 4; weight: 1 }
      // Opens the full-screen view.
      Canvas {
        width: 22; height: 14
        onTap: screen()
        rect(7, 2, 10, 10, stroke: muted, width: 1.5)
      }
    }
    Posts { weight: 1 }
    if cur == "feed" && len(items) > 0 {
      Text { text: "edit the feed list"; fontSize: 10; color: muted; align: end; onTap: terminal('$EDITOR ~/.config/omarchy-proot/feeds', "feeds") }
    }
  }

  screen {
    title: "news"
    Column {
      gap: 10
      Tabs { short: len(tabs) > 5; big: true }
      Posts { big: true; weight: 1 }
      Row {
        gap: 8
        Button { text: "sources"; onTap: terminal('$EDITOR ~/.config/omarchy-proot/news', "news") }
        Button { text: "feeds"; onTap: terminal('$EDITOR ~/.config/omarchy-proot/feeds', "feeds") }
        Button { text: "refresh"; onTap: refresh() }
        Button { text: "close"; onTap: close() }
      }
    }
  }
}
