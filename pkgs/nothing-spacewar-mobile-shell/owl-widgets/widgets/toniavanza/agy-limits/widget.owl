widget "agy limits" {
  size: 6x4
  minSize: 3x3

  meta { owl: 4; description: "Antigravity CLI usage limits: 5-hour and weekly for each model group, with reset times. Uses agy's login on this device"; version: "1.0"; license: "MIT"; category: "dev" }
  requires { pacman: ["jq"] }

  source now = clock every 30s

  // Same numbers as /usage in agy. In print mode the slash command runs without a model
  // turn, with the account agy is signed into: no tokens spent.
  source u = cmd("""
    command -v agy >/dev/null || { echo '{"error":"agy not installed"}'; exit 0; }
    [ -s ~/.gemini/antigravity-cli/antigravity-oauth-token ] || { echo '{"error":"not logged in: open agy"}'; exit 0; }
    cd ~ && agy --output-format json --print-timeout 25s --print /usage 2>/dev/null |
      jq -ce '{limits: [.command.data.groups[] | (.name | ascii_downcase | sub(" models$"; "") | sub(" and "; " & ")) as $g |
        .buckets | sort_by(.window != "5h") | .[] | {
          label: "\($g) · \(if .window == "5h" then "5h" elif .window == "weekly" then "week" else .window end)",
          short: "\($g) · \(if .window == "5h" then "5h" elif .window == "weekly" then "wk" else .window end)",
          pct: ((1 - .remaining_fraction) * 100 | round),
          resets: (if .reset_time then .reset_time | sub("\\.[0-9]+"; "") | fromdateiso8601 else null end)}]}' ||
      echo '{"error":"usage unavailable"}'
  """) every 5m json timeout 40s

  let limits = u.limits ?? []

  // Under 4 rows the reset time moves next to the bar, so all four limits fit in 3x3.
  let compact = rows != null && rows < 4

  component Limit(label, pct, resets) {
    Column {
      gap: 2
      Row {
        gap: 6
        Text { text: label; style: label; weight: 1; maxLines: 1 }
        Text { text: "${pct}%"; fontSize: 14; width: 44; align: end; color: pct >= 90 ? red : pct >= 70 ? yellow : foreground }
      }
      if compact {
        Row {
          gap: 6
          align: center
          Column {
            weight: 1
            Progress { value: pct; color: pct >= 90 ? red : pct >= 70 ? yellow : accent; animate value: spring() }
          }
          if resets != null {
            Text { text: resets > now ? fmtDuration(resets - now) : "reset"; fontSize: 11; color: muted; width: 52; align: end; maxLines: 1 }
          }
        }
      } else {
        Progress { value: pct; color: pct >= 90 ? red : pct >= 70 ? yellow : accent; animate value: spring() }
        if resets != null {
          Text { text: resets > now ? "resets in ${fmtDuration(resets - now)}" : "reset"; fontSize: 11; color: muted }
        }
      }
    }
  }

  onTap: refresh()

  Column {
    gap: compact ? 6 : 8
    Text { text: "agy limits"; style: muted }
    if u.error != null {
      Text { text: u.error; color: red }
    }
    for l in limits key l.label {
      Limit { label: compact || (cols != null && cols < 4) ? l.short : l.label; pct: l.pct; resets: l.resets }
    }
  }
}
