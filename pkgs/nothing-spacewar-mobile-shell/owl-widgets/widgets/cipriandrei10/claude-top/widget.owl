widget "claude top" {
  size: 6x3
  minSize: 3x2

  meta { owl: 6; description: "htop for Claude Code: every running instance with its status, folder, window, CPU and memory. Tap for details, the last prompt and kill"; version: "1.0"; license: "MIT"; category: "dev" }
  requires { pacman: ["jq", "procps-ng"] }

  // Claude Code registers each running instance in ~/.claude/sessions/<pid>.json (name, folder,
  // busy/idle). This adds CPU over one second, memory, the window it runs in (the foot terminal's
  // app id, found up the parent chain) and the last prompt typed into it.
  source ps = cmd("""
    pids=$(pgrep -x claude)
    [ -n "$pids" ] || { echo '[]'; exit 0; }
    t1=""; for p in $pids; do t1="$t1 $(awk '{print $14+$15}' /proc/$p/stat 2>/dev/null || echo 0)"; done
    sleep 1
    set -- $t1
    hz=$(getconf CLK_TCK)
    home=$(getent passwd "$(id -u)" | cut -d: -f6)
    for p in $pids; do
      a=$1; shift
      b=$(awk '{print $14+$15}' /proc/$p/stat 2>/dev/null) || continue
      read rss et tty <<<"$(ps -o rss=,etimes=,tty= -p "$p")"
      where=""; q=$p
      for i in 1 2 3 4 5 6; do
        q=$(awk '{print $4}' /proc/$q/stat 2>/dev/null)
        [ -n "$q" ] && [ "$q" -gt 1 ] || break
        c=$(tr '\0' ' ' </proc/$q/cmdline 2>/dev/null)
        case $c in foot*--app-id=*) where=${c#*--app-id=}; where=${where%% *}; break ;; esac
      done
      f=~/.claude/sessions/$p.json; [ -f "$f" ] || f=/dev/null
      sid=$(jq -r '.sessionId // empty' "$f" 2>/dev/null)
      last=""; [ -n "$sid" ] && last=$(tac ~/.claude/history.jsonl 2>/dev/null | grep -m1 -F "\"sessionId\":\"$sid\"" | jq -r '.display // empty' | head -c 200)
      jq -n -c --argjson pid "$p" --argjson cpu "$(( (b - a) * 100 / hz ))" --argjson rss "${rss:-0}" --argjson up "${et:-0}" \
        --arg home "$home" --arg tty "$tty" --arg where "$where" --arg last "$last" --arg cwd "$(readlink /proc/$p/cwd)" \
        --slurpfile s <(cat "$f" 2>/dev/null || true) \
        '($s[0] // {}) as $s | {pid: $pid, cpu: $cpu, mem: ($rss * 1024), up: $up, tty: $tty, where: $where, last: $last,
          sid: ($s.sessionId // ""), name: ($s.name // "claude"), status: ($s.status // "unknown"), cwd: ($s.cwd // $cwd),
          dir: (($s.cwd // $cwd) as $c | if $home != "" and ($c == $home or ($c | startswith($home + "/"))) then "~" + $c[($home | length):] else $c end),
          version: ($s.version // ""), since: (($s.statusUpdatedAt // 0) / 1000 | floor), started: (($s.startedAt // 0) / 1000 | floor)}'
    done | jq -s -c 'sort_by(-.started)'
  """) every 5s json timeout 20s

  source now = clock every 5s
  state confirm = 0

  let all = (ps ?? []).map(p => {
    pid: p.pid, cpu: p.cpu, mem: p.mem, up: p.up, last: p.last, sid: p.sid, name: p.name, status: p.status,
    cwd: p.cwd, version: p.version, since: p.since,
    dir: p.dir,
    where: startsWith(p.where, "omarchy.tile") ? "home tile" : p.where == "omarchy.claude-new-widget" ? "widget agent" : startsWith(p.where, "omarchy.") ? sub(p.where, 8) : p.where != "" ? p.where : p.tty != "" && p.tty != "?" ? p.tty : "background",
    tint: p.status == "busy" ? green : p.status == "idle" ? muted : yellow
  })
  let busy = count(all, p => p.status == "busy")
  let idle = all.filter(p => p.status == "idle")
  let totalMem = sum(all.map(p => p.mem))

  onTap: screen()

  component Dot(tint, sz = 8) {
    Spacer { width: sz; height: sz; radius: sz / 2; background: tint }
  }

  // ---------- tile ----------
  Column {
    gap: 4
    Row {
      gap: 6
      align: center
      Text { text: "claude"; style: label; color: accent; width: 56 }
      Text {
        text: ps == null ? "…" : len(all) == 0 ? "none running" : "${len(all)} running · ${busy} busy"
        style: small
        color: muted
        weight: 1
        maxLines: 1
      }
      if (cols ?? 6) >= 5 && len(all) > 0 {
        Text { text: fmtBytes(totalMem); style: small; color: muted; width: 56; align: end }
      }
    }
    if ps != null && len(all) == 0 {
      Spacer { weight: 1 }
      Text { text: "no Claude Code running"; style: small; color: muted; align: center }
      Spacer { weight: 1 }
    }
    Column {
      gap: 4
      weight: 1
      clip: true
      for p in all key p.pid {
        Column {
          gap: 0
          Row {
            gap: 6
            align: center
            Dot { tint: p.tint }
            Text { text: p.name; style: small; weight: 1; maxLines: 1 }
            if (cols ?? 6) >= 5 {
              Text { text: p.where; style: small; color: muted; width: 96; maxLines: 1 }
            }
            Text { text: "${p.cpu}%"; style: small; color: p.cpu >= 50 ? yellow : muted; width: 40; align: end }
            if (cols ?? 6) >= 4 {
              Text { text: fmtBytes(p.mem); style: small; color: muted; width: 48; align: end }
            }
          }
          if (rows ?? 3) >= 3 && p.last != "" {
            Text { text: p.last; style: small; color: muted; maxLines: 1; padding: [14, 0, 0, 0] }
          }
        }
      }
    }
  }

  // ---------- full screen ----------
  screen {
    title: "claude top"
    Column {
      gap: 10
      padding: 4
      Row {
        gap: 8
        align: center
        Text { text: "${len(all)} running · ${busy} busy · ${len(idle)} idle · ${fmtBytes(totalMem)}"; style: small; color: muted; weight: 1 }
        if len(idle) > 0 {
          if confirm == -1 {
            Button { text: "close ${len(idle)} idle?"; color: red; onTap: { run("for p in $(echo ${sh(join(idle.map(p => str(int(p.pid))), " "))}); do [ \"$(cat /proc/$p/comm 2>/dev/null)\" = claude ] && kill $p; done"); confirm = 0 } }
            Button { text: "no"; color: muted; onTap: confirm = 0 }
          } else {
            Button { text: "close idle"; color: muted; onTap: confirm = -1 }
          }
        }
      }
      Column {
        gap: 8
        weight: 1
        scroll: true
        if ps != null && len(all) == 0 {
          Text { text: "No Claude Code instance is running."; style: body; color: muted }
        }
        for p in all key p.pid {
          Column {
            gap: 4
            padding: [12, 10]
            border: 1
            borderColor: alpha(p.tint, 0.5)
            Row {
              gap: 8
              align: center
              Dot { tint: p.tint; sz: 10 }
              Text { text: p.name; style: body; weight: 1; maxLines: 1 }
              Text {
                text: p.since > 0 ? "${p.status} ${fmtDuration(max(0, now - p.since))}" : p.status
                style: small
                color: p.tint
                width: 120
                align: end
                maxLines: 1
              }
            }
            Text { text: p.dir; style: small; font: mono; maxLines: 2 }
            Text {
              text: "${p.where} · pid ${p.pid} · up ${fmtDuration(p.up)} · ${p.cpu}% cpu · ${fmtBytes(p.mem)}"
              style: small
              color: muted
              maxLines: 2
            }
            if p.last != "" {
              Text { text: "› ${p.last}"; style: small; italic: true; maxLines: 3 }
            }
            Row {
              gap: 8
              if confirm == p.pid {
                Button { text: "kill ${p.name}?"; color: red; onTap: { run("p=${int(p.pid)}; [ \"$(cat /proc/$p/comm 2>/dev/null)\" = claude ] && kill $p"); confirm = 0 } }
                Button { text: "no"; color: muted; onTap: confirm = 0 }
              } else {
                Button { text: "kill"; color: red; onTap: confirm = p.pid }
              }
              if p.sid != "" {
                Button { text: "copy resume"; color: muted; onTap: copy("cd ${sh(p.cwd)} && claude --resume ${sh(p.sid)}") }
              }
            }
          }
        }
      }
    }
  }
}
