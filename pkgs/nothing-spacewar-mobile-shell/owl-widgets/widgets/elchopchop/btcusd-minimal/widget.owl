widget "btc" {
  size: 1x1
  minSize: 1x1
  padding: 6

  meta {
    owl: 5
    description: "The live BTC/USD price from Coinbase in a tiny 1x1 tile, green if it rose over the last 24 hours and red if it fell."
    version: "1.1"
    license: "MIT"
    category: "world"
  }

  // Fetched by Android itself; no shell and no packages needed.
  // `open` is the price 24 hours ago, `last` the current one.
  source st = http("https://api.exchange.coinbase.com/products/BTC-USD/stats") every 1m json timeout 10s status

  let last = num(st.out.last)
  let open = num(st.out.open)
  let price = last == null ? "…" : last >= 1000 ? "$${fixed(last / 1000, 1)}k" : "$${round(last)}"
  let dir = last == null || open == null ? null : last > open ? "up" : last < open ? "down" : "flat"
  let tint = dir == "up" ? green : dir == "down" ? red : foreground

  Column {
    fill: true
    gap: 1
    align: center
    justify: center
    Text { text: "BTCUSD"; style: label; color: accent }
    Text { text: price; fontSize: 13; bold: true; color: tint; maxLines: 1 }
  }
}
