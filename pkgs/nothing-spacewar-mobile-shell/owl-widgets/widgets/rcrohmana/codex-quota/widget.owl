widget "codex quota" {
  size: 6x4
  minSize: 3x4
  padding: 10
  meta { description: "Codex 5-hour and weekly usage from the account signed into Codex CLI, with reset times and explicit auth status"; version: "1.4"; license: "MIT"; category: "dev" }
  requires { pacman: ["bash", "python"] }

  source now = clock every 30s
  // Read-only: never refresh or modify Codex credentials. Codex owns token refresh.
  // Only normalized quota data leaves this command; credentials stay local.
  source u = cmd("""
    python - <<'PY'
import base64, json, os, time, urllib.request, urllib.error

def emit(**data):
    print(json.dumps(data))

def main():
    path = os.path.join(os.path.expanduser(os.environ.get('CODEX_HOME', '~/.codex')), 'auth.json')
    try:
        auth = json.load(open(path))
    except (OSError, ValueError):
        emit(error='Sign in to Codex CLI to view quota.', checked=time.time())
        return
    credential = auth.get('tokens') or {}
    token = credential.get('access_token')
    if not token:
        emit(error='Use ChatGPT login in Codex CLI, not an API key.', checked=time.time())
        return
    claims = {}
    try:
        claims = json.loads(base64.urlsafe_b64decode(token.split('.')[1] + '==='))
    except (ValueError, IndexError):
        pass
    if claims.get('exp', time.time() + 60) <= time.time():
        emit(error='Session expired. Open Codex to refresh your login.', checked=time.time())
        return
    headers = {'Authorization': 'Bearer ' + token, 'Accept': 'application/json', 'User-Agent': 'codex-quota-widget'}
    # Always test the quota endpoint itself; model access is not quota access.
    account = credential.get('account_id') or claims.get('https://api.openai.com/auth', {}).get('chatgpt_account_id')
    if account:
        headers['ChatGPT-Account-Id'] = account
    request = urllib.request.Request('https://chatgpt.com/backend-api/wham/usage', headers=headers)
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            data = json.load(response)
    except urllib.error.HTTPError as error:
        message = 'Session rejected (HTTP 401). Check your Codex login.' if error.code == 401 else 'Quota access denied (HTTP %s)'  % error.code
        emit(error=message, checked=time.time())
        return
    except (urllib.error.URLError, TimeoutError, OSError, ValueError):
        emit(error='Could not fetch quota. Check your connection.', checked=time.time())
        return
    rate = data.get('rate_limit') or {}
    windows = [rate.get('primary_window'), rate.get('secondary_window')]
    def window(seconds):
        w = next((w for w in windows if isinstance(w, dict) and w.get('limit_window_seconds') == seconds), None)
        if not w or not isinstance(w.get('used_percent'), (int, float)):
            return None
        return {'pct': w['used_percent'], 'reset': w.get('reset_at') or (time.time() + w['reset_after_seconds'] if isinstance(w.get('reset_after_seconds'), (int, float)) else None)}
    emit(five=window(18000), week=window(604800), plan=data.get('plan_type'), checked=time.time(), error=None if any(windows) else 'No quota limits returned by the API.')

try:
    main()
except Exception:
    emit(error='Unexpected quota response. Try again later.', checked=time.time())
PY
  """) every 5m json timeout 25s

  let quotaError = u.error ?? (u != null && u.five == null && u.week == null ? "No quota available for this Codex account." : null)

  component Limit(label, data) {
    let remaining = data.pct == null ? null : clamp(100 - data.pct, 0, 100)
    let tint = remaining == null ? muted : remaining <= 10 ? red : remaining <= 30 ? yellow : accent
    Column {
      padding: cols < 4 ? 6 : 10
      gap: cols < 4 ? 3 : 5
      background: surface
      radius: 8
      border: 1
      borderColor: border
      fill: true
      if cols < 4 {
        Row {
          align: center
          gap: 4
          Text { text: label; fontSize: 9; bold: true; color: muted; weight: 1 }
          Text { text: remaining == null ? "—" : "${round(remaining)}%"; fontSize: 20; bold: true; color: tint; width: 52; align: end }
          Text { text: "left"; fontSize: 9; color: muted; width: 20 }
        }
      } else {
        Text { text: label; fontSize: 10; bold: true; color: muted }
        Row {
          align: bottom
          gap: 4
          Text { text: remaining == null ? "—" : "${round(remaining)}%"; fontSize: 28; bold: true; color: tint; weight: 1 }
          Text { text: "left"; fontSize: 11; color: muted; width: 26 }
        }
        Spacer { weight: 1 }
      }
      Progress { value: remaining ?? 0; color: tint; track: background; fill: width; height: 5; animate value: spring() }
      Text { text: data.pct == null ? "Not available" : data.reset == null ? "Reset time unavailable" : data.reset > now ? "Resets in ${fmtDuration(data.reset - now)}" : "Awaiting reset update"; fontSize: 10; color: muted; maxLines: 2 }
    }
  }

  onTap: refresh()
  Column {
    gap: cols < 4 ? 5 : 8
    fill: true
    Row {
      align: center
      Text { text: "CODEX QUOTA"; fontSize: 12; bold: true; color: foreground; weight: 1 }
      Text { text: u == null ? "…" : quotaError != null ? "OFFLINE" : upper(u.plan ?? "CODEX"); fontSize: 10; bold: true; width: 65; align: end; color: quotaError != null ? yellow : accent }
    }
    if u.five != null || u.week != null {
      if cols >= 4 {
        Row {
          gap: 8
          weight: 1
          fill: width
          Limit { label: "5-HOUR LIMIT"; data: u.five; weight: 1; fill: height }
          Limit { label: "WEEKLY LIMIT"; data: u.week; weight: 1; fill: height }
        }
      } else {
        Column {
          gap: 5
          weight: 1
          fill: width
          Limit { label: "5-HOUR LIMIT"; data: u.five; weight: 1; fill: width }
          Limit { label: "WEEKLY LIMIT"; data: u.week; weight: 1; fill: width }
        }
      }
    } else {
      Column {
        weight: 1
        fill: width
        padding: 12
        gap: 8
        background: surface
        radius: 8
        justify: center
        Text { text: u == null ? "Fetching quota…" : "Quota unavailable"; fontSize: 20; bold: true }
        Text { text: quotaError ?? "Connecting to your Codex account."; fontSize: 12; color: quotaError != null ? yellow : muted; maxLines: 4 }
      }
    }
    Row {
      align: center
      Text { text: u == null ? "Loading…" : "${fmtTime(u.checked, 'HH:mm')} · Tap to refresh"; fontSize: 9; color: muted; weight: 1 }
      Text { text: "Usage ↗"; fontSize: 10; color: accent; width: 54; align: end; onTap: url("https://chatgpt.com/settings/usage") }
    }
  }
}
