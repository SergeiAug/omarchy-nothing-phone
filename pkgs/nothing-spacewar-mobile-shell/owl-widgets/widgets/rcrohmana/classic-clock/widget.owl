// Based on "digital clock" by jonasallencodes (MIT License)
widget "classic clock" {
  size: 2x2
  minSize: 2x2
  padding: 10
  meta { owl: 7; description: "Retro LCD digital clock with seven-segment 24h digits, date, seconds and your phone's brand; tap opens your clock app"; version: "1.0"; license: "MIT"; category: "time" }

  source now = clock every 1s
  source dev = android.device
  state clockPkg = "" persist
  state draft = ""
  onTap: screen()

  let hh = fmtTime(now, "HH")
  let mm = fmtTime(now, "mm")
  let ss = fmtTime(now, "ss")
  let blink = now % 2 == 0
  // English month names whatever the phone's language is
  let month = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"][num(fmtTime(now, "M")) - 1]
  let hours = [sub(hh, 0, 1), sub(hh, 1, 2)]
  let mins = [sub(mm, 0, 1), sub(mm, 1, 2)]
  let secs = [sub(ss, 0, 1), sub(ss, 1, 2)]

  let maker = lower(dev.maker ?? "")
  let model = lower(dev.model ?? "")
  let guess = contains(maker, "samsung") ? "com.sec.android.app.clockpackage" : contains(maker, "google") || contains(model, "pixel") ? "com.google.android.deskclock" : contains(maker, "xiaomi") || contains(maker, "redmi") || contains(maker, "poco") ? "com.android.deskclock" : contains(maker, "motorola") || contains(maker, "moto") ? "com.google.android.deskclock" : ""
  let effective = clockPkg == "" ? guess : clockPkg

  // Seven-segment digits drawn as slanted hexagons, with the unlit segments
  // showing faintly like an old LCD. A "" digit draws only the ghost.
  component Seven(digits, colon = false, dot = true, lit = accent) {
    Canvas {
      let seg = {
        a: [[0.135, 0.11], [0.245, 0], [0.755, 0], [0.865, 0.11], [0.755, 0.22], [0.245, 0.22]],
        g: [[0.135, 1], [0.245, 0.89], [0.755, 0.89], [0.865, 1], [0.755, 1.11], [0.245, 1.11]],
        d: [[0.135, 1.89], [0.245, 1.78], [0.755, 1.78], [0.865, 1.89], [0.755, 2], [0.245, 2]],
        f: [[0.11, 0.245], [0.22, 0.355], [0.22, 0.755], [0.11, 0.865], [0, 0.755], [0, 0.355]],
        b: [[0.89, 0.245], [1, 0.355], [1, 0.755], [0.89, 0.865], [0.78, 0.755], [0.78, 0.355]],
        e: [[0.11, 1.135], [0.22, 1.245], [0.22, 1.645], [0.11, 1.755], [0, 1.645], [0, 1.245]],
        c: [[0.89, 1.135], [1, 1.245], [1, 1.645], [0.89, 1.755], [0.78, 1.645], [0.78, 1.245]]
      }
      let names = ["a", "b", "c", "d", "e", "f", "g"]
      let map = ["abcdef", "bc", "abdeg", "abcdg", "bcfg", "acdfg", "acdefg", "abc", "abcdefg", "abcdfg"]
      let xs = colon ? [0, 1.3, 3.0, 4.3] : [0, 1.3]
      let sk = 0.1
      let span = (colon ? 5.3 : 2.3) + 2 * 0.92 * sk
      let w = min(width / span, height / 1.84)
      let u = w * 0.92
      let ox = (width - span * w) / 2
      let oy = (height - 2 * u) / 2
      let ghost = alpha(lit, 0.09)
      for d, i in digits {
        let on = d == "" ? "" : map[num(d)]
        for s in names {
          path(seg[s].map(p => [ox + (xs[i] + p[0]) * w + (2 - p[1]) * u * sk, oy + p[1] * u]), closed: true, fill: contains(on, s) ? lit : ghost)
        }
      }
      if colon {
        let cs = w * 0.2
        for y in [0.6, 1.4] {
          rect(ox + 2.65 * w + (2 - y) * u * sk - cs / 2, oy + y * u - cs / 2, cs, cs, radius: cs * 0.3, fill: dot ? lit : ghost)
        }
      }
    }
  }

  // a 1-row tile only fits the digits; 2x2 and up get the date, brand and seconds
  let compact = (rows ?? 2) < 2

  Column {
    fill: true
    gap: 5
    if !compact {
      Row {
        align: center
        gap: 2
        Text { text: upper(fmtTime(now, "EEE")); font: mono; bold: true; fontSize: 10; color: accent; weight: 1; maxLines: 1 }
        Text { text: "${month} ${fmtTime(now, "d")}"; font: mono; fontSize: 10; color: muted; width: 48; align: end; maxLines: 1 }
      }
    }
    Row {
      weight: 1
      fill: width
      gap: 4
      align: center
      Box {
        weight: 1
        fill: height
        background: alpha(accent, 0.05)
        border: 1
        borderColor: alpha(accent, 0.25)
        radius: 6 * corners
        padding: [6, 6]
        Seven { digits: flatten([hours, mins]); colon: true; dot: blink; fill: true }
        // the digits open the clock app; without one known, the tile's tap opens the screen
        if effective != "" {
          Box { fill: true; onTap: androidApp(effective) }
        }
      }
    }
    if !compact {
      Row {
        align: center
        gap: 4
        Text { text: upper(dev.maker ?? ""); font: mono; bold: true; fontSize: 10; color: foreground; weight: 1; maxLines: 1 }
        Seven { digits: secs; lit: muted; width: 24; height: 16 }
      }
    }
  }

  screen {
    title: "classic clock"
    Column {
      scroll: true
      gap: 10
      Seven { digits: flatten([hours, mins]); colon: true; dot: blink; fill: width; height: 120 }
      Spacer { size: 8 }
      Text { text: "clock app"; style: muted }
      Text { text: effective == "" ? "none selected yet" : effective; style: small; maxLines: 1 }
      Text { text: clockPkg == "" ? (guess == "" ? "pick one below" : "auto-selected from your phone") : "your choice"; style: small; color: muted }
      if effective != "" {
        Button { text: "open clock"; color: accent; onTap: { androidApp(effective); close() } }
      }
      Flow {
        gap: 8
        Button { text: "Samsung"; onTap: clockPkg = "com.sec.android.app.clockpackage" }
        Button { text: "Google"; onTap: clockPkg = "com.google.android.deskclock" }
        Button { text: "Xiaomi / AOSP"; onTap: clockPkg = "com.android.deskclock" }
        if clockPkg != "" {
          Button { text: "auto"; color: muted; onTap: clockPkg = "" }
        }
      }
      Text { text: "custom package"; style: muted }
      Input { text: draft; placeholder: "com.example.clock"; onChange: draft = value }
      Button { text: "use custom"; color: muted; onTap: { clockPkg = trim(draft) == "" ? clockPkg : trim(draft); draft = "" } }
      Text { text: "on the tile: tap the digits to open the clock app, tap anywhere else for this screen"; style: small; color: muted }
    }
  }
}
