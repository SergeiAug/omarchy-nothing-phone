widget "f1" {
  meta { owl: 5; description: "F1 calendar: next race countdown, results, driver and team standings"; version: "1.0"; license: "MIT"; category: "news" }

  requires { pacman: ["curl", "jq"] }

  size: 3x4
  minSize: 2x3

  source now = clock every 30s
  source sys = android.system every 1m
  source f1 = cmd("""
    curl -sf 'https://api.jolpi.ca/ergast/f1/current.json' | jq -c '{season:.MRData.RaceTable.season, races:[.MRData.RaceTable.Races[] | {gp:(.raceName|sub(" Grand Prix";"")), city:.Circuit.Location.locality, country:.Circuit.Location.country, round:(.round|tonumber), ts:(.date+"T"+(.time // "12:00:00Z")|fromdateiso8601), quali:(.Qualifying? | if . then (.date+"T"+(.time // "12:00:00Z")|fromdateiso8601) else null end), sprint:(.Sprint? | if . then (.date+"T"+(.time // "12:00:00Z")|fromdateiso8601) else null end)}]}'
  """) every 1h json
  source res = cmd("""
    off=0; tmp=$(mktemp); n=0
    while [ $n -lt 10 ] && p=$(curl -sf "https://api.jolpi.ca/ergast/f1/current/results.json?limit=100&offset=$off") && [ "$(jq '.MRData.RaceTable.Races|length' <<<"$p")" -gt 0 ]; do
      printf '%s\n' "$p" >> "$tmp"; off=$((off+100)); n=$((n+1))
    done
    jq -s '[.[].MRData.RaceTable.Races[]] | sort_by(.round|tonumber) | group_by(.round|tonumber) | map(.[0] + {Results: ([.[].Results[]] | sort_by(.position|tonumber))}) | . as $all | {races: [$all[] | {round:(.round|tonumber), country:.Circuit.Location.country, name:(.raceName|sub(" Grand Prix";"")), top3:[.Results[0:3][] | {p:(.position|tonumber), code:.Driver.code, name:.Driver.familyName, team:.Constructor.name}]}], latest: ($all[-1] | {round:(.round|tonumber), teams:([.Results[] | {(.Driver.code): .Constructor.name}] | add)})}' "$tmp"
    rm -f "$tmp"
  """) every 30m json timeout 30s
  source drv = cmd("""
    curl -sf 'https://api.jolpi.ca/ergast/f1/current/driverStandings.json' | jq -c '{drivers:[.MRData.StandingsTable.StandingsLists[0].DriverStandings[] | {pos:(.position|tonumber), code:.Driver.code, name:.Driver.familyName, team:.Constructors[0].name, pts:(.points|tonumber), wins:(.wins|tonumber)}]}'
  """) every 30m json
  source con = cmd("""
    curl -sf 'https://api.jolpi.ca/ergast/f1/current/constructorStandings.json' | jq -c '{teams:[.MRData.StandingsTable.StandingsLists[0].ConstructorStandings[] | {pos:(.position|tonumber), name:.Constructor.name, pts:(.points|tonumber), wins:(.wins|tonumber)}]}'
  """) every 30m json

  let races = f1.races ?? []
  let results = res.races ?? []
  let drivers = drv.drivers ?? []
  let teams = con.teams ?? []
  let total = f1.season != null ? (races.last() ?? {}).round ?? 0 : 0
  let next = races.find(r => r.ts > now)
  let done = count(races) > 0 && next == null
  let nextRound = next != null ? next.round : total
  let lastRace = results.last()
  let latestTeams = res.latest.teams ?? {}
  let flags = {Australia: "🇦🇺", China: "🇨🇳", Japan: "🇯🇵", USA: "🇺🇸", Canada: "🇨🇦", Monaco: "🇲🇨", Spain: "🇪🇸", Austria: "🇦🇹", UK: "🇬🇧", Belgium: "🇧🇪", Hungary: "🇭🇺", Netherlands: "🇳🇱", Italy: "🇮🇹", Azerbaijan: "🇦🇿", Malaysia: "🇲🇾", Singapore: "🇸🇬", Mexico: "🇲🇽", Brazil: "🇧🇷", Qatar: "🇶🇦", UAE: "🇦🇪"}
  let medals = ["🥇", "🥈", "🥉"]
  state view = "calendario"
  let lang = sys.locale != null && lower(sys.locale).startsWith("es") ? "es" : "en"
  let L = lang == "es"
    ? {seasonOver: "temporada terminada", quali: "clasif", in: "en", noRaces: "aún no hay carreras", wins: "victorias", gp: "gp", podios: "podios", pilotos: "pilotos", equipos: "equipos"}
    : {seasonOver: "season over", quali: "quali", in: "in", noRaces: "no races yet", wins: "wins", gp: "gp", podios: "podiums", pilotos: "drivers", equipos: "teams"}

  onTap: screen()

  Column {
    gap: 6
    Row {
      align: center
      Text { text: "f1 ${f1.season ?? ""}"; style: muted; width: 60 }
      Spacer { weight: 1 }
      Text { text: done ? "🏁" : flags[next.country] ?? "🏎️"; fontSize: 22; width: 30; align: end }
    }

    if count(races) == 0 {
      Text { text: "…"; style: title }
    } else if done {
      Text { text: L.seasonOver; style: title }
    } else {
      Text { text: "R${next.round} · ${next.gp}"; style: title; maxLines: 2 }
      Text { text: fmtTime(next.ts, "EEE d MMM · HH:mm"); style: body }
      Text { text: "${L.in} ${fmtDuration(next.ts - now)}"; style: title; color: accent }

      Column {
        gap: 4
        if next.sprint != null && next.sprint > now {
          Text { text: "sprint ${fmtTime(next.sprint, "EEE HH:mm")}"; style: label; color: background; background: orange; radius: 4; padding: [6, 2]; width: 120; align: center }
        }
        if next.quali != null && next.quali > now {
          Text { text: "${L.quali} ${fmtTime(next.quali, "EEE HH:mm")}"; style: label; color: background; background: blue; radius: 4; padding: [6, 2]; width: 120; align: center }
        }
      }
    }

    if lastRace != null {
      Row {
        gap: 6
        Text { text: flags[lastRace.country] ?? "🏁"; fontSize: 14; width: 24 }
        Column {
          gap: 0
          weight: 1
          Text { text: lastRace.name; style: label; color: muted }
          Text { text: lastRace.top3.map(t => t.code).join(" · "); style: small; maxLines: 1 }
        }
      }
    }

    Row {
      align: center
      gap: 8
      Progress { value: nextRound; max: total; color: accent; weight: 1; height: 6 }
      Text { text: "${nextRound}/${total}"; style: label; color: muted; width: 40; align: end }
    }
  }

  component Tab(t, label) {
    Text {
      text: label
      style: label
      width: 78
      align: center
      color: view == t ? background : muted
      background: view == t ? accent : surface
      radius: 4
      padding: [8, 4]
      onTap: { view = t }
    }
  }

  component DriverRow(d, teamsNow = {}) {
    Row {
      align: center
      gap: 8
      Text { text: "${d.pos}"; style: label; color: muted; width: 20 }
      Text { text: d.code; style: body; bold: d.pos <= 3; width: 42 }
      Column {
        gap: 0
        weight: 1
        Text { text: d.name; style: small }
        Text { text: lower(teamsNow[d.code] ?? d.team); style: label; color: muted }
      }
      Column {
        gap: 0
        width: 56
        Text { text: "${d.pts}"; style: body; bold: d.pos == 1; color: d.pos == 1 ? accent : foreground; align: end }
        Text { text: "${d.wins} 🏆"; style: label; color: muted; align: end }
      }
    }
  }

  component TeamRow(t) {
    Row {
      align: center
      gap: 8
      Text { text: "${t.pos}"; style: label; color: muted; width: 20 }
      Column {
        gap: 0
        weight: 1
        Text { text: t.name; style: small; bold: t.pos == 1 }
        Text { text: "${t.wins} ${L.wins}"; style: label; color: muted }
      }
      Text { text: "${t.pts}"; style: body; bold: t.pos == 1; color: t.pos == 1 ? accent : foreground; width: 56; align: end }
    }
  }

  screen {
    title: "f1 ${f1.season ?? ""}"
    Column {
      padding: 4
      gap: 8
      Row {
        gap: 6
        Tab { t: "calendario"; label: L.gp }
        Tab { t: "podios"; label: L.podios }
        Tab { t: "pilotos"; label: L.pilotos }
        Tab { t: "equipos"; label: L.equipos }
      }

      if view == "calendario" {
        Column {
          scroll: true
          weight: 1
          gap: 2
          for r in races key r.round {
            let past = r.ts <= now && (next == null || r.round < next.round)
            let isNext = next != null && r.round == next.round
            Row {
              align: center
              gap: 8
              padding: [8, 4]
              radius: 6
              background: past ? surface : (isNext ? mix(accent, background, 0.85) : null)
              Text { text: "${r.round}"; style: label; color: muted; width: 20 }
              Text { text: flags[r.country] ?? "·"; fontSize: 16; width: 26 }
              Column {
                gap: 0
                weight: 1
                Text { text: r.gp; style: past ? "small" : "body"; bold: isNext; color: past ? muted : foreground }
                Text { text: r.city; style: label; color: muted }
              }
              if r.sprint != null { Text { text: "S"; style: label; color: orange; width: 14 } }
              Text { text: fmtTime(r.ts, "d MMM"); style: small; color: past ? muted : foreground; width: 52; align: end }
            }
          }
        }
      } else if view == "podios" {
        Column {
          scroll: true
          weight: 1
          gap: 2
          if count(results) == 0 {
            Text { text: L.noRaces; style: muted }
          }
          for r in results key r.round {
            Row {
              align: center
              gap: 8
              padding: [8, 4]
              radius: 6
              Text { text: "${r.round}"; style: label; color: muted; width: 20 }
              Text { text: flags[r.country] ?? "🏁"; fontSize: 16; width: 26 }
              Column {
                gap: 0
                weight: 1
                Text { text: r.name; style: body }
                for t in r.top3 {
                  Text { text: "${medals[t.p - 1]} ${t.code} · ${t.team}"; style: label; color: t.p == 1 ? foreground : muted }
                }
              }
            }
          }
        }
      } else if view == "pilotos" {
        Column {
          scroll: true
          weight: 1
          gap: 6
          for d in drivers key d.code {
            DriverRow { d: d; teamsNow: latestTeams }
          }
        }
      } else {
        Column {
          scroll: true
          weight: 1
          gap: 6
          for t in teams key t.name {
            TeamRow { t: t }
          }
        }
      }
    }
  }
}
