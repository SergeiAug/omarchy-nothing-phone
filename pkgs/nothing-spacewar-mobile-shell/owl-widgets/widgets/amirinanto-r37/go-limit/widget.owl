widget "go limit" {
  meta {
    owl: 5
    description: "OpenCode Go usage per model: 5-hour, weekly and monthly ring gauges against that model's limits, credit left, cost sparkline. Estimated from the local opencode database."
    version: "1.3"
    license: "MIT"
    category: "dev"
  }
  page: 2
  order: 1
  size: 3x3
  minSize: 3x3

  requires { pacman: ["sqlite", "jq"] }

  // Percentage = used dollars / window limit, as on opencode.ai. Each Go model has its own
  // monthly limit; the 5h rolling window is 20% of it and the weekly window 50%.
  // Prices are Go's published per-1M-token rates (reasoning billed as output). DeepSeek models
  // are peak-hour pricing (conservative); Grok/GPT/Claude use their short-context tier.
  // Weekly = Monday 00:00 local, monthly = 1st, 5-hour = rolling.
  state sel = "glm-5.3-flash" persist

  let prices = {
    "glm-5.3-flash": {name: "GLM-5.3-Flash"; ip: 0.15; op: 0.5; cp: 0.03; wp: 0; ml: 60}
    "glm-5.3": {name: "GLM-5.3"; ip: 1.4; op: 4.4; cp: 0.26; wp: 0; ml: 15}
    "glm-5.2": {name: "GLM-5.2"; ip: 1.4; op: 4.4; cp: 0.26; wp: 0; ml: 60}
    "kimi-k3": {name: "Kimi K3"; ip: 3; op: 15; cp: 0.3; wp: 0; ml: 15}
    "kimi-k2.7-code": {name: "Kimi K2.7 Code"; ip: 0.95; op: 4; cp: 0.19; wp: 0; ml: 60}
    "longcat-2.0": {name: "LongCat-2.0"; ip: 0.3; op: 1.2; cp: 0.006; wp: 0; ml: 60}
    "longcat-2.5-preview-free": {name: "LongCat 2.5 Free"; ip: 0; op: 0; cp: 0; wp: 0; ml: null}
    "step-5-preview-free": {name: "Step 5 Free"; ip: 0; op: 0; cp: 0; wp: 0; ml: null}
    "mimo-v2.6-flash": {name: "MiMo-V2.6-Flash"; ip: 0.14; op: 0.28; cp: 0.0028; wp: 0; ml: 60}
    "mimo-v2.6-pro": {name: "MiMo-V2.6-Pro"; ip: 0.435; op: 0.87; cp: 0.003625; wp: 0; ml: 15}
    "mimo-v2.5": {name: "MiMo-V2.5"; ip: 0.14; op: 0.28; cp: 0.0028; wp: 0; ml: 60}
    "mimo-v2.5-pro": {name: "MiMo-V2.5-Pro"; ip: 0.435; op: 0.87; cp: 0.003625; wp: 0; ml: 15}
    "minimax-m3": {name: "MiniMax M3"; ip: 0.3; op: 1.2; cp: 0.06; wp: 0; ml: 60}
    "minimax-m2.7": {name: "MiniMax M2.7"; ip: 0.3; op: 1.2; cp: 0.06; wp: 0.375; ml: 60}
    "muse-spark-1.3-contributor": {name: "Muse Spark 1.3"; ip: 0.1; op: 0.2; cp: 0.002; wp: 0; ml: 60}
    "muse-spark-1.2-contributor": {name: "Muse Spark 1.2"; ip: 0.1; op: 0.2; cp: 0.002; wp: 0; ml: 60}
    "qwen3.8-max": {name: "Qwen3.8 Max"; ip: 2; op: 6; cp: 0.25; wp: 2.5; ml: 15}
    "qwen3.8-flash": {name: "Qwen3.8 Flash"; ip: 0.15; op: 0.47; cp: 0.016; wp: 0.2; ml: 30}
    "qwen3.7-plus": {name: "Qwen3.7 Plus"; ip: 0.4; op: 1.6; cp: 0.04; wp: 0.5; ml: 60}
    "deepseek-v4.1-flash": {name: "DeepSeek V4.1 Flash"; ip: 0.3; op: 1.2; cp: 0.006; wp: 0; ml: 60}
    "deepseek-v4-pro": {name: "DeepSeek V4 Pro"; ip: 1.32; op: 3.96; cp: 0.044; wp: 0; ml: 15}
    "deepseek-v4-flash": {name: "DeepSeek V4 Flash"; ip: 0.3; op: 1.2; cp: 0.006; wp: 0; ml: 30}
    "deepseek-v4-flash-vision-exp": {name: "DeepSeek V4 Flash Vis"; ip: 0.3; op: 1.2; cp: 0.006; wp: 0; ml: 15}
    "hy4-preview": {name: "Hy4 preview"; ip: 0.834; op: 2.501; cp: 0.042; wp: 0; ml: 30}
    "hy3": {name: "Hy3"; ip: 0.14; op: 0.58; cp: 0.035; wp: 0; ml: 60}
    "space-bunny": {name: "Space Bunny"; ip: 0.15; op: 0.6; cp: 0.03; wp: 0; ml: 30}
    "grok-4.7": {name: "Grok 4.7"; ip: 2; op: 6; cp: 0.5; wp: 0; ml: 15}
    "grok-4.6": {name: "Grok 4.6"; ip: 2; op: 6; cp: 0.5; wp: 0; ml: 15}
    "gpt-6-luna": {name: "GPT 6 Luna"; ip: 0.1; op: 0.5; cp: 0.01; wp: 0.125; ml: 15}
    "gpt-5.6-luna": {name: "GPT 5.6 Luna"; ip: 0.2; op: 1.2; cp: 0.02; wp: 0.25; ml: 15}
    "claude-haiku-5-5": {name: "Claude Haiku 5.5"; ip: 0.1; op: 0.5; cp: 0.01; wp: 0.125; ml: 15}
  }

  source usage = cmd("""
    db="$HOME/.local/share/opencode/opencode.db"
    if [ ! -f "$db" ]; then printf '{"models":null,"hours":null}\n'; exit 0; fi
    now=$(date +%s); h5ms=$((now*1000-18000000)); h24ms=$((now*1000-86400000))
    dow=$(date +%u)
    wk=$(date -d "$(date -d "@$((now - (dow-1)*86400))" +%F) 00:00" +%s)
    mo=$(date -d "$(date +%Y-%m-01) 00:00" +%s); moMS=$((mo*1000)); wkMS=$((wk*1000))
    earliest=$(( moMS < wkMS ? (moMS < h24ms ? moMS : h24ms) : (wkMS < h24ms ? wkMS : h24ms) ))
    sel="json_valid(data)=1 and time_created >= $earliest and json_extract(data,'$.providerID')='opencode-go' and json_extract(data,'$.role')='assistant'"
    q1="with cost as (select time_created as t, json_extract(data,'$.modelID') as m, json_extract(data,'$.tokens.input') as i, json_extract(data,'$.tokens.output')+json_extract(data,'$.tokens.reasoning') as o, json_extract(data,'$.tokens.cache.read') as c, json_extract(data,'$.tokens.cache.write') as v from message where $sel)
      select m as m,
        coalesce(sum(i) filter (where t >= $h5ms),0) as i5,
        coalesce(sum(o) filter (where t >= $h5ms),0) as o5,
        coalesce(sum(c) filter (where t >= $h5ms),0) as c5,
        coalesce(sum(v) filter (where t >= $h5ms),0) as v5,
        coalesce(sum(i) filter (where t >= $wkMS),0) as iw,
        coalesce(sum(o) filter (where t >= $wkMS),0) as ow,
        coalesce(sum(c) filter (where t >= $wkMS),0) as cw,
        coalesce(sum(v) filter (where t >= $wkMS),0) as vw,
        coalesce(sum(i) filter (where t >= $moMS),0) as im,
        coalesce(sum(o) filter (where t >= $moMS),0) as om,
        coalesce(sum(c) filter (where t >= $moMS),0) as cm,
        coalesce(sum(v) filter (where t >= $moMS),0) as vm,
        coalesce((min(t) filter (where t >= $h5ms))/1000,0) as f5
      from cost group by m order by m"
    h=$(sqlite3 --json "$db" "
      with cost as (select time_created as t, json_extract(data,'$.modelID') as m, json_extract(data,'$.tokens.input') as i, json_extract(data,'$.tokens.output')+json_extract(data,'$.tokens.reasoning') as o, json_extract(data,'$.tokens.cache.read') as c, json_extract(data,'$.tokens.cache.write') as v from message where $sel),
      used as (select distinct m from cost),
      b(i,s) as (select 0, $h24ms union all select i+1, s+3600000 from b where i < 23)
      select used.m as m, b.i as hb,
        coalesce(sum(cost.i),0) as hs,
        coalesce(sum(cost.o),0) as hos,
        coalesce(sum(cost.c),0) as hcs,
        coalesce(sum(cost.v),0) as hvs
      from used cross join b
      left join cost on cost.m = used.m and cost.t >= b.s and cost.t < b.s + 3600000
      group by used.m, b.i order by used.m, b.i
    " 2>/dev/null | jq -c 'if type == "array" then (group_by(.m) | map({m: .[0].m, hours: map([.hs, .hos, .hcs, .hvs])})) else null end')
    [ -n "$h" ] || h=null
    sqlite3 --json "$db" "$q1" 2>/dev/null | jq -c --argjson H "$h" '{models: (if type == "array" then . else null end), hours: $H}'
  """) every 2m json timeout 30s

  source now = clock every 60s

  // tokens of the selected model, and its prices/limits
  let row = usage == null ? null : (usage.models ?? []).find(x => x.m == sel)
  let P = get(prices, sel, null)
  let free = P != null && P.ml == null
  let mlim = P == null ? null : P.ml
  let cost5 = usage == null || P == null ? null : row == null ? 0 : (row.i5 * get(P, "ip") + row.o5 * get(P, "op") + row.c5 * get(P, "cp") + row.v5 * (get(P, "wp") ?? 0)) / 1000000
  let costw = usage == null || P == null ? null : row == null ? 0 : (row.iw * get(P, "ip") + row.ow * get(P, "op") + row.cw * get(P, "cp") + row.vw * (get(P, "wp") ?? 0)) / 1000000
  let costm = usage == null || P == null ? null : row == null ? 0 : (row.im * get(P, "ip") + row.om * get(P, "op") + row.cm * get(P, "cp") + row.vm * (get(P, "wp") ?? 0)) / 1000000
  let pct5 = free || cost5 == null ? null : cost5 / (P.ml / 5) * 100
  let pctw = free || costw == null ? null : costw / (P.ml / 2) * 100
  let pctm = free || costm == null ? null : costm / P.ml * 100

  component G(label, pct, cost, limit, free) {
    let tint = pct == null ? muted : pct >= 100 ? red : pct >= 80 ? orange : accent
    let left = limit == null || cost == null ? null : max(limit - cost, 0)
    Column {
      gap: 3
      weight: 1
      align: center
      Box {
        size: 60
        align: center
        Ring { fill: true; thickness: 7; value: pct == null ? 0 : min(max(pct, 0), 100); color: pct == null ? surface : tint; animate value: tween(500ms) }
        Text {
          text: pct == null ? (free ? "free" : "…") : "${fixed(pct, 0)}%"
          style: body
          color: tint
          align: center
        }
      }
      Text { text: label; style: label; color: muted }
      Text { text: free ? "free model" : cost == null || limit == null ? "…" : '$' + fixed(cost, 2) + ' of $' + fixed(limit, 2); style: small; color: muted }
      Text {
        text: free ? "unlimited" : left == null ? "…" : '$' + fixed(left, 2) + ' left'
        style: small; color: left != null && limit > 0 && left / limit <= 0.2 ? tint : muted
      }
    }
  }

  component ModelRow(id, name, pct, cost, limit, picked) {
    let tint = pct == null ? muted : pct >= 100 ? red : pct >= 80 ? orange : accent
    Row {
      gap: 8
      align: center
      padding: [6, 4]
      onTap: { sel = id; close() }
      Text { text: picked ? "●" : ""; color: accent; width: 20 }
      Text { text: name; style: body; weight: 1 }
      Text {
        text: pct == null
          ? (limit == null ? "free" : "0% · $${fixed(limit, 2)} left")
          : "${fixed(pct, 0)}% · $${fixed(max(limit - cost, 0), 2)} left"
        style: small
        color: tint
        width: 200
        align: end
      }
    }
  }

  onTap: terminal("opencode stats")

  Column {
    gap: 8
    Text {
      text: "opencode go · " + get(P, "name", sel)
      style: muted
      onTap: screen()
    }
    Row {
      gap: 4
      align: top
      G { label: "rolling"; pct: pct5; cost: cost5; limit: free ? null : mlim / 5; free: free }
      G { label: "weekly"; pct: pctw; cost: costw; limit: free ? null : mlim / 2; free: free }
      G { label: "monthly"; pct: pctm; cost: costm; limit: free ? null : mlim; free: free }
    }
    Sparkline {
      min: 0
      area: true
      color: accent
      fill: width
      weight: 1
      values: ((usage.hours ?? []).find(x => x.m == sel) ?? {hours: []}).hours.map(h => (h[0] * get(P, "ip") + h[1] * get(P, "op") + h[2] * get(P, "cp") + h[3] * (get(P, "wp") ?? 0)) / 1000000)
    }
    if pct5 != null && pct5 >= 80 {
      Text {
        text: "5h window refreshes in " + fmtDuration(max(row.f5 + 18000 - now, 0))
        style: small; color: pct5 >= 100 ? red : orange
      }
    }
  }

  screen {
    title: "opencode go models"
    Column {
      padding: 12
      scroll: true
      Text { text: "estimate for which model?"; style: muted }
      Text { text: "5h rolling · week · month, against that model's own limits"; style: small; color: muted }
      Spacer { height: 4 }
      for id in keys(prices) {
        let Pm = get(prices, id)
        let er = usage == null ? null : (usage.models ?? []).find(x => x.m == id)
        let cm = usage == null || Pm == null ? null : er == null ? 0 : (er.im * get(Pm, "ip") + er.om * get(Pm, "op") + er.cm * get(Pm, "cp") + er.vm * (get(Pm, "wp") ?? 0)) / 1000000
        let pm = Pm.ml == null || cm == null ? null : cm / Pm.ml * 100
        ModelRow { id: id; name: get(Pm, "name", id); pct: pm; cost: cm; limit: Pm.ml; picked: id == sel }
      }
    }
  }
}
