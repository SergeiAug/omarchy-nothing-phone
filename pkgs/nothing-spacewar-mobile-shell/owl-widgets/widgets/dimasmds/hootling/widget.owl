    {id: "birdhouse", kind: "home", name: "birdhouse", price: 50, lvl: 2, desc: "wooden, with a perch",
      art: ["......rr......", ".....rrrr.....", "....rrrrrr....", "...rrrrrrrr...", "..rrrrrrrrrr..", ".rrrrrrrrrrrr.", "rrrrrrrrrrrrrr",
        ".wwwwwwwwwwww.", ".wwwwwkkwwwww.", ".wwwwkkkkwwww.", ".wwwwkkkkwwww.", ".wwwwwkkwwwww.", ".wwwwwwwwwwww.", ".wwwwppppwwww.", ".wwwwwwwwwwww."],
      pal: {r: mix(red, background, 0.35), w: mix(orange, background, 0.5), k: mix(background, rgb(0, 0, 0), 0.4), p: mix(orange, foreground, 0.2)}},
    {id: "tent", kind: "home", name: "tent", price: 70, lvl: 3, desc: "camping on the branch",
      art: [".......yy.......", "......yccy......", ".....yccccy.....", "....yccccccy....", "...yccckkcccy...", "..yccckkkkcccy..", ".yccckkkkkkcccy.", "yccckkkkkkkkcccy"],
      pal: {c: mix(green, background, 0.4), y: mix(green, foreground, 0.25), k: mix(background, rgb(0, 0, 0), 0.4)}},
    {id: "igloo", kind: "home", name: "igloo", price: 100, lvl: 4, desc: "cool in summer, snug in winter",
      art: ["....wwwwwwww....", "..wwwwwwwwwwww..", ".wwwbwwwwwwbwww.", ".bbbbbbbbbbbbbb.", "wwbwwwwkkwwwwbww", "wwwwwwkkkkwwwwww", "bbbbbbkkkkbbbbbb", "wwwbwwkkkkwwbwww"],
      pal: {w: mix(cyan, foreground, 0.65), b: mix(cyan, background, 0.35), k: mix(background, rgb(0, 0, 0), 0.4)}},
    {id: "castle", kind: "home", name: "castle", price: 250, lvl: 7, desc: "its windows light up at night",
      art: ["..rrr..........rrr", "..rr...........rr.", "..t............t..", "s.s.s........s.s.s", "sssss........sssss",
        "sswssss.ss.sssswss", "sswsssssssssssswss", "sssssddddddddsssss", "ssssssswsswsssssss", "ssssssssssssssssss",
        "ssssssskkkksssssss", "ssdssskkkkkksssdss", "sssssskkkkkkssssss", "sssssskkkkkkssssss"],
      pal: {s: mix(foreground, background, 0.55), d: mix(foreground, background, 0.75), k: mix(background, rgb(0, 0, 0), 0.4), r: red, t: muted, w: mix(yellow, background, 0.55)}},
    // Toys sit beside it; it plays with one now and then.
    {id: "ball", kind: "toy", name: "bouncy ball", price: 15, lvl: 1, desc: "boing, boing",
      art: ballArt, pal: ballPal},
    {id: "yarn", kind: "toy", name: "ball of yarn", price: 20, lvl: 1, desc: "to bat about",
      art: [".mmmm..", "mnmmnm.", "mmnmmm.", "mnmmnm.", ".mmmm.n", ".....n."], pal: {m: magenta, n: mix(magenta, foreground, 0.4)}},
    {id: "teddy", kind: "toy", name: "teddy bear", price: 35, lvl: 2, desc: "a bear to cuddle",
      art: ["b.....b", "bbbbbbb", ".bkbkb.", ".bbnbb.", "bbllbbb", ".bllbb.", ".bb.bb."], pal: {b: mix(orange, background, 0.3), k: background, n: mix(orange, background, 0.75), l: mix(orange, foreground, 0.4)}},
    {id: "drum", kind: "toy", name: "drum", price: 45, lvl: 3, desc: "rat-a-tat-tat",
      art: [".s..s.", "wwwwww", "rrrrrr", "ryryry", "rrrrrr"], pal: {s: mix(foreground, background, 0.3), w: foreground, r: red, y: yellow}},
    {id: "kite", kind: "toy", name: "kite", price: 60, lvl: 4, desc: "flies high over the branch",
      art: ["...y...", "..yry..", ".yyryy.", "rrrrrrr", ".yyryy.", "..yry..", "...y...", "...t...", "..t....", "...t..."], pal: {y: yellow, r: red, t: muted}},
    {id: "robot", kind: "toy", name: "wind-up robot", price: 90, lvl: 5, desc: "beep boop",
      art: ["...a...", "..sss..", ".sksks.", ".sssss.", "s.rrr.s", "..sss..", "..s.s.."], pal: {a: red, s: mix(cyan, foreground, 0.4), k: background, r: mix(cyan, background, 0.4)}},
    {id: "charm", kind: "perk", name: "lucky clover", price: 50, lvl: 2, desc: "+50% coins from games",
      art: [".gg.gg.", ".ggggg.", "..ggg..", ".ggggg.", ".gg.gg.", "...g...", "....g.."], pal: {g: green}},
    {id: "pond", kind: "perk", name: "duck pond", price: 70, lvl: 3, desc: "poop piles up every 4 h, not 3",
      art: duckArt, pal: pal},
    {id: "blanket", kind: "perk", name: "cozy blanket", price: 90, lvl: 4, desc: "hearts drain 25% slower",
      art: ["rrrrrr", "rwrwrw", "rrrrrr", "wrwrwr", "rrrrrr"], pal: {r: mix(red, background, 0.2), w: mix(yellow, background, 0.2)}},
    // Eggs of animal friends, in petIds order. Art faces right; `k` (the eyes) is drawn
    // on its own, so they can shut them. `egg` colors the spots on the shell.
    {id: "duckling", kind: "pet", name: "duckling", price: 35, lvl: 1, desc: "baths pay 3¢ more", egg: yellow,
      art: ["....yyy.", "...yyyko", "y..yyyy.", "yyyyyyy.", ".yyyyyy.", "..o..o.."], pal: {y: yellow, o: orange}},
    {id: "turtle", kind: "pet", name: "turtle", price: 45, lvl: 1, desc: "hunger drains 20% slower", egg: green,
      art: ["...sssss....", "..sSsSsSs...", ".sssssssss.h", ".sssssssss.k", ".hh....hh..."], pal: {s: mix(green, background, 0.25), S: mix(green, yellow, 0.45), h: mix(green, foreground, 0.35)}},
    {id: "bunny", kind: "pet", name: "bunny", price: 60, lvl: 2, desc: "petting pays a coin every 3rd pet, not 5th", egg: mix(red, foreground, 0.5),
      art: [".....b.b.", ".....b.b.", ".....bbbb", "....bbbkb", "w..bbbbbn", "wbbbbbbb.", ".bbbbbbb.", ".bb...bb."], pal: {b: mix(foreground, background, 0.15), w: foreground, n: mix(red, foreground, 0.5)}},
    {id: "frog", kind: "pet", name: "frog", price: 60, lvl: 2, desc: "eats the flies: hygiene lasts 25% longer", egg: mix(green, yellow, 0.5),
      art: [".ww...ww.", ".wk...wk.", "bbbbbbbbb", "bbnnnnnbb", "bbbbbbbbb", ".lllllll.", "bb.....bb"], pal: {w: foreground, b: green, n: mix(green, background, 0.6), l: mix(green, yellow, 0.5)}},
    {id: "kitten", kind: "pet", name: "kitten", price: 80, lvl: 3, desc: "game rounds won pay 3¢, not 2", egg: orange,
      art: ["b....b..b", "b....bbbb", ".b...bkbk", ".b..bbbnb", "..bbbbbb.", "..bbbbbb.", "..b.b.bb."], pal: {b: mix(orange, foreground, 0.2), n: mix(red, foreground, 0.5)}},
    {id: "hamster", kind: "pet", name: "hamster", price: 80, lvl: 3, desc: "+10¢ on the daily bonus", egg: mix(orange, yellow, 0.4),
      art: [".e....e.", ".bbbbbb.", "bbkbbkbb", "blbnnblb", "bbllllbb", ".bbbbbb.", ".f....f."], pal: {e: mix(red, foreground, 0.5), b: mix(orange, yellow, 0.4), l: mix(yellow, foreground, 0.6), n: mix(red, foreground, 0.4), f: mix(red, foreground, 0.5)}},
    {id: "penguin", kind: "pet", name: "penguin", price: 100, lvl: 4, desc: "poop piles up 30 min slower", egg: blue,
      art: ["..bbbb..", ".bbbbbb.", ".bkwwkb.", ".bwyywb.", "bbwwwwbb", "bbwwwwbb", ".bwwwwb.", ".yy..yy."], pal: {b: mix(blue, background, 0.35), w: foreground, y: orange}},
    {id: "fox", kind: "pet", name: "fox", price: 140, lvl: 5, desc: "+50% xp from games", egg: mix(orange, red, 0.4),
      art: ["........b.b.", "........bbbb", "tt......bkbn", "ttt....bbbb.", ".ttbbbbbbb..", "..bbbbbbbl..", "...b.b.b.b.."], pal: {b: orange, t: mix(orange, foreground, 0.35), n: mix(background, foreground, 0.2), l: foreground}},
    {id: "dragon", kind: "pet", name: "baby dragon", price: 300, lvl: 8, desc: "+25% coins from care and games", egg: magenta,
      art: ["........h.h.", "..w....bbbb.", ".ww....bkbbb", "www...bbbb..", ".wwbbbbbb...", "..bbbllbb...", "bbbbllbbb...", "b..bb..bb..."], pal: {h: orange, w: mix(green, background, 0.4), b: green, l: yellow}}
  ]
  let petEgg = ["..ee..", ".eeee.", "eeseee", "eeeeee", "eeeese", "eseeee", ".eeee.", "..ee.."]
  let toyIds = ["ball", "yarn", "teddy", "drum", "kite", "robot"]
  let crumbs = {berry: mix(magenta, blue, 0.4), cake: mix(magenta, foreground, 0.35), gold: gold, star: yellow}

  let dropArt = ["..h..", "..h..", ".hhh.", "hhhhh", ".hhh."]
  component Hearts(v, glyph = heartArt, tint = red) {
    Canvas {
      height: 14
      for i in range(4) { sprite(glyph, i * 16, 1, 2.4, palette: {h: i < ceil(v) ? tint : alpha(muted, 0.3)}) }
    }
  }

  component Scene(W, H, big = false) {
    Box {
      width: W
      height: H
      align: topStart
      let n = big ? 6 : 8
      let barH = big ? 48 : clamp(floor(W / n * 0.9), 20, 28)
      let capH = big ? 24 : 15
      let SH = H - barH - capH
      let barTop = H - barH
      let slot = W / n
      // One art pixel, in dp: owl, branch and room for hearts above.
      // A home or friends on the branch need room, so the art gets smaller to make it.
      let hm = homeW != "" && homeW != "nest" ? shop.find(z => z.id == homeW) : null
      let p = clamp(floor(min(W / (hm != null ? 34 : palA != "" || palB != "" ? 28 : 24), SH / 20)), 2, big ? 16 : 14)
      let branchY = floor((SH - 3 * p) / p) * p
      // Friends and toys are drawn at half the owl's art pixel. Friends sit at the two ends of the branch.
      let cpp = max(round(p / 2), 2)
      // Its home is the middle of the branch, or just right of its house. It walks up to `roamMax`
      // art pixels either way: less with friends out, who need room to roam beside it.
      let ox = max(floor((W / 2 - aw / 2 * p) / p), hm != null ? len(hm.art[0]) - 2 : 0) * p
      let pals = palA != "" || palB != ""
      let roamMax = hm != null ? 0 : max(floor((W / p / 2 - aw / 2 - 2 - (pals ? 6 : 0)) / (pals ? 2 : 1)), 0)

      Canvas {
        width: W
        height: H
        onTap: {
          bi = y >= barTop ? clamp(floor(x / slot), 0, n - 1) : -1
          palHit = bi >= 0 || y < branchY - 12 * cpp || y > branchY + 2 * p ? -1
            : palA != "" && x < ox - p ? 0 : palB != "" && x > ox + (aw + 1) * p ? 1 : -1
          act = bi != 5 && time >= tapAt && now - tapNow < 10 && time - tapAt < get(dur, tapKind, 0) ? "none"
            : !hatched ? (bi < 0 ? "hatch" : "none")
            : bi == 5 ? "light"
            : asleep ? (bi < 0 ? "peek" : "none")
            : gameOn && !(gRound >= 5 && time - gAt > 2.6) ? (bi >= 0 || gRound >= 5 ? "quit"
                : time >= gAt && time - gAt < 1.1 ? "none" : gKind == "catch" ? "swat" : gKind == "pounce" ? "peck" : x < W / 2 ? "left" : "right")
            : inPick ? (bi >= 0 ? "back" : x < W / 3 ? "way" : x < W * 2 / 3 ? "catch" : "pounce")
            : inMenu ? (bi >= 0 ? "back" : x < W / 3 ? (foodH >= 3.5 ? "refuse" : "meal") : x < W * 2 / 3 ? "snack" : curTreat != "" ? "treat" : "notreat")
            : palHit >= 0 ? "palpet"
            : bi == 0 ? (sick ? "refuse" : "menu")
            : bi == 1 ? (sick ? "refuse" : "play")
            : bi == 2 ? "clean"
            : bi == 3 ? "bath"
            : bi == 4 ? (sick ? "med" : "refuse")
            : "pet"
          tr = act == "treat" ? curTreat : tr
          palTap = act == "palpet" ? palHit : palTap
          pressI = bi
          pressAt = bi >= 0 ? time : pressAt

          // The games. Which way's pick comes from the tap's moment, which is random enough;
          // a catch counts when the moth's middle is within 3 art pixels of the owl's; a pounce
          // when the mouse is up on the tapped side (gPos is then the side: 0 left, 1 right).
          start = act == "way" || act == "catch" || act == "pounce"
          guess = act == "left" || act == "right" || act == "swat" || act == "peck"
          gDir = act == "left" || act == "right" ? floor(time * 7919 + now * 31) % 2 : gDir
          mK = floor((time - gAt - 1.1) / mL)
          mSide = abs(sin(mK * 12.9898 + gSeed * 78.233)) * 43758.5453 % 1 < 0.5 ? 0 : 1
          mShow = time - gAt - 1.1 - mK * mL >= mL - mW && abs(sin(mK * 39.346 + gSeed * 11.135)) * 24634.6345 % 1 > 0.3
          gPos = act == "swat" ? (time - gAt < 1.1 ? 0 : 1 - abs(((time - gAt - 1.1) * ballV) % 2 - 1))
            : act == "peck" ? (x < W / 2 ? 0 : 1) : gPos
          gHist = start ? "" : !guess ? gHist
            : gHist + ((act == "swat" ? abs(3 * p + gPos * (W - 6 * p) - W / 2) <= 3 * p
              : act == "peck" ? mShow && gPos == mSide
              : (act == "left" ? 0 : 1) == gDir) ? "w" : "l")
          gRound = start ? 0 : guess ? gRound + 1 : gRound
          gAt = start || guess ? time : gAt
          gSeed = start || guess ? floor(time * 7919 + now * 31) % 997 : gSeed
          gKind = start ? act : gKind
          fin = guess && gRound >= 5
          gamesPlayed = fin ? gamesPlayed + 1 : gamesPlayed
          gamesWon = fin && gWon ? gamesWon + 1 : gamesWon

          // Coins and xp. A game pays for each round won, more for the game and a perfect one;
          // cleaning by the pile; petting a coin every fifth time. Feeding pays xp only when needed.
          // Friends out on the branch: kitten, bunny, duckling and dragon pay more; the fox adds game xp.
          gainC = round((fin ? (gWins * (outIds.indexOf("kitten") >= 0 ? 3 : 2) + (gWon ? 5 : 0) + (gWins == 5 ? 10 : 0)) * (contains(owned, ",charm,") ? 1.5 : 1)
            : act == "clean" ? poops * 2
            : act == "med" ? 3
            : act == "bath" && washH < 2 ? 2 + (outIds.indexOf("duckling") >= 0 ? 3 : 0)
            : act == "pet" && (pets + 1) % petEvery == 0 ? 1
            : 0) * (outIds.indexOf("dragon") >= 0 ? 1.25 : 1))
          coins = coins + gainC
          xp = xp + (fin ? round((4 + gWins * 2) * (outIds.indexOf("fox") >= 0 ? 1.5 : 1)) : 0) + (act == "hatch" ? 10
            : act == "meal" && foodH < 3.5 || act == "snack" && joyH < 3.5 ? 2
            : act == "treat" ? 4
            : act == "clean" ? poops * 2
            : act == "med" ? 5
            : act == "bath" && washH < 3 ? 2
            : act == "pet" && (pets + 1) % petEvery == 0 ? 1 : 0)
          cleaned = act == "clean" ? cleaned + poops : cleaned
          baths = act == "bath" ? baths + 1 : baths
          perfects = fin && gWins == 5 ? perfects + 1 : perfects
          treats = act == "treat" ? treats + 1 : treats
          qFeed = act == "meal" || act == "snack" || act == "treat" ? qFeed + 1 : qFeed
          qWin = fin && gWon ? qWin + 1 : qWin
          qPet = act == "pet" || act == "palpet" ? qPet + 1 : qPet

          // The meters, from their values now (before their times move).
          tF = foodH
          tJ = joyH
          tW = washH
          nF = act == "meal" ? min(tF + 1, 4) : act == "treat" ? (tr == "berry" ? min(tF + 1, 4) : tr == "cake" ? -1 : 4) : act == "hatch" ? 3 : -1
          nJ = act == "snack" ? min(tJ + 1, 4)
            : act == "treat" ? (tr == "berry" ? min(tJ + 0.5, 4) : tr == "cake" ? min(tJ + 2, 4) : tr == "gold" ? min(tJ + 1, 4) : 4)
            : act == "pet" ? min(tJ + 0.2, 4) : fin && gWon ? min(tJ + (gWins == 5 ? 2 : 1), 4) : act == "hatch" ? 3 : -1
          food = nF >= 0 ? nF : food
          foodAt = nF >= 0 ? now : foodAt
          foodMiss = nF >= 0 ? false : foodMiss
          joy = nJ >= 0 ? nJ : joy
          joyAt = nJ >= 0 ? now : joyAt
          joyMiss = nJ >= 0 ? false : joyMiss
          weight = act == "hatch" ? 5 : act == "meal" ? weight + 1 : act == "snack" ? weight + 2 : act == "treat" ? weight + (tr == "cake" ? 3 : tr == "gold" ? 2 : 1) : fin ? max(weight - 1, 5) : weight
          cleanN = act == "clean" ? poops : cleanN
          cleanAt = act == "clean" || act == "hatch" ? now : cleanAt
          wash = act == "bath" || act == "hatch" ? 4 : act == "clean" ? tW : wash
          washAt = act == "bath" || act == "hatch" || act == "clean" ? now : washAt
          washMiss = act == "bath" || act == "hatch" ? false : washMiss
          sick = act == "med" || act == "hatch" ? false : sick
          lightsOff = act == "light" ? !lightsOff : lightsOff
          pets = act == "pet" ? pets + 1 : act == "hatch" ? 0 : pets
          mistakes = act == "hatch" ? 0 : mistakes
          nBerry = act == "treat" && tr == "berry" ? nBerry - 1 : nBerry
          nCake = act == "treat" && tr == "cake" ? nCake - 1 : nCake
          nGold = act == "treat" && tr == "gold" ? nGold - 1 : nGold
          nStar = act == "treat" && tr == "star" ? nStar - 1 : nStar

          mode = act == "menu" ? "feed" : act == "play" ? "pick" : start || guess ? "game" : act == "none" || act == "light" ? mode : ""
          modeNow = act == "menu" || act == "play" || start || guess ? now : modeNow
          tapKind = act == "none" || act == "light" ? tapKind : act
          tapAt = act == "none" || act == "light" ? tapAt : time
          tapNow = act == "none" || act == "light" ? tapNow : now
          // `born` last: the lines before it still see the egg.
          born = act == "hatch" ? now : born
        }

        // Seconds since the last tap. `time` restarts with the frame clock (say,
        // after the page was off screen), so an old tap could look recent again:
        // the wall clock has the final say.
        let since = time >= tapAt && now - tapNow < 10 ? time - tapAt : 1000
        let anim = since < get(dur, tapKind, 0) ? tapKind : ""
        let gSince = time >= gAt && now - modeNow < 60 ? time - gAt : 1000
        let inGame = gameOn && !(gRound >= 5 && gSince > 2.6)
        let reveal = inGame && gRound > 0 && gSince < 1.1
        let gEnd = inGame && gRound >= 5
        let gDirS = gDir == 1 ? 1 : -1
        let s = p + 0.5
        let oy = branchY - ah * p + p
        // Catch: the moth's middle (0 left, 1 right), frozen where it was tapped while the
        // result shows. It waits a moment each round, then sweeps back and forth.
        let catching = inGame && gKind == "catch"
        let ballX = 3 * p + (reveal ? gPos : gSince < 1.1 ? 0 : 1 - abs(((gSince - 1.1) * ballV) % 2 - 1)) * (W - 6 * p)
        let ballY = max(oy - 4 * p, 5 * p)
        // Pounce: the same cycles as the tap handler, and how far the mouse has popped up.
        let pouncing = inGame && gKind == "pounce"
        let mT = gSince - 1.1
        let mk = floor(mT / mL)
        let mph = mT - mk * mL
        let mS = abs(sin(mk * 12.9898 + gSeed * 78.233)) * 43758.5453 % 1 < 0.5 ? 0 : 1
        let mUp = pouncing && !gEnd && !reveal && mT >= 0 && mph >= mL - mW && abs(sin(mk * 39.346 + gSeed * 11.135)) * 24634.6345 % 1 > 0.3
        let mRise = clamp((mph - mL + mW) / 0.1, 0, 1)
        let gTurn = pouncing ? (gPos == 0 ? -1 : 1) : gDirS
        let peeking = tapKind == "peek" && since < 2

        let lit = asleep || lightsOff
        // Behind everything: the rainbow by day, and its home on the branch, off to the left
        // where there's room (the nest is drawn later, in front of its feet).
        if decorW == "rainbow" && !lit {
          for c, k in [red, orange, yellow, green, blue, magenta] {
            arc(W / 2, branchY, min(W * 0.44, branchY - p) - k * p, 270, 180, stroke: alpha(c, 0.3), width: p)
          }
        }
        if hm != null {
          let hx = max(floor(ox / p - len(hm.art[0]) + 2), 0) * p
          let hy = branchY - len(hm.art) * p
          sprite(hm.art, hx, hy, p, palette: hm.pal)
          if homeW == "castle" && lit { sprite(hm.art, hx, hy, p, palette: {w: yellow}) }
        }

        // The branch, with a twig and leaves.
        rect(0, branchY, W, p * 2, fill: mix(orange, background, 0.55))
        rect(0, branchY + p, W, p, fill: mix(orange, background, 0.7))
        for l in [[0.06, -1], [0.1, 0], [0.88, -1], [0.92, -2]] {
          rect(floor(W * l[0] / p) * p, branchY + l[1] * p, 2 * p, p, fill: mix(green, background, 0.2))
        }
        // Decor from the shop.
        if decorW == "mushrooms" {
          for f, k in [0.28, 0.7, 0.8] {
            sprite(shop.find(z => z.id == "mushrooms").art, floor(W * f / p) * p, branchY - 5 * (k == 2 ? cpp : p), k == 2 ? cpp : p,
              palette: {r: k == 1 ? orange : red, w: mix(foreground, background, 0.1)})
          }
        }
        if decorW == "flowers" {
          for f, k in [0.22, 0.34, 0.64, 0.76] {
            sprite([".r.", "ryr", ".r.", ".g."], floor(W * f / p) * p, branchY - 4 * p, p,
              palette: {r: [magenta, red, cyan, yellow][k], y: k == 3 ? orange : yellow, g: green})
          }
        }
        if decorW == "lantern" {
          let lx = floor(W * 0.8 / p) * p
          sprite(shop.find(z => z.id == "lantern").art, lx, branchY - 9 * p, p, palette: {k: mix(foreground, background, 0.3), y: lit ? yellow : mix(yellow, background, 0.5)})
        }
        if decorW == "lights" {
          // A string in three swags under the coin counter, a bulb hanging from every other point.
          let ly = big ? 30 : 20
          let pts = range(25).map(k => [W * k / 24, ly + abs(sin(k / 8 * 3.1416)) * 2 * p])
          path(pts, stroke: alpha(muted, 0.6), width: 1)
          for pt, k in pts {
            if k % 2 == 1 {
              rect(pt[0] - p / 2, pt[1], p, 1.5 * p, radius: p / 3,
                fill: alpha([red, yellow, green, cyan, magenta][k % 5], 0.45 + 0.55 * abs(sin(time * 1.7 + k * 1.3))))
            }
          }
        }

        // Idle life: time runs in cycles of a few seconds. Each cycle it hops along the branch
        // to a new spot, then does something there: 0 look around, 1 hop, 2 flap, 3 turn its
        // head right round, 4 yawn, 5 preen, 6 watch a moth. Spots and acts are hashed from the
        // cycle, so nothing needs storing. It stays home with poop about, and freezes mid-tap.
        let idle = hatched && !asleep && !sick && !inGame && !inMenu && !inPick && mood != "dancing"
        let roam = idle && poops == 0 ? roamMax : 0
        let cyc = mood == "tired" ? 9 : 7
        let it = anim != "" && since < 5 ? time - since : time
        let ck = floor(it / cyc)
        let cph = it - ck * cyc
        let tx0 = round((abs(sin((ck - 1) * 12.9898 + 4.1)) * 43758.5453 % 1 * 2 - 1) * roam)
        let tx1 = round((abs(sin(ck * 12.9898 + 4.1)) * 43758.5453 % 1 * 2 - 1) * roam)
        // Walking takes at most 40% of the cycle, so there's always time left to do something.
        let walkT = min(abs(tx1 - tx0) / (mood == "tired" ? 2.5 : 4), cyc * 0.4)
        let walking = idle && cph < walkT
        let wx = idle ? (walking ? round(lerp(tx0, tx1, cph / walkT)) : tx1) * p : 0
        let wdir = sign(tx1 - tx0)
        let iaRaw = floor(abs(sin(ck * 7.233 + 1.7)) * 9631.3 % 1 * (toyW != "" ? 8 : 7))
        let ia = !idle || walking || anim != "" ? -1 : mood == "tired" ? [4, 0, 4, 5, 0, 4, 0, 7][iaRaw] : iaRaw
        let at = cph - walkT
        let turnDir = abs(sin(ck * 3.71)) * 517.3 % 1 < 0.5 ? -1 : 1
        let headBack = ia == 3 && at > 0.5 && at < 2.3
        let yawn = ia == 4 && at > 0.3 && at < 1.8
        let preen = ia == 5 && at < 2.4
        let mothOn = ia == 6 && at < cyc - walkT - 0.2
        // 7 (with a toy out): it plays with the toy, which bounces beside it.
        let toyPlay = ia == 7 && at < 2.6
        let mp = max(round(p / 2), 2)
        let mothX = ox + wx + aw / 2 * p + cos(at * 1.7) * 8 * p
        let mothY = oy - 3 * p + sin(at * 3.1) * 2 * p

        // Friends walk beside it, each on its own side and its own cycle, at an offset from the
        // owl's edge, so they tag along when it walks. Each cycle a friend strolls to a new spot,
        // or comes over (offset below 0: just in front of its edge) to nuzzle it (hearts) or to
        // play (they hop together). In games, menus or sickness they wait; at night they sleep
        // snuggled up beside it. Like the owl's, it's all hashed from the cycle, so nothing is stored.
        let night = hour >= bedH || hour < wakeH
        let fOn = [palA, palB].map(id => id != "" && readyIds.indexOf(id) >= 0)
        let fWd = [palA, palB].map(id => len((shop.find(z => z.id == id).art ?? ["......"])[0]) * cpp)
        let fCy = [6.5, 7.7]
        let fTm = [0, 1].map(i => time + i * 2.9)
        let fK = [0, 1].map(i => floor(fTm[i] / fCy[i]))
        let fPh = [0, 1].map(i => fTm[i] - fK[i] * fCy[i])
        let fWait = night || !hatched || inGame || inMenu || inPick || sick || mood == "dancing"
        // Room on each side between the owl's farthest walk and the tile's edge.
        let fRoom = [0, 1].map(i => max((i == 0 ? ox : W - ox - aw * p) - roamMax * p - fWd[i] - p, p))
        let fVis = [0, 1].map(i => [fK[i] - 1, fK[i]].map(k => abs(sin(k * 4.71 + i * 9.3)) * 7919.3 % 1 < 0.4))
        let fOff = [0, 1].map(i => [fK[i] - 1, fK[i]].map((k, j) => fVis[i][j] ? -1.5 * p
          : p + round(abs(sin(k * 2.17 + i * 5.1)) * 4513.7 % 1 * (fRoom[i] - p) / cpp) * cpp))
        let fWalkT = [0, 1].map(i => max(min(abs(fOff[i][1] - fOff[i][0]) / (3 * p), fCy[i] * 0.45), 0.01))
        let fWalk = [0, 1].map(i => fOn[i] && !fWait && fPh[i] < fWalkT[i])
        let fCur = [0, 1].map(i => night ? 0 : fWait ? fRoom[i] / 2
          : fWalk[i] ? round(lerp(fOff[i][0], fOff[i][1], fPh[i] / fWalkT[i]) / cpp) * cpp : fOff[i][1])
        let fAt = [0, 1].map(i => fPh[i] - fWalkT[i])
        let fWith = [0, 1].map(i => fOn[i] && !fWait && !fWalk[i] && fVis[i][1] && fAt[i] < 3)
        let fNuzzle = [0, 1].map(i => fWith[i] && abs(sin(fK[i] * 1.37 + i)) * 911.7 % 1 < 0.5)
        let fPlay = [0, 1].map(i => fWith[i] && !fNuzzle[i])
        let fPlayAny = fPlay[0] || fPlay[1]
        let fNuzzleAny = fNuzzle[0] || fNuzzle[1]

        if !hatched {
          // The egg rocks now and then.
          let rock = time % 4 < 0.6 ? sin(time * 25) * 12 : 0
          let ex = floor((W / 2 - 4 * p) / p) * p
          let ey = branchY - 10 * p
          rotate(rock, W / 2, branchY) {
            for c in eggArt {
              rect(ex + c[0] * p, ey + c[1] * p, c[3] * p + 0.5, s, fill: get(pal, c[2]))
            }
          }
        } else {
          // Poop beside it, at half the art's pixel size: one side, then the other.
          // Two on a side that has no room for both make one big heap. The duck washes it away.
          let wave = anim == "clean" ? -6 * p + since / 1.8 * (W + 12 * p) : -1000
          let pn = anim == "clean" ? cleanN : poops
          let pp = max(round(p / 2), 2)
          for side in [0, 1] {
            let cnt = side == 0 ? ceil(pn / 2) : floor(pn / 2)
            let inner = side == 0 ? ox + (aw + 1) * p : ox - p - 6 * pp
            let room = side == 0 ? W - inner : inner + 6 * pp
            let heap = cnt == 2 && room < 13 * pp
            for j in range(heap ? 1 : cnt) {
              let ppx = side == 0 ? inner + j * 7 * pp : inner - j * 7 * pp - (heap ? 2 * pp : 0)
              let pa = heap ? bigPoopArt : poopArt
              let ppy = branchY - len(pa) * pp
              if ppx > wave {
                sprite(pa, ppx, ppy, pp, palette: pal)
                let st = floor(time * 2 + j + side) % 2
                rect(ppx + (st == 0 ? pp : 3 * pp), ppy - 2 * pp, pp, pp, fill: alpha(muted, 0.6))
                rect(ppx + (st == 0 ? 3 * pp : pp), ppy - 3.5 * pp, pp, pp, fill: alpha(muted, 0.4))
              }
            }
          }

          let happyT = (tapKind == "pet" || tapKind == "hatch") && since < 2.5 ? since
            : tapKind == "med" && since > 1 && since < 3.5 ? since - 1
            : tapKind == "treat" && since > 1.8 && since < 4.3 ? since - 1.8
            : tapKind == "bath" && since > 1.8 && since < 4.3 ? since - 1.8
            : gEnd && gWon ? gSince : 1000
          let happy = happyT < 2.5
          let eating = anim == "meal" || anim == "snack" || anim == "treat"
          // A hop when happy; otherwise a one-pixel breath (slower in sleep). Feet stay on the branch.
          // Idle, a little hop per step while walking, and a double hop for act 1.
          let hop = happy ? round(abs(sin(happyT * 7)) * 2 * max(1.4 - happyT, 0)) * p
            : walking ? (cph * (mood == "tired" ? 2.5 : 4) % 1 < 0.5 ? p : 0)
            : ia == 1 && at < 1.2 ? round(abs(sin(at * 5.24)) * 2) * p
            : toyPlay ? (floor(at * 3) % 2) * p
            : fPlayAny ? round(abs(sin(time * 6)) * 1.5) * p : 0
          let breath = (floor(time / (asleep ? 1.6 : 0.8)) % 2) * p
          // Dancing: a step to each side, in time with a slow beat. Refusing: a head shake.
          let shake = anim == "refuse" ? [1, -1][floor(since * 9) % 2] * p
            : reveal && !catching ? gTurn * p
            : mood == "dancing" && !inGame ? [0, 1, 0, -1][floor(time * 2.5) % 4] * p
            : preen ? (floor(at * 2.5) % 2 == 0 ? p : 0) * turnDir : 0
          let flap = happy && floor(happyT * 8) % 2 == 0 || ia == 2 && at < 1.6 && floor(at * 8) % 2 == 0
            || yawn && at > 0.6 && at < 1.4 ? -p : 0
          let bx = ox + wx + shake
          let by = oy - hop

          // Its toy, at its left on the branch (it goes where it goes); the kite flies on a string.
          let ty0 = shop.find(z => z.id == toyW)
          if ty0 != null {
            if toyW == "kite" {
              let kx = ox + wx - 9 * p + round(sin(time * 0.8) * (toyPlay ? 3 : 1)) * p
              let ky = max(oy - 10 * p, 2 * p) + round(cos(time * 1.1) * (toyPlay ? 2 : 0.5)) * p
              line(kx + 3.5 * cpp, ky + 7 * cpp, bx + p, by + 10 * p + breath, stroke: alpha(muted, 0.6), width: 1)
              sprite(ty0.art, kx, ky, cpp, palette: ty0.pal)
            } else {
              let tw = len(ty0.art[0])
              let bounce = toyPlay ? round(abs(sin(at * 6)) * 3) * cpp : 0
              sprite(ty0.art, ox + wx - p - tw * cpp, branchY - len(ty0.art) * cpp - bounce, cpp, palette: ty0.pal)
            }
          }

          // Everything about the owl is drawn at its grown size, around its feet on the branch.
          scale(grow, grow, ox + wx + aw / 2 * p, branchY) {
          for c in art {
            let dy = c[2] == "f" ? 0 : c[2] == "w" ? breath + flap : breath
            rect(bx + c[0] * p, by + c[1] * p + dy, c[3] * p + 0.5, s, fill: get(pal, c[2]))
          }
          // Filthy: mud spots on its feathers.
          if washH < 1 && anim != "bath" {
            for v in chick ? [[3, 8], [8, 8], [5, 9]] : [[3, 9], [9, 11], [6, 12], [11, 9]] {
              rect(bx + v[0] * p, by + v[1] * p + breath, s, s, fill: mix(orange, foreground, 0.45))
            }
          }
          // Head turned right round: the back of its head, with a few darker feathers.
          if headBack {
            rect(bx + p, by + 3 * p + breath, (aw - 2) * p, 5 * p, fill: body)
            for v in [[-1, 4], [1, 4], [0, 5], [-2, 6], [2, 6]] {
              rect(bx + (aw / 2 - 0.5 + v[0]) * p, by + v[1] * p + breath, p, p, fill: get(pal, "v"))
            }
          }
          let headTop = chick ? 1 : 2
          let neckRow = chick ? 7 : 8
          if neckW != "" && !headBack {
            let a = shop.find(z => z.id == neckW)
            sprite(a.art, bx + floor((aw - len(a.art[0])) / 2) * p, by + breath + neckRow * p, p, palette: a.pal)
          }
          if headW != "" {
            let a = shop.find(z => z.id == headW)
            sprite(a.art, bx + (floor((aw - len(a.art[0])) / 2) + (a.dx ?? 0)) * p, by + breath + (headTop + 1 - len(a.art) + (a.dy ?? 0)) * p, p, palette: a.pal)
          } else if scholar && !chick {
            sprite(capArt, bx, by + breath - 2 * p, p, palette: pal)
          }

          // Eyes, drawn over the face discs.
          let ey = by + breath
          let dark = background
          let blink = time % 4.3 < 0.15
          if asleep && !peeking {
            for e in eyeCols { rect(bx + e * p, ey + 5 * p, 4 * p, s, fill: dark) }
          } else if asleep {
            // Woken by a tap: one grumpy eye.
            rect(bx + eyeCols[0] * p, ey + 5 * p, 4 * p, s, fill: dark)
            rect(bx + (eyeCols[1] + 1) * p, ey + 4 * p, 2 * p, 2 * p, fill: dark)
          } else if happy || eating && since > 0.7 || mood == "dancing" && !inGame || fNuzzleAny && anim == "" {
            for e in eyeCols {
              rect(bx + e * p, ey + 5 * p, s, s, fill: dark)
              rect(bx + (e + 1) * p, ey + 4 * p, 2 * p, s, fill: dark)
              rect(bx + (e + 3) * p, ey + 5 * p, s, s, fill: dark)
            }
          } else if headBack {
            // No face to draw.
          } else if anim == "refuse" || anim == "bath" || blink || yawn || preen {
            for e in eyeCols { rect(bx + e * p, ey + 5 * p, 4 * p, s, fill: dark) }
          } else if !reveal && (sick || mood == "tired" || mood == "bored" || gEnd && !gWon) {
            for e in eyeCols {
              rect(bx + e * p, ey + 4 * p, 4 * p, s, fill: mix(body, background, 0.2))
              rect(bx + (e + 1) * p, ey + 5 * p, 2 * p, s, fill: dark)
            }
          } else {
            // Looking around; a hungry one looks up at its thought, a player where it turned
            // or, catching, up at the moth.
            let lx = catching ? (ballX < W / 2 - 3 * p ? -1 : ballX > W / 2 + 3 * p ? 1 : 0)
              : mUp ? (mS == 0 ? -1 : 1)
              : walking ? wdir
              : fPlay[0] ? -1 : fPlay[1] ? 1
              : mothOn ? (mothX < bx + aw / 2 * p - 2 * p ? -1 : mothX > bx + aw / 2 * p + 2 * p ? 1 : 0)
              : ia == 3 ? (at < 0.5 ? turnDir : -turnDir)
              : toyPlay ? (toyW == "kite" ? 0 : -1)
              : reveal ? gTurn : inMenu || inPick ? [-1, 1][floor(time / 1.2) % 2] : mood == "hungry" ? 1 : [0, 1, 0, -1][floor(time / 2.7) % 4]
            let ly = catching || mothOn && mothY < oy || toyPlay && toyW == "kite" || mood == "hungry" && !reveal && !inMenu && !inPick ? -1 : 0
            for e in eyeCols { rect(bx + (e + 1 + lx) * p, ey + (4 + ly) * p, 2 * p, 2 * p, fill: dark) }
          }

          if faceW != "" && !headBack {
            let a = shop.find(z => z.id == faceW)
            sprite(a.art, bx + eyeCols[0] * p, ey + 3 * p, p, palette: a.pal)
          }

          // Yawning: the beak gapes.
          if yawn {
            rect(bx + mouth[0] * p, ey + mouth[1] * p, 2 * p, at > 0.6 && at < 1.4 ? 2 * p : p, fill: dark)
          }
          // Preening: a loose feather drifts down.
          if preen && at > 0.8 {
            let ft = at - 0.8
            let fx = bx + (turnDir > 0 ? aw + 1 : -2) * p + sin(ft * 4) * p
            rect(floor(fx / p) * p, floor(min(by + 5 * p + ft * 3 * p, branchY - 2 * p) / p) * p, p, 2 * p, fill: alpha(get(pal, "l"), clamp(1.6 - ft / 1.6, 0, 1)))
          }
          // A moth visits, and it watches it.
          if mothOn {
            layer(clamp(min(at, cyc - walkT - 0.2 - at), 0, 1)) {
              sprite(mothArt[floor(time * 8) % 2], mothX - 4.5 * mp, mothY - 3 * mp, mp, palette: mothPal)
            }
          }

          // Chomping: the beak opens and shuts, crumbs fall.
          if eating && since > 0.7 {
            if floor(since * 6) % 2 == 0 { rect(bx + mouth[0] * p, ey + mouth[1] * p, 2 * p, s, fill: dark) }
            for k in range(3) {
              let f = since - 0.7
              rect(bx + (mouth[0] - 1 + k * 2) * p + (k - 1) * f * 6 * p, ey + (mouth[1] + 1) * p + f * f * 20 * p, p, p,
                fill: anim == "meal" ? get(fishPal, "s") : anim == "treat" ? get(crumbs, tr) : get(pal, "c"))
            }
          }
          // The food drops into its beak.
          if eating && since <= 0.7 {
            let cy = lerp(-5 * p, ey + (mouth[1] - 2) * p, since / 0.7)
            if anim == "meal" {
              sprite(fishArt, bx + (mouth[0] - 2.5) * p, cy, p, palette: fishPal)
            } else if anim == "treat" {
              let a = shop.find(z => z.id == tr)
              sprite(a.art, bx + (mouth[0] + 1 - len(a.art[0]) / 2) * p, cy, p, palette: a.pal)
            } else {
              sprite(cookieArt, bx + (mouth[0] - 1.5) * p, cy, p, palette: pal)
            }
          }

          // Medicine: the syringe slides in, then sparkles.
          if anim == "med" && since < 1.2 {
            layer(since < 0.9 ? 1 : (1.2 - since) / 0.3) {
              sprite(syringeArt, lerp(-9 * p, bx - 8 * p, min(since / 0.8, 1)), by + 9 * p, p, palette: pal)
            }
          }
          let sparkT = tapKind == "med" ? since - 0.9 : tapKind == "bath" ? since - 1.8 : -1
          if sparkT > 0 && sparkT < 1.7 {
            for k in range(4) {
              if floor(sparkT * 8 + k) % 2 == 0 {
                let sx = bx + [-2, aw + 1, -1, aw][k] * p
                let sy = by + [2, 4, 10, 11][k] * p
                rect(sx - p, sy, 3 * p, p, fill: tapKind == "bath" ? cyan : yellow)
                rect(sx, sy - p, p, 3 * p, fill: tapKind == "bath" ? cyan : yellow)
              }
            }
          }

          // Hearts float up.
          if happy {
            for k in range(3) {
              let t = happyT - k * 0.35
              if t > 0 && t < 1.8 {
                layer(1 - t / 1.8) {
                  sprite(heartArt, floor((bx + [-1, aw / 2 - 2, aw - 3][k] * p + sin(t * 5 + k) * p) / p) * p, floor((by - t * 6 * p) / p) * p, p, palette: pal)
                }
              }
            }
          }

          // Shell pieces flying off a fresh hatchling.
          if tapKind == "hatch" && since < 1.2 {
            layer(1 - since / 1.2) {
              for c in eggArt {
                if c[1] < 5 {
                  let dir = c[0] < 4 ? -1 : 1
                  rect(bx + (3 + c[0]) * p + dir * since * 30 * p, by + (c[1] - 2) * p - since * 12 * p + since * since * 30 * p, c[3] * p + 0.5, s, fill: get(pal, c[2]))
                }
              }
            }
          }

          // Sick: a skull blinks by its head.
          if sick && !asleep && anim != "med" && floor(time * 1.5) % 3 != 0 {
            sprite(skullArt, min(bx + (aw - 1) * p, W - 5 * p), max(by - 4 * p, 0), p, palette: skullPal)
          }

          // Music notes drift up while it dances.
          if mood == "dancing" && !inGame && !inMenu && !inPick {
            for k in range(2) {
              let t = (time * 0.5 + k / 2) % 1
              let nx = floor((bx + (k == 0 ? -2 : aw) * p + sin(t * 6) * p) / p) * p
              let ny = floor((by + 6 * p - t * 8 * p) / p) * p
              let nc = alpha(k == 0 ? cyan : magenta, 1 - t)
              rect(nx, ny + 2 * p, 2 * p, 2 * p, fill: nc)
              rect(nx + p, ny - p, p, 3 * p, fill: nc)
              rect(nx + 2 * p, ny - p, p, p, fill: nc)
            }
          }

          // Hungry or bored: a thought bubble with a fish or a ball.
          if (mood == "hungry" || mood == "bored" || mood == "smelly") && anim == "" && !inMenu && !inPick && !inGame {
            let cloud = mix(foreground, background, 0.4)
            let tx = min(bx + (aw - 5) * p, W - 11 * p)
            let ty = max(by - 9 * p, 0)
            rect(tx - p, ty + 8 * p, p, p, fill: cloud)
            rect(tx, ty + 7 * p, p, p, fill: cloud)
            rect(tx + p, ty, 9 * p, 7 * p, radius: p, fill: cloud)
            if mood == "hungry" {
              sprite(fishArt, tx + 2 * p, ty + 2 * p, p, palette: fishPal)
            } else if mood == "smelly" {
              sprite(duckArt, tx + 2 * p, ty + 0.5 * p, p, palette: pal)
            } else {
              sprite(ballArt, tx + 3 * p, ty + p, p, palette: ballPal)
            }
          }

          // Bath: a shower rains on it and soap bubbles rise.
          if anim == "bath" {
            layer(clamp((2.4 - since) / 0.4, 0, 1)) {
              for k in range(10) {
                let dt = (since * 2.2 + k * 0.37) % 1
                rect(bx + ((k * 5) % (aw + 2) - 1) * p, floor((by - 6 * p + dt * (branchY - by + 4 * p)) / p) * p, p, 2 * p, fill: alpha(cyan, 0.75))
              }
              for k in range(6) {
                let bt = (since * 0.8 + k * 0.29) % 1
                circle(bx + [1, 4, 9, 12, 6, 11][k] * aw / 14 * p, by + (11 - bt * 9) * p, (0.7 + (k % 3) * 0.35) * p,
                  fill: alpha(cyan, 0.18), stroke: alpha(foreground, 0.55 * (1 - bt)), width: 1)
              }
            }
          }
          // Dirty: stink lines rise beside it, and a filthy one draws a fly.
          if washH < 1.5 && !asleep && anim != "bath" {
            for k in range(2) {
              let t = (time * 0.6 + k / 2) % 1
              rect(floor((bx + (k == 0 ? -2 : aw + 1) * p + round(sin(t * 9)) * p) / p) * p, floor((by + 8 * p - t * 8 * p) / p) * p, p, 2 * p,
                fill: alpha(mix(green, muted, 0.5), 1 - t))
            }
            if washH < 1 {
              let fp = max(round(p / 2), 2)
              let fx = bx + aw / 2 * p + cos(time * 4.3) * (aw / 2 + 2) * p
              let fy = by + 2 * p + sin(time * 9.1) * 1.5 * p
              rect(fx, fy, 2 * fp, fp, fill: foreground)
              rect(fx + (floor(time * 20) % 2) * fp, fy - fp, fp, fp, fill: alpha(foreground, 0.4))
            }
          }

          // Zzz.
          if asleep && !peeking {
            for k in range(3) {
              let t = (time * 0.4 + k / 3) % 1
              text("z", bx + (aw - 2) * p + t * 4 * p, by + p - t * 8 * p, size: (2 + t * 2) * p, bold: true, color: alpha(foreground, 1 - t))
            }
          }
          }

          // Coins earned rise from it.
          if gainC > 0 && since < 1.8 {
            let gs = big ? 16 : 11
            let gy = by - p - since * 5 * p
            layer(clamp((1.8 - since) / 0.6, 0, 1)) {
              text("+${gainC}", bx + aw / 2 * p - 1, gy, size: gs, bold: true, align: end, color: foreground)
              sprite(coinArt, bx + aw / 2 * p + 2, gy - gs * 0.4, gs * 0.16, palette: coinPal)
            }
          }

          // Which way? Arrows on both sides, a ? over its head, and the rounds so far.
          if inGame {
            if !gEnd && gKind == "way" {
              let pulse = reveal ? 0.25 : 0.55 + 0.45 * abs(sin(time * 3))
              sprite(arrowL, p, oy + 5 * p, p, palette: {a: alpha(accent, pulse)})
              sprite(arrowR, W - 4 * p, oy + 5 * p, p, palette: {a: alpha(accent, pulse)})
            }
            // Catch: the zone over its head, and the moth fluttering through it.
            if catching && !gEnd {
              rect(W / 2 - 5.5 * p, ballY - 3 * p, 11 * p, 6 * p, radius: p, fill: alpha(accent, 0.15))
              sprite(mothArt[reveal ? 0 : floor(time * 8) % 2], ballX - 4.5 * p, ballY - 3 * p, p, palette: mothPal)
            }
            // Pounce: the mouse pops up from behind the branch, facing the owl.
            if mUp {
              let mx = mS == 0 ? W * 0.2 : W * 0.8
              clip(0, 0, W, branchY) {
                scale(mS == 0 ? -1 : 1, 1, mx, branchY) {
                  sprite(mouseArt, mx - 4.5 * p, branchY - 5 * p * mRise, p, palette: mousePal)
                }
              }
            }
            if reveal {
              let rx = catching ? ballX : pouncing ? (gPos == 0 ? W * 0.2 : W * 0.8) : bx + aw / 2 * p
              let ry = catching ? ballY - 3 * p : pouncing ? branchY - 6 * p : max(branchY - (branchY - by + 4 * p) * grow, 5 * p)
              if endsWith(gHist, "w") {
                sprite(heartArt, rx - 2.5 * p, ry - 2 * p - floor(gSince * 3) * p / 2, p, palette: pal)
              } else {
                text("✕", rx, ry, size: 4 * p, bold: true, align: center, color: red)
              }
            }
            for i in range(5) {
              let r = sub(gHist, i, i + 1)
              rect(W / 2 + (i * 2 - 4.5) * p, p, p, p, fill: r == "w" ? green : r == "l" ? red : alpha(muted, 0.4))
            }
          }


          // The duck and its wave.
          if anim == "clean" {
            for r in range(7) {
              rect(wave + (r % 2) * p, branchY - (6 - r) * p, 2 * p, p, fill: alpha(cyan, 0.6))
            }
            sprite(duckArt, wave - 2 * p, branchY - 12 * p + (floor(time * 6) % 2) * p, p, palette: pal)
          }
        }

        // The nest, in front of its feet at home.
        if homeW == "nest" {
          let nz = shop.find(z => z.id == "nest")
          sprite(nz.art, ox + (aw / 2 - 9) * p, branchY - 3 * p, p, palette: nz.pal)
        }

        // Friends: an egg wobbles at its end of the branch until it hatches; then a little animal
        // that walks beside the owl (see the friends' cycles above), faces it, hops along, comes
        // over to nuzzle or play, sleeps beside it at night and loves a pat.
        for pid, si in [palA, palB] {
          let pz = pid != "" ? shop.find(z => z.id == pid) : null
          if pz != null {
            let t0 = (palT[petIds.indexOf(pid)] ?? 0)
            let patted = anim == "palpet" && palTap == si
            if now - t0 < hatchS {
              let ewx = si == 0 ? p : W - p - 6 * cpp
              let rock = patted ? sin(since * 30) * 15 : time % 3 < 0.5 ? sin(time * 25) * 8 : 0
              rotate(rock, ewx + 3 * cpp, branchY) {
                sprite(petEgg, ewx, branchY - 8 * cpp, cpp, palette: {e: get(pal, "e"), s: pz.egg})
              }
              text("${ceil((t0 + hatchS - now) / 60)}m", ewx + 3 * cpp, branchY - 10 * cpp, size: big ? 11 : 8, align: center, color: muted)
            } else {
              let cw = len(pz.art[0])
              let ch = len(pz.art)
              // Its spot: the owl's edge on this side (at its grown size), then the friend's offset.
              let mid = ox + wx + aw / 2 * p
              let edge = si == 0 ? mid - aw / 2 * p * grow - fCur[si] - cw * cpp : mid + aw / 2 * p * grow + fCur[si]
              // Nuzzling: it rubs against the owl's side.
              let rub = fNuzzle[si] && fAt[si] > 0.2 ? (floor(fAt[si] * 3) % 2) * cpp * (si == 0 ? 1 : -1) : 0
              let cx = clamp(round((edge + rub) / cpp) * cpp, 0, W - cw * cpp)
              // It faces the owl, except while walking away from it.
              let away = fWalk[si] && fOff[si][1] > fOff[si][0]
              let flip = si == 0 ? away : !away
              let chop = night ? 0
                : patted ? round(abs(sin(since * 8)) * 3 * max(1.2 - since, 0)) * cpp
                : fWalk[si] ? (fPh[si] * 4 % 1 < 0.5 ? cpp : 0)
                : fPlay[si] ? round(abs(sin(fAt[si] * 6 + 1)) * 3) * cpp : 0
              let cy = branchY - ch * cpp - chop
              let shut = night || fNuzzle[si] && fAt[si] > 0.2 || (time + si * 1.3) % 3.7 < 0.15
              scale(flip ? -1 : 1, 1, cx + cw * cpp / 2, branchY) {
                sprite(pz.art, cx, cy, cpp, palette: pz.pal)
                sprite(pz.art, cx, cy, cpp, palette: {k: shut ? alpha(background, 0.3) : background})
              }
              if night {
                let zt = (time * 0.4 + si / 2) % 1
                text("z", cx + cw * cpp / 2 + zt * 3 * cpp, cy - zt * 6 * cpp, size: (2 + zt * 2) * cpp, bold: true, color: alpha(foreground, 1 - zt))
              }
              // Hearts rise between the two while they nuzzle.
              if fNuzzle[si] && fAt[si] > 0.3 {
                let hx = si == 0 ? cx + cw * cpp : cx
                for k in range(2) {
                  let t = fAt[si] - 0.3 - k * 0.9
                  if t > 0 && t < 1.6 {
                    layer(1 - t / 1.6) {
                      sprite(heartArt, round((hx - 2.5 * cpp + sin(t * 5) * cpp) / cpp) * cpp, cy - 3 * cpp - floor(t * 6) * cpp, cpp, palette: pal)
                    }
                  }
                }
              }
              // Playing: dust puffs where it lands.
              if fPlay[si] && abs(sin(fAt[si] * 6 + 1)) < 0.3 {
                rect(cx - cpp, branchY - cpp, cpp, cpp, fill: alpha(muted, 0.5))
                rect(cx + cw * cpp, branchY - cpp, cpp, cpp, fill: alpha(muted, 0.5))
              }
              if patted {
                layer(1 - since / 1.2) {
                  sprite(heartArt, cx + cw * cpp / 2 - 2.5 * cpp, cy - 6 * cpp - floor(since * 8) * cpp, cpp, palette: pal)
                }
              }
              // Fresh out of the shell: sparkles.
              let fresh = now - t0 - hatchS
              if fresh < 5 {
                for k in range(3) {
                  if floor(time * 6 + k) % 2 == 0 {
                    let sx = cx + [-1, cw + 1, cw / 2][k] * cpp
                    let sy = cy + [1, 2, -3][k] * cpp
                    rect(sx - cpp, sy, 3 * cpp, cpp, fill: yellow)
                    rect(sx, sy - cpp, cpp, 3 * cpp, fill: yellow)
                  }
                }
              }
            }
          }
        }

        // Lights out: the room goes dark.
        if lightsOff {
          rect(0, 0, W, barTop, fill: alpha(rgb(0, 0, 0), 0.55))
        }
        // Fireflies drift about, glowing brighter in the dark.
        if decorW == "fireflies" {
          for k in range(6) {
            let fx = W * (0.12 + 0.15 * k) + sin(time * 0.7 + k * 2.1) * 3 * p
            let fy = branchY * (0.3 + (k % 3) * 0.17) + cos(time * 0.9 + k * 1.3) * 2 * p
            let glow = (lit ? 0.55 : 0.25) + 0.45 * abs(sin(time * 1.9 + k * 1.7))
            if lit { circle(fx, fy, 1.6 * cpp, fill: alpha(mix(yellow, green, 0.3), 0.2 * glow)) }
            rect(fx - cpp / 2, fy - cpp / 2, cpp, cpp, fill: alpha(mix(yellow, green, 0.3), glow))
          }
        }
        if decorW == "lantern" && lit {
          circle(floor(W * 0.8 / p) * p + 2.5 * p, branchY - 5.5 * p, 7 * p, fill: alpha(yellow, 0.16 + 0.06 * sin(time * 2)))
        }
        // Coins and level, top right.
        let hs = big ? 14 : 10
        let cp = big ? 3 : 2
        sprite(coinArt, W - 5 * cp - 2, hs / 2 + 2 - 2.5 * cp, cp, palette: coinPal)
        text("lv ${level} · ${coins}", W - 5 * cp - 6, hs / 2 + 2, size: hs, align: end, color: muted)
        // Night sky: a crescent moon and a few twinkling stars.
        if asleep {
          for c in range(25) {
            let i = c % 5 - 2
            let j = floor(c / 5) - 2
            if i * i + j * j <= 5 && (i + 1) * (i + 1) + (j + 1) * (j + 1) > 4 {
              rect(p + (i + 2) * p, p + (j + 2) * p, s, s, fill: yellow)
            }
          }
          for k in range(5) {
            let sx = floor(W * (0.3 + 0.15 * k) / p) * p
            let sy = (1 + (k * 7) % 5) * p
            rect(sx, sy, p, p, fill: alpha(foreground, 0.3 + 0.5 * abs(sin(time * 0.8 + k * 1.9))))
          }
        }

        // Meal or snack: the two choices over the scene.
        if inMenu {
          rect(0, 0, W, SH, fill: alpha(background, 0.8))
          let q = clamp(p, 2, floor(W / 30))
          let bob = round(sin(time * 3)) * q / 2
          let ls = big ? 16 : clamp(W / 3 / 6, 9, 11)
          sprite(fishArt, W / 6 - 3.5 * q, SH * 0.4 - 1.5 * q + bob, q, palette: fishPal)
          sprite(cookieArt, W / 2 - 2.5 * q, SH * 0.4 - 2.5 * q - bob, q, palette: pal)
          text("meal", W / 6, SH * 0.4 + 4.5 * q, size: ls, align: center, color: foreground)
          text("snack", W / 2, SH * 0.4 + 4.5 * q, size: ls, align: center, color: foreground)
          if curTreat != "" {
            let a = shop.find(z => z.id == curTreat)
            sprite(a.art, W * 5 / 6 - len(a.art[0]) / 2 * q, SH * 0.4 - len(a.art) / 2 * q + bob, q, palette: a.pal)
            text("${W < 300 ? "treat" : a.name} ×${get(pantry, curTreat, 0)}", W * 5 / 6, SH * 0.4 + 4.5 * q, size: ls, align: center, color: foreground)
          } else {
            sprite(icons[6], W * 5 / 6 - 3.5 * q, SH * 0.4 - 3.5 * q, q, fill: alpha(muted, 0.4))
            text("no treats", W * 5 / 6, SH * 0.4 + 4.5 * q, size: ls, align: center, color: muted)
          }
          for d in [1, 2] {
            for k in range(5) { rect(W * d / 3, SH * 0.15 + k * SH * 0.15, 1, SH * 0.08, fill: alpha(muted, 0.4)) }
          }
        }
        // Which game: three thirds.
        if inPick {
          rect(0, 0, W, SH, fill: alpha(background, 0.8))
          let q = clamp(p, 2, floor(W / 33))
          let bob = round(sin(time * 3)) * q / 2
          let ap = {a: accent}
          sprite(arrowL, W / 6 - 4 * q - bob, SH * 0.4 - 2.5 * q, q, palette: ap)
          sprite(arrowR, W / 6 + q + bob, SH * 0.4 - 2.5 * q, q, palette: ap)
          sprite(mothArt[floor(time * 4) % 2], W / 2 - 4.5 * q + bob * 2, SH * 0.4 - 3 * q, q, palette: mothPal)
          sprite(mouseArt, W * 5 / 6 - 4.5 * q, SH * 0.4 - 2.5 * q + (floor(time * 1.5) % 2) * q, q, palette: mousePal)
          let ls = big ? 16 : clamp(W / 3 / 6, 9, 11)
          text(W < 200 ? "way" : "which way", W / 6, SH * 0.4 + 4.5 * q, size: ls, align: center, color: foreground)
          text("catch", W / 2, SH * 0.4 + 4.5 * q, size: ls, align: center, color: foreground)
          text("pounce", W * 5 / 6, SH * 0.4 + 4.5 * q, size: ls, align: center, color: foreground)
          for d in [1, 2] {
            for k in range(5) { rect(W * d / 3, SH * 0.15 + k * SH * 0.15, 1, SH * 0.08, fill: alpha(muted, 0.4)) }
          }
        }

        // The caption.
        let short = W < 140
        let toastOn = toast != "" && now - toastNow < 4
        let capText = toastOn ? toast
          : mood == "egg" ? (short ? "tap to hatch" : "an egg · tap to hatch")
          : inMenu ? "meal or snack?"
          : inPick ? "which game?"
          : inGame ? (gEnd ? (gWon ? "won ${gWins}/5 ♥ +${gainC}¢" : "lost ${gWins}/5 · +${gainC}¢")
            : catching ? (short ? "catch · ${gRound + 1}/5" : "tap when it's overhead · ${gRound + 1}/5")
            : pouncing ? (short ? "pounce · ${gRound + 1}/5" : "tap the mouse's side · ${gRound + 1}/5")
            : short ? "◀ or ▶ · ${gRound + 1}/5" : "which way? ◀ ▶ · ${gRound + 1}/5")
          : anim == "notreat" ? (short ? "no treats" : "no treats · buy some in the shop")
          : anim == "bath" ? "splish splash!"
          : anim == "palpet" ? (readyIds.indexOf([palA, palB][palTap]) >= 0 ? "${shop.find(z => z.id == [palA, palB][palTap]).name} ♥" : "it wiggles…")
          : anim == "treat" ? "yum, ${shop.find(z => z.id == tr).name}!"
          : anim == "refuse" ? (sick ? "too sick for that" : foodH >= 3.5 && tapKind == "refuse" && bi < 0 ? "full!" : "no thanks")
          : asleep ? (lightsOff ? "zzz · day ${day}" : short ? "turn off light" : "sleepy · turn off the light")
          : mood == "sick" ? (short ? "sick · medicine" : "sick · give it medicine")
          : poops >= 2 ? (short ? "messy · clean" : "what a mess · clean up")
          : mood == "hungry" ? (short ? "hungry · feed" : "hungry · feed me")
          : mood == "dancing" ? "♪ ${lower(m.title ?? "music")}"
          : mood == "bored" ? (short ? "bored · play" : "bored · let's play")
          : mood == "smelly" ? (short ? "smelly · bath" : "smelly · bath time")
          : mood == "tired" ? (short ? "tired · ${bat.level}%" : "tired · battery ${bat.level}%")
          : short ? "${stageName} · ${weight}g" : "${stageName} · day ${day} · ${weight}g"
        text(capText, W / 2, SH + capH / 2, size: big ? 15 : 10.5, align: center, bold: toastOn, color: toastOn ? accent : muted)

        // The icon bar: feed, play, clean, bath, medicine, light, shop, stats. What it needs blinks.
        rect(4, barTop, W - 8, 1, fill: alpha(muted, 0.25))
        let needs = [mood == "hungry", mood == "bored", poops > 0, washH < 1, sick, asleep && !lightsOff, false, false]
        let ip = clamp(floor(min(slot * 0.55, barH * 0.62) / 7 * 2) / 2, 1.5, big ? 5 : 3)
        for ic, i in icons.take(n) {
          let cx = slot * (i + 0.5)
          let iy = barTop + (barH - 7 * ip) / 2 + 0.5
          let on = i >= 6 || hatched && (!asleep || i >= 5)
          let active = i == 0 && inMenu || i == 1 && (inGame || inPick) || i == 5 && lightsOff
          let col = !on ? alpha(muted, 0.25)
            : needs[i] ? (floor(time * 2) % 2 == 0 ? accent : mix(accent, background, 0.5))
            : active ? accent : muted
          let down = pressI == i && time >= pressAt && time - pressAt < 0.18
          scale(down ? 0.8 : 1, down ? 0.8 : 1, cx, iy + 3.5 * ip) {
            sprite(i == 5 && lightsOff ? bulbOff : ic, cx - 3.5 * ip, iy, ip, fill: col)
          }
        }
      }

      // On the tile, the shop and stats icons open the screen.
      if !big {
        Box { offset: [slot * 6, barTop]; width: slot; height: barH; onTap: { tab = "shop"; screen() } }
        Box { offset: [slot * 7, barTop]; width: slot; height: barH; onTap: { tab = "owl"; screen() } }
      }
    }
  }

  Scene { W: (tileWidth ?? 176) - 12; H: (tileHeight ?? 180) - 12 }

  component Goal(label, v, goal) {
    Row {
      align: center
      Text { text: v >= goal ? "✓" : "○"; width: 24; color: v >= goal ? green : muted }
      Text { text: label; weight: 1 }
      Text { text: "${min(v, goal)}/${goal}"; width: 56; align: end; color: muted }
    }
  }
  component Tab(id, label) {
    Button { text: label; color: tab == id ? accent : muted; onTap: tab = id }
  }

  screen {
    title: "hootling"
    Column {
      scroll: true
      gap: 12
      align: center
      let sw = min((screenWidth ?? 360) - 32, 460)
      Scene { W: sw; H: sw * 1.05; big: true }

      // The keeper: level, xp to the next one, coins and streak.
      Column {
        fill: width
        gap: 4
        Row {
          align: center
          Text { text: "level ${level}"; style: title; weight: 1 }
          Canvas { width: 16; height: 16; sprite(coinArt, 0, 0, 3.2, palette: coinPal) }
          Text { text: "${coins}"; style: title; width: 72 }
        }
        Progress { value: xp - lvlFrom; max: lvlTo - lvlFrom; fill: width; animate value: spring() }
        Text { text: "${xp - lvlFrom}/${lvlTo - lvlFrom} xp to level ${level + 1} · ${streak}-day streak"; style: small; color: muted }
      }
      Row {
        fill: width
        gap: 8
        Tab { id: "owl"; label: "owl"; weight: 1 }
        Tab { id: "shop"; label: "shop"; weight: 1 }
        Tab { id: "badges"; label: "badges ${len(badgeList.filter(b => contains(badges, ",${b.id},")))}/${len(badgeList)}"; weight: 1 }
      }

      if tab == "shop" {
        // One category at a time, picked from a row of chips.
        let cats = [["treat", "treats", "Served from the feed menu. Tap a treat's name to serve it next."],
          ["pet", "friends", "Animal friends: an egg hatches 15 min after you buy it. Up to two walk about beside it, come over to nuzzle or play, and each has a perk while it's out. Tap one on the tile to pet it."],
          ["home", "homes", "A home for it on the branch, one at a time."],
          ["toy", "toys", "It plays with its toy now and then, and happy hearts drain 15% slower while one is out."],
          ["head", "hats", "Wearables go on when bought; tap again to swap or take off."],
          ["face", "eyewear", "Wearables go on when bought; tap again to swap or take off."],
          ["neck", "neckwear", "Wearables go on when bought; tap again to swap or take off."],
          ["decor", "decor", "One piece of decor is out at a time."],
          ["perk", "upgrades", "Upgrades work for good."]]
        let cat = cats.find(c => c[0] == shopCat) ?? cats[0]
        Flow {
          fill: width
          gap: 6
          for c in cats key c[0] {
            Button { text: c[1]; color: c[0] == cat[0] ? accent : muted; onTap: { shopCat = c[0]; shopMsg = "" } }
          }
        }
        Text { text: shopMsg != "" ? shopMsg : cat[2]; style: small; color: shopMsg != "" ? accent : muted; fill: width }
        for it in shop.filter(x => x.kind == cat[0]) key it.id {
          Row {
            let isPet = it.kind == "pet"
            let pt = isPet ? (palT[petIds.indexOf(it.id)] ?? 0) : 0
            let isOwn = isPet ? pt > 0 : it.kind != "treat" && contains(owned, ",${it.id},")
            let hatching = isPet && pt > 0 && now - pt < hatchS
            let placed = ["decor", "home", "toy", "pet"].indexOf(it.kind) >= 0
            let worn = [headW, faceW, neckW, decorW, homeW, toyW, palA, palB].indexOf(it.id) >= 0
            let locked = level < it.lvl && !isOwn
            let cnt = get(pantry, it.id, 0)
            let ic = hatching ? petEgg : it.art
            let q = floor(min(32 / len(ic[0]), 32 / len(ic)) * 2) / 2
            fill: width
            align: center
            gap: 10
            padding: [10, 6]
            border: 1
            borderColor: [headW, faceW, neckW, decorW, homeW, toyW, palA, palB].indexOf(it.id) >= 0 || it.kind == "treat" && it.id == curTreat ? accent : alpha(muted, 0.25)
            Canvas {
              width: 40
              height: 40
              opacity: locked ? 0.35 : 1
              let ix = (40 - len(ic[0]) * q) / 2
              let iy = (40 - len(ic) * q) / 2
              if hatching {
                sprite(ic, ix, iy, q, palette: {e: get(pal, "e"), s: it.egg})
              } else {
                sprite(ic, ix, iy, q, palette: it.pal)
                if isPet { sprite(ic, ix, iy, q, palette: {k: background}) }
              }
            }
            Column {
              weight: 1
              gap: 0
              onTap: { treatSel = it.kind == "treat" && cnt > 0 ? it.id : treatSel }
              Text { text: (isPet && !isOwn ? "${it.name} egg" : it.name) + (it.kind == "treat" && cnt > 0 ? " ×${cnt}" : ""); color: locked ? muted : foreground; maxLines: 1 }
              Text {
                text: it.kind == "treat" && it.id == curTreat ? "${it.desc} · served next"
                  : hatching ? "hatching… ${it.desc}"
                  : isPet && worn ? "${it.desc} · out" : it.desc
                style: small; color: muted; maxLines: 2
              }
            }
            Button {
              width: 96
              text: locked ? "lv ${it.lvl}" : it.kind == "perk" && isOwn ? "owned ✓"
                : hatching ? "${ceil((pt + hatchS - now) / 60)}m${worn ? " · out" : ""}"
                : isOwn ? (worn ? (placed ? "put away" : "take off") : (placed ? "put out" : "wear")) : "${it.price}¢"
              color: locked || !isOwn && coins < it.price ? alpha(muted, 0.5) : worn ? accent : foreground
              onTap: {
                own = it.kind == "pet" ? (palT[petIds.indexOf(it.id)] ?? 0) > 0 : it.kind != "treat" && contains(owned, ",${it.id},")
                buyOk = !own && coins >= it.price && level >= it.lvl
                coins = buyOk ? coins - it.price : coins
                bought = buyOk ? bought + 1 : bought
                nBerry = buyOk && it.id == "berry" ? nBerry + 1 : nBerry
                nCake = buyOk && it.id == "cake" ? nCake + 1 : nCake
                nGold = buyOk && it.id == "gold" ? nGold + 1 : nGold
                nStar = buyOk && it.id == "star" ? nStar + 1 : nStar
                treatSel = buyOk && it.kind == "treat" ? it.id : treatSel
                headW = it.kind == "head" && (own || buyOk) ? (own && headW == it.id ? "" : it.id) : headW
                faceW = it.kind == "face" && (own || buyOk) ? (own && faceW == it.id ? "" : it.id) : faceW
                neckW = it.kind == "neck" && (own || buyOk) ? (own && neckW == it.id ? "" : it.id) : neckW
                decorW = it.kind == "decor" && (own || buyOk) ? (own && decorW == it.id ? "" : it.id) : decorW
                homeW = it.kind == "home" && (own || buyOk) ? (own && homeW == it.id ? "" : it.id) : homeW
                toyW = it.kind == "toy" && (own || buyOk) ? (own && toyW == it.id ? "" : it.id) : toyW
                // A friend: a bought egg goes out on the branch, in the free end or else the right one;
                // tapping an owned one puts it out or away.
                palT = it.kind == "pet" && buyOk ? range(len(petIds)).map(k => petIds[k] == it.id ? now : palT[k] ?? 0) : palT
                palWas = palA == it.id || palB == it.id
                palA = it.kind == "pet" && (own || buyOk) ? (palWas ? (palA == it.id ? "" : palA) : palA == "" ? it.id : palA) : palA
                palB = it.kind == "pet" && (own || buyOk) ? (palWas ? (palB == it.id ? "" : palB) : palA != it.id ? it.id : palB) : palB
                owned = buyOk && it.kind != "treat" ? owned + it.id + "," : owned
                shopMsg = buyOk ? (it.kind == "pet" ? "Bought a ${it.name} egg! It hatches in 15 min." : "Bought ${it.name}!")
                  : own ? "" : level < it.lvl ? "${it.name} unlocks at level ${it.lvl}." : coins < it.price ? "${it.price - coins}¢ short for ${it.name}." : ""
              }
            }
          }
        }
      } else if tab == "badges" {
        for b in badgeList key b.id {
          Row {
            let got = contains(badges, ",${b.id},")
            fill: width
            align: center
            gap: 10
            padding: [10, 6]
            border: 1
            borderColor: contains(badges, ",${b.id},") ? alpha(yellow, 0.6) : alpha(muted, 0.25)
            Text { text: "★"; width: 28; fontSize: 22; align: center; color: got ? gold : alpha(muted, 0.35) }
            Column {
              weight: 1
              gap: 0
              Text { text: b.name; color: got ? foreground : muted }
              Text { text: b.desc; style: small; color: muted }
            }
            Text { text: got ? "✓" : "+${b.reward}¢"; width: 64; align: end; color: got ? green : muted }
          }
        }
      } else {
        Column {
          fill: width; gap: 8; padding: [12, 10]; border: 1; borderColor: alpha(muted, 0.3)
          Row {
            Text { text: "today's goals"; style: title; weight: 1; maxLines: 1 }
            Text { text: qDone ? "done ✓" : "+25¢"; width: 90; align: end; color: qDone ? green : muted }
          }
          Goal { label: "feed it 3 times"; v: qFeed; goal: 3 }
          Goal { label: "win a game"; v: qWin; goal: 1 }
          Goal { label: "pet it 10 times"; v: qPet; goal: 10 }
        }
        Column {
          fill: width; gap: 8; padding: [12, 10]; border: 1; borderColor: alpha(muted, 0.3)
          Row {
            Text { text: stageName; style: title; weight: 1; maxLines: 1 }
            Text { text: hatched ? "day ${day}" : ""; width: 90; align: end; color: muted }
          }
          if hatched {
            Row { align: center; Text { text: "hunger"; width: 96; color: muted }  Hearts { v: foodH; weight: 1 } }
            Row { align: center; Text { text: "happiness"; width: 96; color: muted }  Hearts { v: joyH; weight: 1 } }
            Row { align: center; Text { text: "hygiene"; width: 96; color: muted }  Hearts { v: washH; glyph: dropArt; tint: cyan; weight: 1 } }
            Row { Text { text: "health"; width: 96; color: muted }  Text { text: sick ? "sick" : poops > 0 ? "fine · ${poops} to clean" : "healthy"; color: sick ? red : foreground; weight: 1 } }
            Row { Text { text: "weight"; width: 96; color: muted }  Text { text: "${weight} g"; weight: 1 } }
            Row { Text { text: "care"; width: 96; color: muted }  Text { text: mistakes == 0 ? "perfect" : "${mistakes} mistake${mistakes == 1 ? "" : "s"}"; color: mistakes > 3 ? orange : foreground; weight: 1 } }
            Row { Text { text: "games"; width: 96; color: muted }  Text { text: "${gamesWon} won of ${gamesPlayed}"; weight: 1 } }
            Row { Text { text: "pets"; width: 96; color: muted }  Text { text: "♥︎ ${pets}"; weight: 1 } }
          } else {
            Text { text: "Tap the egg to hatch it."; color: muted }
          }
        }
        Text {
          style: small
          color: muted
          text: "Feed: a meal fills a hunger heart (+1 g), a snack a happy heart (+2 g), and treats from the shop do more. Play a game of five rounds and win 3 for a happy heart (−1 g): which-way, guess where it turns; catch, tap as the moth passes over its head; or pounce, tap the side a mouse pops up on before it hides. Clean poop before it piles up, and give it a bath when it gets smelly (hygiene drains a drop every 3 h awake, and faster with every pile of poop about; a filthy owl with poop about gets sick), and cure it with medicine when it's sick. Turn the light off at bedtime (21–6). Tap the owl to pet it. Hearts drain only while it's awake; letting one run empty is a care mistake. Five days of good care earn a scholar's cap.\n\nCoins: 2 per round won, +5 for a won game, +10 for a perfect one; 2 per poop cleaned, 2 for bathing a dirty owl, 3 for a cure, 1 every fifth pet; a daily bonus that grows with your streak; badges, goals and level-ups. Coins, level, badges, the shop and your animal friends stay with you when you start a new egg.\n\nShop: besides treats and things to wear, buy it a home, a toy it plays with now and then, decor, and eggs of animal friends. An egg hatches 15 minutes after you buy it; up to two friends walk about beside it, come over to nuzzle it or play together, and sleep snuggled up beside it at night. Each has a perk while it's out (see friends in the shop). Tap one to pet it."
        }
        Button {
          text: confirmReset ? "really start over with a new egg?" : "new egg"
          color: confirmReset ? red : muted
          fill: width
          onTap: {
            born = confirmReset ? 0 : born
            mode = confirmReset ? "" : mode
            lightsOff = confirmReset ? false : lightsOff
            confirmReset = !confirmReset
          }
        }
      }
    }
  }
}
