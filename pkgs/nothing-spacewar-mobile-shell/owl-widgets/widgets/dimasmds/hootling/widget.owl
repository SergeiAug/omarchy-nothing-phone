widget "hootling" {
  meta { owl: 5; description: "A pixel owl virtual pet: feed, play, clean, bathe and cure it. Earn coins, xp and badges; buy treats, outfits, homes, toys and decor, and hatch animal friends to keep it company"; version: "4.2"; license: "MIT"; category: "fun" }
  page: 2
  order: 1
  size: 3x3
  minSize: 2x2
  padding: 6

  // Hootling: a fork of "owl" by Simon Schubert, from the widget store
  // (github.com/SimonSchubert/omarchy-widgets, widgets/simonschubert/owl).
  // Copyright (c) 2026 Simon Schubert and contributors; changes (c) 2026 dimasmds.
  // MIT License: https://github.com/SimonSchubert/omarchy-widgets/blob/main/LICENSE

  // A virtual pet in theme colors. Hunger and happiness are four hearts each that
  // drain while it's awake (6 to 21): a heart every 2 h. Poop piles up every 3 h
  // awake. Hygiene is four drops that drain a drop every 3 h awake, and faster with
  // poop about; a bath fills them. Three piles, a filthy owl with poop about, or an empty belly and heart
  // make it sick, which needs medicine. Letting a meter run empty is a care mistake. It hatches as a chick,
  // grows into an owl after a day, and earns a scholar's cap after five days of
  // good care. Everything comes from Android, so it works without Linux.
  //
  // Caring earns coins and xp. The keeper levels up, keeps a daily streak, meets
  // three goals a day and collects badges; coins buy treats, things to wear, homes,
  // toys, decor and upgrades in the shop, and eggs of other animals: they hatch
  // after 15 minutes, and up to two keep the owl company on the branch, each with
  // a small perk while it's out. All of that is kept across eggs.
  //
  // The tile is one Canvas: the scene, a caption and an icon bar (feed, play,
  // clean, bath, medicine, light, shop, stats). Shop and stats open the screen.
  source now = clock every 1s
  source bat = android.battery
  source m = android.media

  state born = 0 persist             // Unix seconds; 0 is still an egg
  state food = 3 persist             // hearts at foodAt
  state foodAt = 0 persist
  state joy = 3 persist              // hearts at joyAt
  state joyAt = 0 persist
  state cleanAt = 0 persist
  state wash = 4 persist             // hygiene drops at washAt
  state washAt = 0 persist
  state washMiss = false persist
  state sick = false persist
  state lightsOff = false persist
  state weight = 5 persist
  state mistakes = 0 persist
  state foodMiss = false persist
  state joyMiss = false persist
  state pets = 0 persist
  state gamesWon = 0 persist
  state gamesPlayed = 0 persist

  // The keeper's progress, kept across eggs.
  state coins = 20 persist
  state xp = 0 persist
  state badges = "," persist          // earned badge ids, ",a,b,"
  state owned = "," persist           // bought wearables, decor and upgrades, ",a,b,"
  state headW = "" persist            // what it wears, and the decor that's out
  state faceW = "" persist
  state neckW = "" persist
  state decorW = "" persist
  state homeW = "" persist
  state toyW = "" persist
  // Animal friends: when each egg was bought (Unix seconds, 0 = not yet; in petIds
  // order), and the two that are out on the branch, left and right.
  state palT = [0, 0, 0, 0, 0, 0, 0, 0, 0] persist
  state palA = "" persist
  state palB = "" persist
  state nBerry = 0 persist            // treats in the pantry
  state nCake = 0 persist
  state nGold = 0 persist
  state nStar = 0 persist
  state treatSel = "berry" persist    // the treat the feed menu offers first
  state lastDay = "" persist          // yyyyMMdd of the last daily bonus
  state streak = 0 persist
  state perfects = 0 persist
  state cleaned = 0 persist
  state baths = 0 persist
  state treats = 0 persist
  state bought = 0 persist
  state qFeed = 0 persist             // today's goals: feed 3, win 1, pet 10
  state qWin = 0 persist
  state qPet = 0 persist
  state qDone = false persist
  state toast = ""                    // a line the caption shows for a few seconds
  state toastNow = 0
  state gainC = 0                     // coins the last tap earned
  state tr = ""                       // the last treat served
  state own = false
  state buyOk = false
  state tab = "owl"
  state shopCat = "treat"
  state shopMsg = ""
  state palHit = -1                   // the friend a tap landed on: 0 left, 1 right
  state palTap = -1                   // the friend the last pet went to
  state palWas = false

  // The last tap, in Canvas `time` and in Unix seconds, and what it did.
  state tapAt = -100
  state tapNow = 0
  state tapKind = ""
  state act = ""
  state bi = -1
  state pressI = -1
  state pressAt = -100
  state mode = ""                    // "", "feed" (meal or snack), "pick" (which game) or "game"
  state modeNow = 0
  state cleanN = 0
  state tF = 0
  state tJ = 0
  state tW = 0
  state nF = -1
  state nJ = -1
  // Two games of five rounds; three wins make it happy.
  // "way": it looks left or right, you guess. "catch": a moth flutters by, tap as it passes over the owl.
  // "pounce": now and then a mouse pops up on the left or right, tap its side before it hides.
  state gKind = "way"
  state guess = false
  state start = false
  state gSeed = 0
  state mK = 0
  state mSide = 0
  state mShow = false
  state gRound = 0
  state gHist = ""
  state gDir = 0
  state gPos = 0
  state gAt = -100
  state fin = false
  state confirmReset = false

  let hour = num(fmtTime(now, "H"))
  let hatched = born > 0
  // Bedtime and waking, in local hours.
  let bedH = 21
  let wakeH = 6
  let asleep = hatched && (hour >= bedH || hour < wakeH)
  // Awake seconds between a time and now, so nothing drains overnight.
  // Each time as awake seconds since the epoch: from wakeH to bedH local, each day.
  let awakeAt = [now, foodAt, joyAt, cleanAt, washAt].map(t =>
    [num(fmtTime(t, "H")) * 3600 + num(fmtTime(t, "m")) * 60 + num(fmtTime(t, "s"))]
      .map(d => round((t - d) / 86400) * (bedH - wakeH) * 3600 + clamp(d - wakeH * 3600, 0, (bedH - wakeH) * 3600))[0])
  // Animal friends. An egg hatches 15 minutes after it's bought; a hatched friend
  // that's out on the branch lends its perk.
  let petIds = ["duckling", "turtle", "bunny", "frog", "kitten", "hamster", "penguin", "fox", "dragon"]
  let hatchS = 900
  let readyIds = range(len(petIds)).filter(k => (palT[k] ?? 0) > 0 && now - palT[k] >= hatchS).map(k => petIds[k])
  let outIds = [palA, palB].filter(id => readyIds.indexOf(id) >= 0)
  let nPals = len(readyIds)
  let palWait = sort(range(len(petIds)).filter(k => (palT[k] ?? 0) > 0 && now - palT[k] < hatchS).map(k => palT[k] + hatchS))
  let nextHatch = palWait[0] ?? 0
  // Upgrades from the shop: the blanket slows the hearts, the pond the poop, a toy the
  // happy hearts. Friends: the turtle slows hunger, the frog grime, the penguin poop.
  let drainS = contains(owned, ",blanket,") ? 9000 : 7200
  let foodS = drainS * (outIds.indexOf("turtle") >= 0 ? 1.25 : 1)
  let joyS = drainS * (toyW != "" ? 1.15 : 1)
  let washS = outIds.indexOf("frog") >= 0 ? 13500 : 10800
  let poopS = (contains(owned, ",pond,") ? 14400 : 10800) + (outIds.indexOf("penguin") >= 0 ? 1800 : 0)
  let petEvery = outIds.indexOf("bunny") >= 0 ? 3 : 5
  let foodH = hatched ? clamp(food - max(awakeAt[0] - awakeAt[1], 0) / foodS, 0, 4) : 0
  let joyH = hatched ? clamp(joy - max(awakeAt[0] - awakeAt[2], 0) / joyS, 0, 4) : 0
  // Hygiene drains a drop every 3 h awake, and another for each pile of poop lying
  // about, from the moment it appeared. Cleaning keeps what was lost so far.
  let washH = hatched ? clamp(wash - (max(awakeAt[0] - awakeAt[4], 0)
    + sum(range(1, 5).map(k => max(awakeAt[0] - max(awakeAt[3] + k * poopS, awakeAt[4]), 0)))) / washS, 0, 4) : 0
  let poops = hatched ? clamp(floor(max(awakeAt[0] - awakeAt[3], 0) / poopS), 0, 4) : 0
  let dancing = m.playing == true
  let tired = bat != null && bat.level < 20 && !bat.charging
  let mood = !hatched ? "egg" : asleep ? "asleep" : sick ? "sick" : foodH < 1 ? "hungry" : dancing ? "dancing" : joyH < 1 ? "bored" : washH < 1 ? "smelly" : tired ? "tired" : "content"
  let day = floor((now - born) / 86400) + 1
  let chick = hatched && day <= 1
  // It grows: from 70% of full size at hatching to full size after three days, a little every moment.
  let grow = hatched ? clamp(0.7 + (now - born) / 86400 * 0.1, 0.7, 1) : 1
  let scholar = hatched && day >= 5 && mistakes <= 3
  let stageName = !hatched ? "egg" : chick ? "chick" : scholar ? "scholar owl" : day < 4 ? "young owl" : "owl"
  let gameOn = mode == "game" && now - modeNow < 60
  let inMenu = mode == "feed" && now - modeNow < 30
  let inPick = mode == "pick" && now - modeNow < 30
  // Catch: the moth's speed in sweeps a second, faster each round.
  let ballV = 0.5 + gRound * 0.1
  // Pounce: time runs in cycles of mL seconds; a mouse may show for the last mW of each,
  // on a side and with a chance hashed from the cycle and the round's seed. Quicker each round.
  let mL = 1.5 - gRound * 0.1
  let mW = 0.75 - gRound * 0.08
  let gWins = len(replace(gHist, "l", ""))
  let gWon = gWins >= 3
  let dur = {hatch: 1.4, meal: 2.2, snack: 2.2, treat: 2.2, notreat: 1.6, refuse: 1.2, med: 2.2, clean: 1.8, bath: 2.4, pet: 1.2, palpet: 1.2}

  // Level n takes 20·(n−1)² xp: 20, 80, 180, 320, 500, ...
  let level = floor(sqrt(xp / 20)) + 1
  let lvlFrom = 20 * (level - 1) * (level - 1)
  let lvlTo = 20 * level * level
  let todayKey = fmtTime(now, "yyyyMMdd")
  let yKey = fmtTime(now - 86400, "yyyyMMdd")
  let goalsMet = qFeed >= 3 && qWin >= 1 && qPet >= 10
  let pantry = {berry: nBerry, cake: nCake, gold: nGold, star: nStar}
  let curTreat = get(pantry, treatSel, 0) > 0 ? treatSel : ["berry", "cake", "gold", "star"].find(t => get(pantry, t, 0) > 0) ?? ""

  let badgeList = [
    {id: "hatch", name: "hello world", desc: "hatch an egg", reward: 10, ok: hatched},
    {id: "pet", name: "cuddly", desc: "pet one owl 25 times", reward: 15, ok: pets >= 25},
    {id: "win", name: "first win", desc: "win a game", reward: 10, ok: gamesWon >= 1},
    {id: "champ", name: "champion", desc: "win 10 games", reward: 40, ok: gamesWon >= 10},
    {id: "flawless", name: "flawless", desc: "win a game 5 of 5", reward: 25, ok: perfects >= 1},
    {id: "tidy", name: "tidy", desc: "clean up 20 poops", reward: 20, ok: cleaned >= 20},
    {id: "bath", name: "squeaky clean", desc: "give 15 baths", reward: 15, ok: baths >= 15},
    {id: "foodie", name: "foodie", desc: "serve 10 treats", reward: 20, ok: treats >= 10},
    {id: "shopper", name: "shopper", desc: "buy something in the shop", reward: 10, ok: bought >= 1},
    {id: "dapper", name: "dapper", desc: "wear a hat, eyewear and neckwear", reward: 30, ok: headW != "" && faceW != "" && neckW != ""},
    {id: "regular", name: "regular", desc: "visit 3 days in a row", reward: 20, ok: streak >= 3},
    {id: "devoted", name: "devoted", desc: "visit 7 days in a row", reward: 50, ok: streak >= 7},
    {id: "wise", name: "wise", desc: "reach level 5", reward: 50, ok: level >= 5},
    {id: "scholar", name: "scholar", desc: "earn the scholar's cap", reward: 50, ok: scholar},
    {id: "friend", name: "new friend", desc: "hatch an animal friend", reward: 15, ok: nPals >= 1},
    {id: "menagerie", name: "menagerie", desc: "hatch 4 animal friends", reward: 40, ok: nPals >= 4},
    {id: "zookeeper", name: "zookeeper", desc: "hatch every animal friend", reward: 120, ok: nPals >= len(petIds)},
    {id: "home", name: "homeowner", desc: "buy it a home", reward: 15, ok: homeW != ""},
    {id: "toys", name: "toy box", desc: "own 3 toys", reward: 20, ok: len(["ball", "yarn", "teddy", "drum", "kite", "robot"].filter(t => contains(owned, ",${t},"))) >= 3}
  ]
  let pending = badgeList.find(b => b.ok && !contains(badges, ",${b.id},"))

  // An owl hatched before version 2 starts its meters fresh.
  when hatched && foodAt == 0 {
    food = 3; foodAt = now; joy = 3; joyAt = now; cleanAt = now
    mistakes = 0; foodMiss = false; joyMiss = false; sick = false
  }
  // Owls from before hygiene start out clean.
  when hatched && washAt == 0 { wash = 4; washAt = now }
  // Care: running a meter empty counts once, and neglect makes it sick.
  when hatched && foodAt > 0 && foodH == 0 && !foodMiss { mistakes = mistakes + 1; foodMiss = true; notify("hootling", "Your owl is starving. Feed it!") }
  when hatched && joyAt > 0 && joyH == 0 && !joyMiss { mistakes = mistakes + 1; joyMiss = true }
  when hatched && washAt > 0 && washH == 0 && !washMiss { mistakes = mistakes + 1; washMiss = true; notify("hootling", "Your owl is filthy. Give it a bath!") }
  when hatched && foodAt > 0 && !asleep && !sick && (poops >= 3 || poops >= 1 && washH == 0 || foodH == 0 && joyH == 0) { sick = true; notify("hootling", "Your owl is sick. It needs medicine.") }
  when !asleep { lightsOff = false }
  // A friend's egg hatches.
  at nextHatch {
    toast = "an egg hatched! say hi"
    toastNow = now
    notify("hootling", "A friend's egg hatched! Come say hi.")
  }

  // The daily visit: the first time it's awake each day pays a bonus that grows
  // with the streak of days in a row, and starts the day's goals afresh.
  when hatched && !asleep && lastDay != todayKey {
    streak = lastDay == yKey ? streak + 1 : 1
    coins = coins + 5 + 5 * min(streak, 7) + (outIds.indexOf("hamster") >= 0 ? 10 : 0)
    xp = xp + 5
    toast = "day ${streak} streak! +${5 + 5 * min(streak, 7) + (outIds.indexOf("hamster") >= 0 ? 10 : 0)}¢"
    toastNow = now
    qFeed = 0; qWin = 0; qPet = 0; qDone = false
    lastDay = todayKey
  }
  // Badges and the day's goals pay out one at a time, so each gets its moment.
  every 2s {
    coins = pending != null ? coins + pending.reward : goalsMet && !qDone ? coins + 25 : coins
    xp = pending == null && goalsMet && !qDone ? xp + 15 : xp
    toast = pending != null ? "★ ${pending.name}! +${pending.reward}¢" : goalsMet && !qDone ? "★ goals done! +25¢" : toast
    toastNow = pending != null || goalsMet && !qDone ? now : toastNow
    qDone = pending == null && goalsMet ? true : qDone
    badges = pending != null ? badges + pending.id + "," : badges
  }
  on level {
    coins = value > old ? coins + value * 10 : coins
    toast = value > old ? "level ${value}! +${value * 10}¢" : toast
    toastNow = value > old ? now : toastNow
  }

  // Sprites: one letter per art pixel, "." is empty. Turned once into runs of the
  // same letter, [column, row, letter, length], so a row takes a few rects, not one per pixel.
  let cells = rows => flatten(rows.map((r, j) => range(len(r))
    .filter(i => sub(r, i, i + 1) != "." && (i == 0 || sub(r, i - 1, i) != sub(r, i, i + 1)))
    .map(i => [i, j, sub(r, i, i + 1), (range(i, len(r)).find(k => sub(r, k, k + 1) != sub(r, i, i + 1)) ?? len(r)) - i])))
  let owlArt = [[
    ".b..........b.",
    ".bb........bb.",
    ".bbbbbbbbbbbb.",
    "bbFFFFbbFFFFbb",
    "bFFFFFFFFFFFFb",
    "bFFFFFFFFFFFFb",
    "bbFFFFkkFFFFbb",
    "bbbbbbkkbbbbbb",
    "wbbllllllllbbw",
    "wwbvlvllvlvbww",
    "wwbllllllllbww",
    "wwbblvllvlbbww",
    ".wwbbllllbbww.",
    "..bbbbbbbbbb..",
    "...ff....ff..."
  ]].map(cells)[0]
  let chickArt = [[
    "....b..b....",
    "..bbbbbbbb..",
    ".bbbbbbbbbb.",
    "bFFFFbbFFFFb",
    "bFFFFFFFFFFb",
    "bFFFFkkFFFFb",
    "wbFFbkkbFFbw",
    "wbbbbbbbbbbw",
    ".wbllllllbw.",
    "..bbllllbb..",
    "...ff..ff..."
  ]].map(cells)[0]
  let eggArt = [[
    "..eeee..",
    ".eeeeee.",
    ".eeeeee.",
    "eeeeeeee",
    "eeeeseee",
    "eseeeeee",
    "eeeeeese",
    "eeeeeeee",
    ".eeeeee.",
    "..eeee.."
  ]].map(cells)[0]
  let art = chick ? chickArt : owlArt
  let aw = chick ? 12 : 14
  let ah = chick ? 11 : 15
  let eyeCols = chick ? [1, 7] : [2, 8]
  let mouth = chick ? [5, 6] : [6, 7]

  // Small sprites, drawn with `sprite` and a palette.
  let heartArt = [".h.h.", "hhhhh", "hhhhh", ".hhh.", "..h.."]
  let cookieArt = [".ccc.", "cdccc", "ccccd", "ccdcc", ".ccc."]
  let fishArt = [".sss..s", "sesssss", ".sss..s"]
  let ballArt = [".rrr.", "rrwrr", "rwwwr", "rrwrr", ".rrr."]
  let poopArt = ["..o...", ".oo...", ".oooo.", "ooqooo"]
  let bigPoopArt = ["...o....", "..oo....", ".ooooo..", ".oqooqo.", "oooooooo"]
  let duckArt = ["..yy...", ".yyko..", "..yy...", "yyyyyy.", ".yyyyy.", "..yyy.."]
  let syringeArt = ["g.ttttt..", "ggtrrrtnn", "g.ttttt.."]
  let skullArt = [".sss.", "sksks", "sssss", ".s.s."]
  let capArt = ["..mmmmmmmmmm..", "....mmmmmm.t..", "...........t.."]
  let mothArt = [
    [".a.....a.", "..a...a..", "wwwwbwwww", "wwSwbwSww", ".wwwbwww.", "..ww.ww.."],
    [".a.....a.", "..a...a..", "..wwbww..", "..wSbSw..", "...wbw...", "....w...."]
  ]
  let mouseArt = ["..ee.....", ".mkmm....", "nmmmmmm..", ".mmmmmmmt", "..p...p.t"]
  let arrowL = ["..a", ".aa", "aaa", ".aa", "..a"]
  let arrowR = ["a..", "aa.", "aaa", "aa.", "a.."]
  let icons = [
    ["x.x..x.", "x.x.xx.", "xxx.xx.", ".x..xx.", ".x...x.", ".x...x.", ".x...x."],
    ["..xxx..", ".x.x.x.", "xx.x.xx", "x.xxx.x", "xx.x.xx", ".x.x.x.", "..xxx.."],
    [".xx....", "x.xx...", "xxx....", ".xx....", ".xxxxxx", "xxxxxxx", ".xxxxx."],
    ["...x...", "..xxx..", ".xxxxx.", "xxxxxxx", "xxxxx.x", "xxxx.xx", ".xxxxx."],
    ["......x", ".....x.", "...xx..", "..x.x..", ".x.x...", "x.x....", "xx....."],
    ["..xxx..", ".x...x.", ".x...x.", ".x...x.", "..x.x..", "..xxx..", "..xxx.."],
    ["..xxx..", ".x...x.", "xxxxxxx", "x.....x", "x..x..x", "x.....x", "xxxxxxx"],
    ["......x", "....x.x", "....x.x", "..x.x.x", "..x.x.x", "x.x.x.x", "xxxxxxx"]
  ]
  let coinArt = [".kkk.", "kkdkk", "kdkkk", "kkkkk", ".kkk."]
  let coinPal = {k: mix(yellow, orange, 0.25), d: mix(yellow, foreground, 0.15)}
  let bulbOff = ["..xxx..", ".xxxxx.", ".xxxxx.", ".xxxxx.", "..xxx..", "..xxx..", "..xxx.."]

  let body = sick ? mix(accent, green, 0.55) : accent
  let pal = {
    b: body, F: mix(foreground, background, 0.12), k: yellow, w: mix(body, background, 0.35),
    l: mix(body, foreground, 0.45), v: mix(body, background, 0.2), f: orange,
    e: mix(foreground, background, 0.15), s: mix(accent, background, 0.3),
    h: red, c: mix(orange, yellow, 0.4), d: mix(orange, background, 0.6),
    o: mix(orange, background, 0.45), q: mix(orange, background, 0.7),
    y: yellow, r: red, t: alpha(foreground, 0.8), g: muted, n: foreground,
    m: mix(foreground, background, 0.3), a: accent
  }
  let fishPal = {s: mix(cyan, foreground, 0.25), e: background}
  let ballPal = {r: red, w: foreground}
  let skullPal = {s: foreground, k: background}
  let mousePal = {m: mix(foreground, background, 0.45), e: mix(red, foreground, 0.5), k: background, n: mix(red, foreground, 0.4), p: mix(red, foreground, 0.5), t: mix(red, foreground, 0.5)}
  let mothPal = {w: mix(foreground, yellow, 0.35), S: mix(orange, background, 0.3), b: mix(orange, background, 0.5), a: mix(foreground, background, 0.4)}

  // The shop. Wearables sit on the art: hats with their bottom row on the top of the
  // head (dx, dy shift them), eyewear on the eye discs, neckwear under the beak.
  let gold = mix(yellow, orange, 0.25)
  let shop = [
    {id: "berry", kind: "treat", name: "berries", price: 6, lvl: 1, desc: "+1 hunger, +½ happy",
      art: ["..g..", ".pgp.", "ppppp", "pwppp", ".ppp."], pal: {p: mix(magenta, blue, 0.4), w: alpha(foreground, 0.7), g: green}},
    {id: "cake", kind: "treat", name: "cupcake", price: 12, lvl: 1, desc: "+2 happy, +3 g",
      art: ["..r..", ".www.", "wwwww", "ccccc", ".cdc.", ".ccc."], pal: {r: red, w: mix(magenta, foreground, 0.35), c: get(pal, "c"), d: get(pal, "d")}},
    {id: "gold", kind: "treat", name: "golden fish", price: 20, lvl: 2, desc: "fills hunger, +1 happy",
      art: fishArt, pal: {s: gold, e: background}},
    {id: "star", kind: "treat", name: "star candy", price: 35, lvl: 4, desc: "fills every heart",
      art: ["..y..", ".yyy.", "yyyyy", ".yyy.", ".y.y."], pal: {y: yellow}},
    {id: "party", kind: "head", name: "party hat", price: 25, lvl: 1, desc: "it's always someone's birthday",
      art: ["...y...", "...p...", "..pzp..", "..zpz..", ".pzpzp.", ".zpzpz.", "pzpzpzp"], pal: {y: yellow, p: magenta, z: cyan}},
    {id: "flower", kind: "head", name: "flower", price: 20, lvl: 1, desc: "tucked behind an ear", dx: 5,
      art: [".m.m.", "mmymm", ".mmm.", "..g.."], pal: {m: magenta, y: yellow, g: green}},
    {id: "beanie", kind: "head", name: "beanie", price: 40, lvl: 2, desc: "snug, with a bobble", dy: 1,
      art: [".....yy.....", "..nnnnnnnn..", ".nnnnnnnnnn.", "oooooooooooo"], pal: {y: mix(background, foreground, 0.08), n: green, o: mix(green, background, 0.35)}},
    {id: "crown", kind: "head", name: "crown", price: 120, lvl: 5, desc: "for royalty",
      art: ["k..k..k", "kk.k.kk", "kkkkkkk", "krkckrk"], pal: {k: gold, r: red, c: cyan}},
    {id: "wizard", kind: "head", name: "wizard hat", price: 150, lvl: 6, desc: "wise beyond its days",
      art: ["......m.", ".....mm.", "....mmm.", "...mmym.", "...mmmm.", "..mmymm.", "..mmmmm.", "mmmmmmmm"], pal: {m: mix(blue, magenta, 0.4), y: yellow}},
    {id: "bow", kind: "head", name: "hair bow", price: 15, lvl: 1, desc: "a little ribbon", dx: -4,
      art: ["pp.pp", "ppkpp", "pp.pp"], pal: {p: magenta, k: mix(magenta, background, 0.4)}},
    {id: "chef", kind: "head", name: "chef's hat", price: 35, lvl: 2, desc: "head cook of the branch",
