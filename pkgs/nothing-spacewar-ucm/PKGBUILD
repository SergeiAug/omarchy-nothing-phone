package() {
  local profile
  for profile in spacewar HiFi VoiceCall; do
    install -Dm644 "$srcdir/$profile.conf" "$pkgdir/usr/share/alsa/ucm2/Nothing/spacewar/$profile.conf"
  done
  install -d "$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250"
  ln -s ../../Nothing/spacewar/spacewar.conf "$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250/NP1.conf"
  install -Dm644 "$srcdir/51-spacewar-s16.conf" "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/51-spacewar-s16.conf"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
