license=('MIT')
depends=('omarchy-dev>=4.0.0.r7031' 'hyprland>=0.56.2' 'quickshell' 'python' 'omarchy-osk-spacewar' 'hyprgrass' 'blueman' 'nm-connection-editor')
source=('spacewar-mobile' 'spacewar-mobile-setup' 'phone-device.lua' 'phone-mobile.lua' 'LICENSE.omarchy-mobile' 'README.md' 'VALIDATION.md'
        'Shade.qml' 'Switcher.qml'
        'spacewar.shade.json' 'spacewar.switcher.json'
        'PlainLabel.qml' 'TouchButton.qml' 'MobilePanel.qml' 'Navigation.qml' 'QuickTile.qml' 'phone-lock.lua' 'lock_setup.py' 'lock-upstream.json' 'LICENSE.omarchy'
        'Service.qml' 'LockView.qml' 'spacewar.lock.json' 'FingerprintModel.js' 'LockFeedSurface.qml' 'poster.sh')

