package() {
  local dest="$pkgdir/usr/share/nothing-spacewar/mobile"
  local name entry
  install -dm755 "$dest/ui" "$pkgdir/usr/bin" "$pkgdir/usr/share/licenses/$pkgname"
  for name in shade switcher; do
    case "$name" in
      shade) entry=Shade ;;
      switcher) entry=Switcher ;;
    esac
    install -Dm644 "$srcdir/spacewar.$name.json" "$dest/plugins/spacewar.$name/manifest.json"
    install -m644 "$srcdir/$entry.qml" "$dest/plugins/spacewar.$name/"
    ln -s ../../ui "$dest/plugins/spacewar.$name/ui"
  done
  install -m644 "$srcdir/PlainLabel.qml" "$srcdir/TouchButton.qml" "$srcdir/MobilePanel.qml" "$srcdir/Navigation.qml" "$srcdir/QuickTile.qml" "$dest/ui/"
  install -dm755 "$dest/plugins/spacewar.lock"
  install -m644 "$srcdir/Service.qml" "$srcdir/LockView.qml" "$srcdir/FingerprintModel.js" "$srcdir/LockFeedSurface.qml" "$dest/plugins/spacewar.lock/"
  install -m644 "$srcdir/spacewar.lock.json" "$dest/plugins/spacewar.lock/manifest.json"
  install -m755 "$srcdir/poster.sh" "$dest/plugins/spacewar.lock/"
  install -m644 "$srcdir/phone-lock.lua" "$srcdir/lock_setup.py" "$srcdir/lock-upstream.json" "$dest/"
  install -m644 "$srcdir/LICENSE.omarchy" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.omarchy"
  install -m644 "$srcdir/phone-device.lua" "$srcdir/phone-mobile.lua" "$srcdir/README.md" "$srcdir/VALIDATION.md" "$srcdir/LICENSE.omarchy-mobile" "$dest/"
  install -m644 "$srcdir/LICENSE.omarchy-mobile" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -m755 "$srcdir/spacewar-mobile" "$srcdir/spacewar-mobile-setup" "$dest/"
  ln -s /usr/share/nothing-spacewar/mobile/spacewar-mobile "$pkgdir/usr/bin/spacewar-mobile"
  ln -s /usr/share/nothing-spacewar/mobile/spacewar-mobile-setup "$pkgdir/usr/bin/spacewar-mobile-setup"
}
